-- ⚔️ WAFFEN
----------------------------------------------------------------------------
BUILDERS.weapons = function(root)
	local top = UI.panel(root, { Size = UDim2.new(1, 0, 0, 74), Color = C.panel2 })
	UI.padding(top, 8)
	local topText = UI.text(top, "", { XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxText = 15 })
	local list = UI.scroll(root, { Size = UDim2.new(1, 0, 1, -82), Position = UDim2.new(0, 0, 0, 82) })
	UI.list(list, false, 6)
	UI.padding(list, 2)

	local function build()
		UI.clear(list)
		local d = data()
		local eq = Logic.weaponById[d.weapon]
		topText.Text = "Ausgerüstet: <font color='" .. UI.hex(C.gold) .. "'>" .. (eq and (eq.emoji .. " " .. eq.name) or "–") .. "</font>  ·  💥 "
			.. Util.format(eq and Logic.weaponDamage(d, eq.id) or 0) .. " pro Treffer  ·  ❤️ Selbstbewusstsein " .. Util.format(Logic.maxConfidence(d))
			.. "\n<font color='" .. UI.hex(C.muted) .. "'>So geht's: Waffe unten im Inventar wählen (Taste 1), zum 👑 Boss laufen, klicken/tippen. Rote Kreise = schnell weg!</font>"
		for i, w in ipairs(Config.Weapons) do
			local level = Logic.weaponLevel(d, w.id)
			local rarity = Config.Rarities[w.rarity]
			local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 80), Color = C.panel2, LayoutOrder = i })
			UI.stroke(row, rarity.color, 2, level > 0 and 0.1 or 0.6)
			UI.text(row, w.emoji, { Size = UDim2.new(0, 56, 1, 0), MaxText = 38 })
			UI.text(row, w.name .. "  <font size='13' color='" .. UI.hex(rarity.color) .. "'>" .. rarity.name .. (level > 0 and (" · Stufe " .. level .. "/" .. Config.WEAPON_MAX_LEVEL) or "") .. "</font>",
				{ Size = UDim2.new(1, -330, 0.34, 0), Position = UDim2.new(0, 60, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 17 })
			UI.text(row, w.desc, { Size = UDim2.new(1, -330, 0.3, 0), Position = UDim2.new(0, 60, 0.38, 0), XAlign = Enum.TextXAlignment.Left,
				Font = Enum.Font.Gotham, Color = C.muted, MaxText = 13 })
			UI.text(row, "💥 " .. Util.format(w.damage) .. " · ⏱️ " .. w.cooldown .. " s · 📏 " .. w.range .. " · 🎯 " .. math.floor(w.crit * 100) .. " %",
				{ Size = UDim2.new(1, -330, 0.26, 0), Position = UDim2.new(0, 60, 0.7, 0), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, Color = C.green, MaxText = 13 })
			if level > 0 then
				local isEq = d.weapon == w.id
				UI.button(row, isEq and "✅ Ausgerüstet" or "Ausrüsten", isEq and C.grey or C.green, function()
					Remotes.EquipWeapon:FireServer(w.id)
				end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -144, 0.5, 0), Size = UDim2.new(0, 124, 0, 44), TextColor = isEq and C.text or C.dark, MaxText = 15 })
				if level < Config.WEAPON_MAX_LEVEL then
					local cost = Logic.weaponUpgradeCost(w.id, level)
					UI.button(row, "⬆️ " .. Util.format(cost), d.cash >= cost and C.money or C.grey, function()
						Remotes.UpgradeWeapon:FireServer(w.id)
					end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 128, 0, 44), TextColor = C.dark, MaxText = 15 })
				else
					UI.text(row, "✅ MAX", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 128, 0, 44), Color = C.gold, MaxText = 18 })
				end
			elseif w.price > 0 then
				UI.button(row, "💵 " .. Util.format(w.price), d.cash >= w.price and C.money or C.grey, function()
					Remotes.BuyWeapon:FireServer(w.id)
				end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 128, 0, 44), TextColor = C.dark, MaxText = 16 })
			else
				UI.text(row, "👑 Nur Beute", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 128, 0, 44), Color = C.red, MaxText = 16 })
			end
		end
	end

	return function(kind)
		if kind == "full" then build() end
	end
end


----------------------------------------------------------------------------
-- 🎁 BOX-INHALT (an einer Pet-Station mit R geöffnet)
----------------------------------------------------------------------------
BUILDERS.egginfo = function(root, eggIndex)
	local egg = Config.Eggs[eggIndex or 1]
	if not egg then return nil end
	local station = Config.EggStations[egg.station] or { emoji = egg.emoji or "🎁" }
	local d = data()
	local total = 0
	for _, e in ipairs(egg.pets) do total = total + e.weight end
	local costText = Util.format(egg.cost) .. " Aura"
	if egg.event then
		for _, ev in ipairs(Config.Events) do
			if ev.id == egg.event then costText = egg.cost .. " " .. ev.token end
		end
	end
	UI.text(root, station.emoji .. " <b>" .. egg.name .. "</b>  ·  <font color='" .. UI.hex(C.gold) .. "'>" .. costText .. "</font>  ·  🍀 Glück "
		.. Util.formatMult(snap().luck), { Size = UDim2.new(1, -250, 0, 34), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
	UI.button(root, "🎁 Öffnen", C.gold, function()
		Remotes.HatchEgg:FireServer(egg.index, 1)
		Menus.close()
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -124, 0, 0), Size = UDim2.new(0, 118, 0, 34), TextColor = C.dark, MaxText = 16 })
	UI.button(root, "🎁 3x", Logic.perkLevel(d, "triple") > 0 and C.gold or C.grey, function()
		Remotes.HatchEgg:FireServer(egg.index, 3)
		Menus.close()
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 118, 0, 34), TextColor = C.dark, MaxText = 16 })
	local grid = UI.scroll(root, { Size = UDim2.new(1, 0, 1, -42), Position = UDim2.new(0, 0, 0, 42) })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0, 112, 0, 150), CellPadding = UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	for i, e in ipairs(egg.pets) do
		local def = Logic.petById[e.id]
		local rarity = Config.Rarities[def.rarity]
		local cell = UI.panel(grid, { Color = rarity.color:Lerp(Color3.new(0, 0, 0), 0.65), LayoutOrder = i, Radius = 10 })
		UI.stroke(cell, rarity.color, 2, 0)
		PetView.make(cell, def.id, 1, false, { Size = UDim2.new(1, 0, 0.5, 0) })
		UI.text(cell, def.name, { Size = UDim2.new(1, -6, 0.15, 0), Position = UDim2.new(0, 3, 0.5, 0), MaxText = 14 })
		UI.text(cell, rarity.name, { Size = UDim2.new(1, -6, 0.11, 0), Position = UDim2.new(0, 3, 0.65, 0), Color = rarity.color, MaxText = 13 })
		UI.text(cell, Util.format(e.weight / total * 100) .. " %", { Size = UDim2.new(1, -6, 0.12, 0), Position = UDim2.new(0, 3, 0.76, 0), Color = C.gold, MaxText = 15 })
		UI.text(cell, Util.formatPercent(def.boost) .. " Aura", { Size = UDim2.new(1, -6, 0.1, 0), Position = UDim2.new(0, 3, 0.88, 0), Color = C.green,
			Font = Enum.Font.GothamBold, MaxText = 12 })
	end
	return nil
end


----------------------------------------------------------------------------
-- 💎 ROBUX-SHOP
----------------------------------------------------------------------------
local MarketplaceService = game:GetService("MarketplaceService")

BUILDERS.shop = function(root)
	local list = UI.scroll(root)
	UI.list(list, false, 6)
	UI.padding(list, 2)
	local function build()
		UI.clear(list)
		local d = data()
		local order = 0
		local function o() order = order + 1 return order end
		UI.text(list, "💎 Du hast <font color='" .. UI.hex(C.cyan) .. "'>" .. Util.format(d.gems) .. " Gems</font> · Gems gibt's auch am 🎡 Glücksrad, bei Spielzeit-Geschenken & Events",
			{ Size = UDim2.new(1, -10, 0, 30), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxText = 15, LayoutOrder = o() })
		local function row(emoji, name, desc, btnText, btnColor, onClick, highlight)
			local r = UI.panel(list, { Size = UDim2.new(1, -10, 0, 64), Color = highlight and C.purple or C.panel2, LayoutOrder = o() })
			UI.text(r, emoji, { Size = UDim2.new(0, 54, 1, 0), MaxText = 34 })
			UI.text(r, name, { Size = UDim2.new(1, -200, 0.5, 0), Position = UDim2.new(0, 58, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
			UI.text(r, desc or "", { Size = UDim2.new(1, -200, 0.42, 0), Position = UDim2.new(0, 58, 0.54, 0), XAlign = Enum.TextXAlignment.Left,
				Font = Enum.Font.Gotham, Color = C.muted, MaxText = 13 })
			UI.button(r, btnText, btnColor, onClick, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 128, 0, 44),
				TextColor = C.dark, MaxText = 16 })
		end
		UI.text(list, "🎟️ Gamepasses (einmal kaufen, für immer)", { Size = UDim2.new(1, -10, 0, 28), XAlign = Enum.TextXAlignment.Left, MaxText = 18, LayoutOrder = o() })
		for _, gp in ipairs(Config.GamePasses) do
			local owned = Logic.hasPass(d, gp.key)
			row(gp.emoji, gp.name, gp.desc, owned and "✅ Besitzt du" or (gp.id > 0 and ("R$ " .. gp.robux) or "Bald verfügbar"),
				owned and C.grey or (gp.id > 0 and C.green or C.grey), function()
					if not owned and gp.id > 0 then
						MarketplaceService:PromptGamePassPurchase(Players.LocalPlayer, gp.id)
					end
				end, gp.key == "vip")
		end
		UI.text(list, "💎 Gems & Pakete", { Size = UDim2.new(1, -10, 0, 28), XAlign = Enum.TextXAlignment.Left, MaxText = 18, LayoutOrder = o() })
		for _, dp in ipairs(Config.DevProducts) do
			if not (dp.once and d.starterPack) then
				row(dp.emoji, dp.name, dp.desc or "", dp.id > 0 and ("R$ " .. dp.robux) or "Bald verfügbar", dp.id > 0 and C.cyan or C.grey, function()
					if dp.id > 0 then
						MarketplaceService:PromptProductPurchase(Players.LocalPlayer, dp.id)
					end
				end, dp.key == "starter")
			end
		end
		UI.text(list, "🧪 Tränke für Gems", { Size = UDim2.new(1, -10, 0, 28), XAlign = Enum.TextXAlignment.Left, MaxText = 18, LayoutOrder = o() })
		for _, p in ipairs(Config.Potions) do
			if p.gems and not p.hidden then
				row(p.emoji, p.name, p.desc, "💎 " .. p.gems, d.gems >= p.gems and C.cyan or C.grey, function()
					Remotes.BuyPotion:FireServer(p.id, true)
				end)
			end
		end
		UI.text(list, "Mit Gems kaufst du auch exklusive Auren, Spuren, Hüte, Emotes & Fahrzeuge (Menü ✨).",
			{ Size = UDim2.new(1, -10, 0, 30), Color = C.muted, Font = Enum.Font.GothamBold, MaxText = 14, LayoutOrder = o() })
	end
	return function(kind)
		if kind == "full" then build() end
	end
end

----------------------------------------------------------------------------
-- ✨ AUSRÜSTUNG: Auren, Spuren, Hüte, Emotes, Fahrzeuge
----------------------------------------------------------------------------
local styleTab = "aura"
local STYLE_TABS = {
	{ id = "aura", name = "✨ Auren", list = Config.Auras },
	{ id = "trail", name = "💫 Spuren", list = Config.Trails },
	{ id = "hat", name = "👑 Hüte", list = Config.Hats },
	{ id = "emote", name = "🕺 Emotes", list = Config.Emotes },
	{ id = "vehicle", name = "🛹 Fahrzeuge", list = Config.Vehicles },
}

local function boostText(def, kind)
	if kind == "hat" then
		local parts = {}
		if def.boost.aura then table.insert(parts, Util.formatPercent(def.boost.aura) .. " Aura") end
		if def.boost.cash then table.insert(parts, Util.formatPercent(def.boost.cash) .. " Geld") end
		if def.boost.luck then table.insert(parts, Util.formatPercent(def.boost.luck) .. " Glück") end
		if def.boost.speed then table.insert(parts, "+" .. def.boost.speed .. " Tempo") end
		return table.concat(parts, " · ")
	elseif kind == "vehicle" then
		return "+" .. def.speed .. " Tempo" .. (def.jump > 0 and (" · +" .. def.jump .. " Sprung") or "") .. " · Taste V"
	elseif kind == "emote" then
		return "Spielt eine Animation ab"
	end
	return "Nur Optik – sieht aber krass aus"
end

BUILDERS.style = function(root, startTab)
	if startTab then styleTab = startTab end
	local tabs = UI.scroll(root, { Size = UDim2.new(1, 0, 0, 40), Horizontal = true })
	UI.list(tabs, true, 6)
	local list = UI.scroll(root, { Size = UDim2.new(1, 0, 1, -48), Position = UDim2.new(0, 0, 0, 48) })
	UI.list(list, false, 6)
	UI.padding(list, 2)
	local tabButtons = {}

	local function build()
		UI.clear(list)
		local d = data()
		for id, b in pairs(tabButtons) do b.BackgroundColor3 = (id == styleTab) and C.pink or C.panel2 end
		local tab
		for _, t in ipairs(STYLE_TABS) do if t.id == styleTab then tab = t end end
		for i, def in ipairs(tab.list) do
			local owned = Logic.ownsItem(d, styleTab, def.id)
			local equipped
			if styleTab == "vehicle" then equipped = d.vehicle == def.id else equipped = d.cosmetics[styleTab] == def.id end
			local r = UI.panel(list, { Size = UDim2.new(1, -10, 0, 64), Color = equipped and C.purple or C.panel2, LayoutOrder = i })
			UI.text(r, def.emoji, { Size = UDim2.new(0, 54, 1, 0), MaxText = 34 })
			UI.text(r, def.name, { Size = UDim2.new(1, -200, 0.5, 0), Position = UDim2.new(0, 58, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
			UI.text(r, boostText(def, styleTab), { Size = UDim2.new(1, -200, 0.42, 0), Position = UDim2.new(0, 58, 0.54, 0), XAlign = Enum.TextXAlignment.Left,
				Font = Enum.Font.GothamBold, Color = C.green, MaxText = 13 })
			local btnText, btnColor, action
			if not owned then
				local price = (def.currency == "gems" and "💎 " or "💵 ") .. Util.format(def.price)
				local can = (def.currency == "gems" and d.gems or d.cash) >= def.price
				btnText, btnColor = price, can and C.gold or C.grey
				action = function() Remotes.BuyItem:FireServer(styleTab, def.id) end
			elseif styleTab == "emote" then
				btnText, btnColor = "▶ Abspielen", C.cyan
				action = function()
					Menus.close()
					Emotes.play(def)
				end
			else
				btnText, btnColor = equipped and "Ablegen" or "Ausrüsten", equipped and C.grey or C.green
				action = function() Remotes.EquipItem:FireServer(styleTab, equipped and (styleTab == "vehicle" and "" or def.id) or def.id) end
			end
			UI.button(r, btnText, btnColor, action, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 128, 0, 44),
				TextColor = C.dark, MaxText = 16 })
		end
	end
	for i, t in ipairs(STYLE_TABS) do
		tabButtons[t.id] = UI.button(tabs, t.name, C.panel2, function()
			styleTab = t.id
			build()
		end, { Size = UDim2.new(0, 140, 1, -6), LayoutOrder = i, MaxText = 16 })
	end
	return function(kind)
		if kind == "full" then build() end
	end
end

----------------------------------------------------------------------------
-- 🎡 GLÜCKSRAD & SPIELZEIT-GESCHENKE
----------------------------------------------------------------------------
local wheelFrame = nil
function Menus.spinTo(index)
	if not wheelFrame or not wheelFrame.Parent then return end
	local seg = 360 / #Config.Wheel
	local target = -((index - 0.5) * seg) - 360 * 6
	wheelFrame.Rotation = wheelFrame.Rotation % 360
	game:GetService("TweenService"):Create(wheelFrame, TweenInfo.new(3.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Rotation = target }):Play()
end

BUILDERS.wheel = function(root)
	-- Rad links
	local left = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0.5, -6, 1, 0), Parent = root })
	local holder = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(1, 0, 0.78, 0), Parent = left })
	UI.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = holder })
	wheelFrame = UI.new("Frame", { BackgroundColor3 = C.panel2, Size = UDim2.new(1, 0, 1, 0), Parent = holder })
	UI.new("UICorner", { CornerRadius = UDim.new(0.5, 0), Parent = wheelFrame })
	UI.stroke(wheelFrame, C.gold, 4, 0)
	local seg = 360 / #Config.Wheel
	for i, s in ipairs(Config.Wheel) do
		local a = math.rad((i - 0.5) * seg)
		local chip = UI.panel(wheelFrame, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5 + 0.36 * math.sin(a), 0, 0.5 - 0.36 * math.cos(a), 0),
			Size = UDim2.new(0.3, 0, 0.12, 0), Color = s.color, Radius = 8 })
		chip.Rotation = (i - 0.5) * seg
		UI.text(chip, s.label, { Color = C.dark, MaxText = 13 })
	end
	UI.text(holder, "▼", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0, 6), Size = UDim2.new(0, 40, 0, 34), Color = C.red, MaxText = 34 })
	local spinBtn = UI.button(left, "", C.gold, function()
		Remotes.SpinWheel:FireServer()
	end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0.9, 0, 0.16, 0), TextColor = C.dark, MaxText = 20 })

	-- Chancen & Spielzeit-Geschenke rechts
	local right = UI.scroll(root, { Size = UDim2.new(0.5, -6, 1, 0), Position = UDim2.new(0.5, 6, 0, 0) })
	UI.list(right, false, 5)
	local total = 0
	for _, s in ipairs(Config.Wheel) do total = total + s.weight end
	UI.text(right, "🎯 Chancen am Glücksrad", { Size = UDim2.new(1, -8, 0, 24), XAlign = Enum.TextXAlignment.Left, MaxText = 16, LayoutOrder = 1 })
	for i, s in ipairs(Config.Wheel) do
		UI.text(right, s.label .. "  <font color='" .. UI.hex(C.gold) .. "'>" .. Util.format(s.weight / total * 100) .. " %</font>",
			{ Size = UDim2.new(1, -8, 0, 20), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxText = 13, LayoutOrder = 1 + i })
	end
	UI.text(right, "🎁 Spielzeit-Geschenke (heute)", { Size = UDim2.new(1, -8, 0, 26), XAlign = Enum.TextXAlignment.Left, MaxText = 16, LayoutOrder = 50 })
	local giftButtons = {}
	for i, g in ipairs(Config.PlaytimeGifts) do
		giftButtons[i] = UI.button(right, "", C.grey, function()
			Remotes.ClaimPlaytime:FireServer(i)
		end, { Size = UDim2.new(1, -8, 0, 36), LayoutOrder = 50 + i, MaxText = 15 })
	end

	return function()
		local d = data()
		local remaining = Config.WHEEL_COOLDOWN - (os.time() - d.wheel.last)
		if d.wheel.spins > 0 then
			spinBtn.Text = "🎡 Drehen! (" .. d.wheel.spins .. " übrig)"
			spinBtn.BackgroundColor3 = C.gold
		elseif remaining <= 0 then
			spinBtn.Text = "🎡 Gratis drehen!"
			spinBtn.BackgroundColor3 = C.gold
		else
			spinBtn.Text = "⏳ " .. Util.formatTime(remaining)
			spinBtn.BackgroundColor3 = C.grey
		end
		local player = Players.LocalPlayer
		local joined = player:GetAttribute("JoinTime") or os.time()
		local played = os.time() - joined
		for i, g in ipairs(Config.PlaytimeGifts) do
			local b = giftButtons[i]
			if player:GetAttribute("Gift" .. i) then
				b.Text = "✅ " .. g.label
				b.BackgroundColor3 = C.panel2
			elseif played >= g.minutes * 60 then
				b.Text = "🎁 " .. g.label .. " – abholen!"
				b.BackgroundColor3 = C.gold
				b.TextColor3 = C.dark
			else
				b.Text = "⏳ " .. g.label .. " in " .. Util.formatTime(g.minutes * 60 - played)
				b.BackgroundColor3 = C.grey
				b.TextColor3 = C.text
			end
		end
	end
end

----------------------------------------------------------------------------
-- 🎉 EVENT
----------------------------------------------------------------------------
BUILDERS.event = function(root)
	local list = UI.scroll(root)
	UI.list(list, false, 6)
	UI.padding(list, 2)
	local function build()
		UI.clear(list)
		local d = data()
		local now = os.time()
		local ev = Logic.activeEvent(now)
		local order = 0
		local function o() order = order + 1 return order end
		local weekend = Logic.isWeekend(now)
		local wk = UI.panel(list, { Size = UDim2.new(1, -10, 0, 50), Color = weekend and C.green or C.panel2, LayoutOrder = o() })
		UI.text(wk, weekend and "🎉 WOCHENEND-BOOST AKTIV: x2 Aura & x2 Glück!" or "📅 Jeden Samstag & Sonntag: x2 Aura & x2 Glück (automatisch)",
			{ Size = UDim2.new(1, -16, 1, 0), Position = UDim2.new(0, 8, 0, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 17, Color = weekend and C.dark or C.text })
		if ev then
			local head = UI.panel(list, { Size = UDim2.new(1, -10, 0, 96), Color = ev.color:Lerp(C.dark, 0.55), LayoutOrder = o() })
			UI.stroke(head, ev.color, 2, 0)
			UI.padding(head, 8)
			UI.text(head, ev.emoji .. " <b>" .. ev.name .. "</b> läuft gerade!", { Size = UDim2.new(1, 0, 0.36, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 22 })
			UI.text(head, "Deine " .. ev.token .. ": <font color='" .. UI.hex(C.gold) .. "'>" .. Logic.eventTokens(d, ev.id) .. "</font> · Sammle " .. ev.tokenEmoji
				.. " in allen Welten & besiege den Event-Boss am Event-Platz in Glow City!", { Size = UDim2.new(1, 0, 0.6, 0), Position = UDim2.new(0, 0, 0.38, 0),
				XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxText = 15 })
			UI.button(list, "🎁 Event-Box ansehen (" .. Config.EVENT_EGG_COST .. " " .. ev.token .. ")", C.gold, function()
				Menus.open("egginfo", ev.eggIndex)
			end, { Size = UDim2.new(1, -10, 0, 42), LayoutOrder = o(), TextColor = C.dark, MaxText = 17 })
			UI.text(list, "Exklusive Event-Pets:", { Size = UDim2.new(1, -10, 0, 24), XAlign = Enum.TextXAlignment.Left, MaxText = 16, LayoutOrder = o() })
			local row = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -10, 0, 120), LayoutOrder = o(), Parent = list })
			UI.list(row, true, 6, Enum.HorizontalAlignment.Center)
			for _, e in ipairs(Config.Eggs[ev.eggIndex].pets) do
				local def = Logic.petById[e.id]
				local rarity = Config.Rarities[def.rarity]
				local cell = UI.panel(row, { Size = UDim2.new(0.19, 0, 1, 0), Color = rarity.color:Lerp(C.dark, 0.6), Radius = 10 })
				UI.stroke(cell, rarity.color, 2, 0)
				PetView.make(cell, def.id, 1, false, { Size = UDim2.new(1, 0, 0.7, 0) })
				UI.text(cell, def.name, { Size = UDim2.new(1, -4, 0.28, 0), Position = UDim2.new(0, 2, 0.7, 0), Color = rarity.color, MaxText = 12 })
			end
		else
			UI.text(list, "Gerade läuft kein saisonales Event.", { Size = UDim2.new(1, -10, 0, 30), MaxText = 18, LayoutOrder = o() })
		end
		UI.text(list, "📅 Event-Kalender", { Size = UDim2.new(1, -10, 0, 26), XAlign = Enum.TextXAlignment.Left, MaxText = 17, LayoutOrder = o() })
		for _, e in ipairs(Config.Events) do
			UI.text(list, e.emoji .. " " .. e.name .. ": " .. string.format("%02d.%02d.", e.from[2], e.from[1]) .. " – " .. string.format("%02d.%02d.", e.to[2], e.to[1]),
				{ Size = UDim2.new(1, -10, 0, 22), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, Color = C.muted, MaxText = 14, LayoutOrder = o() })
		end
	end
	return function(kind)
		if kind == "full" then build() end
	end
end


return Menus
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000022"><Properties><string name="Name">PetFollow</string><ProtectedString name="Source"><![CDATA[--[[
	PETFOLLOW – bewegt alle Pets (von allen Spielern) flüssig hinter ihren Besitzern her.
	Läuft auf jedem Gerät selbst, damit es ruckelfrei aussieht.
	Pets laufen leicht hüpfend, schauen in Laufrichtung, Regenbogen-Pets wechseln die Farbe.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local PetFollow = {}
local t = 0
local FAR = 220   -- weiter entfernte Pets werden nicht bewegt (spart Leistung)

function PetFollow.init()
	RunService.RenderStepped:Connect(function(dt)
		t = t + dt
		local folder = workspace:FindFirstChild("Pets")
		local cam = workspace.CurrentCamera
		if not folder or not cam then return end
		local camPos = cam.CFrame.Position
		for _, ownerFolder in ipairs(folder:GetChildren()) do
			local owner = Players:GetPlayerByUserId(tonumber(ownerFolder.Name) or 0)
			local char = owner and owner.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			if hrp and (hrp.Position - camPos).Magnitude < FAR then
				local pets = ownerFolder:GetChildren()
				local n = #pets
				local moving = hrp.AssemblyLinearVelocity.Magnitude > 1
				for _, model in ipairs(pets) do
					local root = model:IsA("Model") and model.PrimaryPart
					if root then
						local slot = model:GetAttribute("Slot") or 1
						-- im Halbkreis hinter dem Spieler
						local angle = 0
						if n > 1 then
							angle = math.rad(-75 + (slot - 1) * (150 / (n - 1)))
						end
						local hop = moving and math.abs(math.sin(t * 9 + slot)) * 0.8 or math.sin(t * 2 + slot) * 0.25
						local target = hrp.CFrame * CFrame.new(math.sin(angle) * 6.5, -1.4 + hop, 4.5 + math.cos(angle) * 2)
						local current = root.CFrame
						local pos = current.Position:Lerp(target.Position, math.clamp(dt * 7, 0, 1))
						local look = hrp.CFrame.LookVector
						root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(look.X, 0, look.Z))
						-- Regenbogen-Pets wechseln die Farbe
						if model:GetAttribute("Tier") == 3 then
							local color = Color3.fromHSV((t * 0.25 + slot * 0.1) % 1, 0.65, 1)
							for _, p in ipairs(model:GetDescendants()) do
								if p:IsA("BasePart") and p:GetAttribute("Main") then
									p.Color = color
								end
							end
						end
					end
				end
			end
		end
	end)
end

return PetFollow
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000023"><Properties><string name="Name">PetView</string><ProtectedString name="Source"><![CDATA[--[[
	PETVIEW – zeigt ein Pet als drehbare 3D-Vorschau in Menüs (ViewportFrame).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local PetModels = require(Shared:WaitForChild("PetModels"))
local Logic = require(Shared:WaitForChild("Logic"))

local PetView = {}
local spinning = {}   -- Modelle, die sich langsam drehen

RunService.RenderStepped:Connect(function(dt)
	for model, data in pairs(spinning) do
		if not model.Parent then
			spinning[model] = nil
		else
			data.angle = data.angle + dt * 0.8
			model:PivotTo(CFrame.Angles(0, data.angle, 0))
		end
	end
end)

-- parent: GUI-Element; petId: z. B. "w1_3"; tier: 1–4; spin: drehen?
function PetView.make(parent, petId, tier, spin, props)
	props = props or {}
	local def = Logic.petById[petId]
	local vp = Instance.new("ViewportFrame")
	vp.Name = "PetView"
	vp.BackgroundTransparency = 1
	vp.Size = props.Size or UDim2.new(1, 0, 1, 0)
	vp.Position = props.Position or UDim2.new(0, 0, 0, 0)
	vp.Ambient = Color3.fromRGB(190, 190, 200)
	vp.LightColor = Color3.fromRGB(255, 250, 240)
	vp.LightDirection = Vector3.new(-1, -1.2, -0.6)
	vp.ZIndex = props.ZIndex or 1
	vp.Parent = parent
	if not def then return vp end

	local model = PetModels.build(def, tier or 1, false)
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	local size = model:GetExtentsSize()
	local dist = math.max(size.X, size.Y, size.Z) * 1.9 + 1
	cam.CFrame = CFrame.lookAt(Vector3.new(dist * 0.45, dist * 0.3, -dist), Vector3.new(0, 0, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	if spin then
		spinning[model] = { angle = 0 }
	end
	return vp
end

return PetView
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000024"><Properties><string name="Name">Sounds</string><ProtectedString name="Source"><![CDATA[--[[
	SOUNDS – spielt Soundeffekte und Hintergrundmusik.
	Die Sound-IDs stehen in Config.Sounds / Config.Music.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Sounds = { sfx = true, music = true }
local cache = {}
local currentMusic = nil

local music = Instance.new("Sound")
music.Name = "Musik"
music.Looped = true
music.Volume = 0.3
music.Parent = SoundService

function Sounds.play(name)
	if not Sounds.sfx then return end
	local id = Config.Sounds[name]
	if not id or id == "" then return end
	local s = cache[name]
	if not s then
		s = Instance.new("Sound")
		s.Name = name
		s.SoundId = id
		s.Volume = 0.6
		s.Parent = SoundService
		cache[name] = s
	end
	SoundService:PlayLocalSound(s)
end

function Sounds.setWorld(index)
	local id = Config.Music[index] or ""
	if id == currentMusic then return end
	currentMusic = id
	music:Stop()
	if id ~= "" and Sounds.music then
		music.SoundId = id
		music:Play()
	end
end

function Sounds.setMusic(on)
	Sounds.music = on
	if on and currentMusic and currentMusic ~= "" then
		music.SoundId = currentMusic
		music:Play()
	else
		music:Stop()
	end
end

function Sounds.setSfx(on)
	Sounds.sfx = on
end

return Sounds
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000025"><Properties><string name="Name">State</string><ProtectedString name="Source"><![CDATA[--[[
	STATE – speichert auf dem Gerät den letzten Spielstand vom Server
	und informiert alle Menüs, wenn sich etwas ändert.
]]

local State = {}
State.snap = nil        -- letzter Stand vom Server (siehe GameService.snapshot)
State.listeners = {}

function State.onChange(fn)
	table.insert(State.listeners, fn)
end

local function fire(kind)
	for _, fn in ipairs(State.listeners) do
		local ok, err = pcall(fn, kind)
		if not ok then
			warn("[Looksmaxxer UI]", err)
		end
	end
end

function State.setFull(snap)
	State.snap = snap
	fire("full")
end

function State.setLight(l)
	local s = State.snap
	if not s then return end
	s.data.aura = l.aura
	s.data.cash = l.cash
	s.data.gems = l.gems or s.data.gems
	s.data.totalAura = l.totalAura
	s.aps = l.aps
	s.click = l.click
	s.mult = l.mult
	s.world = l.world
	s.serverTime = l.serverTime
	fire("light")
end

-- nur lokal (z. B. Klick sofort anzeigen, bevor der Server antwortet)
function State.bump()
	fire("light")
end

return State
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000026"><Properties><string name="Name">TradeUI</string><ProtectedString name="Source"><![CDATA[--[[
	TRADEUI – das Handelsfenster.
	Links: dein Angebot + deine Pets (antippen = hinzufügen/entfernen) + Geld.
	Rechts: was der andere anbietet.
	Unten: Bereit → Bestätigen (beide müssen zustimmen) oder Abbrechen.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))
local Effects = require(script.Parent:WaitForChild("Effects"))

local TradeUI = {}
local C = UI.C
local gui
local window = nil
local current = nil      -- letzter Stand vom Server

local function petCell(parent, pet, order, onClick, highlight)
	local def = Logic.petById[pet.id]
	if not def then return end
	local rarity = Config.Rarities[def.rarity]
	local tier = Config.PetTiers[pet.tier or 1]
	local cell = UI.new("TextButton", { Text = "", AutoButtonColor = onClick ~= nil, BackgroundColor3 = rarity.color:Lerp(Color3.new(0, 0, 0), 0.6),
		LayoutOrder = order, Parent = parent })
	UI.corner(cell, 8)
	UI.stroke(cell, highlight and C.gold or (tier.color or rarity.color), highlight and 3 or 1.5, 0)
	UI.text(cell, def.emoji, { Size = UDim2.new(1, 0, 0.6, 0), MaxText = 30 })
	UI.text(cell, Util.formatPercent(Logic.petBoost(pet)), { Size = UDim2.new(1, -2, 0.36, 0), Position = UDim2.new(0, 1, 0.62, 0), Color = C.green, MaxText = 11 })
	if onClick then cell.Activated:Connect(onClick) end
	return cell
end

local function grid(parent, props)
	local s = UI.scroll(parent, props)
	UI.new("UIGridLayout", { CellSize = UDim2.new(0, 58, 0, 64), CellPadding = UDim2.new(0, 5, 0, 5), SortOrder = Enum.SortOrder.LayoutOrder, Parent = s })
	return s
end

local function totalBoost(pets)
	local t = 0
	for _, p in ipairs(pets) do t = t + Logic.petBoost(p) end
	return t
end

local function sendOffer(petUids, cash)
	Remotes.TradeOffer:FireServer(petUids, cash)
end

local function render()
	if not current then return end
	if not window then
		window = UI.panel(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.53, 0), Size = UDim2.new(0.7, 0, 0.78, 0), Color = C.bg })
		window.Active = true
		UI.new("UISizeConstraint", { MinSize = Vector2.new(340, 340), MaxSize = Vector2.new(900, 600), Parent = window })
		UI.stroke(window, C.cyan, 3, 0)
		UI.padding(window, 10)
	end
	for _, c in ipairs(window:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	local s = current
	local myPetsSelected = {}
	for _, p in ipairs(s.mine.pets) do myPetsSelected[p.uid] = true end

	UI.text(window, "<b>🤝 Handel mit " .. s.otherName .. "</b>", { Size = UDim2.new(1, 0, 0.07, 0), MaxText = 24 })
	UI.text(window, "⚠️ Prüfe genau, was du bekommst! Jede Änderung setzt Bereit & Bestätigen zurück.", { Size = UDim2.new(1, 0, 0.045, 0),
		Position = UDim2.new(0, 0, 0.07, 0), Color = C.gold, Font = Enum.Font.GothamBold, MaxText = 13 })

	-- Linke Seite: dein Angebot
	local left = UI.panel(window, { Size = UDim2.new(0.49, 0, 0.36, 0), Position = UDim2.new(0, 0, 0.12, 0), Color = C.panel })
	UI.padding(left, 6)
	UI.text(left, "Dein Angebot " .. (s.myReady and "✅" or "") .. "  <font color='" .. UI.hex(C.green) .. "'>" .. Util.formatPercent(totalBoost(s.mine.pets)) .. "</font>",
		{ Size = UDim2.new(1, 0, 0.18, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 16 })
	local myOffer = grid(left, { Size = UDim2.new(1, 0, 0.58, 0), Position = UDim2.new(0, 0, 0.2, 0) })
	for i, p in ipairs(s.mine.pets) do
		petCell(myOffer, p, i, function()
			local list = {}
			for _, q in ipairs(s.mine.pets) do
				if q.uid ~= p.uid then table.insert(list, q.uid) end
			end
			sendOffer(list, s.mine.cash)
		end, true)
	end
	UI.text(left, "💵", { Size = UDim2.new(0, 26, 0.2, 0), Position = UDim2.new(0, 0, 0.8, 0), MaxText = 18 })
	local cashBox = UI.new("TextBox", { Size = UDim2.new(1, -30, 0.2, 0), Position = UDim2.new(0, 28, 0.8, 0), BackgroundColor3 = C.dark, TextColor3 = C.text,
		Text = tostring(s.mine.cash), PlaceholderText = "Geld anbieten", ClearTextOnFocus = false, TextScaled = true, Font = Enum.Font.GothamBold, Parent = left })
	UI.corner(cashBox, 6)
	cashBox.FocusLost:Connect(function()
		local value = math.max(0, math.floor(tonumber(cashBox.Text) or 0))
		if value == s.mine.cash then
			cashBox.Text = tostring(s.mine.cash)
			return
		end
		local list = {}
		for _, q in ipairs(s.mine.pets) do table.insert(list, q.uid) end
		sendOffer(list, value)
	end)

	-- Rechte Seite: Angebot des anderen
	local right = UI.panel(window, { Size = UDim2.new(0.49, 0, 0.36, 0), Position = UDim2.new(0.51, 0, 0.12, 0), Color = C.panel })
	UI.padding(right, 6)
	UI.text(right, s.otherName .. " bietet " .. (s.theirReady and "✅" or "") .. "  <font color='" .. UI.hex(C.green) .. "'>" .. Util.formatPercent(totalBoost(s.theirs.pets)) .. "</font>",
		{ Size = UDim2.new(1, 0, 0.18, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 16 })
	local theirOffer = grid(right, { Size = UDim2.new(1, 0, 0.58, 0), Position = UDim2.new(0, 0, 0.2, 0) })
	for i, p in ipairs(s.theirs.pets) do
		petCell(theirOffer, p, i, nil, false)
	end
	UI.text(right, "💵 " .. Util.format(s.theirs.cash) .. " Geld", { Size = UDim2.new(1, 0, 0.2, 0), Position = UDim2.new(0, 0, 0.8, 0), Color = C.money,
		XAlign = Enum.TextXAlignment.Left, MaxText = 16 })

	-- Deine Pets zum Auswählen
	UI.text(window, "Deine Pets – antippen zum Anbieten (max. " .. Config.TRADE_MAX_PETS .. "):", { Size = UDim2.new(1, 0, 0.045, 0), Position = UDim2.new(0, 0, 0.49, 0),
		XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, Color = C.muted, MaxText = 14 })
	local inv = grid(window, { Size = UDim2.new(1, 0, 0.3, 0), Position = UDim2.new(0, 0, 0.54, 0) })
	local d = State.snap and State.snap.data
	if d then
		local sorted = Util.copy(d.pets)
		table.sort(sorted, function(a, b) return Logic.petBoost(a) > Logic.petBoost(b) end)
		for i, p in ipairs(sorted) do
			if not myPetsSelected[p.uid] then
				petCell(inv, p, i, function()
					if #s.mine.pets >= Config.TRADE_MAX_PETS then return end
					local list = {}
					for _, q in ipairs(s.mine.pets) do table.insert(list, q.uid) end
					table.insert(list, p.uid)
					sendOffer(list, s.mine.cash)
				end, false)
			end
		end
	end

	-- Knöpfe
	local bothReady = s.myReady and s.theirReady
	UI.button(window, s.myReady and "❎ Doch nicht bereit" or "✅ Bereit", s.myReady and C.grey or C.green, function()
		Remotes.TradeReady:FireServer(not s.myReady)
	end, { Size = UDim2.new(0.32, 0, 0.1, 0), Position = UDim2.new(0, 0, 0.88, 0), TextColor = C.dark, MaxText = 18 })
	local confirmText = s.myConfirm and "⏳ Warte auf " .. s.otherName or (bothReady and "🤝 Bestätigen" or "Beide müssen bereit sein")
	UI.button(window, confirmText, (bothReady and not s.myConfirm) and C.gold or C.grey, function()
		if bothReady and not s.myConfirm then Remotes.TradeConfirm:FireServer() end
	end, { Size = UDim2.new(0.34, 0, 0.1, 0), Position = UDim2.new(0.33, 0, 0.88, 0), TextColor = C.dark, MaxText = 16 })
	UI.button(window, "❌ Abbrechen", C.red, function()
		Remotes.TradeCancel:FireServer()
	end, { Size = UDim2.new(0.32, 0, 0.1, 0), Position = UDim2.new(0.68, 0, 0.88, 0), MaxText = 18 })
end

function TradeUI.init(mainGui)
	gui = mainGui
	Remotes:WaitForChild("TradeRequest").OnClientEvent:Connect(function(name, userId)
		Effects.requestPopup("🤝 <b>" .. name .. "</b> möchte mit dir handeln!", C.cyan, function(ok)
			Remotes.TradeRespond:FireServer(ok, userId)
		end)
	end)
	Remotes:WaitForChild("TradeUpdate").OnClientEvent:Connect(function(state)
		current = state
		render()
	end)
	Remotes:WaitForChild("TradeClosed").OnClientEvent:Connect(function(reason)
		current = nil
		if window then
			window:Destroy()
			window = nil
		end
		if reason ~= "done" then
			Effects.toast("🤝 Handel beendet", reason or "", "")
		end
	end)
	-- eigenes Inventar ändert sich → Fenster neu zeichnen
	State.onChange(function(kind)
		if kind == "full" and current then render() end
	end)
end

return TradeUI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000027"><Properties><string name="Name">UI</string><ProtectedString name="Source"><![CDATA[--[[
	UI – kleine Helfer, um Oberflächen per Code zu bauen.
	Farben und Schriften des Spiels sind hier festgelegt.
]]

local UI = {}

UI.C = {
	bg = Color3.fromRGB(26, 11, 46),
	panel = Color3.fromRGB(45, 18, 78),
	panel2 = Color3.fromRGB(64, 28, 108),
	dark = Color3.fromRGB(15, 5, 28),
	pink = Color3.fromRGB(255, 79, 216),
	purple = Color3.fromRGB(155, 92, 255),
	cyan = Color3.fromRGB(62, 242, 255),
	gold = Color3.fromRGB(255, 209, 102),
	orange = Color3.fromRGB(255, 159, 67),
	green = Color3.fromRGB(78, 240, 160),
	money = Color3.fromRGB(124, 252, 154),
	red = Color3.fromRGB(255, 93, 115),
	text = Color3.new(1, 1, 1),
	muted = Color3.fromRGB(199, 181, 220),
	grey = Color3.fromRGB(90, 80, 110),
}

-- Instanz mit Eigenschaften und Kindern erstellen
function UI.new(className, props, children)
	local inst = Instance.new(className)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

function UI.corner(inst, radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12), Parent = inst })
end

function UI.stroke(inst, color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or Color3.new(1, 1, 1), Thickness = thickness or 1.5,
		Transparency = transparency or 0.6, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Parent = inst,
	})
end

function UI.gradient(inst, c1, c2, rotation)
	return UI.new("UIGradient", { Color = ColorSequence.new(c1, c2), Rotation = rotation or 0, Parent = inst })
end

function UI.padding(inst, px)
	return UI.new("UIPadding", {
		PaddingLeft = UDim.new(0, px), PaddingRight = UDim.new(0, px),
		PaddingTop = UDim.new(0, px), PaddingBottom = UDim.new(0, px), Parent = inst,
	})
end

function UI.list(inst, horizontal, padding, hAlign, vAlign)
	return UI.new("UIListLayout", {
		FillDirection = horizontal and Enum.FillDirection.Horizontal or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = hAlign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = vAlign or Enum.VerticalAlignment.Top,
		Parent = inst,
	})
end

-- Textfeld (passt die Schriftgröße automatisch an)
function UI.text(parent, text, props)
	props = props or {}
	local l = UI.new("TextLabel", {
		BackgroundTransparency = 1,
		Size = props.Size or UDim2.new(1, 0, 1, 0),
		Position = props.Position or UDim2.new(0, 0, 0, 0),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		Text = text or "",
		RichText = true,
		TextScaled = true,
		Font = props.Font or Enum.Font.FredokaOne,
		TextColor3 = props.Color or UI.C.text,
		TextXAlignment = props.XAlign or Enum.TextXAlignment.Center,
		TextYAlignment = props.YAlign or Enum.TextYAlignment.Center,
		TextWrapped = true,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Name = props.Name or "Label",
		Parent = parent,
	})
	UI.new("UITextSizeConstraint", { MaxTextSize = math.min(props.MaxText or 26, 100), MinTextSize = props.MinText or 8, Parent = l })
	return l
end

-- Knopf
function UI.button(parent, text, color, onClick, props)
	props = props or {}
	local b = UI.new("TextButton", {
		Size = props.Size or UDim2.new(0, 120, 0, 40),
		Position = props.Position or UDim2.new(0, 0, 0, 0),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		BackgroundColor3 = color or UI.C.purple,
		AutoButtonColor = true,
		Text = text or "",
		RichText = true,
		TextScaled = true,
		Font = props.Font or Enum.Font.FredokaOne,
		TextColor3 = props.TextColor or UI.C.text,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Name = props.Name or "Button",
		Parent = parent,
	})
	UI.corner(b, props.Radius or 10)
	UI.new("UITextSizeConstraint", { MaxTextSize = math.min(props.MaxText or 22, 100), MinTextSize = 8, Parent = b })
	UI.padding(b, props.Pad or 4)
	if onClick then
		b.Activated:Connect(onClick)
	end
	return b
end

-- Panel (Hintergrund-Kasten)
function UI.panel(parent, props)
	props = props or {}
	local f = UI.new("Frame", {
		Size = props.Size or UDim2.new(1, 0, 1, 0),
		Position = props.Position or UDim2.new(0, 0, 0, 0),
		AnchorPoint = props.AnchorPoint or Vector2.new(0, 0),
		BackgroundColor3 = props.Color or UI.C.panel,
		BackgroundTransparency = props.Transparency or 0,
		LayoutOrder = props.LayoutOrder or 0,
		ZIndex = props.ZIndex or 1,
		Name = props.Name or "Panel",
		Parent = parent,
	})
	UI.corner(f, props.Radius or 14)
	return f
end

-- Scrollbare Liste
function UI.scroll(parent, props)
	props = props or {}
	local s = UI.new("ScrollingFrame", {
		Size = props.Size or UDim2.new(1, 0, 1, 0),
		Position = props.Position or UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = UI.C.pink,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = props.Horizontal and Enum.AutomaticSize.X or Enum.AutomaticSize.Y,
		ScrollingDirection = props.Horizontal and Enum.ScrollingDirection.X or Enum.ScrollingDirection.Y,
		Name = props.Name or "Scroll",
		Parent = parent,
	})
	return s
end

-- Farbe als Hex-Text für RichText
function UI.hex(c)
	return string.format("#%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5))
end

function UI.clear(frame)
	for _, child in ipairs(frame:GetChildren()) do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

return UI
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000028"><Properties><string name="Name">WorldFx</string><ProtectedString name="Source"><![CDATA[--[[
	WORLDFX – Licht, Atmosphäre, Wolken, Bloom und Musik passend zur Welt,
	und versteckt den eigenen "Mog Battle"-Knopf am eigenen Körper.
]]

local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))

local WorldFx = {}
local player = Players.LocalPlayer
local lastWorld = nil

-- Nachbearbeitung für eine realistischere Optik (wie in großen Roblox-Spielen)
local fx = {}
local function ensure(className, parent, name)
	local inst = parent:FindFirstChild(name)
	if not inst then
		local ok, created = pcall(function()
			local i = Instance.new(className)
			i.Name = name
			i.Parent = parent
			return i
		end)
		if ok then inst = created end
	end
	return inst
end

local function setupPost()
	fx.atmo = ensure("Atmosphere", Lighting, "LMX_Atmosphere")
	fx.bloom = ensure("BloomEffect", Lighting, "LMX_Bloom")
	fx.cc = ensure("ColorCorrectionEffect", Lighting, "LMX_Color")
	fx.rays = ensure("SunRaysEffect", Lighting, "LMX_SunRays")
	fx.depth = ensure("DepthOfFieldEffect", Lighting, "LMX_Depth")
	fx.clouds = ensure("Clouds", workspace.Terrain, "LMX_Clouds")
	pcall(function()
		Lighting.Brightness = 2.6
		Lighting.EnvironmentDiffuseScale = 1
		Lighting.EnvironmentSpecularScale = 1
		Lighting.ShadowSoftness = 0.25
		fx.bloom.Intensity = 0.7
		fx.bloom.Size = 28
		fx.bloom.Threshold = 1.4
		fx.rays.Intensity = 0.07
		fx.rays.Spread = 0.6
		fx.depth.FarIntensity = 0.12
		fx.depth.FocusDistance = 60
		fx.depth.InFocusRadius = 80
		fx.depth.NearIntensity = 0
	end)
end

local function apply(index)
	if index == lastWorld then return end
	lastWorld = index
	local w = Config.Worlds[index]
	if not w then return end
	local L = w.light
	local night = L.ClockTime < 6 or L.ClockTime > 19
	TweenService:Create(Lighting, TweenInfo.new(1.5), {
		ClockTime = L.ClockTime, Ambient = L.Ambient, OutdoorAmbient = L.Ambient:Lerp(Color3.new(1, 1, 1), 0.15),
		FogColor = L.Fog, FogEnd = L.FogEnd,
	}):Play()
	pcall(function()
		local info = TweenInfo.new(1.5)
		if fx.atmo then
			TweenService:Create(fx.atmo, info, {
				Density = night and 0.42 or 0.3, Offset = 0.15, Haze = night and 2.2 or 1.4, Glare = night and 0 or 0.6,
				Color = L.Fog, Decay = L.Fog:Lerp(Color3.new(0, 0, 0), 0.45),
			}):Play()
		end
		if fx.cc then
			TweenService:Create(fx.cc, info, {
				Saturation = 0.15, Contrast = 0.1, Brightness = night and 0.02 or 0,
				TintColor = Color3.new(1, 1, 1):Lerp(L.Fog, 0.12),
			}):Play()
		end
		if fx.bloom then fx.bloom.Threshold = night and 1.1 or 1.4 end
		if fx.clouds then
			fx.clouds.Enabled = index ~= #Config.Worlds   -- im Weltall keine Wolken
			fx.clouds.Cover = night and 0.45 or 0.62
			fx.clouds.Density = 0.55
			fx.clouds.Color = night and L.Fog or Color3.new(1, 1, 1)
		end
	end)
	Sounds.setWorld(index)
end

local function hideOwnPrompt(char)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not hrp then return end
	-- eigene Knöpfe (Mog Battle, Handeln) am eigenen Körper ausblenden
	for _, name in ipairs({ "MogPrompt", "TradePrompt" }) do
		local pr = hrp:WaitForChild(name, 15)
		if pr then pr.Enabled = false end
	end
end

-- Sprungfelder & Trampoline (Parkour): schleudern den eigenen Avatar nach oben
local CollectionService = game:GetService("CollectionService")
local lastPad = 0
local function hookPad(pad)
	if not pad:IsA("BasePart") then return end
	pad.Touched:Connect(function(hit)
		local char = player.Character
		if not char or not hit:IsDescendantOf(char) then return end
		if os.clock() - lastPad < 0.5 then return end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		local hum = char:FindFirstChildOfClass("Humanoid")
		if not hrp or not hum or hum.Health <= 0 then return end
		lastPad = os.clock()
		local power = pad:GetAttribute("Power") or 90
		local dir = pad:GetAttribute("Dir")
		local v = hrp.AssemblyLinearVelocity
		if typeof(dir) == "Vector3" then
			hrp.AssemblyLinearVelocity = Vector3.new(dir.X, power, dir.Z)
			-- Seitwärts-Schwung bis zur Landung halten (sonst bremst die Luftsteuerung ihn ab)
			local started = os.clock()
			local conn
			conn = game:GetService("RunService").Heartbeat:Connect(function()
				local t = os.clock() - started
				if t > 1.6 or not hrp.Parent or (t > 0.25 and hum.FloorMaterial ~= Enum.Material.Air) then
					conn:Disconnect()
					return
				end
				local cur = hrp.AssemblyLinearVelocity
				hrp.AssemblyLinearVelocity = Vector3.new(dir.X, cur.Y, dir.Z)
			end)
		else
			hrp.AssemblyLinearVelocity = Vector3.new(v.X, power, v.Z)
		end
		hum:ChangeState(Enum.HumanoidStateType.Freefall)
		Sounds.play("Click")
	end)
end

function WorldFx.init()
	setupPost()
	for _, pad in ipairs(CollectionService:GetTagged("JumpPad")) do hookPad(pad) end
	CollectionService:GetInstanceAddedSignal("JumpPad"):Connect(hookPad)
	apply(player:GetAttribute("World") or 1)
	player:GetAttributeChangedSignal("World"):Connect(function()
		apply(player:GetAttribute("World") or 1)
	end)
	player.CharacterAdded:Connect(hideOwnPrompt)
	if player.Character then
		task.spawn(hideOwnPrompt, player.Character)
	end
end

return WorldFx
]]></ProtectedString></Properties></Item>
