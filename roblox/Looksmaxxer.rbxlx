-- 🏔️ IRON MOUNTAIN: Gipfel-Kletterei, gefrorener See (rutschig!), Skilift, Iglu
----------------------------------------------------------------------------
local function mountainExtras(O, w, rng, index)
	local C = Vector3.new(140, 0, 140)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(80, 34, 34), CFrame = CFrame.new(O + C + Vector3.new(0, 40, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(120, 118, 125), Material = Enum.Material.Slate })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 35, 35), CFrame = CFrame.new(O + C + Vector3.new(0, 79, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(245, 248, 255), Material = Enum.Material.Snow })
	course(O, {
		id = "mountain", title = "Gipfel-Kletterei", emoji = "🧗", hint = "Kletter die Felsvorsprünge hoch bis zur Gipfelfahne!",
		start = Vector3.new(140, 0, 108),
		points = spiralPoints(C, 20, 25, 0.42, 0, 3.15),
		cpEvery = 6,
		size = Vector3.new(6, 1, 6), material = Enum.Material.Slate,
		color = function(i) return (i % 2 == 0) and Color3.fromRGB(150, 145, 150) or Color3.fromRGB(235, 240, 250) end,
		finish = C + Vector3.new(math.cos(25 * 0.42) * 8, 81.5, math.sin(25 * 0.42) * 8),
		finishBuild = function(fp)
			part({ Size = Vector3.new(0.6, 14, 0.6), CFrame = CFrame.new(fp + Vector3.new(4, 7, 4)), Color = Color3.fromRGB(80, 80, 85), Material = Enum.Material.Metal })
			part({ Size = Vector3.new(0.2, 4, 6), CFrame = CFrame.new(fp + Vector3.new(4, 12, 7)), Color = Color3.fromRGB(255, 79, 216) })
		end,
		reward = courseReward(index),
	})
	-- Gefrorener See: Eis ist rutschig!
	local A = O + Vector3.new(-90, 0, 190)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 72, 72), CFrame = CFrame.new(A + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(170, 215, 245), Material = Enum.Material.Ice, Transparency = 0.1 })
	local sign = part({ Size = Vector3.new(14, 4, 0.6), CFrame = CFrame.new(A + Vector3.new(0, 7, -40)), Color = Color3.fromRGB(20, 5, 35) })
	surfaceSign(sign, Enum.NormalId.Front, "⛸️ EISBAHN – rutschig!", Color3.fromRGB(20, 5, 35), WHITE)
	surfaceSign(sign, Enum.NormalId.Back, "⛸️ EISBAHN – rutschig!", Color3.fromRGB(20, 5, 35), WHITE)
	for _, s in ipairs({ -6, 6 }) do part({ Size = Vector3.new(0.5, 7, 0.5), CFrame = CFrame.new(A + Vector3.new(s, 3.5, -40)), Color = Color3.fromRGB(110, 75, 45) }) end
	-- Skilift
	for k = 0, 4 do
		local P = O + Vector3.new(110 + k * 28, 0, -205)
		part({ Size = Vector3.new(1.2, 26 + k * 4, 1.2), CFrame = CFrame.new(P + Vector3.new(0, (26 + k * 4) / 2, 0)), Color = Color3.fromRGB(70, 70, 80), Material = Enum.Material.Metal })
		part({ Size = Vector3.new(1, 1, 8), CFrame = CFrame.new(P + Vector3.new(0, 26 + k * 4, 0)), Color = Color3.fromRGB(70, 70, 80), Material = Enum.Material.Metal })
		if k < 4 then
			local a, b = P + Vector3.new(0, 26 + k * 4, 0), P + Vector3.new(28, 30 + k * 4, 0)
			local mid = (a + b) / 2
			part({ Size = Vector3.new(0.3, 0.3, (b - a).Magnitude), CFrame = CFrame.lookAt(mid, b), Color = Color3.fromRGB(30, 30, 30), CanCollide = false })
			part({ Size = Vector3.new(4, 0.6, 2), CFrame = CFrame.new(mid + Vector3.new(0, -4, 0)), Color = Color3.fromRGB(230, 60, 60), CanCollide = false })
			part({ Size = Vector3.new(0.2, 4, 0.2), CFrame = CFrame.new(mid + Vector3.new(0, -2, 0)), Color = Color3.fromRGB(30, 30, 30), CanCollide = false })
		end
	end
	-- Iglu
	local I = O + Vector3.new(-140, 0, -195)
	ellipsoid({ Size = Vector3.new(18, 14, 18), CFrame = CFrame.new(I), Color = Color3.fromRGB(240, 248, 255), Material = Enum.Material.Snow })
	ellipsoid({ Size = Vector3.new(6, 7, 8), CFrame = CFrame.new(I + Vector3.new(0, 0, -8)), Color = Color3.fromRGB(235, 243, 252), Material = Enum.Material.Snow })
	part({ Size = Vector3.new(3.4, 4.5, 0.4), CFrame = CFrame.new(I + Vector3.new(0, 1.6, -11.9)), Color = Color3.fromRGB(30, 40, 60) })
	-- Eisskulpturen
	for k = 0, 3 do
		local h = 6 + k * 3
		part({ Class = "WedgePart", Size = Vector3.new(3, h, 3), CFrame = CFrame.new(O + Vector3.new(200 + (k % 2) * 8, h / 2, -90 + k * 7)) * CFrame.Angles(0, math.rad(k * 50), 0),
			Color = Color3.fromRGB(160, 220, 255), Material = Enum.Material.Ice, Transparency = 0.25 })
	end
	-- dichter Nadelwald am Rand
	for _ = 1, 40 do
		local x, z = freeSpot(rng, 5, 150)
		if x then
			part({ Size = Vector3.new(1.6, 6, 1.6), CFrame = CFrame.new(O + Vector3.new(x, 3, z)), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood })
			for t = 0, 2 do
				local s = 9 - t * 2.5
				part({ Class = "WedgePart", Size = Vector3.new(s, 4.5, s / 2), CFrame = CFrame.new(O + Vector3.new(x, 7 + t * 3.2, z - s / 4)), Color = Color3.fromRGB(30, 95, 55), Material = Enum.Material.Grass })
				part({ Class = "WedgePart", Size = Vector3.new(s, 4.5, s / 2), CFrame = CFrame.new(O + Vector3.new(x, 7 + t * 3.2, z + s / 4)) * CFrame.Angles(0, math.rad(180), 0), Color = Color3.fromRGB(30, 95, 55), Material = Enum.Material.Grass })
				part({ Size = Vector3.new(s * 0.7, 0.4, s * 0.7), CFrame = CFrame.new(O + Vector3.new(x, 9.3 + t * 3.2, z)), Color = WHITE, Material = Enum.Material.Snow })
			end
		end
	end
	trampoline(O, -120, 40, 110)
end

----------------------------------------------------------------------------
-- 🗿 MEWING-TEMPEL: Lava-Tempel-Parkour, Pagode, Koi-Teich mit Brücke, Zen-Garten
----------------------------------------------------------------------------
local function templeExtras(O, w, rng, index)
	local lava = part({ Name = "Lava", Size = Vector3.new(92, 1, 92), CFrame = CFrame.new(O + Vector3.new(150, 0.4, 150)), Color = Color3.fromRGB(255, 90, 20), Material = Enum.Material.Neon })
	local glow = Instance.new("PointLight")
	glow.Color = Color3.fromRGB(255, 120, 40)
	glow.Range = 40
	glow.Brightness = 2
	glow.Parent = lava
	local smoke = Instance.new("ParticleEmitter")
	smoke.Color = ColorSequence.new(Color3.fromRGB(255, 160, 60))
	smoke.Rate = 18
	smoke.Lifetime = NumberRange.new(1.5, 2.5)
	smoke.Speed = NumberRange.new(2, 5)
	smoke.Size = NumberSequence.new(0.6)
	smoke.LightEmission = 1
	smoke.EmissionDirection = Enum.NormalId.Top
	smoke.Parent = lava
	for _, r in ipairs({ { 0, -47, 96, 2 }, { 0, 47, 96, 2 }, { -47, 0, 2, 96 }, { 47, 0, 2, 96 } }) do
		part({ Size = Vector3.new(r[3], 2, r[4]), CFrame = CFrame.new(O + Vector3.new(150 + r[1], 1, 150 + r[2])), Color = Color3.fromRGB(90, 85, 80), Material = Enum.Material.Slate })
	end
	-- Stufenpyramide mit Gong als Ziel
	local fin = Vector3.new(200, 20, 200)
	for k = 0, 3 do
		local s = 24 - k * 4.5
		part({ Size = Vector3.new(s, 5, s), CFrame = CFrame.new(O + Vector3.new(200, 2.5 + k * 5, 200)), Color = Color3.fromRGB(190 - k * 10, 170 - k * 10, 130 - k * 8), Material = Enum.Material.Sandstone })
	end
	course(O, {
		id = "temple", title = "Lava-Tempel", emoji = "🔥", hint = "Spring über die Steinsäulen – die Lava schickt dich zurück!",
		start = Vector3.new(98, 0, 98),
		points = linePoints(Vector3.new(108, 0, 108), Vector3.new(190, 0, 190), 24, 6, 0.9, 2.2, 0.68),
		cpEvery = 6,
		build = function(P, i, size, under)
			local top = P.Y
			local col = Color3.fromRGB(150 - (i % 3) * 12, 140 - (i % 3) * 12, 125)
			local p = part({ Size = Vector3.new(size.X, top, size.Z), CFrame = CFrame.new(Vector3.new(P.X, top / 2, P.Z)), Color = col, Material = Enum.Material.Slate })
			if not under then
				part({ Size = Vector3.new(size.X + 0.6, 0.6, size.Z + 0.6), CFrame = CFrame.new(P - Vector3.new(0, 0.3, 0)), Color = Color3.fromRGB(200, 180, 120), Material = Enum.Material.Sandstone })
			end
			return p
		end,
		finish = fin,
		finishBuild = function(fp)
			part({ Size = Vector3.new(0.8, 9, 0.8), CFrame = CFrame.new(fp + Vector3.new(-3.5, 4.5, 4)), Color = Color3.fromRGB(150, 40, 30), Material = Enum.Material.Wood })
			part({ Size = Vector3.new(0.8, 9, 0.8), CFrame = CFrame.new(fp + Vector3.new(3.5, 4.5, 4)), Color = Color3.fromRGB(150, 40, 30), Material = Enum.Material.Wood })
			part({ Size = Vector3.new(8, 0.8, 0.8), CFrame = CFrame.new(fp + Vector3.new(0, 9, 4)), Color = Color3.fromRGB(150, 40, 30), Material = Enum.Material.Wood })
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 5.5, 5.5), CFrame = CFrame.new(fp + Vector3.new(0, 5.5, 4)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Foil })
		end,
		reward = courseReward(index), killParts = { lava },
	})
	-- Pagode
	local A = O + Vector3.new(-90, 0, 190)
	for k = 0, 4 do
		local s = 16 - k * 2.4
		part({ Size = Vector3.new(s, 6, s), CFrame = CFrame.new(A + Vector3.new(0, 3 + k * 7, 0)), Color = Color3.fromRGB(200, 50, 40), Material = Enum.Material.WoodPlanks })
		part({ Size = Vector3.new(s + 6, 1, s + 6), CFrame = CFrame.new(A + Vector3.new(0, 6.5 + k * 7, 0)), Color = Color3.fromRGB(40, 35, 35), Material = Enum.Material.Slate })
	end
	part({ Size = Vector3.new(0.8, 8, 0.8), CFrame = CFrame.new(A + Vector3.new(0, 42, 0)), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Foil })
	-- Koi-Teich mit roter Bogenbrücke
	local B = O + Vector3.new(150, 0, -150)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 34, 34), CFrame = CFrame.new(B + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(60, 140, 180), Material = Enum.Material.Glass, Transparency = 0.2 })
	for k = -6, 6 do
		local y = 4 - (k * k) / 9
		part({ Size = Vector3.new(6, 0.6, 3), CFrame = CFrame.new(B + Vector3.new(0, y, k * 2.6)) * CFrame.Angles(math.rad(-k * 6), 0, 0), Color = Color3.fromRGB(210, 40, 30), Material = Enum.Material.WoodPlanks })
	end
	for _ = 1, 8 do
		ellipsoid({ Size = Vector3.new(0.9, 0.6, 2), CFrame = CFrame.new(B + Vector3.new(rng:NextNumber(-12, 12), 0.7, rng:NextNumber(-12, 12))) * CFrame.Angles(0, rng:NextNumber(0, 6), 0),
			Color = rng:NextNumber() < 0.5 and Color3.fromRGB(255, 140, 50) or WHITE, CanCollide = false })
	end
	-- Zen-Garten mit geharktem Sand und Steinen
	local Z = O + Vector3.new(-140, 0, -195)
	part({ Size = Vector3.new(30, 0.4, 22), CFrame = CFrame.new(Z + Vector3.new(0, 0.2, 0)), Color = Color3.fromRGB(235, 225, 200), Material = Enum.Material.Sand })
	for k = -4, 4 do part({ Size = Vector3.new(29, 0.1, 0.3), CFrame = CFrame.new(Z + Vector3.new(0, 0.45, k * 2.3)), Color = Color3.fromRGB(210, 200, 175) }) end
	for _, r in ipairs({ { -8, -3, 4 }, { 5, 4, 3 }, { 9, -5, 2.5 } }) do rock(O, Z.X - O.X + r[1], Z.Z - O.Z + r[2], r[3], Color3.fromRGB(90, 90, 95)) end
	-- Riesen-Moai mit Sonnenbrille
	local M = O + Vector3.new(205, 0, -85)
	local cf = CFrame.new(M) * CFrame.Angles(0, math.rad(-90), 0)
	part({ Size = Vector3.new(14, 26, 11), CFrame = cf * CFrame.new(0, 13, 0), Color = Color3.fromRGB(115, 110, 104), Material = Enum.Material.Slate })
	part({ Size = Vector3.new(14.4, 3.5, 12), CFrame = cf * CFrame.new(0, 24.5, -0.5), Color = Color3.fromRGB(100, 95, 90), Material = Enum.Material.Slate })
	part({ Size = Vector3.new(12, 2.4, 0.6), CFrame = cf * CFrame.new(0, 18, -5.8), Color = Color3.fromRGB(15, 15, 20), Reflectance = 0.4 })
	part({ Class = "WedgePart", Size = Vector3.new(3, 6, 3), CFrame = cf * CFrame.new(0, 13, -7) * CFrame.Angles(0, math.rad(180), 0), Color = Color3.fromRGB(110, 105, 100), Material = Enum.Material.Slate })
	-- Gong-Turm
	local G = O + Vector3.new(-120, 0, 40)
	for _, s in ipairs({ -4, 4 }) do part({ Size = Vector3.new(1, 12, 1), CFrame = CFrame.new(G + Vector3.new(s, 6, 0)), Color = Color3.fromRGB(150, 40, 30), Material = Enum.Material.Wood }) end
	part({ Size = Vector3.new(11, 1, 1.6), CFrame = CFrame.new(G + Vector3.new(0, 12, 0)), Color = Color3.fromRGB(40, 35, 35) })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 6, 6), CFrame = CFrame.new(G + Vector3.new(0, 7.5, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Foil })
end

----------------------------------------------------------------------------
-- 👔 MAILAND: Dachterrassen-Parkour, Modenschau-Bühne, Riesen-Parfüm, Riesen-High-Heel, Glas-Café
----------------------------------------------------------------------------
local BAG_COLORS = { Color3.fromRGB(255, 120, 200), Color3.fromRGB(250, 250, 250), Color3.fromRGB(30, 30, 35), Color3.fromRGB(212, 175, 55), Color3.fromRGB(150, 110, 255) }

local function fashionExtras(O, w, rng, index)
	course(O, {
		id = "fashion", title = "Shopping-Parkour", emoji = "🛍️", hint = "Spring über die Riesen-Einkaufstüten bis zur VIP-Lounge!",
		start = Vector3.new(95, 0, 95),
		points = linePoints(Vector3.new(102, 0, 102), Vector3.new(170, 0, 170), 22, 4.5, 1.2, 1.8, 1.65, { [11] = 14 }),
		jumps = { [11] = 14 },
		cpEvery = 7,
		build = function(P, i, size, under)
			if under then return end
			local col = BAG_COLORS[(i % #BAG_COLORS) + 1]
			local p = part({ Size = Vector3.new(5, 6, 4), CFrame = CFrame.new(P - Vector3.new(0, 3, 0)), Color = col, Material = Enum.Material.SmoothPlastic })
			part({ Size = Vector3.new(0.3, 1.6, 2.4), CFrame = CFrame.new(P + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, math.rad(90), 0), Color = col:Lerp(Color3.new(0, 0, 0), 0.4), CanCollide = false })
			return p
		end,
		finish = Vector3.new(178, 54, 178),
		finishBuild = function(fp)
			for _, s in ipairs({ -4, 4 }) do
				part({ Size = Vector3.new(6, 1.5, 2.5), CFrame = CFrame.new(fp + Vector3.new(s, 0.75, 5)), Color = Color3.fromRGB(255, 120, 200), Material = Enum.Material.Fabric })
			end
			part({ Size = Vector3.new(14, 0.4, 14), CFrame = CFrame.new(fp - Vector3.new(0, 1.2, 0)), Color = w.accent, Material = Enum.Material.Neon })
		end,
		reward = courseReward(index),
	})
	-- Modenschau-Bühne mit LED-Wand und Scheinwerfern
	local A = O + Vector3.new(-90, 0, 190)
	part({ Size = Vector3.new(36, 3, 16), CFrame = CFrame.new(A + Vector3.new(0, 1.5, 0)), Color = Color3.fromRGB(25, 25, 30), Material = Enum.Material.SmoothPlastic })
	local screen = part({ Size = Vector3.new(32, 16, 1), CFrame = CFrame.new(A + Vector3.new(0, 11, 7.5)), Color = Color3.fromRGB(20, 5, 35) })
	surfaceSign(screen, Enum.NormalId.Front, "✨ GLOW FASHION WEEK ✨", Color3.fromRGB(255, 79, 216), WHITE)
	for k = -2, 2 do
		local spot = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(A + Vector3.new(k * 7, 20, 2)), Color = WHITE, Material = Enum.Material.Neon })
		local l = Instance.new("SpotLight")
		l.Face = Enum.NormalId.Bottom
		l.Range = 30
		l.Brightness = 4
		l.Color = BAG_COLORS[(k % #BAG_COLORS) + 1]
		l.Parent = spot
	end
	part({ Size = Vector3.new(36, 1, 1), CFrame = CFrame.new(A + Vector3.new(0, 21, 2)), Color = Color3.fromRGB(40, 40, 45), Material = Enum.Material.Metal })
	-- Riesen-Parfümflasche
	local B = O + Vector3.new(150, 0, -150)
	part({ Size = Vector3.new(12, 16, 7), CFrame = CFrame.new(B + Vector3.new(0, 8, 0)), Color = Color3.fromRGB(255, 170, 220), Material = Enum.Material.Glass, Transparency = 0.25 })
	part({ Size = Vector3.new(4, 3, 4), CFrame = CFrame.new(B + Vector3.new(0, 17.5, 0)), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Foil })
	part({ Shape = Enum.PartType.Ball, Size = Vector3.new(5, 5, 5), CFrame = CFrame.new(B + Vector3.new(0, 21, 0)), Color = Color3.fromRGB(255, 120, 200), Material = Enum.Material.Glass })
	local lbl = part({ Size = Vector3.new(8, 4, 0.2), CFrame = CFrame.new(B + Vector3.new(0, 8, -3.6)), Color = WHITE })
	surfaceSign(lbl, Enum.NormalId.Front, "N°1 GLOW", WHITE, Color3.fromRGB(30, 30, 30))
	-- Riesen-High-Heel
	local C = O + Vector3.new(-140, 0, -195)
	local red = Color3.fromRGB(220, 20, 50)
	part({ Size = Vector3.new(5, 1.6, 16), CFrame = CFrame.new(C + Vector3.new(0, 0.8, 0)), Color = red, Material = Enum.Material.SmoothPlastic, Reflectance = 0.2 })
	part({ Size = Vector3.new(5, 1.4, 10), CFrame = CFrame.new(C + Vector3.new(0, 6, 3)) * CFrame.Angles(math.rad(-35), 0, 0), Color = red, Reflectance = 0.2 })
	part({ Size = Vector3.new(1.4, 11, 1.4), CFrame = CFrame.new(C + Vector3.new(0, 5.5, 7.4)), Color = Color3.fromRGB(30, 30, 30) })
	part({ Size = Vector3.new(5.4, 3, 3), CFrame = CFrame.new(C + Vector3.new(0, 2, -6)), Color = red, Reflectance = 0.2 })
	-- Glas-Café
	local D = O + Vector3.new(205, 0, -85)
	part({ Size = Vector3.new(22, 0.6, 18), CFrame = CFrame.new(D + Vector3.new(0, 0.3, 0)), Color = Color3.fromRGB(240, 240, 240), Material = Enum.Material.Marble })
	part({ Size = Vector3.new(22, 10, 0.4), CFrame = CFrame.new(D + Vector3.new(0, 5.5, 9)), Color = Color3.fromRGB(180, 220, 240), Material = Enum.Material.Glass, Transparency = 0.5 })
	part({ Size = Vector3.new(0.4, 10, 18), CFrame = CFrame.new(D + Vector3.new(11, 5.5, 0)), Color = Color3.fromRGB(180, 220, 240), Material = Enum.Material.Glass, Transparency = 0.5 })
	part({ Size = Vector3.new(23, 0.6, 19), CFrame = CFrame.new(D + Vector3.new(0, 10.8, 0)), Color = Color3.fromRGB(30, 30, 35) })
	for _, p in ipairs({ { -5, -3 }, { 3, -3 }, { -5, 4 }, { 3, 4 } }) do
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 3, 3), CFrame = CFrame.new(D + Vector3.new(p[1], 3, p[2])) * CFrame.Angles(0, 0, math.rad(90)), Color = WHITE })
		part({ Size = Vector3.new(0.3, 3, 0.3), CFrame = CFrame.new(D + Vector3.new(p[1], 1.5, p[2])), Color = Color3.fromRGB(30, 30, 30) })
	end
	surfaceSign(part({ Size = Vector3.new(12, 2.5, 0.3), CFrame = CFrame.new(D + Vector3.new(0, 12.5, -9)), Color = Color3.fromRGB(20, 5, 35) }), Enum.NormalId.Front, "☕ CAFÉ MILANO", Color3.fromRGB(20, 5, 35), WHITE)
	-- Blumenbögen-Allee
	for k = 0, 3 do
		local P = O + Vector3.new(-120, 0, 20 + k * 12)
		for t = 0, 8 do
			local a = math.rad(t * 22.5)
			part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(P + Vector3.new(math.cos(a) * 6, math.sin(a) * 8 + 0.5, 0)),
				Color = FLOWER_COLORS[((t + k) % #FLOWER_COLORS) + 1], Material = Enum.Material.Fabric })
		end
	end
	trampoline(O, 30, 120, 110, w.accent)
end

----------------------------------------------------------------------------
-- 🎬 HOLLYWOOD: Stunt-Parkour, Western-Filmset, Riesen-Filmklappe, Kamerakran, Foodtrucks, Suchscheinwerfer
----------------------------------------------------------------------------
local function hollywoodExtras(O, w, rng, index)
	course(O, {
		id = "hollywood", title = "Stunt-Parkour", emoji = "🎬", hint = "Kisten, Gerüste, Sprungfelder – ein echter Filmstunt bis zum Hubschrauber!",
		start = Vector3.new(95, 0, 95),
		points = linePoints(Vector3.new(102, 0, 102), Vector3.new(178, 0, 178), 24, 5, 1.0, 1.6, 1.1, { [8] = 12, [16] = 12 }),
		jumps = { [8] = 12, [16] = 12 },
		cpEvery = 6,
		build = function(P, i, size, under)
			local top = P.Y
			if top < 14 then
				local p = part({ Size = Vector3.new(size.X + 1, top, size.Z + 1), CFrame = CFrame.new(Vector3.new(P.X, top / 2, P.Z)), Color = Color3.fromRGB(160, 115, 70), Material = Enum.Material.WoodPlanks })
				return under and nil or p
			end
			for _, o in ipairs({ { -2.5, -2.5 }, { 2.5, -2.5 }, { -2.5, 2.5 }, { 2.5, 2.5 } }) do
				part({ Size = Vector3.new(0.4, top, 0.4), CFrame = CFrame.new(Vector3.new(P.X + o[1], top / 2, P.Z + o[2])), Color = Color3.fromRGB(170, 170, 180), Material = Enum.Material.Metal })
			end
			if under then return nil end
			return part({ Size = Vector3.new(6, 1, 6), CFrame = CFrame.new(P - Vector3.new(0, 0.5, 0)), Color = Color3.fromRGB(200, 160, 90), Material = Enum.Material.WoodPlanks })
		end,
		finish = Vector3.new(186, 53, 186),
		finishBuild = function(fp)
			part({ Size = Vector3.new(16, 0.4, 16), CFrame = CFrame.new(fp - Vector3.new(0, 1.2, 0)), Color = Color3.fromRGB(50, 50, 55) })
			for _, o in ipairs({ { -6, -6 }, { 6, -6 }, { -6, 6 }, { 6, 6 } }) do
				part({ Size = Vector3.new(0.8, fp.Y - 1.4, 0.8), CFrame = CFrame.new(Vector3.new(fp.X + o[1], (fp.Y - 1.4) / 2, fp.Z + o[2])), Color = Color3.fromRGB(170, 170, 180), Material = Enum.Material.Metal })
			end
			-- Hubschrauber
			local H = fp + Vector3.new(0, 0, -3)
			ellipsoid({ Size = Vector3.new(5, 4, 8), CFrame = CFrame.new(H + Vector3.new(-3, 2.4, 0)), Color = Color3.fromRGB(30, 30, 35), CanCollide = false })
			part({ Size = Vector3.new(1, 1, 7), CFrame = CFrame.new(H + Vector3.new(-3, 2.8, 7)), Color = Color3.fromRGB(30, 30, 35), CanCollide = false })
			part({ Size = Vector3.new(14, 0.2, 0.8), CFrame = CFrame.new(H + Vector3.new(-3, 4.8, 0)) * CFrame.Angles(0, math.rad(30), 0), Color = Color3.fromRGB(60, 60, 65), CanCollide = false })
		end,
		reward = courseReward(index),
	})
	-- Western-Filmset
	local A = O + Vector3.new(-90, 0, 190)
	local names = { "SALOON", "SHERIFF", "BANK" }
	for k = -1, 1 do
		local P = A + Vector3.new(k * 16, 0, 0)
		part({ Size = Vector3.new(15, 14, 1), CFrame = CFrame.new(P + Vector3.new(0, 7, 0)), Color = Color3.fromRGB(150 + k * 15, 100, 60), Material = Enum.Material.WoodPlanks })
		part({ Size = Vector3.new(15, 0.6, 5), CFrame = CFrame.new(P + Vector3.new(0, 8, -2.5)), Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.WoodPlanks })
		for _, s in ipairs({ -7, 7 }) do part({ Size = Vector3.new(0.5, 8, 0.5), CFrame = CFrame.new(P + Vector3.new(s, 4, -4.8)), Color = Color3.fromRGB(110, 75, 45) }) end
		part({ Size = Vector3.new(4, 6, 0.3), CFrame = CFrame.new(P + Vector3.new(0, 3, -0.6)), Color = Color3.fromRGB(70, 45, 30) })
		surfaceSign(part({ Size = Vector3.new(10, 2.5, 0.3), CFrame = CFrame.new(P + Vector3.new(0, 11.5, -0.7)), Color = Color3.fromRGB(240, 220, 180) }), Enum.NormalId.Front, names[k + 2], Color3.fromRGB(240, 220, 180), Color3.fromRGB(60, 30, 20))
		-- Stützen hinten (es ist nur Kulisse!)
		part({ Size = Vector3.new(0.4, 14, 0.4), CFrame = CFrame.new(P + Vector3.new(0, 6, 4)) * CFrame.Angles(math.rad(-30), 0, 0), Color = Color3.fromRGB(110, 75, 45) })
	end
	-- Riesen-Filmklappe
	local B = O + Vector3.new(150, 0, -150)
	part({ Size = Vector3.new(16, 12, 1.5), CFrame = CFrame.new(B + Vector3.new(0, 6, 0)), Color = Color3.fromRGB(25, 25, 25) })
	surfaceSign(part({ Size = Vector3.new(14, 8, 0.2), CFrame = CFrame.new(B + Vector3.new(0, 5.5, -0.85)), Color = Color3.fromRGB(25, 25, 25) }), Enum.NormalId.Front, "GLOW-UP\nSZENE 1 · TAKE 3000", Color3.fromRGB(25, 25, 25), WHITE)
	for k = 0, 7 do
		part({ Size = Vector3.new(2, 2.2, 1.5), CFrame = CFrame.new(B + Vector3.new(-7 + k * 2, 13.8, 0)) * CFrame.Angles(0, 0, math.rad(8)), Color = (k % 2 == 0) and WHITE or Color3.fromRGB(25, 25, 25) })
	end
	-- Kamerakran
	local C = O + Vector3.new(-140, 0, -195)
	part({ Size = Vector3.new(6, 1.5, 6), CFrame = CFrame.new(C + Vector3.new(0, 0.75, 0)), Color = Color3.fromRGB(40, 40, 45), Material = Enum.Material.Metal })
	part({ Size = Vector3.new(1.4, 10, 1.4), CFrame = CFrame.new(C + Vector3.new(0, 6, 0)), Color = Color3.fromRGB(60, 60, 65), Material = Enum.Material.Metal })
	part({ Size = Vector3.new(1, 1, 22), CFrame = CFrame.new(C + Vector3.new(0, 13, -6)) * CFrame.Angles(math.rad(-15), 0, 0), Color = Color3.fromRGB(60, 60, 65), Material = Enum.Material.Metal })
	part({ Size = Vector3.new(3, 2.4, 4), CFrame = CFrame.new(C + Vector3.new(0, 16.5, -16.5)), Color = Color3.fromRGB(25, 25, 25) })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.6, 1.8, 1.8), CFrame = CFrame.new(C + Vector3.new(0, 16.5, -19)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(80, 80, 90) })
	-- Foodtrucks
	local truckColors = { Color3.fromRGB(255, 200, 40), Color3.fromRGB(80, 190, 255) }
	local truckNames = { "🌮 TACOS", "🥤 PROTEIN-SHAKES" }
	for k = 1, 2 do
		local P = O + Vector3.new(205, 0, -100 + k * 18)
		part({ Size = Vector3.new(8, 7, 14), CFrame = CFrame.new(P + Vector3.new(0, 4.5, 0)), Color = truckColors[k] })
		for _, o in ipairs({ { -4, -4 }, { 4, -4 }, { -4, 4 }, { 4, 4 } }) do
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 2.2, 2.2), CFrame = CFrame.new(P + Vector3.new(o[1], 1.1, o[2])), Color = Color3.fromRGB(25, 25, 25) })
		end
		surfaceSign(part({ Size = Vector3.new(0.3, 2.5, 10), CFrame = CFrame.new(P + Vector3.new(-4.2, 7, 0)), Color = Color3.fromRGB(20, 5, 35) }), Enum.NormalId.Left, truckNames[k], Color3.fromRGB(20, 5, 35), WHITE)
	end
	-- Premieren-Suchscheinwerfer
	for k = 0, 2 do
		local P = O + Vector3.new(-130 + k * 12, 0, 40)
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 4, 4), CFrame = CFrame.new(P + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(70 + k * 20)), Color = Color3.fromRGB(60, 60, 65), Material = Enum.Material.Metal })
		part({ Size = Vector3.new(2.5, 120, 2.5), CFrame = CFrame.new(P + Vector3.new(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(-20 + k * 20)) * CFrame.new(0, 60, 0),
			Color = Color3.fromRGB(255, 250, 220), Material = Enum.Material.Neon, Transparency = 0.82, CanCollide = false, CastShadow = false, CanQuery = false })
	end
	-- Riesen-Popcorn
	local Pp = O + Vector3.new(-160, 0, 0)
	for k = 0, 7 do
		part({ Size = Vector3.new(1.6, 10, 1.6), CFrame = CFrame.new(Pp + Vector3.new(math.cos(k * 0.785) * 4, 5, math.sin(k * 0.785) * 4)), Color = (k % 2 == 0) and Color3.fromRGB(220, 30, 40) or WHITE })
	end
	for _ = 1, 14 do
		part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), CFrame = CFrame.new(Pp + Vector3.new(rng:NextNumber(-3.5, 3.5), rng:NextNumber(10, 12.5), rng:NextNumber(-3.5, 3.5))), Color = Color3.fromRGB(255, 245, 200) })
	end
end

----------------------------------------------------------------------------
-- 🌇 DUBAI: Wolkenkratzer-Lauf mit Sprungfeld-Aufzug, Riesenrad, Infinity-Pool, Hubschrauber, Supercar-Showroom
----------------------------------------------------------------------------
local function dubaiExtras(O, w, rng, index)
	local T = Vector3.new(135, 0, 135)
	part({ Size = Vector3.new(26, 112, 26), CFrame = CFrame.new(O + T + Vector3.new(0, 56, 0)), Color = Color3.fromRGB(120, 170, 210), Material = Enum.Material.Glass, Reflectance = 0.15 })
	for f = 1, 10 do
		part({ Size = Vector3.new(27, 1, 27), CFrame = CFrame.new(O + T + Vector3.new(0, f * 11, 0)), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Foil })
	end
	course(O, {
		id = "dubai", title = "Wolkenkratzer-Lauf", emoji = "🏙️", hint = "Lauf die Stahlträger rund um den Turm hoch bis zum Helipad!",
		start = Vector3.new(135, 0, 102),
		points = spiralPoints(T, 21, 28, 0.4, 0, 3.0, { [10] = 14, [20] = 14 }),
		jumps = { [10] = 14, [20] = 14 },
		cpEvery = 5,
		size = Vector3.new(6, 1, 4), material = Enum.Material.Metal,
		color = function() return Color3.fromRGB(190, 190, 200) end,
		finish = T + Vector3.new(math.cos(28 * 0.4) * 8, 113.5, math.sin(28 * 0.4) * 8),
		finishBuild = function(fp)
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 20, 20), CFrame = CFrame.new(fp - Vector3.new(0, 0.85, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(50, 50, 55) })
			surfaceSign(part({ Size = Vector3.new(8, 0.1, 8), CFrame = CFrame.new(fp - Vector3.new(0, 0.95, 0)), Transparency = 1, CanCollide = false }), Enum.NormalId.Top, "H", nil, WHITE)
		end,
		reward = courseReward(index),
	})
	-- Riesenrad „Dubai Eye“
	local A = O + Vector3.new(-90, 0, 200)
	local R = 30
	for _, side in ipairs({ -2, 2 }) do
		part({ Size = Vector3.new(1.4, R + 6, 1.4), CFrame = CFrame.new(A + Vector3.new(side * 2, (R + 6) / 2, 0)) * CFrame.Angles(0, 0, math.rad(side * 6)), Color = WHITE, Material = Enum.Material.Metal })
	end
	local hub = A + Vector3.new(0, R + 6, 0)
	for k = 0, 15 do
		local a = k / 16 * math.pi * 2
		local p = hub + Vector3.new(math.cos(a) * R, math.sin(a) * R, 0)
		part({ Size = Vector3.new(0.4, 0.4, R), CFrame = CFrame.lookAt((hub + p) / 2, p), Color = Color3.fromRGB(230, 230, 240), CanCollide = false })
		local nextP = hub + Vector3.new(math.cos(a + math.pi / 8) * R, math.sin(a + math.pi / 8) * R, 0)
		part({ Size = Vector3.new(0.8, 0.8, (nextP - p).Magnitude), CFrame = CFrame.lookAt((p + nextP) / 2, nextP), Color = Color3.fromRGB(62, 242, 255), Material = Enum.Material.Neon, CanCollide = false })
		ellipsoid({ Size = Vector3.new(3, 3, 3.6), CFrame = CFrame.new(p + Vector3.new(0, -1.8, 0)), Color = Color3.fromRGB(200, 230, 255), Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false })
	end
	-- Infinity-Pool mit Liegen
	local B = O + Vector3.new(150, 0, -150)
	part({ Size = Vector3.new(34, 2, 20), CFrame = CFrame.new(B + Vector3.new(0, 1, 0)), Color = Color3.fromRGB(240, 240, 240), Material = Enum.Material.Marble })
	part({ Size = Vector3.new(31, 0.4, 17), CFrame = CFrame.new(B + Vector3.new(0, 2.05, 0)), Color = Color3.fromRGB(40, 190, 230), Material = Enum.Material.Glass, Transparency = 0.15 })
	for k = -2, 2 do
		local P = B + Vector3.new(k * 6, 0, -14)
		part({ Size = Vector3.new(2.5, 0.6, 6), CFrame = CFrame.new(P + Vector3.new(0, 1, 0)), Color = WHITE })
		part({ Size = Vector3.new(2.5, 0.6, 2.5), CFrame = CFrame.new(P + Vector3.new(0, 1.8, 2.4)) * CFrame.Angles(math.rad(-40), 0, 0), Color = WHITE })
	end
	-- Helikopter auf Landeplatz
	local C = O + Vector3.new(-140, 0, -195)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 24, 24), CFrame = CFrame.new(C + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(50, 50, 55) })
	ellipsoid({ Size = Vector3.new(7, 6, 12), CFrame = CFrame.new(C + Vector3.new(0, 4.5, 0)), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Foil })
	part({ Size = Vector3.new(1.4, 1.4, 10), CFrame = CFrame.new(C + Vector3.new(0, 5, 10)), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Foil })
	part({ Size = Vector3.new(22, 0.3, 1.2), CFrame = CFrame.new(C + Vector3.new(0, 8, 0)) * CFrame.Angles(0, math.rad(25), 0), Color = Color3.fromRGB(40, 40, 45) })
	for _, s in ipairs({ -3, 3 }) do part({ Size = Vector3.new(0.5, 0.5, 11), CFrame = CFrame.new(C + Vector3.new(s, 1.5, 0)), Color = Color3.fromRGB(40, 40, 45) }) end
	-- Luxus-Mall-Torbogen
	local D = O + Vector3.new(205, 0, -85)
	for _, s in ipairs({ -10, 10 }) do part({ Size = Vector3.new(4, 24, 4), CFrame = CFrame.new(D + Vector3.new(0, 12, s)), Color = Color3.fromRGB(240, 230, 210), Material = Enum.Material.Marble }) end
	part({ Size = Vector3.new(5, 5, 26), CFrame = CFrame.new(D + Vector3.new(0, 26, 0)), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Foil })
	surfaceSign(part({ Size = Vector3.new(0.3, 4, 20), CFrame = CFrame.new(D + Vector3.new(-2.7, 26, 0)), Color = Color3.fromRGB(20, 5, 35) }), Enum.NormalId.Left, "💎 GLOW MALL", Color3.fromRGB(20, 5, 35), Color3.fromRGB(255, 209, 102))
	-- Supercar-Showroom
	local E = O + Vector3.new(-120, 0, 40)
	for k = -1, 1 do
		local P = E + Vector3.new(k * 14, 0, 0)
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 13, 13), CFrame = CFrame.new(P + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(30, 30, 35), Material = Enum.Material.Marble })
		car(O, P.X - O.X, P.Z - O.Z, math.rad(30 + k * 40), ({ Color3.fromRGB(212, 175, 55), Color3.fromRGB(250, 250, 250), Color3.fromRGB(220, 20, 50) })[k + 2], true)
	end
	trampoline(O, 60, 120, 110, Color3.fromRGB(255, 209, 102))
end

----------------------------------------------------------------------------
-- 🌌 AURA-GALAXIE: Planeten-Hüpfen mit Sprungfeldern, Mondbasis, Satellitenschüssel, Schwarzes Loch, Alien-Statue
----------------------------------------------------------------------------
local PLANET_COLORS = { Color3.fromRGB(255, 120, 200), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 200, 80), Color3.fromRGB(150, 255, 160), Color3.fromRGB(200, 120, 255) }

local function galaxyExtras(O, w, rng, index)
	course(O, {
		id = "galaxy", title = "Planeten-Hüpfen", emoji = "🪐", hint = "Hüpf von Planet zu Planet – die pinken Felder schießen dich hoch!",
		start = Vector3.new(95, 0, 95),
		points = linePoints(Vector3.new(104, 0, 104), Vector3.new(180, 0, 180), 20, 7, 0.8, 3, 1.6, { [6] = 15, [13] = 15 }),
		jumps = { [6] = 15, [13] = 15 },
		cpEvery = 7,
		build = function(P, i, size, under)
			if under then return end
			local d = 9
			local planet = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d), CFrame = CFrame.new(P - Vector3.new(0, d / 2, 0)),
				Color = PLANET_COLORS[(i % #PLANET_COLORS) + 1], Material = Enum.Material.SmoothPlastic })
			-- flache Landefläche oben, damit man nicht abrutscht
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 6, 6), CFrame = CFrame.new(P - Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = PLANET_COLORS[(i % #PLANET_COLORS) + 1]:Lerp(WHITE, 0.3), Material = Enum.Material.SmoothPlastic })
			if i % 4 == 0 then
				part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, d * 1.7, d * 1.7), CFrame = CFrame.new(P - Vector3.new(0, d / 2, 0)) * CFrame.Angles(math.rad(15), 0, math.rad(90)),
					Color = WHITE, Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false })
			end
			return planet
		end,
		finish = Vector3.new(188, 66, 188),
		finishBuild = function(fp)
			-- UFO
			ellipsoid({ Size = Vector3.new(22, 4, 22), CFrame = CFrame.new(fp - Vector3.new(0, 2.6, 0)), Color = Color3.fromRGB(180, 185, 200), Material = Enum.Material.Metal })
			ellipsoid({ Size = Vector3.new(9, 6, 9), CFrame = CFrame.new(fp + Vector3.new(0, 1, 6)), Color = Color3.fromRGB(120, 255, 180), Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false })
			for k = 0, 7 do
				local a = k / 8 * math.pi * 2
				part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = CFrame.new(fp + Vector3.new(math.cos(a) * 10, -2.6, math.sin(a) * 10)), Color = Color3.fromRGB(255, 209, 102), Material = Enum.Material.Neon })
			end
		end,
		reward = courseReward(index),
	})
	-- Mondbasis
	local A = O + Vector3.new(-90, 0, 190)
	for _, d in ipairs({ { 0, 0, 20 }, { 16, 6, 12 }, { -14, 8, 10 } }) do
		ellipsoid({ Size = Vector3.new(d[3], d[3] * 0.9, d[3]), CFrame = CFrame.new(A + Vector3.new(d[1], 0, d[2])), Color = Color3.fromRGB(200, 230, 255), Material = Enum.Material.Glass, Transparency = 0.35 })
	end
	part({ Size = Vector3.new(16, 3, 3), CFrame = CFrame.new(A + Vector3.new(8, 1.5, 3)), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal })
	part({ Size = Vector3.new(14, 3, 3), CFrame = CFrame.new(A + Vector3.new(-7, 1.5, 4)), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal })
	-- Satellitenschüssel
	local B = O + Vector3.new(150, 0, -150)
	part({ Size = Vector3.new(2, 12, 2), CFrame = CFrame.new(B + Vector3.new(0, 6, 0)), Color = Color3.fromRGB(180, 180, 190), Material = Enum.Material.Metal })
	ellipsoid({ Size = Vector3.new(20, 3, 20), CFrame = CFrame.new(B + Vector3.new(0, 14, 0)) * CFrame.Angles(math.rad(35), 0, 0), Color = Color3.fromRGB(230, 230, 240), Material = Enum.Material.Metal })
	part({ Size = Vector3.new(0.5, 7, 0.5), CFrame = CFrame.new(B + Vector3.new(0, 16.5, -2)) * CFrame.Angles(math.rad(35), 0, 0), Color = Color3.fromRGB(80, 80, 90) })
	part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(B + Vector3.new(0, 19.4, 0)), Color = Color3.fromRGB(255, 80, 80), Material = Enum.Material.Neon })
	-- Schwarzes Loch (Deko)
	local C = O + Vector3.new(-140, 22, -195)
	part({ Shape = Enum.PartType.Ball, Size = Vector3.new(14, 14, 14), CFrame = CFrame.new(C), Color = Color3.new(0, 0, 0), CanCollide = false })
	for k = 1, 3 do
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 18 + k * 7, 18 + k * 7), CFrame = CFrame.new(C) * CFrame.Angles(math.rad(70), 0, math.rad(90)),
			Color = ({ Color3.fromRGB(255, 160, 60), Color3.fromRGB(255, 80, 200), Color3.fromRGB(150, 90, 255) })[k], Material = Enum.Material.Neon, Transparency = 0.3 + k * 0.15, CanCollide = false })
	end
	-- Raumstation-Module
	local D = O + Vector3.new(205, 0, -85)
	for k = 0, 2 do
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(12, 6, 6), CFrame = CFrame.new(D + Vector3.new(0, 4, -12 + k * 12)) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(225, 225, 235), Material = Enum.Material.Metal })
	end
	for _, s in ipairs({ -1, 1 }) do
		part({ Size = Vector3.new(14, 0.3, 6), CFrame = CFrame.new(D + Vector3.new(s * 10, 4, 0)), Color = Color3.fromRGB(40, 70, 160), Material = Enum.Material.Glass })
	end
	-- Alien-Statue (macht natürlich Mewing)
	local E = O + Vector3.new(-120, 0, 40)
	local alien = Color3.fromRGB(120, 230, 140)
	part({ Size = Vector3.new(6, 2, 6), CFrame = CFrame.new(E + Vector3.new(0, 1, 0)), Color = Color3.fromRGB(60, 50, 80), Material = Enum.Material.Marble })
	ellipsoid({ Size = Vector3.new(3, 6, 2.4), CFrame = CFrame.new(E + Vector3.new(0, 5.5, 0)), Color = alien })
	ellipsoid({ Size = Vector3.new(5, 6, 5), CFrame = CFrame.new(E + Vector3.new(0, 11, 0)), Color = alien })
	for _, s in ipairs({ -1.1, 1.1 }) do
		ellipsoid({ Size = Vector3.new(1.4, 2, 0.6), CFrame = CFrame.new(E + Vector3.new(s, 11.4, -2.3)) * CFrame.Angles(0, 0, math.rad(s * 20)), Color = Color3.new(0, 0, 0), Reflectance = 0.5 })
	end
	trampoline(O, 60, 120, 120, Color3.fromRGB(200, 120, 255))
end

local WORLD_EXTRAS = { beach = beachExtras, mountain = mountainExtras, temple = templeExtras, fashion = fashionExtras,
	hollywood = hollywoodExtras, dubai = dubaiExtras, galaxy = galaxyExtras }

-- Bereiche je Welt, an denen keine zufällige Deko stehen darf (Parkour & Wahrzeichen)
local LANDMARK_SPOTS = { { -90, 190, 30 }, { 150, -150, 22 }, { -140, -195, 20 }, { 205, -85, 18 }, { -120, 40, 22 }, { -160, 0, 8 } }
local WORLD_RESERVED = {
	beach = { { 130, 175, 70 }, { 60, 120, 8 } },
	mountain = { { 140, 140, 45 }, { 170, -205, 14 }, { 115, -205, 12 }, { 225, -205, 12 } },
	temple = { { 150, 150, 70 } },
	fashion = { { 138, 138, 58 }, { 30, 120, 8 } },
	hollywood = { { 140, 140, 60 } },
	dubai = { { 135, 135, 50 }, { -90, 200, 40 }, { 60, 120, 8 } },
	galaxy = { { 140, 140, 62 }, { 60, 120, 8 } },
}

local function buildWorld(index, mapFolder)
	local w = Config.Worlds[index]
	local O = Vector3.new((index - 1) * Config.WORLD_SPACING, 0, 0)
	local rng = Random.new(index * 7919)
	currentFolder = Instance.new("Folder")
	currentFolder.Name = index .. "_" .. w.id
	currentFolder.Parent = mapFolder

	-- Boden & unsichtbare Wände
	local ground = part({ Name = "Ground", Size = Vector3.new(S, 4, S), CFrame = CFrame.new(O + Vector3.new(0, -2, 0)), Color = w.ground, Material = GROUND_MATERIAL[w.theme] })
	if TERRAIN_GROUND[w.theme] then
		local ok = pcall(function()
			workspace.Terrain:FillBlock(CFrame.new(O + Vector3.new(0, -2, 0)), Vector3.new(S, 4, S), TERRAIN_GROUND[w.theme])
		end)
		if ok then
			ground.Transparency = 1     -- das Gelände ersetzt die Bodenplatte
			ground.CanCollide = false
			ground.CanQuery = false     -- Fans & Sammel-Items stehen auf dem echten Gelände (nicht übers Meer)
		end
	end
	for _, side in ipairs({ { HALF, 0, 2, S }, { -HALF, 0, 2, S }, { 0, HALF, S, 2 }, { 0, -HALF, S, 2 } }) do
		part({ Name = "Wall", Size = Vector3.new(side[3], 120, side[4]), CFrame = CFrame.new(O + Vector3.new(side[1], 60, side[2])), Transparency = 1 })
	end

	-- Spawn-Platz
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 40, 40), CFrame = CFrame.new(O + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = w.accent, Material = Enum.Material.SmoothPlastic, Transparency = 0.25 })
	if index == 1 then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Spawn"
		spawn.Anchored = true
		spawn.Size = Vector3.new(10, 1, 10)
		spawn.CFrame = CFrame.new(O + Vector3.new(0, 0.5, 22))
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Duration = 0
		spawn.Neutral = true
		spawn.Parent = currentFolder
	end
	local nameAnchor = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(O + Vector3.new(0, 26, -30)), Transparency = 1, CanCollide = false })
	billboard(nameAnchor, w.emoji .. " " .. string.upper(w.name) .. "\n<font size='20' color='#ffd166'>Aura x" .. Util.format(w.mult) .. "</font>", 40, 10, 0, WHITE)

	-- Sperrflächen für Parkour & Wahrzeichen dieser Welt
	currentReserved = {}
	currentMaxZ = (w.theme == "beach") and 118 or nil
	for _, r in ipairs(WORLD_RESERVED[w.theme] or {}) do table.insert(currentReserved, r) end
	if WORLD_EXTRAS[w.theme] then
		for _, r in ipairs(LANDMARK_SPOTS) do table.insert(currentReserved, r) end
	end

	-- Deko
	local theme = THEMES[w.theme]
	if theme then theme(O, w, rng) end
	decorate(O, w, rng)

	-- Pet-Stationen: 5 Geschenkboxen, von günstig bis göttlich
	for st, station in ipairs(Config.EggStations) do
		local egg = Config.Eggs[Config.eggIndex(index, st)]
		local ep = O + Vector3.new(40 + (st - 1) * 26, 0, -45 - math.abs(st - 3) * 6)
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 13, 13), CFrame = CFrame.new(ep + Vector3.new(0, 1, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(40, 20, 60), Material = Enum.Material.SmoothPlastic })
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 13.6, 13.6), CFrame = CFrame.new(ep + Vector3.new(0, 2.05, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = station.color, Material = Enum.Material.Neon, Transparency = 0.3 })
		local s = 4.5 + st * 0.5
		local box = part({ Name = "Geschenkbox", Size = Vector3.new(s, s, s), CFrame = CFrame.new(ep + Vector3.new(0, 2 + s / 2 + 0.5, 0)) * CFrame.Angles(0, math.rad(20), 0),
			Color = station.color, Material = st >= 4 and Enum.Material.Glass or Enum.Material.SmoothPlastic, Reflectance = st >= 3 and 0.2 or 0 })
		part({ Size = Vector3.new(s + 0.2, s + 0.2, 0.9), CFrame = box.CFrame, Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon })
		part({ Size = Vector3.new(0.9, s + 0.2, s + 0.2), CFrame = box.CFrame, Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon })
		part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.6, 1.6), CFrame = box.CFrame * CFrame.new(0, s / 2 + 0.5, 0), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Neon })
		local light = Instance.new("PointLight")
		light.Color = station.color
		light.Range = 14
		light.Parent = box
		-- beste Chance auf dem Schild
		local bestName, bestChance, total = nil, 0, 0
		for _, e in ipairs(egg.pets) do total = total + e.weight end
		local bestOrder = 0
		for rarityId, w in pairs(station.weights) do
			local r = Config.Rarities[rarityId]
			if r.order > bestOrder then bestOrder, bestName, bestChance = r.order, r.name, w end
		end
		billboard(box, station.emoji .. " " .. station.name .. "\n<font color='#ffd166'>" .. Util.format(egg.cost) .. " Aura</font>\n<font size='14'>bis " .. bestName .. ": "
			.. Util.format(bestChance / total * 100) .. " %</font>", 11, 4.6, s / 2 + 3.5, WHITE)
		table.insert(MapBuilder.eggPrompts, { prompt = prompt(box, "Öffnen", station.name, 0.25), egg = egg, count = 1 })
		table.insert(MapBuilder.eggPrompts, { prompt = prompt(box, "3x öffnen", "Rebirth-Shop: 3er-Öffnen", 0.25, Enum.KeyCode.F), egg = egg, count = 3 })
		table.insert(MapBuilder.eggPrompts, { prompt = prompt(box, "Inhalt ansehen", station.name, 0, Enum.KeyCode.R), egg = egg, info = true })
	end
	local plazaSign = part({ Size = Vector3.new(30, 5, 1), CFrame = CFrame.new(O + Vector3.new(92, 14, -78)), Color = Color3.fromRGB(20, 5, 35) })
	surfaceSign(plazaSign, Enum.NormalId.Back, "🐾 PET-STATIONEN", Color3.fromRGB(20, 5, 35), WHITE)
	part({ Size = Vector3.new(1, 13, 1), CFrame = CFrame.new(O + Vector3.new(78, 6.5, -78)), Color = Color3.fromRGB(60, 60, 70) })
	part({ Size = Vector3.new(1, 13, 1), CFrame = CFrame.new(O + Vector3.new(106, 6.5, -78)), Color = Color3.fromRGB(60, 60, 70) })

	-- Rivale & Boss
	local rival = Config.Rivals[index]
	table.insert(MapBuilder.npcs, { prompt = makeNPC(rival, O + Vector3.new(-55, 0, -40), false), def = rival, world = index, isBoss = false })
	-- schwächere Rivalen zum Üben
	for k, extra in ipairs(Config.ExtraRivals) do
		local name = extra.prefix .. " " .. Config.RivalNames[((index * 3 + k) % #Config.RivalNames) + 1]
		local def = {
			name = name, level = math.max(1, math.floor(rival.level * extra.strength)), rebirths = math.floor(rival.rebirths * extra.strength),
			shirt = rival.shirt:Lerp(Color3.fromRGB(80, 80, 90), 0.4), pants = rival.pants, skin = rival.skin,
		}
		table.insert(MapBuilder.npcs, { prompt = makeNPC(def, O + Vector3.new(-85 - k * 25, 0, -25 - k * 18), false), def = def, world = index, isBoss = false })
	end
	local boss = Config.Bosses[index]
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 30, 30), CFrame = CFrame.new(O + Vector3.new(0, 2, -160)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = boss.final and Color3.fromRGB(212, 175, 55) or Color3.fromRGB(60, 20, 40), Material = boss.final and Enum.Material.Foil or Enum.Material.Slate })
	table.insert(MapBuilder.npcs, { prompt = makeNPC(boss, O + Vector3.new(0, 4, -160), true), def = boss, world = index, isBoss = true })

	-- Portale zur nächsten / vorherigen Welt
	local function portal(x, target, arrow)
		local tw = Config.Worlds[target]
		local P = O + Vector3.new(x, 0, 0)
		part({ Size = Vector3.new(4, 24, 4), CFrame = CFrame.new(P + Vector3.new(0, 12, -11)), Color = Color3.fromRGB(40, 20, 60) })
		part({ Size = Vector3.new(4, 24, 4), CFrame = CFrame.new(P + Vector3.new(0, 12, 11)), Color = Color3.fromRGB(40, 20, 60) })
		part({ Size = Vector3.new(4, 4, 26), CFrame = CFrame.new(P + Vector3.new(0, 26, 0)), Color = Color3.fromRGB(40, 20, 60) })
		local gate = part({ Name = "Portal", Size = Vector3.new(1, 22, 18), CFrame = CFrame.new(P + Vector3.new(0, 12, 0)), Color = tw.accent, Material = Enum.Material.Neon, Transparency = 0.35, CanCollide = false })
		local info = arrow .. " " .. tw.emoji .. " " .. tw.name .. "\n<font size='18' color='#ffd166'>Aura x" .. Util.format(tw.mult)
		if target > index and tw.cost > 0 then
			info = info .. " · " .. Util.format(tw.cost) .. " Aura"
			if tw.rebirths > 0 then info = info .. " · ♻️ " .. tw.rebirths end
		end
		billboard(gate, info .. "</font>", 16, 5, 15, WHITE)
		table.insert(MapBuilder.portals, { prompt = prompt(gate, "Reisen", tw.name, 0.5), target = target })
	end
	if index < #Config.Worlds then portal(200, index + 1, "➡️") end
	if index > 1 then portal(-200, index - 1, "⬅️") end

	-- Minispiele & Event-Platz
	if index == 1 then
		eventPlaza(O)
		obbyCourse(O)
		gymStation(O)
	elseif index == 3 then
		gymStation(O)
	elseif index == 5 then
		raceTrack(O)
	end
	-- Parkour & Wahrzeichen der Welt
	if WORLD_EXTRAS[w.theme] then
		WORLD_EXTRAS[w.theme](O, w, rng, index)
	end

	-- Nur in Glow City: Ranglisten-Tafel & Info-Tafel
	if index == 1 then
		local board = part({ Name = "Rangliste", Size = Vector3.new(40, 26, 1), CFrame = CFrame.new(O + Vector3.new(0, 15, 100)), Color = Color3.fromRGB(20, 5, 35) })
		part({ Size = Vector3.new(2, 15, 2), CFrame = CFrame.new(O + Vector3.new(-15, 1, 100)), Color = Color3.fromRGB(60, 60, 70) })
		part({ Size = Vector3.new(2, 15, 2), CFrame = CFrame.new(O + Vector3.new(15, 1, 100)), Color = Color3.fromRGB(60, 60, 70) })
		local sg = Instance.new("SurfaceGui")
		sg.Face = Enum.NormalId.Front
		sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		sg.PixelsPerStud = 25
		sg.LightInfluence = 0
		sg.Parent = board
		local header = Instance.new("TextLabel")
		header.Size = UDim2.new(1, 0, 0.16, 0)
		header.BackgroundColor3 = Color3.fromRGB(255, 79, 216)
		header.TextScaled = true
		header.Font = Enum.Font.FredokaOne
		header.TextColor3 = WHITE
		header.Text = "🏆 GLOBALE TOP 10 – GLOW-POWER"
		header.Parent = sg
		for r = 1, 10 do
			local row = Instance.new("TextLabel")
			row.Size = UDim2.new(0.96, 0, 0.078, 0)
			row.Position = UDim2.new(0.02, 0, 0.17 + (r - 1) * 0.082, 0)
			row.BackgroundTransparency = r % 2 == 0 and 1 or 0.85
			row.BackgroundColor3 = WHITE
			row.TextScaled = true
			row.RichText = true
			row.Font = Enum.Font.GothamBold
			row.TextColor3 = WHITE
			row.TextXAlignment = Enum.TextXAlignment.Left
			row.Text = r .. ". …"
			row.Parent = sg
			MapBuilder.boardRows[r] = row
		end

		local infoBoard = part({ Size = Vector3.new(22, 16, 0.6), CFrame = CFrame.new(O + Vector3.new(-45, 9, 60)) * CFrame.Angles(0, math.rad(-37), 0), Color = Color3.fromRGB(20, 5, 35) })
		local _, infoLabel = surfaceSign(infoBoard, Enum.NormalId.Front,
			"<b>📖 SO GEHT'S</b>\n🪞 Daily Routine klicken = Aura\n💪 Upgrades kaufen = mehr Aura & Glow\n🎁 Geschenkboxen = Pets mit Boosts\n⚔️ Rivalen & Bosse = Mog Battles\n🌍 Portale = neue Welten\n♻️ Rebirth = dauerhafter Bonus",
			Color3.fromRGB(20, 5, 35), WHITE)
		infoLabel.Font = Enum.Font.GothamBold
	end
end

function MapBuilder.build()
	local mapFolder = workspace:FindFirstChild("Map")
	if mapFolder then mapFolder:Destroy() end
	mapFolder = Instance.new("Folder")
	mapFolder.Name = "Map"
	mapFolder.Parent = workspace

	npcFolder = Instance.new("Folder")
	npcFolder.Name = "NPCs"
	npcFolder.Parent = workspace

	local pets = workspace:FindFirstChild("Pets") or Instance.new("Folder")
	pets.Name = "Pets"
	pets.Parent = workspace

	-- realistischere Beleuchtung (falls in Studio nicht schon eingestellt)
	local Lighting = game:GetService("Lighting")
	pcall(function() Lighting.Technology = Enum.Technology.Future end)
	pcall(function()
		Lighting.GlobalShadows = true
		Lighting.EnvironmentDiffuseScale = 1
		Lighting.EnvironmentSpecularScale = 1
		Lighting.Brightness = 2.5
		workspace.Terrain.Decoration = false   -- Grashalme verdecken sonst kleine Deko (wirkte "im Boden")
		workspace.Terrain.WaterWaveSize = 0.25
		workspace.Terrain.WaterTransparency = 0.6
		workspace.Terrain.WaterColor = Color3.fromRGB(20, 150, 190)
		workspace.Terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(95, 150, 70))
		workspace.Terrain:SetMaterialColor(Enum.Material.Sand, Color3.fromRGB(230, 205, 150))
	end)

	for i = 1, #Config.Worlds do
		local ok, err = pcall(buildWorld, i, mapFolder)
		if not ok then
			warn("[Looksmaxxer] Fehler beim Bauen von Welt " .. i .. ":", err)
		end
	end
end

return MapBuilder
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000012"><Properties><string name="Name">MinigameService</string><ProtectedString name="Source"><![CDATA[--[[
	MINIGAMESERVICE – Minispiele auf der Karte
	🧗 Dach-Parkour (Glow City): Springe von Plattform zu Plattform bis ganz nach oben. Mit Checkpoints.
	🏁 Laufsteg-Rennen (Mailand): So schnell wie möglich vom Start zum Ziel. Bestzeit wird gespeichert.
	💪 Gym-Training (Glow City & Iron Mountain): Rhythmus-Minispiel → Gym-Pump (+50 % Aura für 3 Minuten).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local RewardService = require(script.Parent.RewardService)

local MinigameService = {}
local raceStart = {}     -- [player] = os.clock()
local gymStart = {}      -- [player] = os.clock()
local touchDebounce = {} -- [player .. part] = Zeit

local function playerFromHit(hit)
	local char = hit and hit.Parent
	local player = char and Players:GetPlayerFromCharacter(char)
	if not player then
		-- Teil eines Fahrzeugs/Huts? Eine Ebene höher suchen
		char = char and char.Parent
		player = char and Players:GetPlayerFromCharacter(char)
	end
	return player
end

local function debounce(player, key, seconds)
	local k = player.UserId .. key
	local now = os.clock()
	if touchDebounce[k] and now - touchDebounce[k] < seconds then return false end
	touchDebounce[k] = now
	return true
end

local function teleportTo(player, cf)
	local char = player.Character
	if char then char:PivotTo(cf) end
end

----------------------------------------------------------------------------
-- 🧗 Dach-Parkour
----------------------------------------------------------------------------
local function initObby(obby)
	obby.start.Triggered:Connect(function(player)
		local cp = player:GetAttribute("ObbyCheckpoint") or 0
		local target = (cp > 0 and obby.checkpoints[cp]) or obby.first
		teleportTo(player, target.CFrame * CFrame.new(0, 4, 0))
		GameService.notify(player, "🧗 Dach-Parkour", cp > 0 and ("Weiter ab Checkpoint " .. cp .. "!") or "Spring nach oben bis zum goldenen Pokal!", "")
	end)
	for i, cpPart in ipairs(obby.checkpoints) do
		cpPart.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and (player:GetAttribute("ObbyCheckpoint") or 0) < i then
				player:SetAttribute("ObbyCheckpoint", i)
				GameService.notify(player, "🚩 Checkpoint " .. i, "Falls du fällst: am Start-Knopf geht's hier weiter.", "")
			end
		end)
	end
	obby.finish.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		local data = player and DataService.get(player)
		if not data or not debounce(player, "obbyFinish", 5) then return end
		player:SetAttribute("ObbyCheckpoint", 0)
		local now = os.time()
		if now - data.records.obbyLast < Config.OBBY_COOLDOWN then
			GameService.notify(player, "🏆 Geschafft!", "Nächste Belohnung in " .. Util.formatTime(Config.OBBY_COOLDOWN - (now - data.records.obbyLast)) .. ".", "good")
		else
			data.records.obbyLast = now
			GameService.track(player, "obby", 1)
			local text = RewardService.give(player, data, Config.ObbyReward)
			GameService.notify(player, "🏆 DACH-PARKOUR GESCHAFFT!", text, "title")
			GameService.sendFull(player)
		end
		task.delay(2, function()
			if player.Parent then teleportTo(player, obby.start.Parent.CFrame * CFrame.new(0, 4, 6)) end
		end)
	end)
end

----------------------------------------------------------------------------
-- 🧗 Parkour-Strecken in den Welten 2–8 (Bojen, Gipfel, Lava-Tempel, Shopping, Stunt, Wolkenkratzer, Planeten)
----------------------------------------------------------------------------
local function initCourse(c)
	local attr = "CP_" .. c.id
	local function backToCheckpoint(player)
		-- immer über der Oberkante in Weltkoordinaten landen (Bojen/Planeten sind gedreht bzw. rund)
		local cp = player:GetAttribute(attr) or 0
		local cpPart = cp > 0 and c.checkpoints[cp]
		local pos = cpPart and (cpPart.Position + Vector3.new(0, cpPart.Size.Y / 2, 0)) or c.firstTop
		if pos then teleportTo(player, CFrame.new(pos + Vector3.new(0, 4, 0))) end
	end
	c.start.Triggered:Connect(function(player)
		local cp = player:GetAttribute(attr) or 0
		backToCheckpoint(player)
		GameService.notify(player, "🧗 " .. c.title, cp > 0 and ("Weiter ab Checkpoint " .. cp .. "!") or "Los geht's – ab zum goldenen Pokal!", "")
	end)
	for i, cpPart in ipairs(c.checkpoints) do
		cpPart.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and (player:GetAttribute(attr) or 0) < i then
				player:SetAttribute(attr, i)
				GameService.notify(player, "🚩 Checkpoint " .. i, "Wenn du fällst, geht's hier weiter.", "")
			end
		end)
	end
	-- Lava / Wasser: zurück zum letzten Checkpoint
	for _, kill in ipairs(c.kills) do
		kill.Touched:Connect(function(hit)
			local player = playerFromHit(hit)
			if player and debounce(player, "kill" .. c.id, 1.2) then
				backToCheckpoint(player)
			end
		end)
	end
	c.finish.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		local data = player and DataService.get(player)
		if not data or not debounce(player, "finish" .. c.id, 5) then return end
		player:SetAttribute(attr, 0)
		local now = os.time()
		local last = data.records.courses[c.id] or 0
		if now - last < Config.OBBY_COOLDOWN then
			GameService.notify(player, "🏆 Geschafft!", "Nächste Belohnung hier in " .. Util.formatTime(Config.OBBY_COOLDOWN - (now - last)) .. ".", "good")
		else
			data.records.courses[c.id] = now
			GameService.track(player, "obby", 1)
			local text = RewardService.give(player, data, c.reward)
			GameService.notify(player, "🏆 " .. c.title .. " geschafft!", text, "title")
			GameService.sendFull(player)
		end
		task.delay(2.5, function()
			if player.Parent then teleportTo(player, c.startCf * CFrame.new(0, 4, -6)) end
		end)
	end)
end

----------------------------------------------------------------------------
-- 🏁 Laufsteg-Rennen
----------------------------------------------------------------------------
local function initRace(race)
	race.start.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		if not player or not debounce(player, "raceStart", 2) then return end
		raceStart[player] = os.clock()
		player:SetAttribute("RaceStart", workspace:GetServerTimeNow())
	end)
	race.finish.Touched:Connect(function(hit)
		local player = playerFromHit(hit)
		local data = player and DataService.get(player)
		local started = player and raceStart[player]
		if not data or not started then return end
		raceStart[player] = nil
		player:SetAttribute("RaceStart", nil)
		local t = os.clock() - started
		if t < 3 then return end   -- zu schnell = unmöglich
		local factor = math.clamp(Config.RACE_TARGET / t, 0.3, 2)
		local cash = math.floor(Config.RaceReward.cash * Logic.jobPayMult(data) * factor * Logic.cashMult(data))
		data.cash = data.cash + cash
		local best = data.records.raceBest
		local newBest = best == 0 or t < best
		if newBest then data.records.raceBest = t end
		GameService.track(player, "race", 1)
		GameService.notify(player, "🏁 Ziel! " .. string.format("%.2f", t) .. " s" .. (newBest and " – NEUE BESTZEIT!" or ""),
			"+" .. Util.format(cash) .. " Geld · Bestzeit: " .. string.format("%.2f", data.records.raceBest) .. " s", newBest and "title" or "good")
		GameService.sendFull(player)
	end)
end

----------------------------------------------------------------------------
-- 💪 Gym-Training
----------------------------------------------------------------------------
local function initGym(prompt)
	prompt.Triggered:Connect(function(player)
		local data = DataService.get(player)
		if not data then return end
		local wait = Config.GYM_COOLDOWN - (os.time() - data.records.gymLast)
		if wait > 0 then
			GameService.notify(player, "😮‍💨 Pause", "Deine Muskeln brauchen noch " .. wait .. " s.", "")
			return
		end
		gymStart[player] = os.clock()
		Remotes.GymStart:FireClient(player)
	end)
end

Remotes.GymFinish.OnServerEvent:Connect(function(player, hits)
	local data = DataService.get(player)
	local started = gymStart[player]
	gymStart[player] = nil
	if not data or not started then return end
	local elapsed = os.clock() - started
	if elapsed < 3 or elapsed > 90 then return end
	hits = math.clamp(math.floor(tonumber(hits) or 0), 0, 8)
	data.records.gymLast = os.time()
	GameService.track(player, "gym", 1)
	if hits >= 4 then
		RewardService.addPotion(data, "pump")
		local cash = math.floor(40 * hits * Logic.jobPayMult(data) * Logic.cashMult(data))
		data.cash = data.cash + cash
		GameService.notify(player, "💪 GYM-PUMP! (" .. hits .. "/8)", "+50 % Aura für 3 Minuten · +" .. Util.format(cash) .. " Geld", "title")
	else
		GameService.notify(player, "😅 Zu wenig Wiederholungen (" .. hits .. "/8)", "Mindestens 4 Treffer für den Gym-Pump. Gleich nochmal!", "bad")
	end
	GameService.sendFull(player)
end)

function MinigameService.init(info)
	if info.obby then initObby(info.obby) end
	if info.race then initRace(info.race) end
	for _, prompt in ipairs(info.gyms or {}) do initGym(prompt) end
	for _, c in ipairs(info.courses or {}) do initCourse(c) end
end

Players.PlayerRemoving:Connect(function(player)
	raceStart[player] = nil
	gymStart[player] = nil
end)

return MinigameService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000013"><Properties><string name="Name">MonetizationService</string><ProtectedString name="Source"><![CDATA[--[[
	MONETIZATIONSERVICE – Robux-Einnahmen
	• Gamepasses (einmal kaufen, für immer): VIP, Doppelte Aura, Glückspilz, +3 Pet-Plätze, 3er-Öffnen, Turbo-Laufen
	• Entwicklerprodukte (mehrfach kaufbar): Gems-Pakete, Starter-Paket, Aura-Paket

	Die IDs trägst du in Config.GamePasses / Config.DevProducts ein (siehe ANLEITUNG.md).
	Wichtig: Für Robux gibt es hier KEINE Zufallsbelohnungen (Roblox-Regeln für "paid random items").
]]

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local RewardService = require(script.Parent.RewardService)
local PetService = require(script.Parent.PetService)

local MonetizationService = {}

local passByKey, passById, productById = {}, {}, {}
for _, gp in ipairs(Config.GamePasses) do
	passByKey[gp.key] = gp
	if gp.id > 0 then passById[gp.id] = gp end
end
for _, dp in ipairs(Config.DevProducts) do
	if dp.id > 0 then productById[dp.id] = dp end
end

local function passGranted(player, data, gp)
	data.passes[gp.key] = true
	GameService.refreshCharacter(player)
	PetService.rebuildModels(player)
	GameService.sendFull(player)
end

-- Beim Betreten: Gamepasses prüfen
table.insert(GameService.joinHooks, function(player, data)
	for _, gp in ipairs(Config.GamePasses) do
		if gp.id > 0 and not data.passes[gp.key] then
			local ok, owns = pcall(function()
				return MarketplaceService:UserOwnsGamePassAsync(player.UserId, gp.id)
			end)
			if ok and owns then
				data.passes[gp.key] = true
			end
		end
	end
	GameService.sendFull(player)
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
	local gp = passById[passId]
	local data = DataService.get(player)
	if purchased and gp and data then
		passGranted(player, data, gp)
		GameService.notify(player, gp.emoji .. " " .. gp.name .. " freigeschaltet!", "Danke für deine Unterstützung! 💖", "title")
		DataService.save(player)
	end
end)

-- Entwicklerprodukte: wird von Roblox aufgerufen, bis wir "Granted" zurückgeben
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local data = DataService.get(player)
	if not data then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Schon gutgeschrieben? (Roblox kann denselben Kauf mehrmals melden)
	-- Erst "Granted" melden, wenn der Stand wirklich gespeichert ist – sonst versucht Roblox es später nochmal.
	if data.purchases[info.PurchaseId] then
		if DataService.save(player) then
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = productById[info.ProductId]
	if not product then
		warn("[Looksmaxxer] Unbekanntes Produkt:", info.ProductId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	-- Liste der Käufe klein halten: nur Einträge älter als 30 Tage entfernen
	local count = 0
	for _ in pairs(data.purchases) do count = count + 1 end
	if count > 300 then
		local cutoff = os.time() - 30 * 86400
		for id, t in pairs(data.purchases) do
			if type(t) ~= "number" or t < cutoff then data.purchases[id] = nil end
		end
	end

	local reward = product.reward
	if product.once and data.starterPack then
		-- Einmal-Paket doppelt gekauft (z. B. auf zwei Geräten): stattdessen nur die Gems
		reward = { gems = product.reward.gems or 0 }
	end
	if product.once then data.starterPack = true end
	local text = RewardService.give(player, data, reward)
	data.purchases[info.PurchaseId] = os.time()
	GameService.notify(player, product.emoji .. " " .. product.name .. " erhalten!", text .. " · Danke! 💖", "title")
	GameService.sendFull(player)
	if DataService.save(player) then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
	return Enum.ProductPurchaseDecision.NotProcessedYet
end

return MonetizationService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000014"><Properties><string name="Name">PetService</string><ProtectedString name="Source"><![CDATA[--[[
	PETSERVICE – Geschenkboxen öffnen, Pets ausrüsten, fusionieren, löschen.
	Die Pet-Figuren in der Welt werden hier erstellt; bewegt werden sie
	auf jedem Gerät vom Client-Skript "PetFollow".
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MessagingService = game:GetService("MessagingService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local PetModels = require(Shared:WaitForChild("PetModels"))

local PetService = {}
local rng = Random.new()
local ANNOUNCE_TOPIC = "LooksmaxxerAnnounce"

----------------------------------------------------------------------------
-- Pet-Figuren in der Welt
----------------------------------------------------------------------------
local function petsFolder()
	local f = workspace:FindFirstChild("Pets")
	if not f then
		f = Instance.new("Folder")
		f.Name = "Pets"
		f.Parent = workspace
	end
	return f
end

function PetService.rebuildModels(player)
	local data = DataService.get(player)
	if not data then return end
	local folder = petsFolder():FindFirstChild(tostring(player.UserId))
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = tostring(player.UserId)
		folder.Parent = petsFolder()
	end
	folder:ClearAllChildren()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local slot = 0
	for _, pet in ipairs(data.pets) do
		if pet.eq then
			slot = slot + 1
			local def = Logic.petById[pet.id]
			if def then
				local model = PetModels.build(def, pet.tier or 1, true)
				model:SetAttribute("Owner", player.UserId)
				model:SetAttribute("Slot", slot)
				model:SetAttribute("Tier", pet.tier or 1)
				if hrp then
					model:PivotTo(hrp.CFrame * CFrame.new(slot * 2, 0, 4))
				end
				model.Parent = folder
			end
		end
	end
end

----------------------------------------------------------------------------
-- Pets im Spielstand
----------------------------------------------------------------------------
local function findPet(data, uid)
	for i, pet in ipairs(data.pets) do
		if pet.uid == uid then
			return pet, i
		end
	end
	return nil
end

local function addPet(data, id, tier)
	local pet = { uid = data.nextPetId, id = id, tier = tier or 1, eq = false }
	data.nextPetId = data.nextPetId + 1
	table.insert(data.pets, pet)
	local isNew = not data.index[id]
	data.index[id] = true
	-- automatisch ausrüsten, wenn noch ein Platz frei ist
	if Logic.equippedCount(data) < Logic.petSlots(data) then
		pet.eq = true
	end
	return pet, isNew
end

local function equipBest(data)
	for _, pet in ipairs(data.pets) do
		pet.eq = false
	end
	local sorted = Util.copy(data.pets)
	table.sort(sorted, function(a, b)
		return Logic.petBoost(a) > Logic.petBoost(b)
	end)
	for i = 1, math.min(Logic.petSlots(data), #sorted) do
		sorted[i].eq = true
	end
end

local function changed(player)
	PetService.rebuildModels(player)
	GameService.sendFull(player)
end

----------------------------------------------------------------------------
-- Weltweite Ansagen bei seltenen Funden
----------------------------------------------------------------------------
local function announceLocal(text)
	for _, p in ipairs(Players:GetPlayers()) do
		GameService.notify(p, "📢 Seltener Fund!", text, "global")
	end
end

function PetService.announce(text)
	local ok = pcall(function()
		MessagingService:PublishAsync(ANNOUNCE_TOPIC, text)
	end)
	if not ok then
		announceLocal(text)
	end
end

task.spawn(function()
	local ok = pcall(function()
		MessagingService:SubscribeAsync(ANNOUNCE_TOPIC, function(message)
			if type(message.Data) == "string" then
				announceLocal(message.Data)
			end
		end)
	end)
	if not ok then
		warn("[Looksmaxxer] MessagingService nicht verfügbar (in Studio normal).")
	end
end)

----------------------------------------------------------------------------
-- Box öffnen
----------------------------------------------------------------------------
local function roll(egg, luck, forceLegendary)
	local entries, total = {}, 0
	for _, e in ipairs(egg.pets) do
		local def = Logic.petById[e.id]
		local r = Config.Rarities[def.rarity]
		local w = e.weight
		if r.order >= 3 then
			w = w * luck
		end
		if forceLegendary and r.order < 5 then
			w = 0
		end
		if w > 0 then
			total = total + w
			table.insert(entries, { id = e.id, w = w })
		end
	end
	local x = rng:NextNumber() * total
	for _, e in ipairs(entries) do
		x = x - e.w
		if x <= 0 then
			return e.id
		end
	end
	return entries[#entries].id
end

-- free = true: kostenlos (Belohnung)
function PetService.hatch(player, eggIndex, count, free)
	local data = DataService.get(player)
	local egg = Config.Eggs[eggIndex]
	if not data or not egg then return end
	count = (count == 3) and 3 or 1
	if count == 3 and Logic.perkLevel(data, "triple") < 1 and not Logic.hasPass(data, "triple") then
		GameService.notify(player, "🎁 3er-Öffnen gesperrt", "Kaufe 3er-Öffnen im Rebirth-Shop.", "bad")
		return
	end
	if not Logic.worldUnlocked(data, egg.world) then
		GameService.notify(player, "🔒 Gesperrt", "Diese Welt ist noch nicht freigeschaltet.", "bad")
		return
	end
	if #data.pets + count > Config.MAX_PET_INVENTORY then
		GameService.notify(player, "🎒 Inventar voll", "Lösche oder fusioniere Pets (max. " .. Config.MAX_PET_INVENTORY .. ").", "bad")
		return
	end
	local cost = egg.cost * count
	if egg.event and not free then
		-- Event-Box: kostet Event-Münzen und gibt es nur während des Events
		local ev = Logic.activeEvent(os.time())
		if not ev or ev.id ~= egg.event then
			GameService.notify(player, "🎉 Event vorbei", "Diese Box gibt es nur während des Events.", "bad")
			return
		end
		if Logic.eventTokens(data, egg.event) < cost then
			GameService.notify(player, ev.tokenEmoji .. " Zu wenig " .. ev.token, "Die Box kostet " .. cost .. " " .. ev.token .. ". Sammle sie in allen Welten!", "bad")
			return
		end
		data.eventTokens[egg.event] = Logic.eventTokens(data, egg.event) - cost
		free = true
	end
	if not free then
		if data.aura < cost then
			GameService.notify(player, "💸 Zu wenig Aura", egg.name .. " kostet " .. Util.format(cost) .. " Aura.", "bad")
			return
		end
		data.aura = data.aura - cost
	end

	local luck = Logic.luck(data, os.time())
	local results = {}
	for _ = 1, count do
		data.eggsOpened = data.eggsOpened + 1
		data.pity = data.pity + 1
		local id = roll(egg, luck, data.pity >= Config.PITY)
		local def = Logic.petById[id]
		local rarity = Config.Rarities[def.rarity]
		if rarity.order >= 5 then
			data.pity = 0
			PetService.announce(player.DisplayName .. " hat ein " .. rarity.name .. "es Pet gezogen: " .. def.emoji .. " " .. def.name .. "!")
		end
		local pet, isNew = addPet(data, id, 1)
		table.insert(results, { id = id, uid = pet.uid, new = isNew })
	end
	Remotes.HatchResult:FireClient(player, results)
	changed(player)
end

-- Ein bestimmtes Pet schenken (z. B. Leons Goldfisch)
function PetService.givePet(player, id)
	local data = DataService.get(player)
	if not data or not Logic.petById[id] then return end
	local pet, isNew = addPet(data, id, 1)
	Remotes.HatchResult:FireClient(player, { { id = id, uid = pet.uid, new = isNew } })
	changed(player)
end

----------------------------------------------------------------------------
-- Remotes
----------------------------------------------------------------------------
Remotes.HatchEgg.OnServerEvent:Connect(function(player, eggIndex, count)
	PetService.hatch(player, tonumber(eggIndex), tonumber(count), false)
end)

Remotes.EquipPet.OnServerEvent:Connect(function(player, uid, equip)
	local data = DataService.get(player)
	if not data then return end
	local pet = findPet(data, uid)
	if not pet then return end
	if equip and not pet.eq then
		if Logic.equippedCount(data) >= Logic.petSlots(data) then
			GameService.notify(player, "🐾 Alle Plätze voll", "Lege zuerst ein anderes Pet ab (Plätze: " .. Logic.petSlots(data) .. ").", "bad")
			return
		end
		pet.eq = true
	elseif not equip then
		pet.eq = false
	end
	changed(player)
end)

Remotes.EquipBest.OnServerEvent:Connect(function(player)
	local data = DataService.get(player)
	if not data then return end
	equipBest(data)
	changed(player)
end)

Remotes.FusePet.OnServerEvent:Connect(function(player, uid)
	local data = DataService.get(player)
	if not data then return end
	local pet = findPet(data, uid)
	if not pet then return end
	if pet.tier >= #Config.PetTiers then
		GameService.notify(player, "💎 Maximum", "Dieses Pet ist schon Diamant.", "")
		return
	end
	-- 5 gleiche Pets (gleiche Art & Stufe) sammeln, das gewählte zuerst
	local group = { pet }
	for _, other in ipairs(data.pets) do
		if #group >= Config.FUSE_COUNT then break end
		if other ~= pet and other.id == pet.id and other.tier == pet.tier and not other.eq then
			table.insert(group, other)
		end
	end
	for _, other in ipairs(data.pets) do
		if #group >= Config.FUSE_COUNT then break end
		if other ~= pet and other.id == pet.id and other.tier == pet.tier and other.eq then
			local already = false
			for _, g in ipairs(group) do
				if g == other then already = true end
			end
			if not already then table.insert(group, other) end
		end
	end
	if #group < Config.FUSE_COUNT then
		GameService.notify(player, "🔮 Zu wenige", "Du brauchst " .. Config.FUSE_COUNT .. " gleiche Pets derselben Stufe.", "bad")
		return
	end
	local wasEquipped = false
	for _, g in ipairs(group) do
		if g.eq then wasEquipped = true end
		local _, i = findPet(data, g.uid)
		if i then table.remove(data.pets, i) end
	end
	local newTier = pet.tier + 1
	local newPet = { uid = data.nextPetId, id = pet.id, tier = newTier, eq = wasEquipped }
	data.nextPetId = data.nextPetId + 1
	table.insert(data.pets, newPet)
	local def = Logic.petById[pet.id]
	GameService.notify(player, "🔮 Fusioniert!", def.emoji .. " " .. def.name .. " ist jetzt " .. Config.PetTiers[newTier].name .. "!", "good")
	changed(player)
end)

Remotes.DeletePet.OnServerEvent:Connect(function(player, uid)
	local data = DataService.get(player)
	if not data then return end
	local _, i = findPet(data, uid)
	if i then
		table.remove(data.pets, i)
		changed(player)
	end
end)

-- Pets erscheinen, wenn der Charakter erscheint
table.insert(GameService.characterHooks, function(player)
	task.wait(1)
	PetService.rebuildModels(player)
end)

Players.PlayerRemoving:Connect(function(player)
	local f = petsFolder():FindFirstChild(tostring(player.UserId))
	if f then f:Destroy() end
end)

return PetService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000015"><Properties><string name="Name">QuestService</string><ProtectedString name="Source"><![CDATA[--[[
	QUESTSERVICE – tägliche Aufträge (3 pro Tag) und Erfolge (je 4 Stufen).

	Aufträge: Beim ersten Login des Tages werden 3 zufällige Aufträge gewählt.
	Der Fortschritt = Zählerstand jetzt – Zählerstand beim Erstellen.
	Erfolge: zählen über die ganze Spielzeit.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local RewardService = require(script.Parent.RewardService)

local QuestService = {}

local function today()
	return math.floor(os.time() / 86400)
end

-- Neue Aufträge erstellen, wenn ein neuer Tag angefangen hat
function QuestService.ensureQuests(player, data)
	local day = today()
	if data.quests.day == day and #data.quests.list > 0 then
		return
	end
	local rng = Random.new(day * 1000 + (player.UserId % 1000))
	local pool = {}
	for _, q in ipairs(Config.QuestPool) do
		table.insert(pool, q)
	end
	local list = {}
	for _ = 1, math.min(Config.QUESTS_PER_DAY, #pool) do
		local q = table.remove(pool, rng:NextInteger(1, #pool))
		table.insert(list, { id = q.id, stat = q.stat, goal = q.goal, text = string.format(q.text, q.goal),
			start = Logic.statValue(data, q.stat), claimed = false })
	end
	data.quests = { day = day, list = list, bonus = false }
end

Remotes.ClaimQuest.OnServerEvent:Connect(function(player, index)
	local data = DataService.get(player)
	if not data then return end
	QuestService.ensureQuests(player, data)
	local q = data.quests.list[tonumber(index) or 0]
	if not q or q.claimed then return end
	if Logic.questProgress(data, q) < q.goal then
		GameService.notify(player, "📋 Noch nicht geschafft", q.text, "bad")
		return
	end
	q.claimed = true
	local text = RewardService.give(player, data, Config.QuestReward)
	GameService.notify(player, "📋 Auftrag erledigt!", text, "good")
	GameService.sendFull(player)
end)

Remotes.ClaimQuestBonus.OnServerEvent:Connect(function(player)
	local data = DataService.get(player)
	if not data or data.quests.bonus then return end
	for _, q in ipairs(data.quests.list) do
		if not q.claimed then
			GameService.notify(player, "📋 Noch nicht", "Erledige zuerst alle Aufträge von heute.", "bad")
			return
		end
	end
	data.quests.bonus = true
	local text = RewardService.give(player, data, Config.QuestBonus)
	GameService.notify(player, "🏆 Alle Aufträge geschafft!", text, "title")
	GameService.sendFull(player)
end)

Remotes.ClaimAchievement.OnServerEvent:Connect(function(player, id)
	local data = DataService.get(player)
	if not data then return end
	local ach
	for _, a in ipairs(Config.Achievements) do
		if a.id == id then ach = a end
	end
	if not ach then return end
	local claimed = data.achievements[id] or 0
	local nextTier = claimed + 1
	local goal = ach.tiers[nextTier]
	if not goal then return end
	if Logic.statValue(data, ach.stat) < goal then
		GameService.notify(player, "🏅 Noch nicht", ach.name .. ": " .. goal .. " " .. ach.text .. " nötig.", "bad")
		return
	end
	data.achievements[id] = nextTier
	local text = RewardService.give(player, data, Logic.achievementReward(nextTier))
	GameService.notify(player, "🏅 Erfolg: " .. ach.name .. " " .. string.rep("⭐", nextTier), text, "title")
	GameService.sendFull(player)
end)

-- Beim Betreten Aufträge prüfen; zusätzlich jede Minute (falls Mitternacht vorbei ist)
table.insert(GameService.joinHooks, function(player, data)
	QuestService.ensureQuests(player, data)
end)
task.spawn(function()
	while true do
		task.wait(60)
		for player, data in pairs(DataService.all()) do
			if data.quests.day ~= today() then
				QuestService.ensureQuests(player, data)
				GameService.notify(player, "📋 Neue Aufträge!", "Ein neuer Tag – 3 neue Aufträge warten auf dich.", "good")
				GameService.sendFull(player)
			end
		end
	end
end)

return QuestService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000016"><Properties><string name="Name">Remotes</string><ProtectedString name="Source"><![CDATA[--[[
	REMOTES – die "Leitungen" zwischen Server und Spieler.
	Der Server erstellt sie beim Start in ReplicatedStorage/Remotes.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = {}

local EVENTS = {
	-- Server -> Spieler
	"Data",           -- Spielstand senden ("full" oder "light")
	"Notify",         -- Nachricht anzeigen (titel, text, art)
	"HatchResult",    -- Ergebnis beim Box-Öffnen
	"BattleResult",   -- Ergebnis eines Mog Battles
	"BattleRequest",  -- jemand fordert dich heraus
	"OpenMenu",       -- Menü öffnen (z. B. Welten am Portal)
	"FanDialog",      -- Fan-Gespräch öffnen
	"FanResult",      -- Ergebnis des Fan-Gesprächs
	"DamagePopup",    -- Schadenszahl im Bosskampf
	"TradeRequest",   -- jemand will mit dir handeln
	"TradeUpdate",    -- aktueller Stand des Handels
	"TradeClosed",    -- Handel beendet
	"WheelResult",    -- Ergebnis des Glücksrads
	"GymStart",       -- Gym-Minispiel starten
	-- Spieler -> Server
	"Click", "BuyUpgrade", "Rebirth", "BuyPerk",
	"EquipPet", "EquipBest", "FusePet", "DeletePet", "HatchEgg",
	"Teleport", "UnlockWorld",
	"BattleRespond",
	"ClaimDaily", "RedeemCode", "BuyPotion", "Setting",
	"ClaimQuest", "ClaimQuestBonus", "ClaimAchievement",
	"StartJob", "FinishJob",
	"FanChoice",
	"BuyWeapon", "UpgradeWeapon", "EquipWeapon",
	"TradeRespond", "TradeOffer", "TradeReady", "TradeConfirm", "TradeCancel",
	"SpinWheel", "ClaimPlaytime",
	"BuyItem", "EquipItem", "ToggleRide",
	"GymFinish",
}

-- Erst alle Leitungen anlegen, dann den Ordner sichtbar machen
local folder = Instance.new("Folder")
folder.Name = "Remotes"

for _, name in ipairs(EVENTS) do
	local ev = Instance.new("RemoteEvent")
	ev.Name = name
	ev.Parent = folder
	Remotes[name] = ev
end

local lb = Instance.new("RemoteFunction")
lb.Name = "GetLeaderboard"
lb.Parent = folder
Remotes.GetLeaderboard = lb

folder.Parent = ReplicatedStorage

return Remotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000017"><Properties><string name="Name">RewardService</string><ProtectedString name="Source"><![CDATA[--[[
	REWARDSERVICE – tägliche Belohnungen (7-Tage-Serie), Promo-Codes und Tränke.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local PetService = require(script.Parent.PetService)

local RewardService = {}
local DAY = 20 * 3600         -- nach 20 Stunden gibt es die nächste Belohnung
local STREAK_RESET = 48 * 3600

local function addPotion(data, id)
	local p = Logic.potionById[id]
	if not p then return end
	local now = os.time()
	data.potions[id] = math.max(now, data.potions[id] or 0) + p.duration
end

-- Belohnung gutschreiben, gibt einen Beschreibungstext zurück
local function give(player, data, reward)
	local parts = {}
	if reward.cash then
		-- scale = mit Lohn-Bonus (Glow & Rebirths) verrechnen, damit es auch später noch lohnt
		local cash = math.floor(reward.cash * (reward.scale and Logic.jobPayMult(data) or 1))
		data.cash = data.cash + cash
		table.insert(parts, "💵 " .. Util.format(cash) .. " Geld")
	end
	if reward.gems then
		data.gems = data.gems + reward.gems
		table.insert(parts, "💎 " .. Util.format(reward.gems) .. " Gems")
	end
	if reward.spins then
		data.wheel.spins = data.wheel.spins + reward.spins
		table.insert(parts, "🎡 " .. reward.spins .. "x Glücksrad")
	end
	if reward.auraSeconds then
		local aps = math.max(Logic.aps(data, GameService.currentWorld(player), os.time()), 5)
		local gain = aps * reward.auraSeconds
		GameService.addAura(data, gain)
		table.insert(parts, "✨ " .. Util.format(gain) .. " Aura")
	end
	if reward.potion then
		addPotion(data, reward.potion)
		local p = Logic.potionById[reward.potion]
		table.insert(parts, p.emoji .. " " .. p.name)
	end
	if reward.freeEgg then
		-- Box der besten freigeschalteten Welt
		local best = 1
		for i = 1, #Config.Worlds do
			if Logic.worldUnlocked(data, i) then best = i end
		end
		local station = (type(reward.freeEgg) == "number") and reward.freeEgg or 2   -- Standard: Silber-Box
		task.delay(1, function()
			if player.Parent then PetService.hatch(player, Config.eggIndex(best, station), 1, true) end
		end)
		table.insert(parts, Config.EggStations[station].emoji .. " gratis " .. Config.EggStations[station].name)
	end
	return table.concat(parts, " · ")
end
RewardService.give = give
RewardService.addPotion = addPotion

Remotes.ClaimDaily.OnServerEvent:Connect(function(player)
	local data = DataService.get(player)
	if not data then return end
	local now = os.time()
	local since = now - data.daily.last
	if since < DAY then
		GameService.notify(player, "⏳ Noch nicht", "Nächste Belohnung in " .. Util.formatTime(DAY - since) .. ".", "")
		return
	end
	if since > STREAK_RESET then
		data.daily.streak = 0
	end
	data.daily.streak = (data.daily.streak % #Config.Daily) + 1
	data.daily.last = now
	local text = give(player, data, Config.Daily[data.daily.streak])
	GameService.notify(player, "📅 Tag " .. data.daily.streak .. " von 7!", text, "good")
	GameService.sendFull(player)
end)

Remotes.RedeemCode.OnServerEvent:Connect(function(player, code)
	local data = DataService.get(player)
	if not data or type(code) ~= "string" then return end
	code = string.upper((string.gsub(code, "%s", "")))
	local reward = Config.Codes[code]
	if not reward then
		GameService.notify(player, "❌ Ungültiger Code", "Diesen Code gibt es nicht (mehr).", "bad")
		return
	end
	if data.codes[code] then
		GameService.notify(player, "✅ Schon eingelöst", "Diesen Code hast du bereits benutzt.", "")
		return
	end
	data.codes[code] = true
	local text = give(player, data, reward)
	GameService.notify(player, "🎟️ " .. reward.text, text, "good")
	GameService.sendFull(player)
end)

Remotes.BuyPotion.OnServerEvent:Connect(function(player, id, withGems)
	local data = DataService.get(player)
	local p = Logic.potionById[id]
	if not data or not p or p.hidden then return end
	if withGems and p.gems then
		if data.gems < p.gems then
			GameService.notify(player, "💎 Zu wenig Gems", p.name .. " kostet " .. p.gems .. " Gems.", "bad")
			return
		end
		data.gems = data.gems - p.gems
		addPotion(data, id)
		GameService.notify(player, p.emoji .. " " .. p.name, p.desc, "good")
		GameService.sendFull(player)
		return
	end
	if data.cash < p.price then
		GameService.notify(player, "💸 Zu wenig Geld", p.name .. " kostet " .. Util.format(p.price) .. " Geld.", "bad")
		return
	end
	data.cash = data.cash - p.price
	addPotion(data, id)
	GameService.notify(player, p.emoji .. " " .. p.name, p.desc, "good")
	GameService.sendFull(player)
end)

----------------------------------------------------------------------------
-- 🎡 GLÜCKSRAD
----------------------------------------------------------------------------
Remotes.SpinWheel.OnServerEvent:Connect(function(player)
	local data = DataService.get(player)
	if not data then return end
	local now = os.time()
	if data.wheel.spins > 0 then
		data.wheel.spins = data.wheel.spins - 1
	elseif now - data.wheel.last >= Config.WHEEL_COOLDOWN then
		data.wheel.last = now
	else
		GameService.notify(player, "🎡 Noch nicht", "Nächste Gratis-Drehung in " .. Util.formatTime(Config.WHEEL_COOLDOWN - (now - data.wheel.last)) .. ".", "")
		return
	end
	local total = 0
	for _, seg in ipairs(Config.Wheel) do total = total + seg.weight end
	local x = Random.new():NextNumber() * total
	local index = #Config.Wheel
	for i, seg in ipairs(Config.Wheel) do
		x = x - seg.weight
		if x <= 0 then index = i break end
	end
	local seg = Config.Wheel[index]
	-- Gewinn sofort gutschreiben (geht auch beim Verlassen nicht verloren), Anzeige erst nach der Dreh-Animation
	local text = give(player, data, seg.reward)
	Remotes.WheelResult:FireClient(player, index)
	task.delay(4, function()
		if not player.Parent then return end
		GameService.notify(player, "🎡 Gewonnen: " .. seg.label, text, "good")
		GameService.sendFull(player)
	end)
end)

----------------------------------------------------------------------------
-- 🎁 SPIELZEIT-GESCHENKE (pro Spielsitzung)
----------------------------------------------------------------------------
-- Spielzeit zählt pro Tag (UTC) und wird gespeichert: Neu-Beitreten setzt die Geschenke NICHT zurück.
local lastTick = {}   -- [player] = os.time() der letzten Zählung
local function today() return os.date("!%Y-%m-%d") end

local function syncPlaytime(player, data)
	local pt = data.playtime
	local now = os.time()
	if pt.day ~= today() then
		pt.day = today()
		pt.seconds = 0
		pt.claimed = {}
	end
	pt.seconds = pt.seconds + math.max(0, now - (lastTick[player] or now))
	lastTick[player] = now
	-- Anzeige im Glücksrad-Menü: "JoinTime" so setzen, dass jetzt - JoinTime = heutige Spielzeit
	player:SetAttribute("JoinTime", now - pt.seconds)
	for gi = 1, #Config.PlaytimeGifts do
		player:SetAttribute("Gift" .. gi, pt.claimed[tostring(gi)] == true or nil)
	end
end

table.insert(GameService.joinHooks, function(player, data)
	lastTick[player] = os.time()
	syncPlaytime(player, data)
end)
task.spawn(function()
	while true do
		task.wait(30)
		for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
			local data = DataService.get(player)
			if data and lastTick[player] then syncPlaytime(player, data) end
		end
	end
end)
Remotes.ClaimPlaytime.OnServerEvent:Connect(function(player, i)
	local data = DataService.get(player)
	local idx = tonumber(i)
	local gift = idx and Config.PlaytimeGifts[idx]
	if not data or not gift or not lastTick[player] then return end
	syncPlaytime(player, data)
	local key = tostring(idx)
	if data.playtime.claimed[key] then return end
	if data.playtime.seconds < gift.minutes * 60 then
		GameService.notify(player, "⏳ Noch nicht", "Dieses Geschenk gibt es nach " .. gift.minutes .. " Minuten Spielzeit (heute).", "")
		return
	end
	data.playtime.claimed[key] = true
	player:SetAttribute("Gift" .. key, true)
	local text = give(player, data, gift.reward)
	GameService.notify(player, "🎁 Spielzeit-Geschenk!", text, "good")
	GameService.sendFull(player)
end)
game:GetService("Players").PlayerRemoving:Connect(function(player)
	local data = DataService.get(player)
	if data and lastTick[player] then syncPlaytime(player, data) end
	lastTick[player] = nil
end)


return RewardService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000018"><Properties><string name="Name">ShopService</string><ProtectedString name="Source"><![CDATA[--[[
	SHOPSERVICE – Ausrüstung & Fahrzeuge kaufen/ausrüsten (mit Geld oder Gems),
	Fahrzeug aufsteigen/absteigen.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)

local ShopService = {}
local KINDS = { aura = true, trail = true, hat = true, emote = true, vehicle = true }

local function pay(player, data, def)
	if def.currency == "gems" then
		if data.gems < def.price then
			GameService.notify(player, "💎 Zu wenig Gems", def.name .. " kostet " .. Util.format(def.price) .. " Gems. Gems gibt's im 💎 Shop, am Glücksrad & bei Events.", "bad")
			return false
		end
		data.gems = data.gems - def.price
	else
		if data.cash < def.price then
			GameService.notify(player, "💸 Zu wenig Geld", def.name .. " kostet " .. Util.format(def.price) .. " Geld. Tipp: 💼 Jobs & Bosse!", "bad")
			return false
		end
		data.cash = data.cash - def.price
	end
	return true
end

Remotes.BuyItem.OnServerEvent:Connect(function(player, kind, id)
	local data = DataService.get(player)
	if not data or not KINDS[kind] then return end
	local def = Logic.itemDef(kind, id)
	if not def or Logic.ownsItem(data, kind, id) then return end
	if not pay(player, data, def) then return end
	if kind == "vehicle" then
		data.vehicles[id] = true
		data.vehicle = id
	else
		data.cosmetics.owned[id] = true
		if kind ~= "emote" then data.cosmetics[kind] = id end
	end
	GameService.notify(player, def.emoji .. " " .. def.name .. " gekauft!", kind == "vehicle" and "Drücke V (oder den Knopf) zum Aufsteigen." or "Ausgerüstet!", "good")
	GameService.refreshCharacter(player)
	GameService.sendFull(player)
end)

Remotes.EquipItem.OnServerEvent:Connect(function(player, kind, id)
	local data = DataService.get(player)
	if not data or not KINDS[kind] or kind == "emote" then return end
	id = tostring(id or "")
	if id ~= "" and not Logic.ownsItem(data, kind, id) then return end
	if kind == "vehicle" then
		data.vehicle = id
		if id == "" then player:SetAttribute("Riding", false) end
	else
		-- gleiches Teil nochmal = ablegen
		if data.cosmetics[kind] == id then id = "" end
		data.cosmetics[kind] = id
	end
	GameService.refreshCharacter(player)
	GameService.sendFull(player)
end)

Remotes.ToggleRide.OnServerEvent:Connect(function(player)
	local data = DataService.get(player)
	if not data then return end
	if (data.vehicle or "") == "" or not Logic.ownsItem(data, "vehicle", data.vehicle) then
		GameService.notify(player, "🛹 Kein Fahrzeug", "Kaufe eins im Menü ✨ Ausrüstung → Fahrzeuge.", "")
		return
	end
	player:SetAttribute("Riding", not player:GetAttribute("Riding"))
	GameService.refreshCharacter(player)
end)

-- Nach dem Respawn nicht mehr fahren
table.insert(GameService.characterHooks, function(player)
	player:SetAttribute("Riding", false)
end)

return ShopService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000019"><Properties><string name="Name">StyleLook</string><ProtectedString name="Source"><![CDATA[--[[
	STYLELOOK – zeigt die Ausrüstung am Avatar:
	Aura (Glitzer, Feuer, Rauch, Regenbogen), Spur beim Laufen, Hut, Fahrzeug unter den Füßen.
	Wird bei jeder Änderung neu gebaut (GameService.refreshCharacter).
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Logic = require(Shared:WaitForChild("Logic"))

local StyleLook = {}

local GOLD = Color3.fromRGB(255, 205, 60)
local BLACK = Color3.fromRGB(25, 25, 30)

local function weldPart(folder, base, size, offset, color, opts)
	opts = opts or {}
	local p = Instance.new(opts.class or "Part")
	p.Name = opts.name or "Style"
	p.Size = size
	p.Color = color
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.Transparency = opts.transparency or 0
	p.Reflectance = opts.reflectance or 0
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	if opts.shape == "ball" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif opts.shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	p.CFrame = base.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	p.Parent = folder
	return p
end

----------------------------------------------------------------------------
-- Hüte
----------------------------------------------------------------------------
local HATS = {}
local function top(head) return head.Size.Y / 2 end

HATS.cap = function(f, head)
	weldPart(f, head, Vector3.new(head.Size.X * 1.05, head.Size.Y * 0.45, head.Size.Z * 1.05), CFrame.new(0, top(head) * 0.75, 0), Color3.fromRGB(230, 50, 60), { shape = "ball" })
	weldPart(f, head, Vector3.new(head.Size.X * 0.9, 0.08, head.Size.Z * 0.6), CFrame.new(0, top(head) * 0.65, -head.Size.Z * 0.6), Color3.fromRGB(230, 50, 60))
end
HATS.headphones = function(f, head)
	for i = 0, 8 do
		local a = math.rad(-90 + i * 22.5)
		weldPart(f, head, Vector3.new(0.18, 0.18, 0.18), CFrame.new(math.sin(a) * head.Size.X * 0.62, math.cos(a) * top(head) * 1.15, 0), BLACK, { shape = "ball" })
	end
	for _, s in ipairs({ -1, 1 }) do
		weldPart(f, head, Vector3.new(0.25, 0.6, 0.6), CFrame.new(s * head.Size.X * 0.6, 0, 0), Color3.fromRGB(255, 79, 216), { shape = "cyl", material = Enum.Material.Neon })
	end
end
HATS.cowboy = function(f, head)
	weldPart(f, head, Vector3.new(0.12, head.Size.X * 2, head.Size.Z * 2), CFrame.new(0, top(head) * 0.9, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(140, 90, 50), { shape = "cyl" })
	weldPart(f, head, Vector3.new(head.Size.X * 0.85, head.Size.Y * 0.55, head.Size.Z * 0.85), CFrame.new(0, top(head) * 1.25, 0), Color3.fromRGB(140, 90, 50))
	weldPart(f, head, Vector3.new(head.Size.X * 0.87, 0.12, head.Size.Z * 0.87), CFrame.new(0, top(head) * 1.0, 0), BLACK)
end
HATS.halo = function(f, head)
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		weldPart(f, head, Vector3.new(0.16, 0.16, 0.16), CFrame.new(math.cos(a) * head.Size.X * 0.45, top(head) + 0.7, math.sin(a) * head.Size.Z * 0.45), GOLD,
			{ shape = "ball", material = Enum.Material.Neon })
	end
end
local function crown(f, head, color, material, gem)
	weldPart(f, head, Vector3.new(0.35, head.Size.X * 0.95, head.Size.Z * 0.95), CFrame.new(0, top(head) + 0.1, 0) * CFrame.Angles(0, 0, math.rad(90)), color,
		{ shape = "cyl", material = material, reflectance = 0.3 })
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		weldPart(f, head, Vector3.new(0.18, 0.45, 0.18), CFrame.new(math.cos(a) * head.Size.X * 0.42, top(head) + 0.45, math.sin(a) * head.Size.Z * 0.42), color,
			{ material = material, reflectance = 0.3 })
		weldPart(f, head, Vector3.new(0.14, 0.14, 0.14), CFrame.new(math.cos(a) * head.Size.X * 0.42, top(head) + 0.72, math.sin(a) * head.Size.Z * 0.42), gem,
			{ shape = "ball", material = Enum.Material.Neon })
	end
end
HATS.crown = function(f, head) crown(f, head, GOLD, Enum.Material.Foil, Color3.fromRGB(255, 60, 90)) end
HATS.diamond = function(f, head) crown(f, head, Color3.fromRGB(170, 240, 255), Enum.Material.Glass, Color3.fromRGB(255, 255, 255)) end
HATS.viking = function(f, head)
	weldPart(f, head, Vector3.new(head.Size.X * 1.08, head.Size.Y * 0.7, head.Size.Z * 1.08), CFrame.new(0, top(head) * 0.55, 0), Color3.fromRGB(150, 150, 160),
		{ shape = "ball", material = Enum.Material.Metal })
	for _, s in ipairs({ -1, 1 }) do
		weldPart(f, head, Vector3.new(0.22, 0.8, 0.22), CFrame.new(s * head.Size.X * 0.6, top(head) * 0.9, 0) * CFrame.Angles(0, 0, math.rad(-s * 35)), Color3.fromRGB(245, 240, 225),
			{ shape = "ball" })
	end
end

----------------------------------------------------------------------------
-- Fahrzeuge (unter den Füßen festgeschweißt)
----------------------------------------------------------------------------
local VEHICLES = {}
local function wheels(f, hrp, y, xs, zs, size)
	for _, x in ipairs(xs) do
		for _, z in ipairs(zs) do
			weldPart(f, hrp, Vector3.new(size * 0.6, size, size), CFrame.new(x, y, z), BLACK, { shape = "cyl" })
		end
	end
end
VEHICLES.board = function(f, hrp, def, foot)
	weldPart(f, hrp, Vector3.new(1.4, 0.15, 4), CFrame.new(0, foot + 0.35, 0), Color3.fromRGB(230, 70, 90), { shape = "ball" })
	wheels(f, hrp, foot + 0.12, { -0.5, 0.5 }, { -1.3, 1.3 }, 0.35)
end
VEHICLES.scooter = function(f, hrp, def, foot)
	weldPart(f, hrp, Vector3.new(1.2, 0.2, 3.6), CFrame.new(0, foot + 0.35, 0), Color3.fromRGB(60, 160, 230))
	weldPart(f, hrp, Vector3.new(0.2, 3.2, 0.2), CFrame.new(0, foot + 1.9, -1.6), Color3.fromRGB(80, 80, 90), { material = Enum.Material.Metal })
	weldPart(f, hrp, Vector3.new(1.8, 0.2, 0.2), CFrame.new(0, foot + 3.5, -1.6), BLACK)
	wheels(f, hrp, foot + 0.2, { 0 }, { -1.6, 1.6 }, 0.5)
end
VEHICLES.car = function(f, hrp, def, foot)
	local color = def.gold and GOLD or Color3.fromRGB(230, 40, 50)
	local mat = def.gold and Enum.Material.Foil or Enum.Material.SmoothPlastic
	weldPart(f, hrp, Vector3.new(4.4, 1.4, 8), CFrame.new(0, foot + 1.3, 0), color, { material = mat, reflectance = 0.25 })
	weldPart(f, hrp, Vector3.new(4.2, 0.9, 2.5), CFrame.new(0, foot + 2.3, -1.8), Color3.fromRGB(150, 210, 240), { material = Enum.Material.Glass, transparency = 0.4 })
	weldPart(f, hrp, Vector3.new(4.5, 0.4, 1.4), CFrame.new(0, foot + 2.1, 3.6), BLACK)   -- Spoiler
	wheels(f, hrp, foot + 0.7, { -2.2, 2.2 }, { -2.6, 2.6 }, 1.4)
	for _, s in ipairs({ -1.4, 1.4 }) do
		weldPart(f, hrp, Vector3.new(0.8, 0.4, 0.15), CFrame.new(s, foot + 1.4, -4.05), Color3.fromRGB(255, 250, 200), { material = Enum.Material.Neon })
	end
end
VEHICLES.hover = function(f, hrp, def, foot)
	weldPart(f, hrp, Vector3.new(0.25, 4.2, 4.2), CFrame.new(0, foot + 0.3, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(62, 242, 255), { shape = "cyl", material = Enum.Material.Neon, transparency = 0.2 })
	local glow = weldPart(f, hrp, Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, foot, 0), Color3.new(1, 1, 1), { transparency = 1 })
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(62, 242, 255))
	e.Rate = 25
	e.Speed = NumberRange.new(2, 4)
	e.Lifetime = NumberRange.new(0.3, 0.6)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	e.Parent = glow
end

----------------------------------------------------------------------------
-- Aura & Spur
----------------------------------------------------------------------------
local function auraEffect(f, hrp, def)
	local holder = weldPart(f, hrp, Vector3.new(2, 4, 1), CFrame.new(0, 0, 0), Color3.new(1, 1, 1), { transparency = 1, name = "Aura" })
	if def.style == "fire" then
		local fire = Instance.new("Fire")
		fire.Color = def.color
		fire.SecondaryColor = Color3.fromRGB(255, 220, 80)
		fire.Size = 6
		fire.Heat = 6
		fire.Parent = holder
	elseif def.style == "smoke" then
		local smoke = Instance.new("Smoke")
		smoke.Color = def.color
		smoke.Size = 4
		smoke.RiseVelocity = 2
		smoke.Opacity = 0.25
		smoke.Parent = holder
	end
	local e = Instance.new("ParticleEmitter")
	if def.style == "rainbow" then
		e.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)), ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.5, Color3.fromRGB(60, 255, 120)), ColorSequenceKeypoint.new(0.75, Color3.fromRGB(60, 160, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 80, 255)),
		})
	else
		e.Color = ColorSequence.new(def.color)
	end
	e.Rate = def.strong and 30 or 15
	e.Lifetime = NumberRange.new(0.8, 1.5)
	e.Speed = NumberRange.new(1, 3)
	e.SpreadAngle = Vector2.new(180, 180)
	e.LightEmission = 1
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, def.strong and 0.6 or 0.4), NumberSequenceKeypoint.new(1, 0) })
	e.Parent = holder
end

local function trailEffect(f, hrp, def)
	local a0 = Instance.new("Attachment")
	a0.Name = "TrailTop"
	a0.Position = Vector3.new(0, 0.8, 0.4)
	a0.Parent = hrp
	local a1 = Instance.new("Attachment")
	a1.Name = "TrailBottom"
	a1.Position = Vector3.new(0, -1.6, 0.4)
	a1.Parent = hrp
	local tr = Instance.new("Trail")
	tr.Attachment0 = a0
	tr.Attachment1 = a1
	tr.Lifetime = 0.7
	tr.LightEmission = 0.8
	tr.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	if def.rainbow then
		tr.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 60, 60)), ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 220, 60)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(60, 200, 255)), ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 80, 255)),
		})
	else
		tr.Color = ColorSequence.new(def.c1, def.c2)
	end
	tr.Parent = f
	-- Attachments mit aufräumen, wenn der Ordner gelöscht wird
	f.Destroying:Connect(function()
		a0:Destroy()
		a1:Destroy()
	end)
end

----------------------------------------------------------------------------
-- Anwenden
----------------------------------------------------------------------------
function StyleLook.apply(player, char, data, riding)
	local head = char:FindFirstChild("Head")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not head or not hrp or not hum then return end
	local old = char:FindFirstChild("StyleLook")
	if old then old:Destroy() end
	local f = Instance.new("Folder")
	f.Name = "StyleLook"
	f.Parent = char

	local cos = data.cosmetics or {}
	local hat = Logic.hatById[cos.hat or ""]
	if hat and HATS[hat.id] then HATS[hat.id](f, head) end
	local aura = Logic.auraById[cos.aura or ""]
	if aura then auraEffect(f, hrp, aura) end
	local trail = Logic.trailById[cos.trail or ""]
	if trail then trailEffect(f, hrp, trail) end
	if riding then
		local v = Logic.vehicleById[data.vehicle or ""]
		if v and VEHICLES[v.plan] then
			local foot = -(hrp.Size.Y / 2 + hum.HipHeight)
			VEHICLES[v.plan](f, hrp, v, foot)
		end
	end
end

return StyleLook
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001A"><Properties><string name="Name">TradeService</string><ProtectedString name="Source"><![CDATA[--[[
	TRADESERVICE – Pets & Geld zwischen Spielern tauschen.

	Sicherheit gegen Betrug:
	  1) Handel startet nur, wenn beide zustimmen
	  2) Beide müssen "Bereit" drücken, danach beide "Bestätigen"
	  3) Jede Änderung am Angebot setzt Bereit & Bestätigen zurück
	  4) Der Server prüft vor dem Tausch alles noch einmal (Besitz, Geld, Platz)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local PetService = require(script.Parent.PetService)

local TradeService = {}
local requests = {}   -- [Ziel] = { from, t }
local active = {}     -- [Spieler] = trade
local lastRequest = {}

local function findPet(data, uid)
	for i, pet in ipairs(data.pets) do
		if pet.uid == uid then return pet, i end
	end
	return nil
end

local function otherOf(trade, player)
	return trade.a == player and trade.b or trade.a
end

local function offerInfo(trade, owner)
	local data = DataService.get(owner)
	local o = trade.offer[owner]
	local pets = {}
	if data then
		for _, uid in ipairs(o.pets) do
			local pet = findPet(data, uid)
			if pet then table.insert(pets, { uid = pet.uid, id = pet.id, tier = pet.tier }) end
		end
	end
	return { pets = pets, cash = o.cash }
end

local function send(trade)
	for _, viewer in ipairs({ trade.a, trade.b }) do
		local other = otherOf(trade, viewer)
		Remotes.TradeUpdate:FireClient(viewer, {
			otherName = other.DisplayName,
			mine = offerInfo(trade, viewer), theirs = offerInfo(trade, other),
			myReady = trade.ready[viewer] == true, theirReady = trade.ready[other] == true,
			myConfirm = trade.confirmed[viewer] == true, theirConfirm = trade.confirmed[other] == true,
		})
	end
end

local function close(trade, reason)
	for _, p in ipairs({ trade.a, trade.b }) do
		if active[p] == trade then active[p] = nil end
		if p.Parent then Remotes.TradeClosed:FireClient(p, reason) end
	end
end

local function resetAgreement(trade)
	trade.ready = {}
	trade.confirmed = {}
end

----------------------------------------------------------------------------
-- Anfrage
----------------------------------------------------------------------------
function TradeService.request(from, target)
	if from == target or active[from] or active[target] then
		GameService.notify(from, "🤝 Geht gerade nicht", "Einer von euch handelt schon.", "bad")
		return
	end
	local last = lastRequest[from]
	if last and os.clock() - last < Config.TRADE_COOLDOWN then
		GameService.notify(from, "⏳ Kurz warten", "Du kannst gleich wieder eine Handelsanfrage schicken.", "")
		return
	end
	lastRequest[from] = os.clock()
	requests[target] = { from = from, t = os.clock() }
	Remotes.TradeRequest:FireClient(target, from.DisplayName, from.UserId)
	GameService.notify(from, "🤝 Anfrage gesendet", target.DisplayName .. " muss noch annehmen …", "")
end

Remotes.TradeRespond.OnServerEvent:Connect(function(target, accept, fromUserId)
	local req = requests[target]
	requests[target] = nil
	if not req or not req.from.Parent or req.from.UserId ~= fromUserId or os.clock() - req.t > 20 then return end
	local from = req.from
	if not accept then
		GameService.notify(from, "🙅 Abgelehnt", target.DisplayName .. " will gerade nicht handeln.", "")
		return
	end
	if active[from] or active[target] then return end
	local trade = { a = from, b = target, offer = {}, ready = {}, confirmed = {}, done = false }
	trade.offer[from] = { pets = {}, cash = 0 }
	trade.offer[target] = { pets = {}, cash = 0 }
	active[from] = trade
	active[target] = trade
	send(trade)
end)

----------------------------------------------------------------------------
-- Angebot ändern, Bereit, Bestätigen, Abbrechen
----------------------------------------------------------------------------
Remotes.TradeOffer.OnServerEvent:Connect(function(player, petUids, cash)
	local trade = active[player]
	local data = DataService.get(player)
	if not trade or not data or trade.done then return end
	local list, seen = {}, {}
	if type(petUids) == "table" then
		for _, uid in ipairs(petUids) do
			uid = tonumber(uid)
			if uid and not seen[uid] and findPet(data, uid) and #list < Config.TRADE_MAX_PETS then
				seen[uid] = true
				table.insert(list, uid)
			end
		end
	end
	cash = math.clamp(math.floor(tonumber(cash) or 0), 0, math.floor(data.cash))
	trade.offer[player] = { pets = list, cash = cash }
	resetAgreement(trade)   -- jede Änderung: alle müssen neu zustimmen
	send(trade)
end)

Remotes.TradeReady.OnServerEvent:Connect(function(player, ready)
	local trade = active[player]
	if not trade or trade.done then return end
	trade.ready[player] = ready == true
	trade.confirmed = {}
	send(trade)
end)

local function execute(trade)
	local A, B = trade.a, trade.b
	local da, db = DataService.get(A), DataService.get(B)
	if not da or not db then close(trade, "Ein Spieler ist weg."); return end
	local oa, ob = trade.offer[A], trade.offer[B]
	-- alles noch einmal prüfen
	for _, pair in ipairs({ { da, oa }, { db, ob } }) do
		for _, uid in ipairs(pair[2].pets) do
			if not findPet(pair[1], uid) then close(trade, "Ein Pet ist nicht mehr da – Handel abgebrochen."); return end
		end
		if pair[1].cash < pair[2].cash then close(trade, "Nicht genug Geld – Handel abgebrochen."); return end
	end
	if #da.pets - #oa.pets + #ob.pets > Config.MAX_PET_INVENTORY or #db.pets - #ob.pets + #oa.pets > Config.MAX_PET_INVENTORY then
		close(trade, "Ein Inventar wäre zu voll (max. " .. Config.MAX_PET_INVENTORY .. " Pets).")
		return
	end
	trade.done = true
	local function move(fromData, toData, uids)
		for _, uid in ipairs(uids) do
			local pet, i = findPet(fromData, uid)
			table.remove(fromData.pets, i)
			table.insert(toData.pets, { uid = toData.nextPetId, id = pet.id, tier = pet.tier, eq = false })
			toData.nextPetId = toData.nextPetId + 1
			toData.index[pet.id] = true
		end
	end
	move(da, db, oa.pets)
	move(db, da, ob.pets)
	da.cash = da.cash - oa.cash + ob.cash
	db.cash = db.cash - ob.cash + oa.cash
	for _, p in ipairs({ A, B }) do
		GameService.track(p, "trades", 1)
		PetService.rebuildModels(p)
		GameService.sendFull(p)
		DataService.save(p)   -- Handel sofort speichern
	end
	GameService.notify(A, "🤝 Handel abgeschlossen!", "Mit " .. B.DisplayName .. ".", "good")
	GameService.notify(B, "🤝 Handel abgeschlossen!", "Mit " .. A.DisplayName .. ".", "good")
	close(trade, "done")
end

Remotes.TradeConfirm.OnServerEvent:Connect(function(player)
	local trade = active[player]
	if not trade or trade.done then return end
	local other = otherOf(trade, player)
	if not (trade.ready[player] and trade.ready[other]) then return end
	trade.confirmed[player] = true
	if trade.confirmed[other] then
		execute(trade)
	else
		send(trade)
	end
end)

Remotes.TradeCancel.OnServerEvent:Connect(function(player)
	local trade = active[player]
	if trade and not trade.done then
		close(trade, player.DisplayName .. " hat den Handel abgebrochen.")
	end
end)

----------------------------------------------------------------------------
-- "Handeln"-Knopf an jedem Spieler (Taste F)
----------------------------------------------------------------------------
local function addPrompt(player, char)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not hrp then return end
	local old = hrp:FindFirstChild("TradePrompt")
	if old then old:Destroy() end
	local pr = Instance.new("ProximityPrompt")
	pr.Name = "TradePrompt"
	pr.ActionText = "Handeln"
	pr.ObjectText = player.DisplayName
	pr.KeyboardKeyCode = Enum.KeyCode.F
	pr.HoldDuration = 0.5
	pr.MaxActivationDistance = 12
	pr.RequiresLineOfSight = false
	pr.UIOffset = Vector2.new(0, 70)
	pr.Parent = hrp
	pr.Triggered:Connect(function(from)
		if from ~= player then TradeService.request(from, player) end
	end)
end
table.insert(GameService.characterHooks, addPrompt)

Players.PlayerRemoving:Connect(function(player)
	local trade = active[player]
	if trade and not trade.done then
		close(trade, player.DisplayName .. " hat das Spiel verlassen.")
	end
	requests[player] = nil
	lastRequest[player] = nil
end)

return TradeService
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="StarterPlayer" referent="RBX0000002B"><Properties><string name="Name">StarterPlayer</string></Properties><Item class="StarterPlayerScripts" referent="RBX0000002A"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="LocalScript" referent="RBX00000029"><Properties><string name="Name">Client</string><ProtectedString name="Source"><![CDATA[--[[
	CLIENT – startet die Oberfläche auf dem Gerät des Spielers
	und empfängt alle Nachrichten vom Server.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Remotes = ReplicatedStorage:WaitForChild("Remotes")

local UI = require(script:WaitForChild("UI"))
local State = require(script:WaitForChild("State"))
local Sounds = require(script:WaitForChild("Sounds"))
local Effects = require(script:WaitForChild("Effects"))
local Menus = require(script:WaitForChild("Menus"))
local Hud = require(script:WaitForChild("Hud"))
local PetFollow = require(script:WaitForChild("PetFollow"))
local WorldFx = require(script:WaitForChild("WorldFx"))
local CameraController = require(script:WaitForChild("CameraController"))
local TradeUI = require(script:WaitForChild("TradeUI"))
local UserInputService = game:GetService("UserInputService")

-- Haupt-Oberfläche
local gui = UI.new("ScreenGui", {
	Name = "LooksmaxxerUI", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

Effects.init(gui)
Menus.init(gui)
Hud.init(gui)
PetFollow.init()
WorldFx.init()
CameraController.init()
TradeUI.init(gui)
CameraController.onMouseLookChanged(function(on)
	Effects.toast(on and "🖱️ Maus-Kamera AN" or "🖱️ Maus-Kamera AUS", on and "Die Kamera folgt jetzt deiner Maus. Strg drücken zum Ausschalten (z. B. für Menüs)." or "Kamera drehen: Maustaste gedrückt halten und ziehen.", "")
end)

-- Spielstand vom Server
local firstData = true
Remotes:WaitForChild("Data").OnClientEvent:Connect(function(kind, payload)
	if kind == "full" then
		State.setFull(payload)
		if firstData then
			firstData = false
			Sounds.setSfx(payload.data.settings.sfx ~= false)
			Sounds.setMusic(payload.data.settings.music ~= false)
		end
	else
		State.setLight(payload)
	end
end)

-- Nachrichten
Remotes:WaitForChild("Notify").OnClientEvent:Connect(function(title, text, kind)
	if kind == "title" then
		Effects.banner(title, text, UI.C.pink)
	elseif kind == "rebirth" then
		Effects.banner(title, text, UI.C.green)
	elseif kind == "offline" then
		Effects.banner(title, text, UI.C.purple)
	else
		Effects.toast(title, text, kind)
	end
end)

Remotes:WaitForChild("HatchResult").OnClientEvent:Connect(function(results)
	Effects.hatch(results)
end)

Remotes:WaitForChild("BattleResult").OnClientEvent:Connect(function(res)
	Menus.close()
	Effects.battle(res)
end)

Remotes:WaitForChild("BattleRequest").OnClientEvent:Connect(function(name, userId)
	Effects.battleRequest(name, userId, function(accept, uid)
		Remotes.BattleRespond:FireServer(accept, uid)
	end)
end)

Remotes:WaitForChild("OpenMenu").OnClientEvent:Connect(function(name, arg)
	Menus.open(name, arg)
end)

-- Fans
Remotes:WaitForChild("FanDialog").OnClientEvent:Connect(function(info)
	Menus.close()
	Effects.fanDialog(info, function(index)
		Remotes.FanChoice:FireServer(index)
	end)
end)
Remotes:WaitForChild("FanResult").OnClientEvent:Connect(function(success, text, extra)
	Effects.fanResult(success, text, extra)
end)

-- Bosskampf: Schadenszahlen
Remotes:WaitForChild("DamagePopup").OnClientEvent:Connect(function(amount, crit, position)
	Effects.damagePopup(amount, crit, position)
end)

-- Glücksrad dreht sich auf das gewonnene Feld
Remotes:WaitForChild("WheelResult").OnClientEvent:Connect(function(index)
	Menus.spinTo(index)
end)

-- Gym-Minispiel
Remotes:WaitForChild("GymStart").OnClientEvent:Connect(function()
	Menus.close()
	Effects.gymGame(function(hits)
		Remotes.GymFinish:FireServer(hits)
	end)
end)

-- Robux-Käufe: nach dem Kauf Danke sagen (die Belohnung gibt der Server)
local MarketplaceService = game:GetService("MarketplaceService")
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(plr, _, purchased)
	if plr == player and purchased then
		Effects.banner("💎 DANKE FÜR DEINEN KAUF!", "Dein Gamepass ist jetzt aktiv.", UI.C.gold)
	end
end)

-- Begrüßung
task.delay(2, function()
	Effects.toast("✨ Willkommen bei Looksmaxxer 3000!", "Klicke auf Daily Routine, kauf Upgrades und öffne die 🎁 Geschenkbox!", "title")
	task.wait(1.5)
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		Effects.toast("📱 Kamera", "Mit einem Finger wischen = drehen · zwei Finger = zoomen", "")
	else
		Effects.toast("🖱️ Kamera", "Maustaste halten + ziehen = drehen · Mausrad = zoomen · Strg = Maus-Kamera", "")
	end
end)
]]></ProtectedString></Properties><Item class="ModuleScript" referent="RBX0000001D"><Properties><string name="Name">CameraController</string><ProtectedString name="Source"><![CDATA[--[[
	CAMERACONTROLLER – eigene Kamerasteuerung für alle Geräte

	PC:
	  • Linke ODER rechte Maustaste gedrückt halten + ziehen = Kamera drehen
	  • Mausrad = zoomen
	  • Strg = "Maus-Kamera" an/aus (Kamera folgt der Maus ohne Klicken, wie Shift-Lock)
	Handy/Tablet:
	  • Mit einem Finger wischen = Kamera drehen
	  • Mit zwei Fingern auseinander/zusammen = zoomen
	Die Kamera geht nicht durch Wände (rückt dann näher heran).
	Wischen/Klicken auf Knöpfe, Menüs oder den Joystick dreht die Kamera NICHT.
]]

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local CameraController = {}

local SETTINGS = {
	mouseSensitivity = 0.0045,   -- wie schnell sich die Kamera mit der Maus dreht
	touchSensitivity = 0.008,    -- wie schnell beim Wischen
	minZoom = 6,
	maxZoom = 70,
	startZoom = 22,
	minPitch = math.rad(-75),    -- maximal so weit nach unten schauen
	maxPitch = math.rad(35),     -- maximal so weit nach oben schauen
	focusHeight = 2.5,           -- Kamera schaut etwas über den Kopf
}

local player = Players.LocalPlayer
local yaw, pitch = 0, math.rad(-20)
local zoom, targetZoom = SETTINGS.startZoom, SETTINGS.startZoom
local mouseDragging = false
local mouseLook = false
local touches = {}           -- aktive Kamera-Finger: [InputObject] = letzte Position
local pinchDistance = nil
local listeners = {}

local function clampPitch()
	pitch = math.clamp(pitch, SETTINGS.minPitch, SETTINGS.maxPitch)
end

local function rotate(dx, dy, sensitivity)
	yaw = yaw - dx * sensitivity
	pitch = pitch - dy * sensitivity
	clampPitch()
end

-- Kamera hinter die Figur drehen (z. B. nach dem Spawnen oder Teleport)
function CameraController.snapBehind()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		local look = hrp.CFrame.LookVector
		yaw = math.atan2(-look.X, -look.Z)
	end
end

function CameraController.isMouseLook()
	return mouseLook
end

function CameraController.setMouseLook(on)
	mouseLook = on and UserInputService.MouseEnabled
	for _, fn in ipairs(listeners) do
		pcall(fn, mouseLook)
	end
end

function CameraController.onMouseLookChanged(fn)
	table.insert(listeners, fn)
end

local function countTouches()
	local n = 0
	for _ in pairs(touches) do n = n + 1 end
	return n
end

local function touchList()
	local list = {}
	for input, pos in pairs(touches) do
		table.insert(list, { input = input, pos = pos })
	end
	return list
end

function CameraController.init()
	----------------------------------------------------------------
	-- Eingaben
	----------------------------------------------------------------
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		local t = input.UserInputType
		if (t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2) and not gameProcessed then
			mouseDragging = true
		elseif t == Enum.UserInputType.Touch and not gameProcessed then
			touches[input] = input.Position
			pinchDistance = nil
		elseif t == Enum.UserInputType.Keyboard and not gameProcessed then
			if input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl then
				CameraController.setMouseLook(not mouseLook)
			end
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 then
			if not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
				and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
				mouseDragging = false
			end
		elseif t == Enum.UserInputType.Touch then
			touches[input] = nil
			pinchDistance = nil
		end
	end)

	UserInputService.InputChanged:Connect(function(input, gameProcessed)
		local t = input.UserInputType
		if t == Enum.UserInputType.MouseMovement then
			if mouseDragging or mouseLook then
				rotate(input.Delta.X, input.Delta.Y, SETTINGS.mouseSensitivity)
			end
		elseif t == Enum.UserInputType.MouseWheel and not gameProcessed then
			targetZoom = math.clamp(targetZoom - input.Position.Z * 4, SETTINGS.minZoom, SETTINGS.maxZoom)
		elseif t == Enum.UserInputType.Touch and touches[input] then
			local n = countTouches()
			if n == 1 then
				local delta = input.Position - touches[input]
				rotate(delta.X, delta.Y, SETTINGS.touchSensitivity)
			elseif n >= 2 then
				-- Zwei Finger: Zoomen
				touches[input] = input.Position
				local list = touchList()
				local dist = (list[1].pos - list[2].pos).Magnitude
				if pinchDistance then
					targetZoom = math.clamp(targetZoom - (dist - pinchDistance) * 0.08, SETTINGS.minZoom, SETTINGS.maxZoom)
				end
				pinchDistance = dist
			end
			touches[input] = input.Position
		end
	end)

	-- Falls das Fenster den Fokus verliert: Ziehen beenden
	UserInputService.WindowFocusReleased:Connect(function()
		mouseDragging = false
		touches = {}
	end)

	player.CharacterAdded:Connect(function(char)
		char:WaitForChild("HumanoidRootPart", 10)
		task.wait()
		CameraController.snapBehind()
	end)
	if player.Character then
		CameraController.snapBehind()
	end

	----------------------------------------------------------------
	-- Jedes Bild: Kamera positionieren
	----------------------------------------------------------------
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.IgnoreWater = true

	RunService:BindToRenderStep("LooksmaxxerCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local cam = workspace.CurrentCamera
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if not cam or not hrp then return end
		cam.CameraType = Enum.CameraType.Scriptable

		-- Mauszeiger: beim Ziehen festhalten, bei Maus-Kamera in die Mitte sperren
		if mouseLook then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
			UserInputService.MouseIconEnabled = false
		elseif mouseDragging then
			UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
			UserInputService.MouseIconEnabled = true
		else
			UserInputService.MouseBehavior = Enum.MouseBehavior.Default
			UserInputService.MouseIconEnabled = true
		end

		zoom = zoom + (targetZoom - zoom) * math.clamp(dt * 10, 0, 1)
		local focus = hrp.Position + Vector3.new(0, SETTINGS.focusHeight, 0)
		local rotation = CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch, 0, 0)
		local desired = focus + rotation:VectorToWorldSpace(Vector3.new(0, 0, zoom))

		-- Nicht durch Wände schauen
		local ignore = { char }
		local pets = workspace:FindFirstChild("Pets")
		if pets then table.insert(ignore, pets) end
		rayParams.FilterDescendantsInstances = ignore
		local dir = desired - focus
		local hit = workspace:Raycast(focus, dir, rayParams)
		local camPos = desired
		if hit and hit.Instance and hit.Instance.CanCollide and hit.Instance.Transparency < 0.9 then
			camPos = hit.Position - dir.Unit * 0.6
		end

		cam.CFrame = CFrame.lookAt(camPos, focus)
		cam.Focus = CFrame.new(focus)

		-- Bei Maus-Kamera schaut die Figur in Blickrichtung (wie Shift-Lock)
		local hum = char:FindFirstChildOfClass("Humanoid")
		if hum then
			hum.AutoRotate = not mouseLook
			if mouseLook then
				hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, yaw, 0)
			end
		end
	end)
end

return CameraController
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001E"><Properties><string name="Name">Effects</string><ProtectedString name="Source"><![CDATA[--[[
	EFFECTS – alles, was kurz aufpoppt:
	Nachrichten (Toasts), große Banner, fliegende Zahlen,
	Box-Öffnen-Animation, Mog-Battle-Ansicht, Herausforderungen, Bestätigungen.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local UI = require(script.Parent:WaitForChild("UI"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local PetView = require(script.Parent:WaitForChild("PetView"))

local Effects = {}
local gui, overlayGui, toastHolder

local function tween(inst, t, props, style)
	local tw = TweenService:Create(inst, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

function Effects.init(mainGui)
	gui = mainGui
	overlayGui = UI.new("ScreenGui", {
		Name = "LooksmaxxerOverlay", ResetOnSpawn = false, DisplayOrder = 20,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling, Parent = Players.LocalPlayer:WaitForChild("PlayerGui"),
	})
	toastHolder = UI.new("Frame", {
		Name = "Toasts", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 80), Size = UDim2.new(0.28, 0, 0.6, 0), Parent = overlayGui,
	})
	UI.new("UISizeConstraint", { MinSize = Vector2.new(220, 100), MaxSize = Vector2.new(380, 600), Parent = toastHolder })
	UI.list(toastHolder, false, 6, Enum.HorizontalAlignment.Right)
end

----------------------------------------------------------------------------
-- Kleine Nachricht oben rechts
----------------------------------------------------------------------------
local KIND_COLORS = {
	good = UI.C.green, bad = UI.C.red, global = UI.C.gold, title = UI.C.pink, world = UI.C.cyan,
}
function Effects.toast(title, text, kind)
	if not toastHolder then return end
	local color = KIND_COLORS[kind] or UI.C.purple
	local f = UI.panel(toastHolder, { Size = UDim2.new(1, 0, 0, 66), Color = UI.C.dark, Transparency = 0.08 })
	UI.stroke(f, color, 2, 0)
	UI.padding(f, 8)
	UI.text(f, "<b>" .. title .. "</b>", { Size = UDim2.new(1, 0, 0.45, 0), Color = color, XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
	UI.text(f, text or "", { Size = UDim2.new(1, 0, 0.55, 0), Position = UDim2.new(0, 0, 0.45, 0), Font = Enum.Font.GothamBold,
		XAlign = Enum.TextXAlignment.Left, MaxText = 14 })
	if kind == "bad" then Sounds.play("Error") else Sounds.play("Notify") end
	-- höchstens 4 gleichzeitig
	local frames = {}
	for _, c in ipairs(toastHolder:GetChildren()) do
		if c:IsA("Frame") then table.insert(frames, c) end
	end
	if #frames > 4 then frames[1]:Destroy() end
	task.delay(4.5, function()
		if f.Parent then
			tween(f, 0.4, { BackgroundTransparency = 1 })
			task.wait(0.4)
			f:Destroy()
		end
	end)
end

----------------------------------------------------------------------------
-- Großes Banner (neuer Titel, Rebirth, Welt, Beauty Sleep)
----------------------------------------------------------------------------
function Effects.banner(title, text, color)
	local f = UI.panel(overlayGui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.12, 0),
		Size = UDim2.new(0.5, 0, 0.16, 0), Color = color or UI.C.pink })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(300, 90), MaxSize = Vector2.new(700, 140), Parent = f })
	UI.gradient(f, color or UI.C.pink, UI.C.purple, 0)
	UI.stroke(f, UI.C.gold, 3, 0)
	UI.padding(f, 10)
	UI.text(f, "<b>" .. title .. "</b>", { Size = UDim2.new(1, 0, 0.55, 0), MaxText = 34 })
	UI.text(f, text or "", { Size = UDim2.new(1, 0, 0.45, 0), Position = UDim2.new(0, 0, 0.55, 0), Font = Enum.Font.GothamBold, MaxText = 18 })
	local scale = UI.new("UIScale", { Scale = 0.4, Parent = f })
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	Sounds.play("TitleUp")
	task.delay(4, function()
		tween(scale, 0.25, { Scale = 0 })
		task.wait(0.3)
		f:Destroy()
	end)
end

----------------------------------------------------------------------------
-- Fliegende "+X" Zahl
----------------------------------------------------------------------------
function Effects.floatText(text, position, color)
	local l = UI.text(overlayGui, text, { Size = UDim2.new(0, 160, 0, 40), Position = position,
		AnchorPoint = Vector2.new(0.5, 0.5), Color = color or UI.C.gold, MaxText = 30 })
	l.TextStrokeTransparency = 0.3
	tween(l, 0.9, { Position = position - UDim2.new(0, 0, 0, 90), TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(1, function() l:Destroy() end)
end

----------------------------------------------------------------------------
-- Dunkler Hintergrund für große Fenster
----------------------------------------------------------------------------
local function overlay()
	local o = UI.new("TextButton", {
		Name = "Overlay", Size = UDim2.new(1, 0, 1, 0), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35, Text = "", AutoButtonColor = false, Parent = overlayGui,
	})
	return o
end

----------------------------------------------------------------------------
-- Geschenkbox öffnen
----------------------------------------------------------------------------
function Effects.hatch(results)
	local o = overlay()
	local box = UI.text(o, "🎁", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.45, 0), Size = UDim2.new(0, 220, 0, 220), MaxText = 200 })
	Sounds.play("Hatch")
	-- Wackeln
	for i = 1, 8 do
		tween(box, 0.09, { Rotation = (i % 2 == 0) and 18 or -18 })
		task.wait(0.1)
	end
	tween(box, 0.2, { Rotation = 0, Size = UDim2.new(0, 320, 0, 320), TextTransparency = 1 })
	task.wait(0.2)
	box:Destroy()

	local row = UI.new("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.45, 0),
		Size = UDim2.new(0.9, 0, 0.42, 0), Parent = o })
	UI.list(row, true, 14, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	local best = 1
	for _, r in ipairs(results) do
		local def = Logic.petById[r.id]
		local rarity = Config.Rarities[def.rarity]
		if rarity.order > best then best = rarity.order end
		local card = UI.panel(row, { Size = UDim2.new(0, 170, 0, 220), Color = rarity.color:Lerp(Color3.new(0, 0, 0), 0.55) })
		UI.stroke(card, rarity.color, 4, 0)
		UI.padding(card, 8)
		PetView.make(card, def.id, 1, true, { Size = UDim2.new(1, 0, 0.5, 0) })
		UI.text(card, def.name, { Size = UDim2.new(1, 0, 0.18, 0), Position = UDim2.new(0, 0, 0.52, 0), MaxText = 20 })
		UI.text(card, rarity.name, { Size = UDim2.new(1, 0, 0.14, 0), Position = UDim2.new(0, 0, 0.7, 0), Color = rarity.color, MaxText = 18 })
		UI.text(card, Util.formatPercent(def.boost) .. " Aura", { Size = UDim2.new(1, 0, 0.13, 0), Position = UDim2.new(0, 0, 0.85, 0),
			Color = UI.C.green, Font = Enum.Font.GothamBold, MaxText = 15 })
		if r.new then
			local badge = UI.panel(card, { Size = UDim2.new(0, 56, 0, 24), Position = UDim2.new(1, -40, 0, -16), Color = UI.C.red, Radius = 8 })
			UI.text(badge, "NEU!", { MaxText = 16 })
		end
		local s = UI.new("UIScale", { Scale = 0.2, Parent = card })
		tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	if best >= 5 then Sounds.play("HatchRare") end
	UI.text(o, "Tippen zum Schließen", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.72, 0), Size = UDim2.new(0.5, 0, 0.05, 0),
		Color = UI.C.muted, MaxText = 18 })
	local closed = false
	local function close()
		if closed then return end
		closed = true
		o:Destroy()
	end
	o.Activated:Connect(close)
	task.delay(best >= 5 and 6 or 3.5, close)
end

----------------------------------------------------------------------------
-- Mog Battle anzeigen
----------------------------------------------------------------------------
function Effects.battle(res)
	local o = overlay()
	local p = UI.panel(o, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.5, 0, 0.78, 0), Color = UI.C.bg })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(320, 380), MaxSize = Vector2.new(620, 640), Parent = p })
	UI.stroke(p, res.final and UI.C.gold or UI.C.pink, 3, 0)
	UI.padding(p, 14)
	local title = res.final and "💀 ENDBOSS LEON 💀" or (res.isBoss and "👑 BOSS-BATTLE 👑" or "⚔️ MOG BATTLE ⚔️")
	UI.text(p, "<b>" .. title .. "</b>", { Size = UDim2.new(1, 0, 0.09, 0), Color = res.final and UI.C.gold or UI.C.text, MaxText = 32 })
	local y = 0.09
	if res.taunt then
		UI.text(p, "<i>„" .. res.taunt .. "“</i>", { Size = UDim2.new(1, 0, 0.05, 0), Position = UDim2.new(0, 0, y, 0), Color = UI.C.muted,
			Font = Enum.Font.GothamBold, MaxText = 16 })
		y = y + 0.05
	end
	UI.text(p, "<font color='" .. UI.hex(UI.C.gold) .. "'>DU</font>   VS   <font color='" .. UI.hex(UI.C.cyan) .. "'>" .. res.opponent .. "</font>",
		{ Size = UDim2.new(1, 0, 0.08, 0), Position = UDim2.new(0, 0, y, 0), MaxText = 26 })
	y = y + 0.1
	local rounds = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.45, 0), Position = UDim2.new(0, 0, y, 0), Parent = p })
	UI.list(rounds, false, 5)
	local verdict = UI.text(p, "", { Size = UDim2.new(1, 0, 0.08, 0), Position = UDim2.new(0, 0, 0.7, 0), MaxText = 30 })
	local info = UI.text(p, "", { Size = UDim2.new(1, 0, 0.1, 0), Position = UDim2.new(0, 0, 0.78, 0), Font = Enum.Font.GothamBold, MaxText = 16 })
	Sounds.play("BattleStart")

	local catByName = {}
	for _, c in ipairs(Config.Categories) do catByName[c.id] = c end
	for i, r in ipairs(res.rounds) do
		task.wait(res.isBoss and 0.9 or 0.7)
		if not p.Parent then return end
		local win = r.a > r.b
		local row = UI.panel(rounds, { Size = UDim2.new(1, 0, 0.18, 0), Color = UI.C.panel2, LayoutOrder = i, Radius = 10 })
		UI.text(row, (win and "✅ " or "") .. Util.format(r.a), { Size = UDim2.new(0.25, 0, 1, 0), Color = win and UI.C.green or UI.C.red, MaxText = 20 })
		local c = catByName[r.cat]
		UI.text(row, "Runde " .. i .. " · " .. c.emoji .. " " .. Config.BattleNames[r.cat], { Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.new(0.25, 0, 0, 0),
			Color = UI.C.muted, MaxText = 16 })
		UI.text(row, Util.format(r.b) .. (win and "" or " ✅"), { Size = UDim2.new(0.25, 0, 1, 0), Position = UDim2.new(0.75, 0, 0, 0),
			Color = win and UI.C.red or UI.C.green, MaxText = 20 })
	end
	task.wait(0.6)
	if not p.Parent then return end
	if res.won then
		verdict.Text = "🏆 DU MOGGST! (" .. res.wins .. ":" .. (5 - res.wins) .. ")"
		verdict.TextColor3 = UI.C.green
		Sounds.play("BattleWin")
	else
		verdict.Text = "💀 GEMOGGT! (" .. res.wins .. ":" .. (5 - res.wins) .. ")"
		verdict.TextColor3 = UI.C.red
		Sounds.play("BattleLose")
	end
	local rewardText = ""
	if res.reward and (res.reward.aura > 0 or res.reward.cash > 0) then
		rewardText = "\n<font color='" .. UI.hex(UI.C.gold) .. "'>+" .. Util.format(res.reward.aura) .. " Aura · +" .. Util.format(res.reward.cash) .. " Geld</font>"
		if res.isBoss then rewardText = rewardText .. "\n🎁 Gratis-Box kommt gleich!" end
	end
	info.Text = (res.text or "") .. rewardText
	UI.button(p, res.won and "Ehrenrunde 😎" or "Ab ins Gym 💪", UI.C.pink, function() o:Destroy() end,
		{ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, 0), Size = UDim2.new(0.6, 0, 0.09, 0) })
end

----------------------------------------------------------------------------
-- Herausforderung von einem anderen Spieler
----------------------------------------------------------------------------
function Effects.battleRequest(name, userId, respond)
	local f = UI.panel(overlayGui, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.78, 0), Size = UDim2.new(0.4, 0, 0.14, 0), Color = UI.C.dark })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(300, 90), MaxSize = Vector2.new(520, 120), Parent = f })
	UI.stroke(f, UI.C.orange, 3, 0)
	UI.padding(f, 8)
	UI.text(f, "⚔️ <b>" .. name .. "</b> fordert dich zum Mog Battle heraus!", { Size = UDim2.new(1, 0, 0.5, 0), MaxText = 20 })
	local done = false
	local function answer(ok)
		if done then return end
		done = true
		respond(ok, userId)
		f:Destroy()
	end
	UI.button(f, "✅ Annehmen", UI.C.green, function() answer(true) end, { Size = UDim2.new(0.48, 0, 0.42, 0), Position = UDim2.new(0, 0, 0.56, 0), TextColor = UI.C.dark })
	UI.button(f, "❌ Ablehnen", UI.C.red, function() answer(false) end, { Size = UDim2.new(0.48, 0, 0.42, 0), Position = UDim2.new(0.52, 0, 0.56, 0) })
	task.delay(15, function() answer(false) end)
end

----------------------------------------------------------------------------
-- Ja/Nein-Abfrage
----------------------------------------------------------------------------
function Effects.confirm(title, text, yesLabel, onYes)
	local o = overlay()
	local p = UI.panel(o, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.4, 0, 0.36, 0), Color = UI.C.bg })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(300, 200), MaxSize = Vector2.new(520, 300), Parent = p })
	UI.stroke(p, UI.C.pink, 2, 0)
	UI.padding(p, 14)
	UI.text(p, "<b>" .. title .. "</b>", { Size = UDim2.new(1, 0, 0.22, 0), MaxText = 26 })
	UI.text(p, text, { Size = UDim2.new(1, 0, 0.45, 0), Position = UDim2.new(0, 0, 0.24, 0), Font = Enum.Font.GothamBold, MaxText = 16 })
	UI.button(p, "Abbrechen", UI.C.grey, function() o:Destroy() end, { Size = UDim2.new(0.48, 0, 0.24, 0), Position = UDim2.new(0, 0, 0.76, 0) })
	UI.button(p, yesLabel or "Ja", UI.C.pink, function()
		o:Destroy()
		onYes()
	end, { Size = UDim2.new(0.48, 0, 0.24, 0), Position = UDim2.new(0.52, 0, 0.76, 0) })
end

----------------------------------------------------------------------------
-- Allgemeine Anfrage (z. B. Handel) mit Annehmen/Ablehnen
----------------------------------------------------------------------------
function Effects.requestPopup(text, color, respond)
	local f = UI.panel(overlayGui, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.62, 0), Size = UDim2.new(0.4, 0, 0.14, 0), Color = UI.C.dark })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(300, 90), MaxSize = Vector2.new(520, 120), Parent = f })
	UI.stroke(f, color or UI.C.cyan, 3, 0)
	UI.padding(f, 8)
	UI.text(f, text, { Size = UDim2.new(1, 0, 0.5, 0), MaxText = 20 })
	local done = false
	local function answer(ok)
		if done then return end
		done = true
		respond(ok)
		f:Destroy()
	end
	UI.button(f, "✅ Annehmen", UI.C.green, function() answer(true) end, { Size = UDim2.new(0.48, 0, 0.42, 0), Position = UDim2.new(0, 0, 0.56, 0), TextColor = UI.C.dark })
	UI.button(f, "❌ Ablehnen", UI.C.red, function() answer(false) end, { Size = UDim2.new(0.48, 0, 0.42, 0), Position = UDim2.new(0.52, 0, 0.56, 0) })
	task.delay(15, function() answer(false) end)
end

----------------------------------------------------------------------------
-- Schadenszahl über dem Boss
----------------------------------------------------------------------------
function Effects.damagePopup(amount, crit, position)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.CanTouch = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.2, 0.2, 0.2)
	anchor.CFrame = CFrame.new(position)
	anchor.Parent = workspace
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(0, crit and 160 or 110, 0, crit and 50 or 36)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Parent = anchor
	local l = UI.text(bb, (crit and "💥 " or "") .. Util.format(amount), { Color = crit and UI.C.gold or UI.C.text, MaxText = crit and 40 or 28 })
	l.TextStrokeTransparency = 0.2
	tween(bb, 0.7, { StudsOffset = Vector3.new(0, 4, 0) })
	tween(l, 0.7, { TextTransparency = 1, TextStrokeTransparency = 1 })
	task.delay(0.75, function() anchor:Destroy() end)
end

----------------------------------------------------------------------------
-- Fan begeistern: Auswahl & Ergebnis
----------------------------------------------------------------------------
local fanPanel = nil
function Effects.fanDialog(info, choose)
	if fanPanel then fanPanel:Destroy() end
	local o = overlay()
	fanPanel = o
	local p = UI.panel(o, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.44, 0, 0.62, 0), Color = UI.C.bg })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(320, 340), MaxSize = Vector2.new(560, 520), Parent = p })
	UI.stroke(p, UI.C.pink, 3, 0)
	UI.padding(p, 14)
	UI.text(p, "<b>⭐ " .. info.name .. " begeistern</b>", { Size = UDim2.new(1, 0, 0.11, 0), MaxText = 28 })
	UI.text(p, info.role .. " · Promi-Level " .. info.fame .. "/10", { Size = UDim2.new(1, 0, 0.07, 0), Position = UDim2.new(0, 0, 0.11, 0), Color = UI.C.muted, Font = Enum.Font.GothamBold, MaxText = 16 })
	UI.text(p, "Deine Chance: ~" .. info.chance .. " %", { Size = UDim2.new(1, 0, 0.08, 0), Position = UDim2.new(0, 0, 0.19, 0), Color = UI.C.gold, MaxText = 22 })
	UI.text(p, "Charisma " .. Util.format(info.charisma) .. " · gebraucht ca. " .. Util.format(info.req), { Size = UDim2.new(1, 0, 0.06, 0), Position = UDim2.new(0, 0, 0.27, 0),
		Color = UI.C.muted, Font = Enum.Font.Gotham, MaxText = 14 })
	local body = UI.new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0.35, 0), Size = UDim2.new(1, 0, 0.65, 0), Name = "Body", Parent = p })
	UI.list(body, false, 8)
	for i, text in ipairs(info.openers) do
		UI.button(body, text, UI.C.panel2, function()
			UI.clear(body)
			UI.text(body, "…", { Size = UDim2.new(1, 0, 0, 40), MaxText = 30 })
			choose(i)
		end, { Size = UDim2.new(1, 0, 0, 48), LayoutOrder = i, MaxText = 16 })
	end
	UI.button(body, "Lieber doch nicht 🙈", UI.C.grey, function()
		o:Destroy()
		fanPanel = nil
	end, { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 9, MaxText = 16 })
end

function Effects.fanResult(success, text, extra)
	if not fanPanel then return end
	local body = fanPanel:FindFirstChild("Body", true)
	if not body then return end
	UI.clear(body)
	UI.text(body, success and "⭐ Neuer Fan!" or "😬 Nicht beeindruckt!", { Size = UDim2.new(1, 0, 0, 44), Color = success and UI.C.green or UI.C.red, MaxText = 30, LayoutOrder = 1 })
	UI.text(body, text, { Size = UDim2.new(1, 0, 0, 60), Font = Enum.Font.GothamBold, MaxText = 18, LayoutOrder = 2 })
	if extra and extra ~= "" then
		UI.text(body, extra, { Size = UDim2.new(1, 0, 0, 40), Color = success and UI.C.gold or UI.C.muted, Font = Enum.Font.GothamBold, MaxText = 15, LayoutOrder = 3 })
	end
	local panel = fanPanel
	UI.button(body, success and "Nice! 😎" or "Weiter geht's", UI.C.pink, function()
		panel:Destroy()
		if fanPanel == panel then fanPanel = nil end
	end, { Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 4 })
	if success then Sounds.play("BattleWin") else Sounds.play("BattleLose") end
end

----------------------------------------------------------------------------
-- Job-Minispiel: im richtigen Moment tippen (3 Versuche)
----------------------------------------------------------------------------
function Effects.jobGame(job, onFinish)
	local RunService = game:GetService("RunService")
	local o = overlay()
	local p = UI.panel(o, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.5, 0, 0.56, 0), Color = UI.C.bg })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(320, 300), MaxSize = Vector2.new(620, 440), Parent = p })
	UI.stroke(p, UI.C.cyan, 3, 0)
	UI.padding(p, 14)
	UI.text(p, "<b>" .. job.emoji .. " " .. job.name .. "</b>", { Size = UDim2.new(1, 0, 0.13, 0), MaxText = 26 })
	UI.text(p, "Tippe auf den Knopf, wenn der weiße Strich im <font color='" .. UI.hex(UI.C.green) .. "'>grünen</font> Bereich ist. Gelbe Mitte = PERFEKT!",
		{ Size = UDim2.new(1, 0, 0.14, 0), Position = UDim2.new(0, 0, 0.13, 0), Font = Enum.Font.GothamBold, Color = UI.C.muted, MaxText = 15 })
	local bar = UI.panel(p, { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.32, 0), Color = UI.C.panel2, Radius = 10 })
	bar.ClipsDescendants = true
	local zoneF = UI.new("Frame", { BackgroundColor3 = UI.C.green, BackgroundTransparency = 0.3, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = bar })
	local perfF = UI.new("Frame", { BackgroundColor3 = UI.C.gold, BorderSizePixel = 0, Size = UDim2.new(0, 0, 1, 0), Parent = bar })
	local marker = UI.new("Frame", { BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.new(0, 6, 1, 0), Parent = bar })
	local results = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.48, 0), Parent = p })
	UI.list(results, true, 8, Enum.HorizontalAlignment.Center)

	local zone = math.max(0.1, 0.32 - job.diff * 0.035)
	local speed = 0.55 + job.diff * 0.17
	local pos, dir, zoneStart = 0, 1, 0
	local scores = {}
	local function newZone()
		zoneStart = 0.05 + math.random() * (0.9 - zone)
		zoneF.Position = UDim2.new(zoneStart, 0, 0, 0)
		zoneF.Size = UDim2.new(zone, 0, 1, 0)
		perfF.Position = UDim2.new(zoneStart + zone * 0.35, 0, 0, 0)
		perfF.Size = UDim2.new(zone * 0.3, 0, 1, 0)
	end
	newZone()
	local conn = RunService.RenderStepped:Connect(function(dt)
		pos = pos + dir * speed * dt
		if pos > 1 then pos = 1; dir = -1 end
		if pos < 0 then pos = 0; dir = 1 end
		marker.Position = UDim2.new(pos, 0, 0, 0)
	end)
	local btn
	btn = UI.button(p, job.act, UI.C.pink, function()
		if #scores >= 3 then return end
		local score, label
		if pos >= zoneStart + zone * 0.35 and pos <= zoneStart + zone * 0.65 then score, label = 1, "🌟 PERFEKT"
		elseif pos >= zoneStart and pos <= zoneStart + zone then score, label = 0.6, "👍 Gut"
		else score, label = 0.1, "😬 Daneben" end
		table.insert(scores, score)
		local chip = UI.panel(results, { Size = UDim2.new(0.3, 0, 1, 0), Color = UI.C.panel2, Radius = 10 })
		UI.text(chip, label, { MaxText = 18 })
		Sounds.play("Click")
		if #scores < 3 then
			newZone()
			return
		end
		conn:Disconnect()
		btn.Text = "⏳ Wird ausgewertet …"
		onFinish(scores)
		task.delay(1.2, function() o:Destroy() end)
	end, { Size = UDim2.new(1, 0, 0.22, 0), Position = UDim2.new(0, 0, 0.66, 0), MaxText = 30 })
	UI.button(p, "Abbrechen", UI.C.grey, function()
		conn:Disconnect()
		o:Destroy()
	end, { Size = UDim2.new(0.4, 0, 0.08, 0), Position = UDim2.new(0.3, 0, 0.91, 0), MaxText = 14 })
end


----------------------------------------------------------------------------
-- Gym-Minispiel: 8 Wiederholungen im Takt (Hantel im grünen Bereich stemmen)
----------------------------------------------------------------------------
function Effects.gymGame(onFinish)
	local RunService = game:GetService("RunService")
	local o = overlay()
	local p = UI.panel(o, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.5, 0), Size = UDim2.new(0.5, 0, 0.6, 0), Color = UI.C.bg })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(320, 320), MaxSize = Vector2.new(560, 480), Parent = p })
	UI.stroke(p, UI.C.orange, 3, 0)
	UI.padding(p, 14)
	UI.text(p, "<b>🏋️ BANKDRÜCKEN</b>", { Size = UDim2.new(1, 0, 0.11, 0), MaxText = 26 })
	UI.text(p, "Tippe, wenn die Hantel im <font color='" .. UI.hex(UI.C.green) .. "'>grünen</font> Bereich ist. 8 Wiederholungen – ab 4 Treffern gibt's den GYM-PUMP (+50 % Aura)!",
		{ Size = UDim2.new(1, 0, 0.13, 0), Position = UDim2.new(0, 0, 0.11, 0), Font = Enum.Font.GothamBold, Color = UI.C.muted, MaxText = 14 })
	-- senkrechte Leiste
	local bar = UI.panel(p, { AnchorPoint = Vector2.new(0.5, 0), Size = UDim2.new(0.16, 0, 0.42, 0), Position = UDim2.new(0.3, 0, 0.26, 0), Color = UI.C.panel2, Radius = 10 })
	bar.ClipsDescendants = true
	local zone = UI.new("Frame", { BackgroundColor3 = UI.C.green, BackgroundTransparency = 0.25, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0.22, 0), Parent = bar })
	local weight = UI.text(bar, "🏋️", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.new(1.4, 0, 0.18, 0), MaxText = 40 })
	local counter = UI.text(p, "0 / 8", { Size = UDim2.new(0.45, 0, 0.16, 0), Position = UDim2.new(0.5, 0, 0.3, 0), Color = UI.C.gold, MaxText = 44 })
	local feedback = UI.text(p, "", { Size = UDim2.new(0.45, 0, 0.12, 0), Position = UDim2.new(0.5, 0, 0.48, 0), MaxText = 24 })
	local reps, hits = 0, 0
	local pos, dir, speed = 0, 1, 0.8
	local zoneStart = 0.39
	local function newZone()
		zoneStart = 0.08 + math.random() * 0.62
		zone.Position = UDim2.new(0, 0, zoneStart, 0)
	end
	newZone()
	local conn = RunService.RenderStepped:Connect(function(dt)
		pos = pos + dir * speed * dt
		if pos > 1 then pos = 1; dir = -1 end
		if pos < 0 then pos = 0; dir = 1 end
		weight.Position = UDim2.new(0.5, 0, pos, 0)
	end)
	local done = false
	local btn
	btn = UI.button(p, "💪 DRÜCKEN!", UI.C.orange, function()
		if done then return end
		reps = reps + 1
		if pos >= zoneStart - 0.02 and pos <= zoneStart + 0.24 then
			hits = hits + 1
			feedback.Text = "✅ Sauber!"
			feedback.TextColor3 = UI.C.green
		else
			feedback.Text = "❌ Daneben"
			feedback.TextColor3 = UI.C.red
		end
		counter.Text = hits .. " / 8"
		Sounds.play("Click")
		speed = speed + 0.12
		if reps < 8 then
			newZone()
			return
		end
		done = true
		conn:Disconnect()
		btn.Text = hits >= 4 and "🔥 PUMP!" or "😮‍💨 Geschafft"
		onFinish(hits)
		task.delay(1.2, function() o:Destroy() end)
	end, { Size = UDim2.new(1, 0, 0.17, 0), Position = UDim2.new(0, 0, 0.72, 0), TextColor = UI.C.dark, MaxText = 30 })
	UI.button(p, "Abbrechen", UI.C.grey, function()
		done = true
		conn:Disconnect()
		o:Destroy()
	end, { Size = UDim2.new(0.4, 0, 0.08, 0), Position = UDim2.new(0.3, 0, 0.92, 0), MaxText = 14 })
end


return Effects
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000001F"><Properties><string name="Name">Emotes</string><ProtectedString name="Source"><![CDATA[--[[
	EMOTES – spielt Emotes (Animationen) am eigenen Avatar ab.
	Eigene Animationen sieht jeder andere Spieler automatisch auch.
]]

local Players = game:GetService("Players")

local Emotes = {}
local current = nil

function Emotes.play(def)
	local char = Players.LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator or not def or not def.anim then return end
	if current then current:Stop() end
	local anim = Instance.new("Animation")
	anim.AnimationId = def.anim
	local ok, track = pcall(function() return animator:LoadAnimation(anim) end)
	if ok and track then
		track.Priority = Enum.AnimationPriority.Action
		track:Play()
		current = track
	end
	if def.bubble then
		pcall(function()
			game:GetService("TextChatService"):DisplayBubble(char:FindFirstChild("Head"), def.bubble)
		end)
	end
end

return Emotes
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000020"><Properties><string name="Name">Hud</string><ProtectedString name="Source"><![CDATA[--[[
	HUD – die ständige Anzeige:
	oben die Werte, links die Menü-Knöpfe, unten der Daily-Routine-Knopf
	mit Titel und Fortschritt zum nächsten Titel.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local Menus = require(script.Parent:WaitForChild("Menus"))

local Hud = {}
local C = UI.C
local chips = {}
local titleLabel, nextLabel, progressBar, routineSub, routineBtn, rewardsDot
local wheelDot, eventBtn, rideBtn, raceLabel

local UIS = game:GetService("UserInputService")
-- Handy/Tablet ohne Tastatur: kompaktere Oberfläche, damit man mehr vom Spiel sieht
local touch = UIS.TouchEnabled and not UIS.KeyboardEnabled

local function chip(parent, key, caption, color, order)
	local f = UI.panel(parent, { Size = UDim2.new(0.155, 0, 1, 0), Color = C.dark, Transparency = touch and 0.3 or 0.15, LayoutOrder = order, Radius = touch and 10 or 14 })
	UI.stroke(f, color, touch and 1.5 or 2, 0.3)
	UI.text(f, caption, { Size = UDim2.new(1, 0, 0.34, 0), Position = UDim2.new(0, 0, 0.04, 0), Color = C.muted, Font = Enum.Font.GothamBold, MaxText = touch and 9 or 12 })
	chips[key] = UI.text(f, "0", { Size = UDim2.new(1, -8, 0.58, 0), Position = UDim2.new(0, 4, 0.38, 0), Color = color, MaxText = touch and 17 or 24 })
end

function Hud.init(gui)
	-- Werte oben
	local top = UI.new("Frame", { Name = "TopBar", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.new(0.66, 0, 0.08, 0), Parent = gui })
	if touch then
		-- ganz nach oben in die Roblox-Leiste, rechts neben die Roblox-Knöpfe
		-- (Höhe der Leiste wird vom Gerät abgefragt, damit nichts abgeschnitten wird)
		local inset = 58
		pcall(function() inset = game:GetService("GuiService"):GetGuiInset().Y end)
		if inset >= 48 then
			local h = math.min(40, inset - 12)
			top.Position = UDim2.new(0.63, 0, 0, -inset + (inset - h) / 2)
			top.Size = UDim2.new(0.56, 0, 0, h)
			UI.new("UISizeConstraint", { MinSize = Vector2.new(280, h), MaxSize = Vector2.new(560, h), Parent = top })
		else
			-- schmale Leiste: direkt darunter, aber klein
			top.Position = UDim2.new(0.5, 0, 0, 2)
			top.Size = UDim2.new(0.56, 0, 0, 34)
			UI.new("UISizeConstraint", { MinSize = Vector2.new(280, 30), MaxSize = Vector2.new(560, 34), Parent = top })
		end
	else
		UI.new("UISizeConstraint", { MinSize = Vector2.new(320, 44), MaxSize = Vector2.new(900, 62), Parent = top })
	end
	UI.list(top, true, touch and 4 or 6, Enum.HorizontalAlignment.Center)
	chip(top, "aura", "✨ AURA", C.gold, 1)
	chip(top, "aps", "⚡ PRO SEK.", C.green, 2)
	chip(top, "cash", "💵 GELD", C.money, 3)
	chip(top, "glow", "💖 GLOW", C.pink, 4)
	chip(top, "reb", "♻️ REBIRTHS", C.cyan, 5)
	chip(top, "gems", "💎 GEMS", C.cyan, 6)

	-- Menü-Knöpfe links
	local side = UI.new("Frame", { Name = "Side", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 8, 0.5, 0),
		Size = UDim2.new(0.07, 0, 0.84, 0), Parent = gui })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(44, 300), MaxSize = Vector2.new(74, 780), Parent = side })
	UI.list(side, false, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	-- Handy/Tablet: Knöpfe kompakt oben anordnen, damit der Lauf-Joystick unten links frei bleibt
	local function compact(frame, anchorRight)
		local layout = frame:FindFirstChildOfClass("UIListLayout")
		if layout then layout:Destroy() end
		local constraint = frame:FindFirstChildOfClass("UISizeConstraint")
		if constraint then constraint:Destroy() end
		frame.AnchorPoint = Vector2.new(anchorRight and 1 or 0, 0)
		frame.Position = anchorRight and UDim2.new(1, -4, 0, 4) or UDim2.new(0, 4, 0, 4)
		frame.Size = UDim2.new(0, 80, 0.75, 0)
		UI.new("UIGridLayout", { CellSize = UDim2.new(0, 37, 0, 37), CellPadding = UDim2.new(0, 3, 0, 3),
			HorizontalAlignment = anchorRight and Enum.HorizontalAlignment.Right or Enum.HorizontalAlignment.Left,
			SortOrder = Enum.SortOrder.LayoutOrder, Parent = frame })
	end
	if touch then compact(side, false) end
	local buttons = {
		{ "upgrades", "💪", "Upgrades", C.pink }, { "pets", "🐾", "Pets", C.purple }, { "weapons", "⚔️", "Waffen", C.red },
		{ "worlds", "🌍", "Welten", C.cyan }, { "quests", "📋", "Aufträge", C.orange }, { "jobs", "💼", "Jobs", C.money },
		{ "rebirth", "♻️", "Rebirth", C.green }, { "leaderboard", "🏆", "Rangliste", C.gold }, { "rewards", "🎁", "Belohnung", C.pink },
		{ "settings", "⚙️", "Optionen", C.grey },
	}
	for i, b in ipairs(buttons) do
		local btn = UI.new("TextButton", { Text = "", AutoButtonColor = true, BackgroundColor3 = b[4], Size = UDim2.new(1, 0, 1 / 10, -6),
			LayoutOrder = i, Parent = side })
		UI.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = btn })
		UI.corner(btn, 14)
		UI.stroke(btn, Color3.new(1, 1, 1), 2, 0.6)
		UI.text(btn, b[2], { Size = UDim2.new(1, 0, 0.62, 0), MaxText = touch and 20 or 34 })
		UI.text(btn, b[3], { Size = UDim2.new(1, -4, 0.3, 0), Position = UDim2.new(0, 2, 0.66, 0), MaxText = touch and 8 or 12 })
		btn.Activated:Connect(function()
			Menus.toggle(b[1])
		end)
		if b[1] == "rewards" then
			rewardsDot = UI.panel(btn, { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -12, 0, -4), Color = C.red, Radius = 8 })
			rewardsDot.Visible = false
		end
	end

	-- Knöpfe rechts: Shop, Glücksrad, Event, Ausrüstung, Emotes, Fahrzeug
	local right = UI.new("Frame", { Name = "Right", BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.45, 0),
		Size = UDim2.new(0.07, 0, 0.56, 0), Parent = gui })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(44, 220), MaxSize = Vector2.new(74, 520), Parent = right })
	UI.list(right, false, 6, Enum.HorizontalAlignment.Center, Enum.VerticalAlignment.Center)
	if touch then compact(right, true) end
	local rightButtons = {
		{ "shop", "💎", "Shop", C.cyan }, { "wheel", "🎡", "Glücksrad", C.gold }, { "event", "🎉", "Events", C.orange },
		{ "style", "✨", "Style", C.purple }, { "emote", "🕺", "Emotes", C.pink }, { "ride", "🛹", "Fahren (V)", C.green },
	}
	for i, b in ipairs(rightButtons) do
		local btn = UI.new("TextButton", { Text = "", AutoButtonColor = true, BackgroundColor3 = b[4], Size = UDim2.new(1, 0, 1 / 6, -6),
			LayoutOrder = i, Parent = right })
		UI.new("UIAspectRatioConstraint", { AspectRatio = 1, Parent = btn })
		UI.corner(btn, 14)
		UI.stroke(btn, Color3.new(1, 1, 1), 2, 0.6)
		UI.text(btn, b[2], { Size = UDim2.new(1, 0, 0.62, 0), MaxText = touch and 20 or 34 })
		UI.text(btn, b[3], { Size = UDim2.new(1, -4, 0.3, 0), Position = UDim2.new(0, 2, 0.66, 0), MaxText = touch and 8 or 12 })
		btn.Activated:Connect(function()
			if b[1] == "emote" then
				Menus.open("style", "emote")
			elseif b[1] == "ride" then
				Hud.toggleRide()
			else
				Menus.toggle(b[1])
			end
		end)
		if b[1] == "wheel" then
			wheelDot = UI.panel(btn, { Size = UDim2.new(0, 16, 0, 16), Position = UDim2.new(1, -12, 0, -4), Color = C.red, Radius = 8 })
			wheelDot.Visible = false
		elseif b[1] == "event" then
			eventBtn = btn
		elseif b[1] == "ride" then
			rideBtn = btn
		end
	end
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.V then
			Hud.toggleRide()
		end
	end)

	-- Stoppuhr fürs Laufrennen
	raceLabel = UI.text(gui, "", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.21, 0), Size = UDim2.new(0, 260, 0, 46),
		Color = C.gold, MaxText = 36 })
	raceLabel.TextStrokeTransparency = 0.2
	raceLabel.Visible = false
	game:GetService("RunService").Heartbeat:Connect(function()
		local start = game:GetService("Players").LocalPlayer:GetAttribute("RaceStart")
		if start then
			raceLabel.Visible = true
			raceLabel.Text = "⏱️ " .. string.format("%.2f", workspace:GetServerTimeNow() - start) .. " s"
		else
			raceLabel.Visible = false
		end
	end)

	-- Unten: Titel, Fortschritt, Daily Routine
	local bottom = UI.new("Frame", { Name = "Bottom", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(0.3, 0, 0.22, 0), Parent = gui })
	if touch then
		bottom.Size = UDim2.new(0.26, 0, 0.24, 0)
		bottom.Position = UDim2.new(0.5, 0, 1, -6)
		UI.new("UISizeConstraint", { MinSize = Vector2.new(190, 92), MaxSize = Vector2.new(300, 124), Parent = bottom })
	else
		UI.new("UISizeConstraint", { MinSize = Vector2.new(240, 130), MaxSize = Vector2.new(420, 190), Parent = bottom })
	end
	-- Solange ein Menü (z. B. Upgrades) offen ist, verschwindet die Daily Routine, damit man mehr sieht
	Menus.onVisibility(function(open)
		bottom.Visible = not open
	end)
	if touch then
		-- liegt eine Waffe im Rucksack, zeigt Roblox unten die Werkzeugleiste → Knopf etwas höher
		local plr = game:GetService("Players").LocalPlayer
		local function fitAboveHotbar()
			local bp = plr:FindFirstChildOfClass("Backpack")
			local char = plr.Character
			local hasTool = (bp and #bp:GetChildren() > 0) or (char and char:FindFirstChildOfClass("Tool") ~= nil)
			bottom.Position = UDim2.new(0.5, 0, 1, hasTool and -62 or -6)
		end
		task.spawn(function()
			while true do
				fitAboveHotbar()
				task.wait(1)
			end
		end)
	end
	titleLabel = UI.text(bottom, "NPC", { Size = UDim2.new(1, 0, 0.18, 0), Color = C.pink, MaxText = 24 })
	titleLabel.TextStrokeTransparency = 0.4
	local barBg = UI.panel(bottom, { Size = UDim2.new(1, 0, 0.07, 0), Position = UDim2.new(0, 0, 0.2, 0), Color = C.dark, Radius = 6 })
	progressBar = UI.panel(barBg, { Size = UDim2.new(0, 0, 1, 0), Color = C.pink, Radius = 6 })
	UI.gradient(progressBar, C.pink, C.gold, 0)
	nextLabel = UI.text(bottom, "", { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.28, 0), Color = C.muted, Font = Enum.Font.GothamBold, MaxText = 14 })
	nextLabel.TextStrokeTransparency = 0.5

	routineBtn = UI.new("TextButton", { Name = "Routine", Text = "", AutoButtonColor = true, BackgroundColor3 = C.pink,
		Size = UDim2.new(1, 0, 0.56, 0), Position = UDim2.new(0, 0, 0.44, 0), Parent = bottom })
	UI.corner(routineBtn, 18)
	UI.gradient(routineBtn, C.pink, C.cyan, 0)
	UI.stroke(routineBtn, Color3.new(1, 1, 1), 3, 0.3)
	local scale = UI.new("UIScale", { Parent = routineBtn })
	UI.text(routineBtn, "🪞 DAILY ROUTINE", { Size = UDim2.new(1, 0, 0.58, 0), Position = UDim2.new(0, 0, 0.06, 0), MaxText = 34 })
	routineSub = UI.text(routineBtn, "+1 Aura", { Size = UDim2.new(1, 0, 0.32, 0), Position = UDim2.new(0, 0, 0.62, 0), Font = Enum.Font.GothamBold, MaxText = 18 })

	routineBtn.Activated:Connect(function()
		local s = State.snap
		if not s then return end
		Remotes.Click:FireServer()
		s.data.aura = s.data.aura + s.click      -- sofort anzeigen
		State.bump()
		local pos = routineBtn.AbsolutePosition
		local size = routineBtn.AbsoluteSize
		Effects.floatText("+" .. Util.format(s.click), UDim2.new(0, pos.X + size.X * (0.3 + math.random() * 0.4), 0, pos.Y), C.gold)
		scale.Scale = 0.93
		TweenService:Create(scale, TweenInfo.new(0.15, Enum.EasingStyle.Back), { Scale = 1 }):Play()
	end)

	-- Lebensbalken: Selbstbewusstsein & Boss
	local bars = UI.new("Frame", { Name = "Bars", BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0), Position = touch and UDim2.new(0.5, 0, 0, 4) or UDim2.new(0.5, 0, 0.11, 6),
		Size = UDim2.new(0.42, 0, 0.09, 0), Parent = gui })
	UI.new("UISizeConstraint", { MinSize = Vector2.new(260, 56), MaxSize = Vector2.new(560, 80), Parent = bars })
	local bossBg = UI.panel(bars, { Size = UDim2.new(1, 0, 0.5, -2), Color = C.dark, Radius = 8 })
	local bossFill = UI.panel(bossBg, { Size = UDim2.new(1, 0, 1, 0), Color = C.red, Radius = 8 })
	local bossText = UI.text(bossBg, "", { MaxText = 16 })
	bossText.TextStrokeTransparency = 0.3
	local confBg = UI.panel(bars, { Size = UDim2.new(0.7, 0, 0.42, 0), Position = UDim2.new(0.15, 0, 0.56, 0), Color = C.dark, Radius = 8 })
	local confFill = UI.panel(confBg, { Size = UDim2.new(1, 0, 1, 0), Color = C.green, Radius = 8 })
	local confText = UI.text(confBg, "", { MaxText = 14 })
	confText.TextStrokeTransparency = 0.3
	bossBg.Visible = false
	confBg.Visible = false

	local Players = game:GetService("Players")
	local player = Players.LocalPlayer
	task.spawn(function()
		while true do
			task.wait(0.15)
			local char = player.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local nearest, nd = nil, 90
			local npcs = workspace:FindFirstChild("NPCs")
			if hrp and npcs then
				for _, m in ipairs(npcs:GetChildren()) do
					local maxHp = m:GetAttribute("MaxHP")
					local root = maxHp and m:FindFirstChild("HumanoidRootPart")
					if root then
						local d = (root.Position - hrp.Position).Magnitude
						if d < nd then nearest, nd = m, d end
					end
				end
			end
			if nearest then
				local hp, maxHp = nearest:GetAttribute("HP") or 0, nearest:GetAttribute("MaxHP") or 1
				bossBg.Visible = true
				bossFill.Size = UDim2.new(math.clamp(hp / maxHp, 0, 1), 0, 1, 0)
				bossText.Text = "👑 " .. nearest.Name .. "  ❤️ " .. Util.format(math.max(0, hp)) .. " / " .. Util.format(maxHp)
			else
				bossBg.Visible = false
			end
			local conf, maxConf = player:GetAttribute("Conf"), player:GetAttribute("MaxConf")
			if conf and maxConf and (nearest or conf < maxConf) then
				confBg.Visible = true
				local r = math.clamp(conf / maxConf, 0, 1)
				confFill.Size = UDim2.new(r, 0, 1, 0)
				confFill.BackgroundColor3 = r > 0.5 and C.green or (r > 0.25 and C.gold or C.red)
				confText.Text = "😎 Selbstbewusstsein " .. Util.format(conf) .. " / " .. Util.format(maxConf)
			else
				confBg.Visible = false
			end
		end
	end)

	State.onChange(Hud.update)
end

function Hud.toggleRide()
	local s = State.snap
	if not s then return end
	if s.data.vehicle == "" then
		Effects.toast("🛹 Kein Fahrzeug", "Kauf dir im Menü ✨ Style → Fahrzeuge ein Skateboard, Auto oder Hoverboard!", "")
		Menus.open("style", "vehicle")
		return
	end
	Remotes.ToggleRide:FireServer()
end

function Hud.update()
	local s = State.snap
	if not s then return end
	local d = s.data
	chips.aura.Text = Util.format(d.aura)
	chips.aps.Text = Util.format(s.aps)
	chips.cash.Text = Util.format(d.cash)
	chips.glow.Text = Util.format(s.glow)
	chips.reb.Text = tostring(d.rebirths)
	chips.gems.Text = Util.format(d.gems)
	if wheelDot then
		wheelDot.Visible = d.wheel.spins > 0 or os.time() - d.wheel.last >= Config.WHEEL_COOLDOWN
	end
	if eventBtn then
		local now = os.time()
		eventBtn.BackgroundColor3 = (Logic.activeEvent(now) or Logic.isWeekend(now)) and C.orange or C.grey
	end
	if rideBtn then
		local riding = game:GetService("Players").LocalPlayer:GetAttribute("Riding") == true
		rideBtn.BackgroundColor3 = riding and C.gold or C.green
	end
	routineSub.Text = "+" .. Util.format(s.click) .. " Aura pro Klick"

	local idx = Logic.titleIndex(s.glow)
	titleLabel.Text = "🏷️ " .. Config.Titles[idx].title
	local nextT = Config.Titles[idx + 1]
	if nextT then
		local prev = Config.Titles[idx].glow
		progressBar.Size = UDim2.new(math.clamp((s.glow - prev) / (nextT.glow - prev), 0, 1), 0, 1, 0)
		nextLabel.Text = "Nächster Titel: " .. nextT.title .. " (" .. Util.format(s.glow) .. "/" .. Util.format(nextT.glow) .. " Glow)"
	else
		progressBar.Size = UDim2.new(1, 0, 1, 0)
		nextLabel.Text = "Höchster Titel erreicht!"
	end
	if rewardsDot then
		rewardsDot.Visible = Menus.dailyReady()
	end
end

return Hud
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000021"><Properties><string name="Name">Menus</string><ProtectedString name="Source"><![CDATA[--[[
	MENUS – alle Menüfenster:
	💪 Upgrades · 🐾 Pets · 🌍 Welten · ♻️ Rebirth · 🏆 Rangliste · 🎁 Belohnungen · ⚙️ Einstellungen
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local UI = require(script.Parent:WaitForChild("UI"))
local State = require(script.Parent:WaitForChild("State"))
local Sounds = require(script.Parent:WaitForChild("Sounds"))
local Effects = require(script.Parent:WaitForChild("Effects"))
local CameraController = require(script.Parent:WaitForChild("CameraController"))
local PetView = require(script.Parent:WaitForChild("PetView"))
local Emotes = require(script.Parent:WaitForChild("Emotes"))
local UserInputService = game:GetService("UserInputService")

local Menus = {}
local window, titleLabel, content
local current = nil        -- Name des offenen Menüs
local refreshFn = nil      -- Aktualisierungsfunktion des offenen Menüs
local C = UI.C

local function snap() return State.snap end
local function data() return State.snap and State.snap.data end

----------------------------------------------------------------------------
-- Fenster
----------------------------------------------------------------------------
function Menus.init(gui)
	window = UI.panel(gui, { Name = "Window", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.52, 0),
		Size = UDim2.new(0.62, 0, 0.74, 0), Color = C.bg, Transparency = 0.03 })
	window.Visible = false
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		-- Handy: Fenster nutzt die frei werdende Höhe (Daily Routine verschwindet bei offenem Menü)
		window.Position = UDim2.new(0.5, 0, 0.5, 0)
		window.Size = UDim2.new(0.7, 0, 0.94, 0)
	end
	window.Active = true   -- Ziehen über dem Menü dreht nicht die Kamera
	UI.new("UISizeConstraint", { MinSize = Vector2.new(330, 300), MaxSize = Vector2.new(880, 620), Parent = window })
	UI.stroke(window, C.pink, 2, 0.2)
	local header = UI.panel(window, { Size = UDim2.new(1, 0, 0, 48), Color = C.panel })
	UI.gradient(header, C.pink, C.purple, 0)
	titleLabel = UI.text(header, "", { Size = UDim2.new(1, -60, 1, -8), Position = UDim2.new(0, 14, 0, 4), XAlign = Enum.TextXAlignment.Left, MaxText = 26 })
	UI.button(header, "✕", C.dark, function() Menus.close() end, { Size = UDim2.new(0, 38, 0, 38), Position = UDim2.new(1, -44, 0, 5), MaxText = 22 })
	content = UI.new("Frame", { Name = "Content", BackgroundTransparency = 1, Position = UDim2.new(0, 10, 0, 56),
		Size = UDim2.new(1, -20, 1, -64), Parent = window })

	State.onChange(function(kind)
		if refreshFn and window.Visible then
			refreshFn(kind)
		end
	end)
end

local BUILDERS = {}
local TITLES = {
	upgrades = "💪 Upgrades", pets = "🐾 Pets", worlds = "🌍 Welten", rebirth = "♻️ Rebirth",
	leaderboard = "🏆 Globale Rangliste", rewards = "🎁 Belohnungen", settings = "⚙️ Einstellungen",
	quests = "📋 Aufträge & Erfolge", jobs = "💼 Jobs", weapons = "⚔️ Waffen & Bosskampf", egginfo = "🎁 Box-Inhalt",
	shop = "💎 Shop", style = "✨ Ausrüstung", wheel = "🎡 Glücksrad & Geschenke", event = "🎉 Events",
}

local visibilityListeners = {}
function Menus.onVisibility(fn)
	table.insert(visibilityListeners, fn)
end
local function fireVisibility(open)
	for _, fn in ipairs(visibilityListeners) do pcall(fn, open) end
end

function Menus.open(name, arg)
	if not BUILDERS[name] or not State.snap then return end
	fireVisibility(true)
	UI.clear(content)
	for _, c in ipairs(content:GetChildren()) do c:Destroy() end
	current = name
	titleLabel.Text = TITLES[name]
	window.Visible = true
	refreshFn = BUILDERS[name](content, arg)
	if refreshFn then refreshFn("full") end
end

function Menus.close()
	window.Visible = false
	fireVisibility(false)
	current = nil
	refreshFn = nil
end

function Menus.toggle(name)
	if current == name and window.Visible then
		Menus.close()
	else
		Menus.open(name)
	end
end

----------------------------------------------------------------------------
-- 💪 UPGRADES
----------------------------------------------------------------------------
local upgradeTab = "skin"
local buyAmount = 1

BUILDERS.upgrades = function(root)
	local tabs = UI.scroll(root, { Size = UDim2.new(1, 0, 0, 40), Horizontal = true })
	UI.list(tabs, true, 6)
	local amountRow = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.new(0, 0, 0, 46), Parent = root })
	UI.list(amountRow, true, 6, Enum.HorizontalAlignment.Right)
	local list = UI.scroll(root, { Size = UDim2.new(1, 0, 1, -86), Position = UDim2.new(0, 0, 0, 86) })
	UI.list(list, false, 6)
	UI.padding(list, 2)

	local rows = {}
	local tabButtons = {}
	local amountButtons = {}

	local function buildRows()
		UI.clear(list)
		rows = {}
		local order = 0
		for _, u in ipairs(Config.Upgrades) do
			if u.cat == upgradeTab then
				order = order + 1
				local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 76), Color = C.panel2, LayoutOrder = order })
				UI.text(row, u.emoji, { Size = UDim2.new(0, 56, 1, 0), MaxText = 40 })
				local name = UI.text(row, "", { Size = UDim2.new(1, -200, 0.38, 0), Position = UDim2.new(0, 60, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 20 })
				local desc = UI.text(row, u.desc, { Size = UDim2.new(1, -200, 0.3, 0), Position = UDim2.new(0, 60, 0.4, 0), XAlign = Enum.TextXAlignment.Left,
					Font = Enum.Font.Gotham, Color = C.muted, MaxText = 14 })
				local parts = {}
				if u.aps > 0 then table.insert(parts, "+" .. Util.format(u.aps) .. " Aura/s") end
				if u.click > 0 then table.insert(parts, "+" .. Util.format(u.click) .. " pro Klick") end
				table.insert(parts, "+" .. u.glow .. " Glow")
				UI.text(row, table.concat(parts, " · ") .. " je Stufe", { Size = UDim2.new(1, -200, 0.26, 0), Position = UDim2.new(0, 60, 0.7, 0),
					XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, Color = C.green, MaxText = 13 })
				local btn = UI.button(row, "", C.gold, function()
					Remotes.BuyUpgrade:FireServer(u.id, buyAmount)
					Sounds.play("Buy")
				end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 128, 0, 54), TextColor = C.dark, MaxText = 18 })
				rows[u.id] = { name = name, btn = btn, u = u, desc = desc }
			end
		end
	end

	local function update()
		local d = data()
		for id, r in pairs(rows) do
			local level = Logic.level(d, id)
			r.name.Text = r.u.name .. "  <font color='" .. UI.hex(C.cyan) .. "' size='14'>Stufe " .. level .. "/" .. Config.MAX_LEVEL .. "</font>"
			if level >= Config.MAX_LEVEL then
				r.btn.Text = "✅ MAX"
				r.btn.BackgroundColor3 = C.grey
				r.btn.TextColor3 = C.text
			else
				local count, cost = Logic.bulk(r.u, level, buyAmount, d.aura)
				local affordable = cost <= d.aura
				r.btn.Text = Util.format(cost) .. " ✨\n<font size='12'>" .. (count > 1 and (count .. " Stufen") or "kaufen") .. "</font>"
				r.btn.BackgroundColor3 = affordable and C.gold or C.grey
				r.btn.TextColor3 = affordable and C.dark or C.muted
			end
		end
		for id, b in pairs(tabButtons) do
			b.BackgroundColor3 = (id == upgradeTab) and C.pink or C.panel2
		end
		for amt, b in pairs(amountButtons) do
			b.BackgroundColor3 = (tostring(buyAmount) == amt) and C.cyan or C.panel2
			b.TextColor3 = (tostring(buyAmount) == amt) and C.dark or C.text
		end
	end

	for i, cat in ipairs(Config.Categories) do
		tabButtons[cat.id] = UI.button(tabs, cat.emoji .. " " .. cat.name, C.panel2, function()
			upgradeTab = cat.id
			buildRows()
			update()
		end, { Size = UDim2.new(0, 150, 1, -6), LayoutOrder = i, MaxText = 16 })
	end
	UI.text(amountRow, "Menge:", { Size = UDim2.new(0, 70, 1, 0), LayoutOrder = 0, MaxText = 16, Color = C.muted })
	for i, amt in ipairs({ "1", "10", "max" }) do
		amountButtons[amt] = UI.button(amountRow, amt == "max" and "Max" or ("x" .. amt), C.panel2, function()
			buyAmount = (amt == "max") and "max" or tonumber(amt)
			update()
		end, { Size = UDim2.new(0, 64, 1, 0), LayoutOrder = i, MaxText = 16 })
	end

	buildRows()
	return function()
		update()
	end
end

----------------------------------------------------------------------------
-- 🐾 PETS
----------------------------------------------------------------------------
local selectedPet = nil

BUILDERS.pets = function(root)
	local info = UI.text(root, "", { Size = UDim2.new(0.7, 0, 0, 30), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxText = 16 })
	UI.button(root, "⭐ Beste ausrüsten", C.pink, function()
		Remotes.EquipBest:FireServer()
	end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.28, 0, 0, 32), MaxText = 16 })
	local grid = UI.scroll(root, { Size = UDim2.new(0.6, -6, 1, -42), Position = UDim2.new(0, 0, 0, 42) })
	UI.new("UIGridLayout", { CellSize = UDim2.new(0, 86, 0, 104), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder, Parent = grid })
	local detail = UI.panel(root, { Size = UDim2.new(0.4, -6, 1, -42), Position = UDim2.new(0.6, 6, 0, 42), Color = C.panel })
	UI.padding(detail, 10)

	local function showDetail()
		UI.clear(detail)
		local d = data()
		local pet = nil
		for _, p in ipairs(d.pets) do
			if p.uid == selectedPet then pet = p end
		end
		if not pet then
			UI.text(detail, "👈 Wähle ein Pet aus.\n\nPets folgen dir und geben dir Aura-Boosts. Öffne Geschenkboxen in jeder Welt, um neue zu finden!",
				{ Font = Enum.Font.GothamBold, Color = C.muted, MaxText = 16 })
			return
		end
		local def = Logic.petById[pet.id]
		local rarity = Config.Rarities[def.rarity]
		local tier = Config.PetTiers[pet.tier]
		PetView.make(detail, pet.id, pet.tier, true, { Size = UDim2.new(1, 0, 0.26, 0) })
		UI.text(detail, def.name, { Size = UDim2.new(1, 0, 0.09, 0), Position = UDim2.new(0, 0, 0.27, 0), MaxText = 22 })
		UI.text(detail, rarity.name .. (pet.tier > 1 and (" · " .. tier.name) or ""), { Size = UDim2.new(1, 0, 0.07, 0), Position = UDim2.new(0, 0, 0.36, 0),
			Color = tier.color or rarity.color, MaxText = 18 })
		UI.text(detail, Util.formatPercent(Logic.petBoost(pet)) .. " Aura", { Size = UDim2.new(1, 0, 0.07, 0), Position = UDim2.new(0, 0, 0.43, 0),
			Color = C.green, MaxText = 20 })
		local same = 0
		for _, p in ipairs(d.pets) do
			if p.id == pet.id and p.tier == pet.tier then same = same + 1 end
		end
		UI.button(detail, pet.eq and "Ablegen" or "Ausrüsten", pet.eq and C.grey or C.green, function()
			Remotes.EquipPet:FireServer(pet.uid, not pet.eq)
		end, { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.53, 0), TextColor = pet.eq and C.text or C.dark })
		if pet.tier < #Config.PetTiers then
			local nextTier = Config.PetTiers[pet.tier + 1]
			UI.button(detail, "🔮 Fusionieren (" .. same .. "/" .. Config.FUSE_COUNT .. ") → " .. nextTier.name, same >= Config.FUSE_COUNT and C.purple or C.grey, function()
				Remotes.FusePet:FireServer(pet.uid)
			end, { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.67, 0), MaxText = 16 })
		end
		UI.button(detail, "🗑️ Löschen", C.red, function()
			Effects.confirm("Pet löschen?", def.emoji .. " " .. def.name .. " wirklich löschen? Das kann man nicht rückgängig machen.", "Löschen", function()
				Remotes.DeletePet:FireServer(pet.uid)
				selectedPet = nil
			end)
		end, { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.81, 0) })
	end

	local function build()
		local s, d = snap(), data()
		local indexCount = 0
		for _ in pairs(d.index) do indexCount = indexCount + 1 end
		info.Text = "🐾 Ausgerüstet " .. Logic.equippedCount(d) .. "/" .. s.petSlots .. "  ·  🎒 " .. #d.pets .. "/" .. Config.MAX_PET_INVENTORY
			.. "  ·  Boost " .. Util.formatMult(s.petMult) .. "  ·  📖 " .. indexCount .. "/" .. #Config.Pets
		UI.clear(grid)
		local sorted = Util.copy(d.pets)
		table.sort(sorted, function(a, b)
			if a.eq ~= b.eq then return a.eq end
			return Logic.petBoost(a) > Logic.petBoost(b)
		end)
		for i, pet in ipairs(sorted) do
			local def = Logic.petById[pet.id]
			if def then
				local rarity = Config.Rarities[def.rarity]
				local tier = Config.PetTiers[pet.tier]
				local cell = UI.new("TextButton", { Text = "", AutoButtonColor = true, BackgroundColor3 = rarity.color:Lerp(Color3.new(0, 0, 0), 0.6),
					LayoutOrder = i, Parent = grid })
				UI.corner(cell, 10)
				UI.stroke(cell, tier.color or rarity.color, pet.uid == selectedPet and 4 or 2, 0)
				PetView.make(cell, pet.id, pet.tier, false, { Size = UDim2.new(1, 0, 0.56, 0) })
				UI.text(cell, Util.formatPercent(Logic.petBoost(pet)), { Size = UDim2.new(1, -4, 0.2, 0), Position = UDim2.new(0, 2, 0.56, 0), Color = C.green, MaxText = 13 })
				UI.text(cell, pet.tier > 1 and tier.name or rarity.name, { Size = UDim2.new(1, -4, 0.18, 0), Position = UDim2.new(0, 2, 0.78, 0),
					Color = tier.color or rarity.color, Font = Enum.Font.GothamBold, MaxText = 11 })
				if pet.eq then
					UI.text(cell, "✅", { Size = UDim2.new(0, 22, 0, 22), Position = UDim2.new(1, -24, 0, 2), MaxText = 18 })
				end
				cell.Activated:Connect(function()
					selectedPet = pet.uid
					build()
				end)
			end
		end
		if #sorted == 0 then
			UI.text(grid, "Noch keine Pets.\nGeh zur 🎁 Geschenkbox!", { Color = C.muted, MaxText = 16 })
		end
		showDetail()
	end

	return function(kind)
		if kind == "full" then build() end
	end
end

----------------------------------------------------------------------------
-- 🌍 WELTEN
----------------------------------------------------------------------------
BUILDERS.worlds = function(root)
	local list = UI.scroll(root)
	UI.list(list, false, 6)
	UI.padding(list, 2)
	local rows = {}
	for i, w in ipairs(Config.Worlds) do
		local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 70), Color = C.panel2, LayoutOrder = i })
		UI.stroke(row, w.accent, 2, 0.3)
		UI.text(row, w.emoji, { Size = UDim2.new(0, 60, 1, 0), MaxText = 40 })
		UI.text(row, "<b>" .. i .. ". " .. w.name .. "</b>  <font color='" .. UI.hex(C.gold) .. "'>Aura x" .. Util.format(w.mult) .. "</font>",
			{ Size = UDim2.new(1, -230, 0.5, 0), Position = UDim2.new(0, 64, 0, 4), XAlign = Enum.TextXAlignment.Left, MaxText = 20 })
		local req = UI.text(row, "", { Size = UDim2.new(1, -230, 0.4, 0), Position = UDim2.new(0, 64, 0.52, 0), XAlign = Enum.TextXAlignment.Left,
			Font = Enum.Font.GothamBold, Color = C.muted, MaxText = 14 })
		local btn = UI.button(row, "", C.cyan, function()
			Remotes.Teleport:FireServer(i)
			Menus.close()
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 150, 0, 48), MaxText = 16 })
		rows[i] = { req = req, btn = btn, w = w }
	end
	return function()
		local s, d = snap(), data()
		for i, r in ipairs(rows) do
			local w = r.w
			local unlocked = Logic.worldUnlocked(d, i)
			if s.world == i then
				r.req.Text = "📍 Du bist hier"
				r.btn.Text = "📍 Hier"
				r.btn.BackgroundColor3 = C.grey
			elseif unlocked then
				r.req.Text = "✅ Freigeschaltet"
				r.btn.Text = "🌀 Teleport"
				r.btn.BackgroundColor3 = C.cyan
				r.btn.TextColor3 = C.dark
			else
				local parts = { "💸 " .. Util.format(w.cost) .. " Aura" }
				if w.rebirths > 0 then table.insert(parts, "♻️ " .. w.rebirths .. " Rebirths") end
				r.req.Text = table.concat(parts, "  ·  ")
				local canBuy = Logic.worldUnlocked(d, i - 1) and d.aura >= w.cost and d.rebirths >= w.rebirths
				r.btn.Text = canBuy and "🔓 Freischalten" or "🔒 Gesperrt"
				r.btn.BackgroundColor3 = canBuy and C.gold or C.grey
				r.btn.TextColor3 = canBuy and C.dark or C.muted
			end
		end
	end
end

----------------------------------------------------------------------------
-- ♻️ REBIRTH
----------------------------------------------------------------------------
BUILDERS.rebirth = function(root)
	local top = UI.panel(root, { Size = UDim2.new(1, 0, 0.42, 0), Color = C.panel2 })
	UI.padding(top, 10)
	local infoL = UI.text(top, "", { Size = UDim2.new(0.62, 0, 0.62, 0), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxText = 17 })
	local barBg = UI.panel(top, { Size = UDim2.new(0.62, 0, 0.12, 0), Position = UDim2.new(0, 0, 0.66, 0), Color = C.dark, Radius = 8 })
	local bar = UI.panel(barBg, { Size = UDim2.new(0, 0, 1, 0), Color = C.green, Radius = 8 })
	UI.gradient(bar, C.pink, C.gold, 0)
	UI.text(top, "Aura & Upgrades werden zurückgesetzt. Pets, Welten, Geld und Perks bleiben!", { Size = UDim2.new(0.62, 0, 0.18, 0),
		Position = UDim2.new(0, 0, 0.82, 0), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.Gotham, Color = C.muted, MaxText = 13 })
	local rbBtn = UI.button(top, "♻️ REBIRTH!", C.gold, function()
		local s = snap()
		Effects.confirm("♻️ Rebirth machen?", "Du startest mit Aura und Upgrades neu, bekommst aber dauerhaft x" .. Util.format(Logic.rebirthMult(s.data.rebirths + 1))
			.. " Aura und " .. Logic.rebirthPointsFor(s.data.rebirths + 1) .. " Rebirth-Punkte.", "Rebirth!", function()
			Remotes.Rebirth:FireServer()
			Sounds.play("Rebirth")
		end)
	end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0.34, 0, 0.5, 0), TextColor = C.dark, MaxText = 26 })

	local shopTitle = UI.text(root, "", { Size = UDim2.new(1, 0, 0, 30), Position = UDim2.new(0, 0, 0.44, 4), XAlign = Enum.TextXAlignment.Left, MaxText = 20 })
	local list = UI.scroll(root, { Size = UDim2.new(1, 0, 0.56, -40), Position = UDim2.new(0, 0, 0.44, 40) })
	UI.list(list, false, 6)
	UI.padding(list, 2)
	local rows = {}
	for i, perk in ipairs(Config.RebirthShop) do
		local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 60), Color = C.panel2, LayoutOrder = i })
		UI.text(row, perk.emoji, { Size = UDim2.new(0, 50, 1, 0), MaxText = 32 })
		local name = UI.text(row, "", { Size = UDim2.new(1, -200, 0.5, 0), Position = UDim2.new(0, 54, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
		UI.text(row, perk.desc, { Size = UDim2.new(1, -200, 0.42, 0), Position = UDim2.new(0, 54, 0.54, 0), XAlign = Enum.TextXAlignment.Left,
			Font = Enum.Font.Gotham, Color = C.muted, MaxText = 13 })
		local btn = UI.button(row, "", C.cyan, function()
			Remotes.BuyPerk:FireServer(perk.id)
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 120, 0, 42), MaxText = 16 })
		rows[perk.id] = { name = name, btn = btn, perk = perk }
	end

	return function()
		local s, d = snap(), data()
		local cost = s.rebirthCost
		infoL.Text = "♻️ Rebirths: <font color='" .. UI.hex(C.cyan) .. "'>" .. d.rebirths .. "</font>\n"
			.. "Multiplikator: x" .. Util.format(Logic.rebirthMult(d.rebirths)) .. " → <font color='" .. UI.hex(C.green) .. "'>x"
			.. Util.format(Logic.rebirthMult(d.rebirths + 1)) .. "</font>\n"
			.. "Kosten: <font color='" .. UI.hex(C.gold) .. "'>" .. Util.format(cost) .. " Aura</font>"
		bar.Size = UDim2.new(math.clamp(d.aura / cost, 0, 1), 0, 1, 0)
		local can = d.aura >= cost
		rbBtn.BackgroundColor3 = can and C.gold or C.grey
		rbBtn.TextColor3 = can and C.dark or C.muted
		shopTitle.Text = "🛒 Rebirth-Shop  ·  <font color='" .. UI.hex(C.cyan) .. "'>" .. d.rebirthPoints .. " Rebirth-Punkte</font>"
		for id, r in pairs(rows) do
			local level = Logic.perkLevel(d, id)
			r.name.Text = r.perk.name .. "  <font size='13' color='" .. UI.hex(C.cyan) .. "'>" .. level .. "/" .. r.perk.max .. "</font>"
			if level >= r.perk.max then
				r.btn.Text = "✅ MAX"
				r.btn.BackgroundColor3 = C.grey
			else
				local pc = Logic.perkCost(r.perk, level)
				r.btn.Text = pc .. " RP"
				r.btn.BackgroundColor3 = d.rebirthPoints >= pc and C.cyan or C.grey
				r.btn.TextColor3 = d.rebirthPoints >= pc and C.dark or C.muted
			end
		end
	end
end

----------------------------------------------------------------------------
-- 🏆 RANGLISTE
----------------------------------------------------------------------------
BUILDERS.leaderboard = function(root)
	local header = UI.text(root, "Lädt …", { Size = UDim2.new(1, -130, 0, 34), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxText = 16 })
	local list = UI.scroll(root, { Size = UDim2.new(1, 0, 1, -42), Position = UDim2.new(0, 0, 0, 42) })
	UI.list(list, false, 4)
	UI.padding(list, 2)
	local me = Players.LocalPlayer.UserId

	local function load()
		header.Text = "Lädt …"
		task.spawn(function()
			local ok, result = pcall(function()
				return Remotes:WaitForChild("GetLeaderboard"):InvokeServer()
			end)
			if not list.Parent then return end
			UI.clear(list)
			if not ok or not result or not result.available then
				header.Text = "Rangliste nicht verfügbar (in Studio: API-Zugriff aktivieren)."
				return
			end
			local myRank = nil
			for i, e in ipairs(result.list) do
				if e.userId == me then myRank = e.rank end
				local isMe = e.userId == me
				local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 34), Color = isMe and C.purple or C.panel2, LayoutOrder = i, Radius = 8 })
				local medal = ({ "🥇", "🥈", "🥉" })[e.rank] or ("#" .. e.rank)
				UI.text(row, medal, { Size = UDim2.new(0, 60, 1, 0), MaxText = 18 })
				UI.text(row, e.name, { Size = UDim2.new(1, -220, 1, 0), Position = UDim2.new(0, 64, 0, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 17 })
				UI.text(row, "✨ " .. Util.format(e.value), { Size = UDim2.new(0, 150, 1, 0), Position = UDim2.new(1, -156, 0, 0),
					XAlign = Enum.TextXAlignment.Right, Color = C.gold, MaxText = 17 })
			end
			local power = snap() and snap().glowPower or 0
			if myRank then
				header.Text = "Dein Platz: <font color='" .. UI.hex(C.gold) .. "'>#" .. myRank .. "</font> · Glow-Power: " .. Util.format(power)
			else
				header.Text = "Du bist (noch) nicht in den Top " .. Config.LEADERBOARD_SIZE .. " · deine Glow-Power: " .. Util.format(power)
			end
			if #result.list == 0 then
				UI.text(list, "Noch keine Einträge. Die Rangliste aktualisiert sich alle 2 Minuten.", { Color = C.muted, MaxText = 16, Size = UDim2.new(1, 0, 0, 60) })
			end
		end)
	end
	UI.button(root, "🔄 Neu laden", C.panel2, load, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0, 120, 0, 34), MaxText = 15 })
	load()
	return nil
end

----------------------------------------------------------------------------
-- 🎁 BELOHNUNGEN: tägliche Serie, Codes, Tränke
----------------------------------------------------------------------------
local function rewardText(r)
	local parts = {}
	if r.cash then table.insert(parts, "💵 " .. Util.format(r.cash)) end
	if r.auraSeconds then table.insert(parts, "✨ " .. r.auraSeconds .. "s Aura") end
	if r.potion then table.insert(parts, Logic.potionById[r.potion].emoji .. " Trank") end
	if r.freeEgg then table.insert(parts, "🎁 Box") end
	return table.concat(parts, "\n")
end

function Menus.dailyReady()
	local d = data()
	if not d then return false end
	return os.time() - d.daily.last >= 20 * 3600
end

BUILDERS.rewards = function(root)
	UI.text(root, "📅 Tägliche Belohnung (7-Tage-Serie)", { Size = UDim2.new(1, 0, 0, 26), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
	local days = UI.new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 92), Position = UDim2.new(0, 0, 0, 28), Parent = root })
	UI.list(days, true, 6, Enum.HorizontalAlignment.Center)
	local dayCells = {}
	for i, r in ipairs(Config.Daily) do
		local cell = UI.panel(days, { Size = UDim2.new(1 / 7, -6, 1, 0), Color = C.panel2, LayoutOrder = i, Radius = 10 })
		UI.padding(cell, 4)
		UI.text(cell, "Tag " .. i, { Size = UDim2.new(1, 0, 0.28, 0), MaxText = 15 })
		UI.text(cell, rewardText(r), { Size = UDim2.new(1, 0, 0.7, 0), Position = UDim2.new(0, 0, 0.3, 0), Font = Enum.Font.GothamBold, Color = C.muted, MaxText = 12 })
		dayCells[i] = cell
	end
	local claim = UI.button(root, "", C.gold, function()
		Remotes.ClaimDaily:FireServer()
	end, { Size = UDim2.new(1, 0, 0, 40), Position = UDim2.new(0, 0, 0, 126), TextColor = C.dark, MaxText = 18 })

	UI.text(root, "🎟️ Code einlösen", { Size = UDim2.new(0.5, 0, 0, 24), Position = UDim2.new(0, 0, 0, 174), XAlign = Enum.TextXAlignment.Left, MaxText = 17 })
	local box = UI.new("TextBox", { Size = UDim2.new(0.65, -6, 0, 38), Position = UDim2.new(0, 0, 0, 200), BackgroundColor3 = C.dark,
		TextColor3 = C.text, PlaceholderText = "z. B. MEWING2026", PlaceholderColor3 = C.muted, Text = "", ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold, TextScaled = true, Parent = root })
	UI.corner(box, 10)
	UI.padding(box, 6)
	UI.button(root, "Einlösen", C.pink, function()
		Remotes.RedeemCode:FireServer(box.Text)
		box.Text = ""
	end, { Size = UDim2.new(0.35, 0, 0, 38), Position = UDim2.new(0.65, 0, 0, 200), MaxText = 18 })

	UI.text(root, "🧪 Tränke (kosten Geld)", { Size = UDim2.new(0.6, 0, 0, 24), Position = UDim2.new(0, 0, 0, 246), XAlign = Enum.TextXAlignment.Left, MaxText = 17 })
	local list = UI.scroll(root, { Size = UDim2.new(1, 0, 1, -276), Position = UDim2.new(0, 0, 0, 274) })
	UI.list(list, false, 6)
	UI.padding(list, 2)
	local potionRows = {}
	for i, p in ipairs(Config.Potions) do
	if not p.hidden then
		local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 56), Color = C.panel2, LayoutOrder = i })
		UI.text(row, p.emoji, { Size = UDim2.new(0, 46, 1, 0), MaxText = 30 })
		UI.text(row, p.name, { Size = UDim2.new(1, -190, 0.5, 0), Position = UDim2.new(0, 50, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 17 })
		local sub = UI.text(row, p.desc, { Size = UDim2.new(1, -190, 0.42, 0), Position = UDim2.new(0, 50, 0.54, 0), XAlign = Enum.TextXAlignment.Left,
			Font = Enum.Font.Gotham, Color = C.muted, MaxText = 13 })
		local btn = UI.button(row, "💵 " .. Util.format(p.price), C.money, function()
			Remotes.BuyPotion:FireServer(p.id)
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 120, 0, 40), TextColor = C.dark, MaxText = 16 })
		potionRows[p.id] = { sub = sub, btn = btn, p = p }
	end
	end

	return function()
		local d = data()
		local streak = d.daily.streak
		local remaining = d.daily.last + 20 * 3600 - os.time()
		local ready = remaining <= 0
		local nextDay = (ready and os.time() - d.daily.last > 48 * 3600) and 1 or ((streak % #Config.Daily) + 1)
		for i, cell in ipairs(dayCells) do
			cell.BackgroundColor3 = (i == nextDay and ready) and C.pink or ((i <= streak and not (ready and nextDay == 1)) and C.purple or C.panel2)
		end
		claim.Text = ready and ("🎁 Tag " .. nextDay .. " abholen!") or ("⏳ Nächste Belohnung in " .. Util.formatTime(remaining))
		claim.BackgroundColor3 = ready and C.gold or C.grey
		local now = os.time()
		for id, r in pairs(potionRows) do
			local untilTime = d.potions[id]
			if untilTime and untilTime > now then
				r.sub.Text = "<font color='" .. UI.hex(C.green) .. "'>Aktiv: noch " .. Util.formatTime(untilTime - now) .. "</font>"
			else
				r.sub.Text = r.p.desc
			end
			r.btn.BackgroundColor3 = d.cash >= r.p.price and C.money or C.grey
		end
	end
end

----------------------------------------------------------------------------
-- ⚙️ EINSTELLUNGEN
----------------------------------------------------------------------------
BUILDERS.settings = function(root)
	UI.list(root, false, 10)
	local musicBtn, sfxBtn, camBtn
	local function update()
		local d = data()
		if camBtn then
			local on = CameraController.isMouseLook()
			camBtn.Text = "🖱️ Maus-Kamera (Taste Strg): " .. (on and "AN" or "AUS")
			camBtn.BackgroundColor3 = on and C.green or C.grey
		end
		musicBtn.Text = "🎵 Musik: " .. (d.settings.music and "AN" or "AUS")
		musicBtn.BackgroundColor3 = d.settings.music and C.green or C.grey
		sfxBtn.Text = "🔊 Soundeffekte: " .. (d.settings.sfx and "AN" or "AUS")
		sfxBtn.BackgroundColor3 = d.settings.sfx and C.green or C.grey
	end
	musicBtn = UI.button(root, "", C.green, function()
		local d = data()
		d.settings.music = not d.settings.music
		Sounds.setMusic(d.settings.music)
		Remotes.Setting:FireServer("music", d.settings.music)
		update()
	end, { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 1, TextColor = C.dark })
	sfxBtn = UI.button(root, "", C.green, function()
		local d = data()
		d.settings.sfx = not d.settings.sfx
		Sounds.setSfx(d.settings.sfx)
		Remotes.Setting:FireServer("sfx", d.settings.sfx)
		update()
	end, { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 2, TextColor = C.dark })
	if UserInputService.MouseEnabled then
		camBtn = UI.button(root, "", C.grey, function()
			CameraController.setMouseLook(not CameraController.isMouseLook())
			update()
		end, { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 3, TextColor = C.dark })
	end
	UI.text(root, UserInputService.TouchEnabled and not UserInputService.MouseEnabled
		and "📱 Kamera: mit einem Finger wischen = drehen · zwei Finger = zoomen"
		or "🖱️ Kamera: Maustaste gedrückt halten und ziehen = drehen · Mausrad = zoomen · Strg = Maus-Kamera",
		{ Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 4, Font = Enum.Font.GothamBold, Color = C.cyan, MaxText = 15 })
	local s = snap()
	local d = data()
	UI.text(root, (s.saving and "💾 Dein Spielstand wird automatisch gespeichert." or "⚠️ Speichern ist gerade aus.")
		.. "\n\n📊 Klicks: " .. Util.format(d.clicks) .. "  ·  🎁 Boxen geöffnet: " .. Util.format(d.eggsOpened)
		.. "\n⚔️ Mog-Siege: " .. d.mogWins .. "  ·  Niederlagen: " .. d.mogLosses .. "  ·  👑 Boss-Siege: " .. d.bossWins
		.. "\n🌌 Aura insgesamt: " .. Util.format(d.totalAura),
		{ Size = UDim2.new(1, 0, 0, 130), LayoutOrder = 5, Font = Enum.Font.GothamBold, Color = C.muted, MaxText = 16 })
	update()
	return nil
end

----------------------------------------------------------------------------
-- 📋 AUFTRÄGE & ERFOLGE
----------------------------------------------------------------------------
local function progressBar(parent, ratio, props)
	local bg = UI.panel(parent, { Size = props.Size, Position = props.Position, Color = C.dark, Radius = 6 })
	local fill = UI.panel(bg, { Size = UDim2.new(math.clamp(ratio, 0, 1), 0, 1, 0), Color = C.green, Radius = 6 })
	UI.gradient(fill, C.pink, C.gold, 0)
	return bg
end

BUILDERS.quests = function(root)
	local list = UI.scroll(root)
	UI.list(list, false, 6)
	UI.padding(list, 2)

	local function build()
		UI.clear(list)
		local d = data()
		local order = 0
		local function nextOrder() order = order + 1; return order end
		local left = 86400 - (os.time() % 86400)
		UI.text(list, "📋 Heutige Aufträge  <font size='14' color='" .. UI.hex(C.muted) .. "'>(neue in " .. Util.formatTime(left) .. ")</font>",
			{ Size = UDim2.new(1, -10, 0, 28), XAlign = Enum.TextXAlignment.Left, MaxText = 20, LayoutOrder = nextOrder() })
		local allDone = #d.quests.list > 0
		for i, q in ipairs(d.quests.list) do
			local prog = Logic.questProgress(d, q)
			local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 62), Color = C.panel2, LayoutOrder = nextOrder() })
			UI.text(row, q.text, { Size = UDim2.new(1, -150, 0.5, 0), Position = UDim2.new(0, 10, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 17 })
			progressBar(row, prog / q.goal, { Size = UDim2.new(1, -170, 0, 10), Position = UDim2.new(0, 10, 0.62, 0) })
			UI.text(row, math.min(prog, q.goal) .. "/" .. q.goal, { Size = UDim2.new(0, 60, 0.3, 0), Position = UDim2.new(1, -210, 0.55, 0), Color = C.muted, MaxText = 13 })
			if not q.claimed then allDone = false end
			local can = prog >= q.goal and not q.claimed
			UI.button(row, q.claimed and "✅ Erledigt" or (can and "🎁 Abholen" or "💵 " .. Config.QuestReward.cash), can and C.gold or C.grey, function()
				Remotes.ClaimQuest:FireServer(i)
			end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 124, 0, 42), TextColor = can and C.dark or C.text, MaxText = 16 })
		end
		local bonusRow = UI.panel(list, { Size = UDim2.new(1, -10, 0, 50), Color = C.purple, LayoutOrder = nextOrder() })
		UI.text(bonusRow, "🏆 Alle Aufträge geschafft: 💵 " .. Config.QuestBonus.cash .. " + 🎁 gratis Box", { Size = UDim2.new(1, -150, 1, 0), Position = UDim2.new(0, 10, 0, 0),
			XAlign = Enum.TextXAlignment.Left, MaxText = 16 })
		local canBonus = allDone and not d.quests.bonus
		UI.button(bonusRow, d.quests.bonus and "✅ Abgeholt" or "Abholen", canBonus and C.gold or C.grey, function()
			Remotes.ClaimQuestBonus:FireServer()
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 124, 0, 38), TextColor = canBonus and C.dark or C.text, MaxText = 16 })

		UI.text(list, "🏅 Erfolge", { Size = UDim2.new(1, -10, 0, 30), XAlign = Enum.TextXAlignment.Left, MaxText = 20, LayoutOrder = nextOrder() })
		for _, ach in ipairs(Config.Achievements) do
			local claimed = d.achievements[ach.id] or 0
			local value = Logic.statValue(d, ach.stat)
			local goal = ach.tiers[claimed + 1]
			local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 64), Color = C.panel2, LayoutOrder = nextOrder() })
			UI.text(row, ach.emoji, { Size = UDim2.new(0, 50, 1, 0), MaxText = 30 })
			local stars = string.rep("⭐", claimed) .. string.rep("☆", #ach.tiers - claimed)
			UI.text(row, ach.name .. "  " .. stars, { Size = UDim2.new(1, -200, 0.45, 0), Position = UDim2.new(0, 54, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 17 })
			if goal then
				UI.text(row, Util.format(math.min(value, goal)) .. " / " .. Util.format(goal) .. " " .. ach.text, { Size = UDim2.new(1, -200, 0.25, 0), Position = UDim2.new(0, 54, 0.46, 0),
					XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, Color = C.muted, MaxText = 13 })
				progressBar(row, value / goal, { Size = UDim2.new(1, -210, 0, 8), Position = UDim2.new(0, 54, 0.8, 0) })
				local can = value >= goal
				local r = Logic.achievementReward(claimed + 1)
				UI.button(row, can and "🎁 Abholen" or ("💵 " .. Util.format(r.cash)), can and C.gold or C.grey, function()
					Remotes.ClaimAchievement:FireServer(ach.id)
				end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 124, 0, 42), TextColor = can and C.dark or C.text, MaxText = 16 })
			else
				UI.text(row, "🏆 Alle Stufen geschafft!", { Size = UDim2.new(1, -70, 0.4, 0), Position = UDim2.new(0, 54, 0.5, 0),
					XAlign = Enum.TextXAlignment.Left, Color = C.gold, MaxText = 15 })
			end
		end
	end

	return function(kind)
		if kind == "full" then build() end
	end
end

----------------------------------------------------------------------------
-- 💼 JOBS
----------------------------------------------------------------------------
BUILDERS.jobs = function(root)
	local info = UI.text(root, "", { Size = UDim2.new(1, 0, 0, 30), XAlign = Enum.TextXAlignment.Left, Font = Enum.Font.GothamBold, MaxText = 15 })
	local list = UI.scroll(root, { Size = UDim2.new(1, 0, 1, -36), Position = UDim2.new(0, 0, 0, 36) })
	UI.list(list, false, 6)
	UI.padding(list, 2)
	local rows = {}
	for i, job in ipairs(Config.Jobs) do
		local row = UI.panel(list, { Size = UDim2.new(1, -10, 0, 76), Color = C.panel2, LayoutOrder = i })
		UI.text(row, job.emoji, { Size = UDim2.new(0, 56, 1, 0), MaxText = 38 })
		UI.text(row, job.name, { Size = UDim2.new(1, -200, 0.36, 0), Position = UDim2.new(0, 60, 0.04, 0), XAlign = Enum.TextXAlignment.Left, MaxText = 18 })
		UI.text(row, job.desc, { Size = UDim2.new(1, -200, 0.3, 0), Position = UDim2.new(0, 60, 0.4, 0), XAlign = Enum.TextXAlignment.Left,
			Font = Enum.Font.Gotham, Color = C.muted, MaxText = 13 })
		local eff = UI.text(row, "", { Size = UDim2.new(1, -200, 0.26, 0), Position = UDim2.new(0, 60, 0.7, 0), XAlign = Enum.TextXAlignment.Left,
			Font = Enum.Font.GothamBold, Color = C.green, MaxText = 13 })
		local btn = UI.button(row, "", C.cyan, function()
			local d = data()
			if Logic.baseGlow(d.levels) < job.req or (d.jobCd[job.id] or 0) > os.time() then return end
			Remotes.StartJob:FireServer(job.id)
			Menus.close()
			Effects.jobGame(job, function(scores)
				Remotes.FinishJob:FireServer(job.id, scores)
			end)
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.new(0, 128, 0, 48), MaxText = 16 })
		rows[job.id] = { eff = eff, btn = btn, job = job }
	end
	return function()
		local d = data()
		local glow = Logic.baseGlow(d.levels)
		info.Text = "💵 Lohn-Bonus durch Glow & Rebirths: <font color='" .. UI.hex(C.gold) .. "'>" .. Util.formatMult(Logic.jobPayMult(d)) .. "</font>  ·  Geld gibt's für Waffen & Tränke"
		local now = os.time()
		for _, r in pairs(rows) do
			local job = r.job
			r.eff.Text = "💵 bis zu " .. Util.format(Logic.jobPay(d, job) * 1.25) .. " · ⏱️ Pause " .. job.cd .. " s · ab " .. Util.format(job.req) .. " Glow"
			local cd = (d.jobCd[job.id] or 0) - now
			if glow < job.req then
				r.btn.Text = "🔒 " .. Util.format(job.req) .. " Glow"
				r.btn.BackgroundColor3 = C.grey
				r.btn.TextColor3 = C.muted
			elseif cd > 0 then
				r.btn.Text = "⏳ " .. Util.formatTime(cd)
				r.btn.BackgroundColor3 = C.grey
				r.btn.TextColor3 = C.text
			else
				r.btn.Text = "💼 Arbeiten"
				r.btn.BackgroundColor3 = C.cyan
				r.btn.TextColor3 = C.dark
			end
		end
	end
end

