-- 🎡 GLÜCKSRAD & SPIELZEIT-GESCHENKE
-- Glücksrad: 1x pro Tag gratis (+ Drehungen aus Spielzeit-Geschenken). Kein Robux-Kauf (Roblox-Regeln für Zufall).
----------------------------------------------------------------------------
Config.WHEEL_COOLDOWN = 20 * 3600
Config.Wheel = {
	{ label = "💵 Geld",          weight = 25, color = EC(124, 252, 154), reward = { cash = 500, scale = true } },
	{ label = "💵 Viel Geld",     weight = 12, color = EC(80, 200, 120),  reward = { cash = 2500, scale = true } },
	{ label = "💎 10 Gems",       weight = 15, color = EC(120, 200, 255), reward = { gems = 10 } },
	{ label = "💎 50 Gems",       weight = 4,  color = EC(60, 140, 255),  reward = { gems = 50 } },
	{ label = "🧪 Aura-Trank",    weight = 14, color = EC(255, 120, 220), reward = { potion = "aura2" } },
	{ label = "🍀 Glücks-Trank",  weight = 12, color = EC(120, 230, 120), reward = { potion = "luck2" } },
	{ label = "🥈 Silber-Box",    weight = 12, color = EC(200, 205, 215), reward = { freeEgg = 2 } },
	{ label = "🌈 Göttliche Box", weight = 1,  color = EC(255, 120, 240), reward = { freeEgg = 5 } },
	{ label = "✨ 10 Min. Aura",  weight = 5,  color = EC(255, 209, 102), reward = { auraSeconds = 600 } },
}
Config.PlaytimeGifts = {
	{ minutes = 5,  label = "💵 Geld",           reward = { cash = 300, scale = true } },
	{ minutes = 10, label = "🎡 Glücksrad-Dreh", reward = { spins = 1 } },
	{ minutes = 20, label = "🧪 Aura-Trank",     reward = { potion = "aura2" } },
	{ minutes = 30, label = "💎 15 Gems",        reward = { gems = 15 } },
	{ minutes = 45, label = "🥈 Silber-Box",     reward = { freeEgg = 2 } },
	{ minutes = 60, label = "🎡 2 Drehungen",    reward = { spins = 2 } },
}

----------------------------------------------------------------------------
-- 💎 ROBUX-SHOP
-- Die IDs musst du im Creator Hub anlegen und hier eintragen (siehe ANLEITUNG.md).
-- id = 0 → im Spiel steht "Bald verfügbar".
----------------------------------------------------------------------------
Config.GamePasses = {
	{ key = "vip",      id = 2100196859, emoji = "👑", name = "VIP",               robux = 299, desc = "+25 % Aura & Geld, goldenes VIP-Namensschild." },
	{ key = "x2aura",   id = 2100370934, emoji = "✨", name = "Doppelte Aura",     robux = 399, desc = "Für immer x2 Aura." },
	{ key = "lucky",    id = 2099398873, emoji = "🍀", name = "Glückspilz",        robux = 249, desc = "Für immer x2 Glück beim Box-Öffnen." },
	{ key = "petslots", id = 2098714908, emoji = "🐾", name = "+3 Pet-Plätze",     robux = 299, desc = "3 Pets mehr gleichzeitig ausrüsten." },
	{ key = "triple",   id = 2098366898, emoji = "🎁", name = "3er-Öffnen",        robux = 199, desc = "Öffne 3 Boxen auf einmal – sofort, ohne Rebirth-Shop." },
	{ key = "speed",    id = 2099392903, emoji = "⚡", name = "Turbo-Laufen",      robux = 99,  desc = "+8 Laufgeschwindigkeit für immer." },
}
Config.DevProducts = {
	{ key = "gems100",  id = 3735709644, emoji = "💎", name = "100 Gems",          robux = 49,  reward = { gems = 100 } },
	{ key = "gems550",  id = 3735709693, emoji = "💎", name = "550 Gems",          robux = 199, reward = { gems = 550 } },
	{ key = "gems1200", id = 3735709713, emoji = "💎", name = "1.200 Gems",        robux = 399, reward = { gems = 1200 } },
	{ key = "gems3000", id = 3735709732, emoji = "💎", name = "3.000 Gems",        robux = 899, reward = { gems = 3000 } },
	{ key = "starter",  id = 3735709751, emoji = "🎁", name = "Starter-Paket",     robux = 99,  once = true,
	  reward = { gems = 150, cash = 2000, scale = true, potion = "aura2" }, desc = "Nur einmal kaufbar!" },
	{ key = "aurapack", id = 3735709765, emoji = "✨", name = "Aura-Paket",        robux = 79,  reward = { auraSeconds = 900 }, desc = "Sofort 15 Minuten deiner Aura/s." },
}

----------------------------------------------------------------------------
-- 🛹 FAHRZEUGE (Taste V = aufsteigen/absteigen)
-- currency = "cash" (Geld) oder "gems"
----------------------------------------------------------------------------
Config.Vehicles = {
	{ id = "skateboard", emoji = "🛹", name = "Skateboard",        speed = 8,  jump = 0,  price = 2000,  currency = "cash", plan = "board" },
	{ id = "scooter",    emoji = "🛴", name = "E-Scooter",         speed = 14, jump = 0,  price = 50000, currency = "cash", plan = "scooter" },
	{ id = "sportwagen", emoji = "🏎️", name = "Sportwagen",        speed = 24, jump = 0,  price = 5e6,   currency = "cash", plan = "car" },
	{ id = "hoverboard", emoji = "🛸", name = "Hoverboard",        speed = 30, jump = 20, price = 400,   currency = "gems", plan = "hover" },
	{ id = "goldcar",    emoji = "🚗", name = "Gold-Sportwagen",   speed = 36, jump = 0,  price = 1500,  currency = "gems", plan = "car", gold = true },
}

----------------------------------------------------------------------------
-- ✨ AUSRÜSTUNG: Auren, Spuren, Hüte (mit Boosts), Emotes
----------------------------------------------------------------------------
Config.Auras = {
	{ id = "aura_pink",    emoji = "💖", name = "Pinke Glitzer-Aura", price = 1000,  currency = "cash", style = "sparkle", color = EC(255, 120, 220) },
	{ id = "aura_fire",    emoji = "🔥", name = "Feuer-Aura",         price = 25000, currency = "cash", style = "fire",    color = EC(255, 120, 30) },
	{ id = "aura_ice",     emoji = "❄️", name = "Eis-Aura",           price = 250000, currency = "cash", style = "sparkle", color = EC(140, 220, 255) },
	{ id = "aura_gold",    emoji = "🌟", name = "Gold-Aura",          price = 2.5e6, currency = "cash", style = "sparkle", color = EC(255, 205, 60), strong = true },
	{ id = "aura_dark",    emoji = "🌑", name = "Dunkle Aura",        price = 2.5e7, currency = "cash", style = "smoke",   color = EC(70, 20, 110) },
	{ id = "aura_rainbow", emoji = "🌈", name = "Regenbogen-Aura",    price = 500,   currency = "gems", style = "rainbow", color = EC(255, 255, 255), strong = true },
}
Config.Trails = {
	{ id = "trail_pink",    emoji = "💗", name = "Pinke Spur",       price = 5000,  currency = "cash", c1 = EC(255, 120, 220), c2 = EC(255, 255, 255) },
	{ id = "trail_fire",    emoji = "🔥", name = "Feuer-Spur",       price = 100000, currency = "cash", c1 = EC(255, 220, 60), c2 = EC(255, 60, 20) },
	{ id = "trail_neon",    emoji = "💠", name = "Neon-Spur",        price = 2e6,   currency = "cash", c1 = EC(62, 242, 255), c2 = EC(155, 92, 255) },
	{ id = "trail_rainbow", emoji = "🌈", name = "Regenbogen-Spur",  price = 300,   currency = "gems", rainbow = true },
	{ id = "trail_galaxy",  emoji = "🌌", name = "Galaxie-Spur",     price = 800,   currency = "gems", c1 = EC(120, 60, 255), c2 = EC(20, 10, 40) },
}
-- Hüte geben Boosts: aura/cash/luck = Prozent (0.1 = +10 %), speed = Laufgeschwindigkeit
Config.Hats = {
	{ id = "cap",        emoji = "🧢", name = "Gym-Cap",            price = 3000,   currency = "cash", boost = { aura = 0.05 } },
	{ id = "headphones", emoji = "🎧", name = "Phonk-Kopfhörer",    price = 60000,  currency = "cash", boost = { cash = 0.05, speed = 3 } },
	{ id = "cowboy",     emoji = "🤠", name = "Sheriff-Hut",        price = 800000, currency = "cash", boost = { cash = 0.1 } },
	{ id = "halo",       emoji = "😇", name = "Heiligenschein",     price = 1e7,    currency = "cash", boost = { aura = 0.15 } },
	{ id = "crown",      emoji = "👑", name = "Gigachad-Krone",     price = 2e8,    currency = "cash", boost = { aura = 0.25 } },
	{ id = "viking",     emoji = "🪖", name = "Wikinger-Helm",      price = 600,    currency = "gems", boost = { luck = 0.15 } },
	{ id = "diamond",    emoji = "💎", name = "Diamant-Krone",      price = 1500,   currency = "gems", boost = { aura = 0.3, luck = 0.1 } },
}
-- Emotes (Standard-Roblox-Animationen für R15)
Config.Emotes = {
	{ id = "wave",   emoji = "👋", name = "Winken",       price = 0,     currency = "cash", anim = "rbxassetid://507770239" },
	{ id = "cheer",  emoji = "🙌", name = "Jubeln",       price = 1000,  currency = "cash", anim = "rbxassetid://507770677" },
	{ id = "laugh",  emoji = "😂", name = "Lachen",       price = 5000,  currency = "cash", anim = "rbxassetid://507770818" },
	{ id = "dance",  emoji = "🕺", name = "Tanzen",       price = 25000, currency = "cash", anim = "rbxassetid://507771019" },
	{ id = "mewing", emoji = "🗿", name = "Mewing-Pose",  price = 100,   currency = "gems", anim = "rbxassetid://507770453", bubble = "*mewt intensiv* 🗿" },
}

----------------------------------------------------------------------------
-- 🏃 MINISPIELE
----------------------------------------------------------------------------
Config.OBBY_COOLDOWN = 600            -- Belohnung für den Dach-Parkour höchstens alle 10 Minuten
Config.ObbyReward = { cash = 400, scale = true, gems = 5 }
Config.RACE_TARGET = 14               -- Sekunden für volle Belohnung im Laufsteg-Rennen
Config.RaceReward = { cash = 250 }    -- wird mit Lohn-Bonus und Tempo verrechnet
Config.GYM_COOLDOWN = 45

return Config
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">Logic</string><ProtectedString name="Source"><![CDATA[--[[
	LOGIC – alle Spielformeln an einem Ort (Server & Client)
	Der Server rechnet damit wirklich, der Client nur zum Anzeigen.
]]

local Config = require(script.Parent:WaitForChild("Config"))

local Logic = {}

-- Schnelle Nachschlage-Tabellen
Logic.upgradeById = {}
for _, u in ipairs(Config.Upgrades) do
	Logic.upgradeById[u.id] = u
end
Logic.petById = {}
for _, p in ipairs(Config.Pets) do
	Logic.petById[p.id] = p
end
Logic.potionById = {}
for _, p in ipairs(Config.Potions) do
	Logic.potionById[p.id] = p
end
Logic.perkById = {}
for _, p in ipairs(Config.RebirthShop) do
	Logic.perkById[p.id] = p
end

----------------------------------------------------------------------------
-- Upgrades
----------------------------------------------------------------------------
function Logic.level(data, id)
	return (data.levels and data.levels[id]) or 0
end

function Logic.costAt(u, level)
	return math.floor(u.base * Config.COST_GROWTH ^ level + 0.5)
end

-- Wie viele Stufen kaufen wir (amount = Zahl oder "max") und was kostet das?
function Logic.bulk(u, level, amount, money)
	local remaining = Config.MAX_LEVEL - level
	if remaining <= 0 then
		return 0, 0
	end
	if amount == "max" then
		local count, cost = 0, 0
		while count < remaining do
			local nextCost = Logic.costAt(u, level + count)
			if cost + nextCost > money then
				break
			end
			cost = cost + nextCost
			count = count + 1
		end
		if count == 0 then
			return 1, Logic.costAt(u, level)
		end
		return count, cost
	end
	local count = math.min(amount, remaining)
	local cost = 0
	for i = 0, count - 1 do
		cost = cost + Logic.costAt(u, level + i)
	end
	return count, cost
end

-- Summe über alle Upgrades
local function sumLevels(levels, field)
	local total = 0
	for _, u in ipairs(Config.Upgrades) do
		total = total + ((levels and levels[u.id]) or 0) * u[field]
	end
	return total
end

function Logic.baseGlow(levels) return sumLevels(levels, "glow") end
function Logic.baseAps(levels) return sumLevels(levels, "aps") end
function Logic.clickBonus(levels) return sumLevels(levels, "click") end

-- Summe der Stufen einer Kategorie (z. B. Fitness für breitere Schultern)
function Logic.catLevels(levels, cat)
	local total = 0
	for _, u in ipairs(Config.Upgrades) do
		if u.cat == cat then
			total = total + ((levels and levels[u.id]) or 0)
		end
	end
	return total
end

-- Punkte in einer Kategorie für Mog Battles
function Logic.catScore(levels, cat, rebirths)
	local total = 0
	for _, u in ipairs(Config.Upgrades) do
		if u.cat == cat then
			total = total + ((levels and levels[u.id]) or 0) * u.glow
		end
	end
	return total * (1 + (rebirths or 0) * 0.2)
end

-- Titel-Index zum Glow-Score
function Logic.titleIndex(glow)
	local idx = 1
	for i, t in ipairs(Config.Titles) do
		if glow >= t.glow then
			idx = i
		end
	end
	return idx
end

----------------------------------------------------------------------------
-- Rebirth & Perks
----------------------------------------------------------------------------
function Logic.rebirthCost(r)
	return Config.Rebirth.baseCost * Config.Rebirth.growth ^ r
end
function Logic.rebirthMult(r)
	return 1 + r * Config.Rebirth.multPer
end
function Logic.rebirthPointsFor(newRebirthCount)
	return 1 + math.floor(newRebirthCount / 5)
end
function Logic.perkLevel(data, id)
	return (data.perks and data.perks[id]) or 0
end
function Logic.perkCost(perk, level)
	return perk.baseCost + perk.costStep * level
end

----------------------------------------------------------------------------
-- Pets
----------------------------------------------------------------------------
function Logic.petBoost(pet)
	local def = Logic.petById[pet.id]
	if not def then return 0 end
	local tier = Config.PetTiers[pet.tier or 1] or Config.PetTiers[1]
	return def.boost * tier.mult
end

function Logic.petMult(data)
	local total = 0
	for _, pet in ipairs(data.pets or {}) do
		if pet.eq then
			total = total + Logic.petBoost(pet)
		end
	end
	return 1 + total
end

function Logic.petSlots(data)
	return Config.BASE_PET_SLOTS + Logic.perkLevel(data, "petslot") + (Logic.hasPass(data, "petslots") and 3 or 0)
end

function Logic.equippedCount(data)
	local n = 0
	for _, pet in ipairs(data.pets or {}) do
		if pet.eq then n = n + 1 end
	end
	return n
end

----------------------------------------------------------------------------
-- Tränke
----------------------------------------------------------------------------
function Logic.potionActive(data, id, now)
	local untilTime = data.potions and data.potions[id]
	return untilTime and untilTime > now
end

function Logic.potionFactor(data, field, now)
	local f = 1
	for _, p in ipairs(Config.Potions) do
		if p[field] and Logic.potionActive(data, p.id, now) then
			f = f * p[field]
		end
	end
	return f
end

function Logic.luck(data, now)
	return (1 + Logic.perkLevel(data, "luck") * 0.1 + Logic.hatBoost(data, "luck")) * Logic.potionFactor(data, "luck", now)
		* (Logic.hasPass(data, "lucky") and 2 or 1) * (Logic.isWeekend(now) and Config.WEEKEND_BOOST.luck or 1)
end

----------------------------------------------------------------------------
-- Gesamtwerte
----------------------------------------------------------------------------
function Logic.worldMult(index)
	local w = Config.Worlds[index] or Config.Worlds[1]
	return w.mult
end

-- Multiplikator auf alle Aura
function Logic.multiplier(data, worldIndex, now)
	return Logic.worldMult(worldIndex) * Logic.rebirthMult(data.rebirths or 0) * Logic.petMult(data)
		* Logic.potionFactor(data, "aura", now)
		* (Logic.hasPass(data, "vip") and 1.25 or 1) * (Logic.hasPass(data, "x2aura") and 2 or 1)
		* (1 + Logic.hatBoost(data, "aura")) * (Logic.isWeekend(now) and Config.WEEKEND_BOOST.aura or 1)
end

function Logic.aps(data, worldIndex, now)
	return Logic.baseAps(data.levels) * Logic.multiplier(data, worldIndex, now)
end

function Logic.clickValue(data, worldIndex, now)
	local base = 1 + Logic.clickBonus(data.levels) + Logic.baseAps(data.levels) * 0.05
	return base * Logic.multiplier(data, worldIndex, now) * Logic.potionFactor(data, "click", now)
end

-- Glow-Power = Wert für die globale Rangliste
function Logic.glowPower(data)
	return math.floor(Logic.baseGlow(data.levels) * (1 + (data.rebirths or 0) * 0.25) * Logic.petMult(data))
end

function Logic.worldUnlocked(data, index)
	return index == 1 or (data.worlds and data.worlds[tostring(index)] == true)
end

----------------------------------------------------------------------------
-- Zähler für Aufträge & Erfolge
----------------------------------------------------------------------------
function Logic.statValue(data, stat)
	if stat == "clicks" then return data.clicks or 0 end
	if stat == "eggs" then return data.eggsOpened or 0 end
	if stat == "mogWins" then return data.mogWins or 0 end
	if stat == "rebirths" then return data.rebirths or 0 end
	if stat == "worlds" then
		local n = 0
		for i = 1, #Config.Worlds do
			if Logic.worldUnlocked(data, i) then n = n + 1 end
		end
		return n
	end
	if stat == "index" then
		local n = 0
		for _ in pairs(data.index or {}) do n = n + 1 end
		return n
	end
	return (data.stats and data.stats[stat]) or 0
end

-- Fortschritt eines Tagesauftrags
function Logic.questProgress(data, q)
	return math.max(0, Logic.statValue(data, q.stat) - (q.start or 0))
end

function Logic.achievementReward(tier)
	return { cash = 150 * 4 ^ (tier - 1), auraSeconds = 120 * tier }
end

----------------------------------------------------------------------------
-- Fans: Charisma & Chance
----------------------------------------------------------------------------
function Logic.charisma(data)
	return Logic.baseGlow(data.levels) + Logic.catLevels(data.levels, "conf") * 10 + (data.rebirths or 0) * 100
end

-- Wie viel Charisma ein Fan mit Promi-Level 1–10 in Welt w braucht
function Logic.fanReq(world, fame)
	local base = Config.FanBaseReq[world] or Config.FanBaseReq[#Config.FanBaseReq]
	return math.floor(base * (0.4 + fame * 0.16))
end

function Logic.fanChance(data, world, fame, mod)
	local req = Logic.fanReq(world, fame)
	return math.clamp(0.5 + 0.45 * (Logic.charisma(data) - req) / req + (mod or 0), 0.03, 0.97)
end

----------------------------------------------------------------------------
-- Jobs
----------------------------------------------------------------------------
function Logic.jobPayMult(data)
	return (1 + Logic.baseGlow(data.levels) / 2000) * (1 + (data.rebirths or 0) * 0.1)
end
function Logic.jobPay(data, job)
	return math.floor(job.pay * Logic.jobPayMult(data))
end

----------------------------------------------------------------------------
-- Waffen & Kampf
----------------------------------------------------------------------------
Logic.weaponById = {}
for _, w in ipairs(Config.Weapons) do
	Logic.weaponById[w.id] = w
end

function Logic.weaponLevel(data, id)
	return (data.weapons and data.weapons[id]) or 0
end

-- Schaden eines Schlags (ohne Krit)
function Logic.weaponDamage(data, id)
	local w = Logic.weaponById[id]
	if not w then return 0 end
	local level = math.max(1, Logic.weaponLevel(data, id))
	return w.damage * (1 + (level - 1) * Config.WEAPON_LEVEL_BONUS)
		* (1 + Logic.baseGlow(data.levels) / 500) * (1 + (data.rebirths or 0) * 0.3)
end

function Logic.weaponUpgradeCost(id, level)
	local w = Logic.weaponById[id]
	local base = (w and w.price > 0) and w.price or 1e7
	return math.floor(math.max(200, base) * 0.5 * 1.6 ^ level)
end

-- Selbstbewusstsein = Lebensbalken im Bosskampf
function Logic.maxConfidence(data)
	return math.floor(100 + Logic.baseGlow(data.levels) / 50)
end


----------------------------------------------------------------------------
-- Gamepasses, Hüte, Wochenende, Events, Laufen
----------------------------------------------------------------------------
function Logic.hasPass(data, key)
	return data.passes ~= nil and data.passes[key] == true
end

Logic.hatById, Logic.auraById, Logic.trailById, Logic.emoteById, Logic.vehicleById = {}, {}, {}, {}, {}
for _, h in ipairs(Config.Hats) do Logic.hatById[h.id] = h end
for _, a in ipairs(Config.Auras) do Logic.auraById[a.id] = a end
for _, t in ipairs(Config.Trails) do Logic.trailById[t.id] = t end
for _, e in ipairs(Config.Emotes) do Logic.emoteById[e.id] = e end
for _, v in ipairs(Config.Vehicles) do Logic.vehicleById[v.id] = v end

-- Bonus des aufgesetzten Hutes (field = "aura", "cash", "luck" oder "speed")
function Logic.hatBoost(data, field)
	local hatId = data.cosmetics and data.cosmetics.hat
	local hat = hatId and Logic.hatById[hatId]
	return (hat and hat.boost[field]) or 0
end

-- Geld-Multiplikator (VIP & Hut)
function Logic.cashMult(data)
	return (Logic.hasPass(data, "vip") and 1.25 or 1) * (1 + Logic.hatBoost(data, "cash"))
end

-- Samstag oder Sonntag (UTC)?
function Logic.isWeekend(now)
	if not now or now <= 0 then return false end
	local t = os.date("!*t", now)
	return t.wday == 1 or t.wday == 7
end

-- Welches Event läuft gerade? (nil = keins)
function Logic.activeEvent(now)
	if Config.EVENT_OVERRIDE and Config.EVENT_OVERRIDE ~= "" then
		for _, ev in ipairs(Config.Events) do
			if ev.id == Config.EVENT_OVERRIDE then return ev end
		end
	end
	if not now or now <= 0 then return nil end
	local t = os.date("!*t", now)
	local today = t.month * 100 + t.day
	for _, ev in ipairs(Config.Events) do
		local from = ev.from[1] * 100 + ev.from[2]
		local to = ev.to[1] * 100 + ev.to[2]
		if from <= to then
			if today >= from and today <= to then return ev end
		elseif today >= from or today <= to then   -- über den Jahreswechsel
			return ev
		end
	end
	return nil
end

function Logic.eventTokens(data, eventId)
	return (data.eventTokens and data.eventTokens[eventId]) or 0
end

-- Laufgeschwindigkeit (Perk, Gamepass, Hut, Fahrzeug)
function Logic.walkSpeed(data, riding)
	local speed = 16 + 2 * Logic.perkLevel(data, "speed") + (Logic.hasPass(data, "speed") and 8 or 0) + Logic.hatBoost(data, "speed")
	if riding then
		local v = Logic.vehicleById[data.vehicle or ""]
		if v then speed = speed + v.speed end
	end
	return speed
end

-- Besitzt der Spieler einen Gegenstand? (kind: "aura", "trail", "hat", "emote", "vehicle")
function Logic.ownsItem(data, kind, id)
	if kind == "vehicle" then return data.vehicles ~= nil and data.vehicles[id] == true end
	if kind == "emote" then
		local e = Logic.emoteById[id]
		if e and e.price == 0 then return true end
	end
	return data.cosmetics ~= nil and data.cosmetics.owned ~= nil and data.cosmetics.owned[id] == true
end

function Logic.itemDef(kind, id)
	if kind == "aura" then return Logic.auraById[id] end
	if kind == "trail" then return Logic.trailById[id] end
	if kind == "hat" then return Logic.hatById[id] end
	if kind == "emote" then return Logic.emoteById[id] end
	if kind == "vehicle" then return Logic.vehicleById[id] end
	return nil
end


return Logic
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000003"><Properties><string name="Name">PetModels</string><ProtectedString name="Source"><![CDATA[--[[
	PETMODELS – baut aus der Beschreibung eines Pets (Config.Pets[..].look)
	eine echte 3D-Figur aus Teilen: Körper, Kopf, Augen, Ohren, Beine, Schwanz, Flügel …
	Wird vom Server (Pets in der Welt) UND vom Client (3D-Vorschau in Menüs) benutzt.

	Die Figur schaut nach vorne (-Z). Der unsichtbare Teil "Root" ist die Mitte.
]]

local Config = require(script.Parent:WaitForChild("Config"))

local PetModels = {}
local PET_SCALE = 1.1
local BLACK = Color3.fromRGB(25, 25, 30)
local WHITE = Color3.new(1, 1, 1)
local ORANGE = Color3.fromRGB(255, 170, 40)
local GOLD = Color3.fromRGB(255, 205, 60)

local function cf(x, y, z, rx, ry, rz)
	return CFrame.new(x, y, z) * CFrame.Angles(math.rad(rx or 0), math.rad(ry or 0), math.rad(rz or 0))
end

----------------------------------------------------------------------------
-- Bauteil erstellen
-- shape: "ball" (Ellipsoid), "block", "cyl" (Zylinder liegend entlang X), "wedge"
----------------------------------------------------------------------------
local function piece(ctx, size, cframe, color, shape, opts)
	opts = opts or {}
	local p = Instance.new(shape == "wedge" and "WedgePart" or "Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = Enum.Material.SmoothPlastic
	if shape == "ball" then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	elseif shape == "cyl" then
		p.Shape = Enum.PartType.Cylinder
	end
	-- Hauptfarbe: bekommt die Effekte (Glas, Neon, Gold, Fusions-Stufen)
	if opts.main then
		p:SetAttribute("Main", true)
		if ctx.look.glass then
			p.Material = Enum.Material.Glass
			p.Transparency = 0.25
			p.Reflectance = 0.2
		elseif ctx.look.gold then
			p.Material = Enum.Material.Foil
			p.Reflectance = 0.25
		end
	end
	if opts.accent and ctx.look.neon then
		p.Material = Enum.Material.Neon
	end
	if opts.neon then p.Material = Enum.Material.Neon end
	if opts.transparency then p.Transparency = opts.transparency end
	p.Parent = ctx.model
	return p
end

local function ball(ctx, sx, sy, sz, x, y, z, color, opts, rx, ry, rz)
	return piece(ctx, Vector3.new(sx, sy, sz), cf(x, y, z, rx, ry, rz), color, "ball", opts)
end

local function block(ctx, sx, sy, sz, x, y, z, color, opts, rx, ry, rz)
	return piece(ctx, Vector3.new(sx, sy, sz), cf(x, y, z, rx, ry, rz), color, "block", opts)
end

-- zwei Augen mit Glanzpunkt
local function eyes(ctx, x, y, z, size, sideways)
	size = size or 0.2
	for _, s in ipairs({ -1, 1 }) do
		if sideways then
			ball(ctx, size * 0.6, size, size, s * x, y, z, BLACK)
			ball(ctx, size * 0.3, size * 0.35, size * 0.35, s * (x + 0.02), y + size * 0.2, z - size * 0.15, WHITE)
		else
			ball(ctx, size, size, size * 0.6, s * x, y, z, BLACK)
			ball(ctx, size * 0.35, size * 0.35, size * 0.3, s * x + size * 0.15, y + size * 0.2, z - size * 0.25, WHITE)
		end
	end
end

-- Heiligenschein aus leuchtenden Kugeln
local function halo(ctx, y)
	for i = 0, 9 do
		local a = i / 10 * math.pi * 2
		ball(ctx, 0.12, 0.12, 0.12, math.cos(a) * 0.45, y, math.sin(a) * 0.45 - 0.3, GOLD, { neon = true })
	end
end

local function shades(ctx, y, z)
	block(ctx, 0.78, 0.18, 0.06, 0, y, z, BLACK)
	block(ctx, 0.3, 0.16, 0.04, -0.2, y - 0.03, z - 0.02, Color3.fromRGB(40, 40, 60))
	block(ctx, 0.3, 0.16, 0.04, 0.2, y - 0.03, z - 0.02, Color3.fromRGB(40, 40, 60))
end

----------------------------------------------------------------------------
-- Baupläne
----------------------------------------------------------------------------
local PLANS = {}

-- Vierbeiner (Katze, Hund, Hamster, Löwe, Bär, Fuchs, Elefant …)
PLANS.quad = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	ball(ctx, 1.4, 1.1, 1.8, 0, 0, 0.1, c1, { main = true })
	ball(ctx, 0.9, 0.8, 0.5, 0, -0.05, -0.7, c2, { accent = true })
	if L.hump then ball(ctx, 0.9, 0.7, 0.9, 0, 0.6, 0.25, c1, { main = true }) end
	-- Kopf
	local hy, hz = 0.6, -0.95
	if L.mane then ball(ctx, 1.55, 1.5, 0.9, 0, hy, hz + 0.3, c2, { accent = true }) end
	ball(ctx, 1.1, 1.0, 1.0, 0, hy, hz, c1, { main = true })
	ball(ctx, 0.55, 0.4, 0.4, 0, hy - 0.17, hz - 0.45, c2, { accent = true })
	ball(ctx, 0.16, 0.12, 0.1, 0, hy - 0.08, hz - 0.65, BLACK)
	eyes(ctx, 0.24, hy + 0.1, hz - 0.42, 0.2)
	if L.patches then
		for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.3, 0.36, 0.1, s * 0.24, hy + 0.08, hz - 0.4, c2, nil, 0, 0, s * 20) end
		eyes(ctx, 0.24, hy + 0.1, hz - 0.44, 0.16)
	end
	if L.mask then block(ctx, 0.85, 0.22, 0.1, 0, hy + 0.1, hz - 0.43, c2) eyes(ctx, 0.24, hy + 0.1, hz - 0.46, 0.17) end
	if L.cucumber then
		for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.3, 0.3, 0.06, s * 0.24, hy + 0.1, hz - 0.49, Color3.fromRGB(120, 200, 90)) end
	end
	if L.shades then shades(ctx, hy + 0.12, hz - 0.5) end
	-- Ohren
	local ears = L.ears or "round"
	for _, s in ipairs({ -1, 1 }) do
		if ears == "round" then
			ball(ctx, 0.36, 0.36, 0.15, s * 0.36, hy + 0.45, hz + 0.05, c1, { main = true })
		elseif ears == "pointy" then
			ball(ctx, 0.26, 0.55, 0.18, s * 0.3, hy + 0.55, hz + 0.05, c1, { main = true }, 0, 0, -s * 18)
		elseif ears == "long" then
			ball(ctx, 0.24, 0.95, 0.16, s * 0.2, hy + 0.85, hz + 0.1, c1, { main = true }, 0, 0, -s * 8)
		elseif ears == "floppy" then
			ball(ctx, 0.26, 0.6, 0.15, s * 0.56, hy - 0.02, hz + 0.05, c2, { accent = true }, 0, 0, s * 20)
		elseif ears == "big" then
			ball(ctx, 0.65, 0.65, 0.12, s * 0.55, hy + 0.4, hz + 0.05, c1, { main = true })
			ball(ctx, 0.45, 0.45, 0.08, s * 0.55, hy + 0.4, hz - 0.01, c2, { accent = true })
		end
	end
	if L.horn then ball(ctx, 0.14, 0.7, 0.14, 0, hy + 0.65, hz - 0.25, GOLD, { neon = true }, -15, 0, 0) end
	if L.horns then
		for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.12, 0.6, 0.12, s * 0.25, hy + 0.6, hz + 0.05, Color3.fromRGB(230, 220, 200), nil, -20, 0, -s * 25) end
	end
	if L.trunk then
		ball(ctx, 0.28, 0.9, 0.28, 0, hy - 0.5, hz - 0.55, c1, { main = true }, 25, 0, 0)
		for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.12, 0.5, 0.12, s * 0.25, hy - 0.45, hz - 0.45, WHITE, nil, 40, 0, 0) end
	end
	-- Muster
	if L.stripes then
		for _, z in ipairs({ -0.35, 0.15, 0.65 }) do ball(ctx, 1.44, 0.18, 0.2, 0, 0.15, z, c2, nil, 0, 0, 0) end
	end
	if L.spots then
		local spots = { { 0.4, 0.35, -0.2 }, { -0.35, 0.4, 0.3 }, { 0.2, 0.5, 0.6 }, { -0.5, 0.1, -0.3 }, { 0.55, 0.05, 0.45 } }
		for _, p in ipairs(spots) do ball(ctx, 0.24, 0.24, 0.24, p[1], p[2], p[3], c2) end
	end
	-- Beine
	for _, p in ipairs({ { -0.45, -0.6 }, { 0.45, -0.6 }, { -0.45, 0.75 }, { 0.45, 0.75 } }) do
		ball(ctx, 0.36, 0.65, 0.36, p[1], -0.55, p[2], c1, { main = true })
	end
	-- Schwanz
	local tail = L.tail or "short"
	if tail == "short" then
		ball(ctx, 0.35, 0.35, 0.35, 0, 0.15, 1.0, c2, { accent = true })
	elseif tail == "long" then
		ball(ctx, 0.18, 0.18, 1.1, 0, 0.35, 1.35, c1, { main = true }, -30, 0, 0)
	elseif tail == "fluffy" then
		ball(ctx, 0.6, 0.6, 1.15, 0, 0.55, 1.3, c1, { main = true }, -45, 0, 0)
		ball(ctx, 0.4, 0.4, 0.5, 0, 0.95, 1.6, c2, { accent = true })
	elseif tail == "curl" then
		ball(ctx, 0.42, 0.42, 0.42, 0, 0.55, 1.0, c2, { accent = true })
	end
	if L.halo then halo(ctx, hy + 0.95) end
end

-- Vögel
PLANS.bird = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	local style = L.style or "default"
	local hy, hz = 0.85, -0.15
	if style == "longleg" or style == "swan" then
		ball(ctx, 0.95, 0.75, 1.2, 0, 0.3, 0.1, c1, { main = true })
		ball(ctx, 0.18, 0.9, 0.18, 0, 0.95, -0.35, c1, { main = true }, style == "swan" and -25 or -10, 0, 0)
		hy, hz = 1.45, -0.55
		ball(ctx, 0.42, 0.42, 0.48, 0, hy, hz, c1, { main = true })
		ball(ctx, 0.14, 0.12, 0.42, 0, hy - 0.06, hz - 0.36, c2, { accent = true }, 15, 0, 0)
		eyes(ctx, 0.16, hy + 0.06, hz - 0.12, 0.1, true)
		if style == "longleg" then
			for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.08, 1.0, 0.08, s * 0.15, -0.45, 0.05, c1) end
		else
			ball(ctx, 0.5, 0.18, 0.5, 0, 1.75, -0.55, GOLD, { neon = true })   -- kleine Krone
		end
		for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.2, 0.6, 0.9, s * 0.5, 0.35, 0.2, c2, { accent = true }, 0, 0, s * 15) end
	else
		ball(ctx, 1.0, 1.2, 1.0, 0, 0, 0, c1, { main = true })
		ball(ctx, 0.78, 0.75, 0.75, 0, hy, hz, style == "eagle" and c2 or c1, { main = style ~= "eagle" })
		local beakColor = (style == "eagle") and Color3.fromRGB(255, 200, 40) or ORANGE
		ball(ctx, 0.2, 0.16, 0.42, 0, hy - 0.08, hz - 0.42, beakColor, nil, 15, 0, 0)
		if style == "owl" then
			for _, s in ipairs({ -1, 1 }) do
				ball(ctx, 0.34, 0.34, 0.1, s * 0.18, hy + 0.08, hz - 0.33, c2, { accent = true })
				ball(ctx, 0.16, 0.35, 0.12, s * 0.25, hy + 0.42, hz, c1, { main = true }, 0, 0, -s * 15)
			end
			eyes(ctx, 0.18, hy + 0.08, hz - 0.4, 0.18)
		else
			eyes(ctx, 0.2, hy + 0.1, hz - 0.33, 0.15)
		end
		if style == "penguin" then
			ball(ctx, 0.75, 1.0, 0.5, 0, -0.05, -0.3, c2, { accent = true })
		else
			ball(ctx, 0.7, 0.8, 0.45, 0, -0.1, -0.32, c2, { accent = true })
		end
		-- Flügel
		local spread = (style == "eagle" or style == "phoenix") and 55 or 15
		local wingLen = (style == "eagle" or style == "phoenix") and 1.2 or 0.75
		for _, s in ipairs({ -1, 1 }) do
			ball(ctx, 0.22, wingLen, 0.7, s * (0.5 + (spread > 20 and 0.35 or 0)), 0.1 + (spread > 20 and 0.3 or 0), 0.05, style == "penguin" and c1 or c2,
				{ accent = style ~= "penguin", main = style == "penguin" }, 0, 0, s * spread)
		end
		-- Schwanz
		if style == "peacock" then
			for i = -3, 3 do
				local col = (i % 2 == 0) and c1 or c2
				local f = ball(ctx, 0.22, 1.3, 0.08, i * 0.24, 0.6, 0.6, col, { accent = true }, -15, 0, -i * 14)
				ball(ctx, 0.14, 0.14, 0.04, i * 0.38, 1.12, 0.55, GOLD, { neon = true })
				f.Name = "Feder"
			end
		elseif style == "crest" or style == "phoenix" then
			for i = -1, 1 do ball(ctx, 0.12, 0.45, 0.12, i * 0.1, hy + 0.45, hz + 0.1, c2, { accent = true }, -20, 0, -i * 25) end
			for i = -1, 1 do ball(ctx, 0.18, 0.12, 0.9, i * 0.15, -0.1, 0.75, i == 0 and c1 or c2, { accent = true }, 15, i * 12, 0) end
		else
			ball(ctx, 0.5, 0.15, 0.5, 0, -0.25, 0.6, c2, { accent = true }, 15, 0, 0)
		end
		for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.18, 0.12, 0.3, s * 0.22, -0.65, -0.12, ORANGE) end
		if style == "phoenix" then
			local f = Instance.new("Fire")
			f.Size = 3
			f.Heat = 3
			f.Color = c1
			f.SecondaryColor = c2
			f.Parent = ctx.root
		end
	end
	if L.shades then shades(ctx, hy + 0.1, hz - 0.36) end
	if L.halo then halo(ctx, hy + 0.65) end
end

-- Meerestiere (Fisch, Delfin, Hai, Wal)
PLANS.sea = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	local style = L.style or "fish"
	if style == "fish" then
		ball(ctx, 0.7, 0.95, 1.4, 0, 0, 0, c1, { main = true })
		ball(ctx, 0.72, 0.3, 0.5, 0, 0.1, -0.1, c2, { accent = true })
		ball(ctx, 0.1, 0.95, 0.6, 0, 0, 0.85, c1, { main = true })
		ball(ctx, 0.1, 0.45, 0.55, 0, 0.5, 0.1, c2, { accent = true }, -20, 0, 0)
		eyes(ctx, 0.3, 0.15, -0.45, 0.18, true)
	else
		local big = style == "whale"
		local sx, sy, sz = big and 1.5 or 0.85, big and 1.3 or 0.85, big and 2.4 or 2.0
		ball(ctx, sx, sy, sz, 0, 0, 0, c1, { main = true })
		ball(ctx, sx * 0.75, sy * 0.55, sz * 0.8, 0, -sy * 0.22, -0.05, c2, { accent = true })
		if style == "dolphin" then ball(ctx, 0.3, 0.25, 0.55, 0, -0.05, -1.15, c1, { main = true }) end
		local dorsal = style == "shark" and 0.95 or (big and 0.4 or 0.6)
		ball(ctx, 0.12, dorsal, 0.55, 0, sy * 0.5 + dorsal * 0.3, 0.1, c1, { main = true }, 20, 0, 0)
		if style == "shark" then
			ball(ctx, 0.12, 1.0, 0.55, 0, 0.2, sz * 0.55, c1, { main = true }, 25, 0, 0)
			block(ctx, 0.45, 0.06, 0.12, 0, -0.25, -0.88, WHITE)
		else
			ball(ctx, sx * 1.15, 0.12, 0.55, 0, 0, sz * 0.55, c1, { main = true })
		end
		for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.55, 0.1, 0.3, s * sx * 0.55, -0.2, -0.2, c1, { main = true }, 0, 0, s * 25) end
		eyes(ctx, sx * 0.42, 0.1, -sz * 0.32, big and 0.18 or 0.16, true)
	end
	if L.halo then halo(ctx, 0.9) end
end

PLANS.crab = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	ball(ctx, 1.4, 0.65, 1.0, 0, 0, 0, c1, { main = true })
	ball(ctx, 1.0, 0.3, 0.7, 0, -0.2, 0, c2, { accent = true })
	for _, s in ipairs({ -1, 1 }) do
		ball(ctx, 0.08, 0.4, 0.08, s * 0.25, 0.4, -0.3, c1)
		ball(ctx, 0.2, 0.2, 0.2, s * 0.25, 0.62, -0.3, WHITE)
		ball(ctx, 0.1, 0.1, 0.06, s * 0.25, 0.63, -0.4, BLACK)
		ball(ctx, 0.55, 0.42, 0.6, s * 0.95, 0.15, -0.55, c1, { main = true }, 0, s * 20, 0)
		ball(ctx, 0.2, 0.2, 0.35, s * 1.15, 0.25, -0.85, c2, { accent = true })
		for k = -1, 1 do ball(ctx, 0.65, 0.12, 0.12, s * 0.85, -0.25, k * 0.3 + 0.1, c1, nil, 0, 0, -s * 30) end
	end
end

PLANS.scorpion = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	ball(ctx, 1.0, 0.5, 1.4, 0, 0, 0, c1, { main = true })
	eyes(ctx, 0.15, 0.2, -0.65, 0.12)
	for _, s in ipairs({ -1, 1 }) do
		ball(ctx, 0.4, 0.3, 0.55, s * 0.75, 0.05, -0.85, c1, { main = true }, 0, s * 25, 0)
		for k = -1, 1 do ball(ctx, 0.6, 0.1, 0.1, s * 0.6, -0.2, k * 0.35, c2, nil, 0, 0, -s * 30) end
	end
	local pts = { { 0, 0.25, 0.8 }, { 0, 0.6, 1.0 }, { 0, 1.0, 0.95 }, { 0, 1.3, 0.7 } }
	for i, p in ipairs(pts) do ball(ctx, 0.4 - i * 0.05, 0.4 - i * 0.05, 0.4 - i * 0.05, p[1], p[2], p[3], c1, { main = true }) end
	ball(ctx, 0.14, 0.35, 0.14, 0, 1.35, 0.42, c2, { accent = true }, 60, 0, 0)
end

PLANS.octopus = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	ball(ctx, 1.25, 1.3, 1.2, 0, 0.45, 0, c1, { main = true })
	eyes(ctx, 0.28, 0.4, -0.55, 0.24)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		ball(ctx, 0.25, 0.85, 0.25, math.cos(a) * 0.5, -0.35, math.sin(a) * 0.5, i % 2 == 0 and c1 or c2, { main = i % 2 == 0, accent = i % 2 == 1 },
			math.sin(a) * 25, 0, -math.cos(a) * 25)
	end
end

PLANS.turtle = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	ball(ctx, 1.5, 0.95, 1.7, 0, 0.15, 0, c2, { accent = true })
	for _, p in ipairs({ { 0, 0.6, 0 }, { 0.4, 0.45, 0.4 }, { -0.4, 0.45, 0.4 }, { 0.4, 0.45, -0.4 }, { -0.4, 0.45, -0.4 } }) do
		ball(ctx, 0.42, 0.12, 0.42, p[1], p[2], p[3], c1:Lerp(BLACK, 0.25))
	end
	ball(ctx, 1.3, 0.3, 1.5, 0, -0.25, 0, c1, { main = true })
	ball(ctx, 0.6, 0.55, 0.7, 0, 0.05, -1.0, c1, { main = true })
	eyes(ctx, 0.18, 0.15, -1.3, 0.14)
	for _, p in ipairs({ { -0.6, -0.65 }, { 0.6, -0.65 }, { -0.6, 0.65 }, { 0.6, 0.65 } }) do
		ball(ctx, 0.4, 0.35, 0.45, p[1], -0.35, p[2], c1, { main = true })
	end
	if L.halo then halo(ctx, 1.0) end
end

PLANS.snake = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	local pts = { { 0, -0.4, 0.9 }, { 0.35, -0.35, 0.55 }, { 0.1, -0.3, 0.15 }, { -0.3, -0.2, -0.15 }, { -0.15, 0.05, -0.45 } }
	for i, p in ipairs(pts) do
		local s = 0.45 + i * 0.06
		ball(ctx, s, s, s, p[1], p[2], p[3], i % 2 == 0 and c2 or c1, { main = i % 2 == 1, accent = i % 2 == 0 })
	end
	ball(ctx, 0.7, 0.55, 0.85, 0, 0.35, -0.75, c1, { main = true })
	eyes(ctx, 0.2, 0.5, -1.05, 0.15)
	block(ctx, 0.06, 0.03, 0.35, 0, 0.25, -1.25, Color3.fromRGB(230, 40, 60))
end

PLANS.frog = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	ball(ctx, 1.35, 0.85, 1.25, 0, 0, 0, c1, { main = true })
	ball(ctx, 1.0, 0.5, 0.9, 0, -0.2, -0.15, c2, { accent = true })
	for _, s in ipairs({ -1, 1 }) do
		ball(ctx, 0.42, 0.42, 0.42, s * 0.35, 0.45, -0.4, c1, { main = true })
		ball(ctx, 0.3, 0.3, 0.2, s * 0.35, 0.5, -0.56, WHITE)
		ball(ctx, 0.15, 0.15, 0.1, s * 0.35, 0.5, -0.65, BLACK)
		ball(ctx, 0.45, 0.32, 0.85, s * 0.62, -0.32, 0.3, c1, { main = true })
		ball(ctx, 0.25, 0.4, 0.25, s * 0.45, -0.4, -0.45, c1, { main = true })
	end
	block(ctx, 0.7, 0.05, 0.05, 0, 0.0, -0.62, Color3.fromRGB(60, 30, 30))
end

PLANS.dragon = function(ctx, L)
	local L2 = {}
	for k, v in pairs(L) do L2[k] = v end
	L2.ears = "none"
	L2.tail = "long"
	L2.horns = true
	PLANS.quad(ctx, L2)
	for _, s in ipairs({ -1, 1 }) do
		ball(ctx, 0.12, 1.3, 1.5, s * 0.95, 0.85, 0.25, L.c2, { accent = true }, 0, 0, s * 45)
	end
	for i = 0, 3 do ball(ctx, 0.15, 0.35, 0.2, 0, 0.6, -0.25 + i * 0.35, L.c2, { accent = true }) end
end

PLANS.moai = function(ctx, L)
	local c1, c2 = L.c1, L.c2
	block(ctx, 1.15, 0.5, 0.85, 0, -0.75, 0, c1, { main = true })
	block(ctx, 1.0, 1.6, 0.9, 0, 0.3, 0, c1, { main = true })
	block(ctx, 1.06, 0.28, 1.0, 0, 0.95, -0.05, c2, { accent = true })
	block(ctx, 0.28, 0.65, 0.35, 0, 0.35, -0.55, c1, { main = true })
	for _, s in ipairs({ -1, 1 }) do block(ctx, 0.25, 0.1, 0.05, s * 0.25, 0.7, -0.46, BLACK) end
	block(ctx, 0.45, 0.06, 0.05, 0, -0.1, -0.46, BLACK)
	if L.halo then halo(ctx, 1.4) end
end

PLANS.ghost = function(ctx, L)
	ball(ctx, 1.2, 1.4, 1.2, 0, 0.1, 0, L.c1, { main = true, transparency = 0.25 })
	for i = 0, 3 do
		local a = i / 4 * math.pi * 2
		ball(ctx, 0.5, 0.5, 0.5, math.cos(a) * 0.35, -0.55, math.sin(a) * 0.35, L.c1, { main = true, transparency = 0.25 })
	end
	eyes(ctx, 0.22, 0.25, -0.55, 0.22)
	ball(ctx, 0.2, 0.25, 0.08, 0, -0.1, -0.58, BLACK)
	local light = Instance.new("PointLight")
	light.Color = L.c2
	light.Range = 8
	light.Parent = ctx.root
end

PLANS.alien = function(ctx, L)
	ball(ctx, 1.3, 1.05, 1.05, 0, 0.55, 0, L.c1, { main = true })
	for _, s in ipairs({ -1, 1 }) do
		ball(ctx, 0.38, 0.22, 0.12, s * 0.28, 0.5, -0.48, L.c2, nil, 0, 0, s * 25)
		ball(ctx, 0.04, 0.5, 0.04, s * 0.25, 1.2, 0, L.c1)
		ball(ctx, 0.15, 0.15, 0.15, s * 0.25, 1.45, 0, Color3.fromRGB(255, 120, 240), { neon = true })
	end
	ball(ctx, 0.6, 0.8, 0.5, 0, -0.35, 0, L.c1, { main = true })
	for _, s in ipairs({ -1, 1 }) do ball(ctx, 0.18, 0.6, 0.18, s * 0.42, -0.35, 0, L.c1, nil, 0, 0, s * 25) end
end

PLANS.star = function(ctx, L)
	for i = 0, 4 do
		local a = math.rad(i * 72)
		ball(ctx, 0.42, 1.0, 0.32, math.sin(a) * 0.5, math.cos(a) * 0.5, 0, i % 2 == 0 and L.c1 or L.c2, { main = i % 2 == 0, accent = i % 2 == 1 }, 0, 0, -i * 72)
	end
	ball(ctx, 0.75, 0.75, 0.42, 0, 0, 0, L.c1, { main = true })
	eyes(ctx, 0.15, 0.1, -0.22, 0.14)
	block(ctx, 0.25, 0.05, 0.05, 0, -0.12, -0.22, BLACK)
end

PLANS.planet = function(ctx, L)
	ball(ctx, 1.45, 1.45, 1.45, 0, 0.1, 0, L.c1, { main = true })
	for _, p in ipairs({ { 0.35, 0.45, -0.45 }, { -0.5, 0.0, -0.4 }, { 0.2, -0.35, -0.55 } }) do ball(ctx, 0.5, 0.4, 0.3, p[1], p[2], p[3], L.c2) end
	ball(ctx, 2.6, 0.06, 2.6, 0, 0.1, 0, Color3.fromRGB(255, 230, 160), { neon = true, transparency = 0.35 }, 0, 0, 18)
	eyes(ctx, 0.22, 0.25, -0.68, 0.16)
end

PLANS.blob = function(ctx, L)
	ball(ctx, 1.35, 1.0, 1.3, 0, -0.1, 0, L.c1, { main = true })
	ball(ctx, 0.35, 0.2, 0.2, -0.3, 0.25, -0.5, WHITE, { transparency = 0.3 })
	ball(ctx, 0.5, 0.5, 0.5, 0.35, 0.45, 0.2, L.c2, { accent = true })
	eyes(ctx, 0.22, 0.1, -0.6, 0.18)
end

----------------------------------------------------------------------------
-- Pet bauen
----------------------------------------------------------------------------
-- forWorld = true: Teile fest verschweißen (dann muss nur "Root" bewegt werden – viel schneller)
function PetModels.build(def, tier, forWorld)
	tier = tier or 1
	local look = def.look or { plan = "blob", c1 = Color3.fromRGB(200, 200, 200), c2 = WHITE }
	local model = Instance.new("Model")
	model.Name = def.name
	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = Vector3.new(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanQuery = false
	root.CanTouch = false
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local ctx = { model = model, root = root, look = look }
	local plan = PLANS[look.plan] or PLANS.blob
	local ok, err = pcall(plan, ctx, look)
	if not ok then warn("[PetModels]", def.name, err) end

	-- Fusions-Stufen: Gold, Regenbogen, Diamant
	local tierInfo = Config.PetTiers[tier]
	if tier >= 2 then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p:GetAttribute("Main") then
				if tier == 2 then
					p.Color = tierInfo.color
					p.Material = Enum.Material.Foil
					p.Reflectance = 0.3
				elseif tier == 3 then
					p.Color = tierInfo.color      -- der Client lässt diese Teile in Regenbogenfarben leuchten
					p.Material = Enum.Material.SmoothPlastic
				elseif tier == 4 then
					p.Color = tierInfo.color
					p.Material = Enum.Material.Glass
					p.Transparency = 0.2
					p.Reflectance = 0.35
				end
			end
		end
	end

	-- Glitzer & Licht für seltene Pets
	local rarity = Config.Rarities[def.rarity]
	if rarity and (rarity.order >= 5 or tier >= 2) then
		local light = Instance.new("PointLight")
		light.Color = tierInfo.color or rarity.color
		light.Range = 6
		light.Brightness = 0.8
		light.Parent = root
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Rate = rarity.order >= 7 and 10 or 4
		sparkle.Lifetime = NumberRange.new(0.6, 1.2)
		sparkle.Speed = NumberRange.new(0.5, 1.5)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.LightEmission = 1
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Color = ColorSequence.new(tierInfo.color or rarity.color)
		sparkle.Parent = root
	end

	local scale = PET_SCALE * (look.size or 1) * (1 + (tier - 1) * 0.12)
	pcall(function() model:ScaleTo(scale) end)

	if forWorld then
		for _, p in ipairs(model:GetDescendants()) do
			if p:IsA("BasePart") and p ~= root then
				local weld = Instance.new("WeldConstraint")
				weld.Part0 = root
				weld.Part1 = p
				weld.Parent = p
				p.Anchored = false
				p.Massless = true
			end
		end
	end
	return model
end

return PetModels
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000004"><Properties><string name="Name">Util</string><ProtectedString name="Source"><![CDATA[--[[
	UTIL – kleine Hilfsfunktionen (Server & Client)
]]

local Util = {}

local SUFFIXES = { "", " Tsd.", " Mio.", " Mrd.", " Bio.", " Brd.", " Trill.", " Trd.", " Quadr.", " Quadrd.",
	" Quint.", " Quintd.", " Sext.", " Sextd.", " Sept.", " Septd.", " Okt.", " Oktd.", " Non.", " Nond.", " Dez." }

-- 12345 -> "12.345"
local function withDots(n)
	local s = tostring(math.floor(n))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1.")))
	if string.sub(out, 1, 1) == "." then
		out = string.sub(out, 2)
	end
	return out
end

-- "12,50" -> "12,5" ; "3,00" -> "3"
local function trimDecimals(s)
	if string.find(s, ",", 1, true) then
		s = string.gsub(s, "0+$", "")
		s = string.gsub(s, ",$", "")
	end
	return s
end

-- Große Zahlen hübsch formatieren (deutsche Schreibweise)
function Util.format(n)
	n = tonumber(n) or 0
	if n ~= n then return "0" end
	if n == math.huge then return "∞" end
	if n < 0 then return "-" .. Util.format(-n) end
	if n < 10 then
		return trimDecimals((string.gsub(string.format("%.1f", n), "%.", ",")))
	end
	if n < 100000 then
		return withDots(n)
	end
	local i = 1
	while n >= 1000 and i < #SUFFIXES do
		n = n / 1000
		i = i + 1
	end
	local s
	if n < 100 then
		s = string.format("%.2f", n)
	else
		s = string.format("%.1f", n)
	end
	s = string.gsub(s, "%.", ",")
	return trimDecimals(s) .. SUFFIXES[i]
end

-- Sekunden -> "1 Std. 5 Min." / "45 s"
function Util.formatTime(sec)
	sec = math.max(0, math.floor(sec))
	if sec < 60 then return sec .. " s" end
	local m = math.floor(sec / 60)
	if m < 60 then return m .. " Min. " .. (sec % 60) .. " s" end
	local h = math.floor(m / 60)
	return h .. " Std. " .. (m % 60) .. " Min."
end

-- Multiplikator schön: 2.5 -> "x2,5"
function Util.formatMult(n)
	return "x" .. Util.format(n)
end

-- Prozent: 0.25 -> "+25 %"
function Util.formatPercent(n)
	return "+" .. Util.format(n * 100) .. " %"
end

-- flache Kopie einer Liste
function Util.copy(list)
	local out = {}
	for i, v in ipairs(list) do
		out[i] = v
	end
	return out
end

-- Liste zufällig mischen
function Util.shuffle(list, rng)
	for i = #list, 2, -1 do
		local j = rng and rng:NextInteger(1, i) or math.random(1, i)
		list[i], list[j] = list[j], list[i]
	end
	return list
end

return Util
]]></ProtectedString></Properties></Item>
</Item>
</Item>
<Item class="ServerScriptService" referent="RBX0000001C"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Script" referent="RBX00000007"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[--[[
	MAIN – startet das Spiel auf dem Server.
	Reihenfolge: Remotes → Karte bauen → Systeme starten → Spieler laden.
]]

local Players = game:GetService("Players")

local Modules = script.Parent:WaitForChild("Modules")
local Remotes = require(Modules.Remotes)
local DataService = require(Modules.DataService)
local MapBuilder = require(Modules.MapBuilder)
local GameService = require(Modules.GameService)
local PetService = require(Modules.PetService)
local BattleService = require(Modules.BattleService)
local LeaderboardService = require(Modules.LeaderboardService)
require(Modules.RewardService)
require(Modules.QuestService)
require(Modules.JobService)
require(Modules.TradeService)
local FanService = require(Modules.FanService)
local EventService = require(Modules.EventService)
local MinigameService = require(Modules.MinigameService)
require(Modules.ShopService)
require(Modules.MonetizationService)
local CombatService = require(Modules.CombatService)

-- 1) Karte mit allen 8 Welten bauen
MapBuilder.build()

-- 2) Geschenkbox-Stände verbinden
for _, entry in ipairs(MapBuilder.eggPrompts) do
	entry.prompt.Triggered:Connect(function(player)
		if entry.info then
			Remotes.OpenMenu:FireClient(player, "egginfo", entry.egg.index)
		else
			PetService.hatch(player, entry.egg.index, entry.count, false)
		end
	end)
end

-- 3) Portale verbinden: freigeschaltet → reisen, sonst Welten-Menü öffnen
for _, entry in ipairs(MapBuilder.portals) do
	entry.prompt.Triggered:Connect(function(player)
		local data = DataService.get(player)
		if not data then return end
		local Logic = require(game:GetService("ReplicatedStorage").Shared.Logic)
		if Logic.worldUnlocked(data, entry.target) then
			GameService.teleport(player, entry.target)
		else
			Remotes.OpenMenu:FireClient(player, "worlds")
		end
	end)
end

-- 4) Mog Battles, Bosskämpfe, Fans & Rangliste starten
BattleService.init(MapBuilder.npcs)
CombatService.init(MapBuilder.npcs)
task.spawn(FanService.init)   -- im Hintergrund (das Erstellen der Figuren dauert kurz)
LeaderboardService.init(MapBuilder.boardRows)
MinigameService.init(MapBuilder.minigames)
EventService.init()

-- 5) Spieler
Players.PlayerAdded:Connect(GameService.playerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(GameService.playerAdded, player)
end
Players.PlayerRemoving:Connect(function(player)
	DataService.release(player)
end)

-- 6) Jede Sekunde Aura verteilen
GameService.start()

print("[Looksmaxxer 3000] Server gestartet – viel Spaß beim Glow-Up! ✨")
]]></ProtectedString></Properties></Item>
<Item class="Folder" referent="RBX0000001B"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX00000008"><Properties><string name="Name">BattleService</string><ProtectedString name="Source"><![CDATA[--[[
	BATTLESERVICE – Mog Battles
	• gegen andere Spieler (Anfrage → Annehmen/Ablehnen)
	• gegen den Rivalen und den Boss jeder Welt
	• gegen Endboss LEON (mit Chance auf das geheime Pet)

	Ablauf: 5 zufällige Kategorien, in jeder werden die Punkte verglichen
	(mit ±25 % Glück). Wer 3 Runden gewinnt, moggt.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local PetService = require(script.Parent.PetService)

local BattleService = {}
local rng = Random.new()
local cooldowns = {}   -- [player] = { [key] = Zeitpunkt }
local pending = {}     -- [Herausgeforderter] = { from = Spieler, t = Zeit }

local function onCooldown(player, key, seconds)
	cooldowns[player] = cooldowns[player] or {}
	local last = cooldowns[player][key]
	local now = os.clock()
	if last and now - last < seconds then
		return math.ceil(seconds - (now - last))
	end
	return nil
end
local function setCooldown(player, key)
	cooldowns[player] = cooldowns[player] or {}
	cooldowns[player][key] = os.clock()
end

-- Kämpfer-Daten
local function playerFighter(player)
	local data = DataService.get(player)
	if not data then return nil end
	return { name = player.DisplayName, levels = data.levels, rebirths = data.rebirths }
end

local function npcFighter(def)
	local levels = {}
	for _, u in ipairs(Config.Upgrades) do
		levels[u.id] = def.level
	end
	return { name = def.name, levels = levels, rebirths = def.rebirths }
end

-- Den Kampf ausrechnen
function BattleService.simulate(A, B)
	local cats = Util.shuffle(Util.copy(Config.Categories), rng)
	local rounds, wins = {}, 0
	for i = 1, 5 do
		local c = cats[i]
		local a = Logic.catScore(A.levels, c.id, A.rebirths) * rng:NextNumber(0.75, 1.25) + rng:NextNumber(0, 4)
		local b = Logic.catScore(B.levels, c.id, B.rebirths) * rng:NextNumber(0.75, 1.25) + rng:NextNumber(0, 4)
		if a > b then wins = wins + 1 end
		table.insert(rounds, { cat = c.id, a = a, b = b })
	end
	return rounds, wins, wins >= 3
end

-- Runden aus Sicht des Gegners umdrehen
local function flip(rounds)
	local out = {}
	for i, r in ipairs(rounds) do
		out[i] = { cat = r.cat, a = r.b, b = r.a }
	end
	return out
end

----------------------------------------------------------------------------
-- Kampf gegen NPCs (Rivalen & Bosse)
----------------------------------------------------------------------------
function BattleService.fightNPC(player, entry)
	local data = DataService.get(player)
	if not data then return end
	local def, world, isBoss = entry.def, entry.world, entry.isBoss
	if not Logic.worldUnlocked(data, world) then return end
	local key = (isBoss and "boss" or "rival") .. world .. def.name
	local wait = onCooldown(player, key, isBoss and Config.BOSS_COOLDOWN or Config.RIVAL_COOLDOWN)
	if wait then
		GameService.notify(player, "⏳ Verschnaufpause", def.name .. " erholt sich noch " .. wait .. " s.", "")
		return
	end
	setCooldown(player, key)

	local me = playerFighter(player)
	local rounds, wins, won = BattleService.simulate(me, npcFighter(def))
	local now = os.time()
	local aps = math.max(Logic.aps(data, GameService.currentWorld(player), now), 1)
	local reward = { aura = 0, cash = 0 }
	local special = nil
	local text

	if won then
		data.mogWins = data.mogWins + 1
		if isBoss then
			data.bossWins = data.bossWins + 1
			reward.aura = math.max(500, aps * 300)
			reward.cash = def.final and 100000 or 200 * world * world
			text = def.final and "Die ganze Stadt rastet aus. Leon setzt wortlos seine Sonnenbrille auf und geht."
				or string.format(Config.MogWin[rng:NextInteger(1, #Config.MogWin)], def.name)
		else
			reward.aura = math.max(100, aps * 60)
			reward.cash = 25 * world * world
			text = string.format(Config.MogWin[rng:NextInteger(1, #Config.MogWin)], def.name)
		end
		reward.cash = math.floor(reward.cash * Logic.cashMult(data))
		GameService.addAura(data, reward.aura)
		data.cash = data.cash + reward.cash
	else
		data.mogLosses = data.mogLosses + 1
		text = def.final and "Leon hat dich nicht mal angeschaut – und trotzdem gewonnen."
			or string.format(Config.MogLose[rng:NextInteger(1, #Config.MogLose)], def.name)
	end

	Remotes.BattleResult:FireClient(player, {
		opponent = def.name, isBoss = isBoss, final = def.final == true,
		taunt = isBoss and Config.BossTaunts[rng:NextInteger(1, #Config.BossTaunts)] or nil,
		rounds = rounds, wins = wins, won = won, reward = reward, text = text,
	})

	-- Belohnungen für Boss-Siege: eine kostenlose Box der Welt (+ Chance auf Leons Goldfisch)
	if won and isBoss then
		task.delay(6, function()
			if not player.Parent then return end
			if def.final and rng:NextNumber() < Config.SECRET_CHANCE then
				PetService.givePet(player, Config.SECRET_PET)
				PetService.announce(player.DisplayName .. " hat LEON besiegt und das GEHEIME Pet 🐠 Leons Goldfisch erbeutet!")
			else
				PetService.hatch(player, Config.eggIndex(world, 2), 1, true)   -- gratis Silber-Box
			end
		end)
	end
	GameService.sendFull(player)
end

----------------------------------------------------------------------------
-- Spieler gegen Spieler
----------------------------------------------------------------------------
local function addPrompt(player, char)
	local hrp = char:WaitForChild("HumanoidRootPart", 10)
	if not hrp then return end
	local old = hrp:FindFirstChild("MogPrompt")
	if old then old:Destroy() end
	local pr = Instance.new("ProximityPrompt")
	pr.Name = "MogPrompt"
	pr.ActionText = "Mog Battle"
	pr.ObjectText = player.DisplayName
	pr.HoldDuration = 0.5
	pr.MaxActivationDistance = 12
	pr.RequiresLineOfSight = false
	pr.Parent = hrp
	pr.Triggered:Connect(function(challenger)
		if challenger == player then return end
		BattleService.challenge(challenger, player)
	end)
end

function BattleService.challenge(challenger, target)
	if not DataService.get(challenger) or not DataService.get(target) then return end
	local wait = onCooldown(challenger, "pvp" .. target.UserId, Config.PVP_COOLDOWN)
	if wait then
		GameService.notify(challenger, "⏳ Kurz warten", "Du kannst " .. target.DisplayName .. " in " .. wait .. " s wieder herausfordern.", "")
		return
	end
	setCooldown(challenger, "pvp" .. target.UserId)
	pending[target] = { from = challenger, t = os.clock() }
	Remotes.BattleRequest:FireClient(target, challenger.DisplayName, challenger.UserId)
	GameService.notify(challenger, "⚔️ Herausforderung gesendet", target.DisplayName .. " muss noch annehmen …", "")
end

Remotes.BattleRespond.OnServerEvent:Connect(function(target, accept, fromUserId)
	local req = pending[target]
	pending[target] = nil
	if not req or not req.from.Parent or req.from.UserId ~= fromUserId then return end
	if os.clock() - req.t > 20 then return end
	local challenger = req.from
	if not accept then
		GameService.notify(challenger, "🙅 Abgelehnt", target.DisplayName .. " hat sich nicht getraut.", "bad")
		return
	end
	local A, B = playerFighter(challenger), playerFighter(target)
	if not A or not B then return end
	local rounds, wins, won = BattleService.simulate(A, B)
	local winner = won and challenger or target
	local loser = won and target or challenger
	local wd, ld = DataService.get(winner), DataService.get(loser)
	local reward = { aura = math.max(100, Logic.aps(wd, GameService.currentWorld(winner), os.time()) * 60), cash = 50 }
	GameService.addAura(wd, reward.aura)
	wd.cash = wd.cash + reward.cash
	wd.mogWins = wd.mogWins + 1
	ld.mogLosses = ld.mogLosses + 1

	Remotes.BattleResult:FireClient(challenger, {
		opponent = target.DisplayName, rounds = rounds, wins = wins, won = won,
		reward = won and reward or { aura = 0, cash = 0 },
		text = won and string.format(Config.MogWin[1], target.DisplayName) or string.format(Config.MogLose[2], target.DisplayName),
	})
	Remotes.BattleResult:FireClient(target, {
		opponent = challenger.DisplayName, rounds = flip(rounds), wins = 5 - wins, won = not won,
		reward = (not won) and reward or { aura = 0, cash = 0 },
		text = (not won) and string.format(Config.MogWin[1], challenger.DisplayName) or string.format(Config.MogLose[2], challenger.DisplayName),
	})
	if wins == 5 or wins == 0 then
		PetService.announce(winner.DisplayName .. " hat " .. loser.DisplayName .. " mit 5:0 komplett gemoggt! 💀")
	end
	GameService.sendFull(challenger)
	GameService.sendFull(target)
end)

----------------------------------------------------------------------------
-- Start
----------------------------------------------------------------------------
function BattleService.init(npcEntries)
	for _, entry in ipairs(npcEntries) do
		entry.prompt.Triggered:Connect(function(player)
			BattleService.fightNPC(player, entry)
		end)
	end
	table.insert(GameService.characterHooks, addPrompt)
end

Players.PlayerRemoving:Connect(function(player)
	cooldowns[player] = nil
	pending[player] = nil
end)

return BattleService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000009"><Properties><string name="Name">CombatService</string><ProtectedString name="Source"><![CDATA[--[[
	COMBATSERVICE – Waffen & Echtzeit-Bosskämpfe

	Waffen:
	  • kaufen, verbessern (bis Stufe 10) und ausrüsten mit Geld
	  • die ausgerüstete Waffe liegt als Werkzeug unten im Inventar (Taste 1)
	  • Klicken/Tippen = zuschlagen
	Bosskampf:
	  • jeder Boss hat Lebenspunkte – alle Spieler in der Nähe kämpfen zusammen
	  • der Boss greift an: rote Kreise auf dem Boden = schnell rauslaufen!
	  • dein "Selbstbewusstsein" ist dein Lebensbalken. Bei 0 wirst du zum Spawn geschickt.
	  • Beute für alle, die mitgeholfen haben: Geld, Aura, seltene Boss-Waffen
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)
local PetService = require(script.Parent.PetService)

local CombatService = {}
local rng = Random.new()
local bosses = {}
local lastAttack = {}     -- [player] = os.clock()
local lastHurt = {}       -- [player] = os.clock()

local RARITY_COLOR = {}
for id, r in pairs(Config.Rarities) do RARITY_COLOR[id] = r.color end

----------------------------------------------------------------------------
-- Selbstbewusstsein (Lebensbalken)
----------------------------------------------------------------------------
local function setConfidence(player, value)
	local data = DataService.get(player)
	if not data then return end
	local max = Logic.maxConfidence(data)
	player:SetAttribute("MaxConf", max)
	player:SetAttribute("Conf", math.clamp(value, 0, max))
end

local function hurt(player, percent)
	local data = DataService.get(player)
	if not data then return end
	local max = Logic.maxConfidence(data)
	local w = Logic.weaponById[data.weapon]
	if w and w.shield then percent = percent * w.shield end
	local conf = (player:GetAttribute("Conf") or max) - max * percent
	lastHurt[player] = os.clock()
	if conf <= 0 then
		setConfidence(player, max)
		GameService.notify(player, "😵 Gemoggt vom Boss!", "Dein Selbstbewusstsein ist am Boden. Kurz durchatmen am Spawn – dann zurück in den Kampf!", "bad")
		GameService.teleport(player, GameService.currentWorld(player))
	else
		setConfidence(player, conf)
	end
end

----------------------------------------------------------------------------
-- Waffe als Werkzeug ins Inventar legen
----------------------------------------------------------------------------
function CombatService.giveTool(player)
	local data = DataService.get(player)
	local char = player.Character
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not data or not backpack then return end
	for _, container in ipairs({ backpack, char }) do
		if container then
			for _, t in ipairs(container:GetChildren()) do
				if t:IsA("Tool") and t:GetAttribute("LooksWeapon") then t:Destroy() end
			end
		end
	end
	local w = Logic.weaponById[data.weapon] or Logic.weaponById[Config.STARTER_WEAPON]
	local tool = Instance.new("Tool")
	tool.Name = w.emoji .. " " .. w.name
	tool.ToolTip = w.name .. " (Stufe " .. math.max(1, Logic.weaponLevel(data, w.id)) .. ")"
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("LooksWeapon", true)
	local handle = Instance.new("Part")
	handle.Name = "Handle"
	handle.Size = Vector3.new(0.5, 3.4, 0.5)
	handle.Color = RARITY_COLOR[w.rarity] or Color3.new(1, 1, 1)
	handle.Material = (w.rarity == "legendary" or w.rarity == "mythic") and Enum.Material.Neon or Enum.Material.SmoothPlastic
	handle.CanCollide = false
	handle.Massless = true
	handle.Parent = tool
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(2, 0, 2, 0)
	bb.StudsOffset = Vector3.new(0, 2, 0)
	bb.LightInfluence = 0
	bb.MaxDistance = 60
	bb.Parent = handle
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Text = w.emoji
	l.Parent = bb
	tool.Activated:Connect(function()
		-- Schwung-Animation über das Standard-Animationsskript
		local anim = Instance.new("StringValue")
		anim.Name = "toolanim"
		anim.Value = "Slash"
		anim.Parent = tool
		Debris:AddItem(anim, 0.5)
		CombatService.attack(player)
	end)
	tool.Parent = backpack
end

----------------------------------------------------------------------------
-- Boss-Lebensbalken
----------------------------------------------------------------------------
local function makeHpBar(boss)
	local bb = Instance.new("BillboardGui")
	bb.Name = "HpBar"
	bb.Size = UDim2.new(9, 0, 1.1, 0)
	bb.StudsOffset = Vector3.new(0, 7 * boss.scale, 0)
	bb.MaxDistance = 150
	bb.LightInfluence = 0
	bb.Parent = boss.head
	local bg = Instance.new("Frame")
	bg.Size = UDim2.new(1, 0, 1, 0)
	bg.BackgroundColor3 = Color3.fromRGB(30, 10, 40)
	bg.BorderSizePixel = 0
	bg.Parent = bb
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(1, 0, 1, 0)
	fill.BackgroundColor3 = Color3.fromRGB(255, 70, 90)
	fill.BorderSizePixel = 0
	fill.Parent = bg
	local text = Instance.new("TextLabel")
	text.Name = "Text"
	text.Size = UDim2.new(1, 0, 1, 0)
	text.BackgroundTransparency = 1
	text.TextScaled = true
	text.Font = Enum.Font.FredokaOne
	text.TextColor3 = Color3.new(1, 1, 1)
	text.TextStrokeTransparency = 0.3
	text.Parent = bg
	boss.bar = fill
	boss.barText = text
end

local function updateBoss(boss)
	boss.model:SetAttribute("HP", boss.hp)
	boss.model:SetAttribute("MaxHP", boss.maxHp)
	if boss.bar then
		boss.bar.Size = UDim2.new(math.clamp(boss.hp / boss.maxHp, 0, 1), 0, 1, 0)
		boss.barText.Text = "❤️ " .. Util.format(math.max(0, boss.hp)) .. " / " .. Util.format(boss.maxHp)
	end
end

----------------------------------------------------------------------------
-- Angreifen
----------------------------------------------------------------------------
local function hitFlash(position, color)
	local p = Instance.new("Part")
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(2.5, 2.5, 2.5)
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Material = Enum.Material.Neon
	p.Color = color
	p.Transparency = 0.2
	p.CFrame = CFrame.new(position)
	p.Parent = workspace
	Debris:AddItem(p, 0.15)
end

local function defeat(boss)
	boss.dead = true
	local participants = {}
	for player, dmg in pairs(boss.damage) do
		if player.Parent and dmg >= boss.maxHp * 0.03 then
			table.insert(participants, { player = player, share = dmg / boss.maxHp })
		end
	end
	boss.damage = {}
	boss.respawnAt = os.clock() + Config.BOSS_RESPAWN
	boss.model.Parent = nil   -- Boss verschwindet

	for _, p in ipairs(participants) do
		local player = p.player
		local data = DataService.get(player)
		if data then
			local aps = math.max(Logic.aps(data, GameService.currentWorld(player), os.time()), 5)
			local cash = math.floor(150 * boss.world ^ 2.5 * (0.5 + math.min(p.share, 1)) * Logic.cashMult(data))
			local aura = aps * 120
			data.cash = data.cash + cash
			GameService.addAura(data, aura)
			GameService.track(player, "bossKills", 1)
			local text = "+" .. Util.format(cash) .. " Geld · +" .. Util.format(aura) .. " Aura · Dein Anteil: " .. math.floor(p.share * 100) .. " %"
			-- Event-Boss: Event-Münzen
			if boss.def.event then
				local tokens = math.floor(10 + 20 * math.min(p.share, 1))
				data.eventTokens[boss.def.event] = Logic.eventTokens(data, boss.def.event) + tokens
				text = text .. " · +" .. tokens .. " Event-Münzen"
			end
			-- seltene Boss-Waffen
			local drop = nil
			if boss.def.final and rng:NextNumber() < Logic.weaponById.laser.drop and Logic.weaponLevel(data, "laser") == 0 then
				drop = "laser"
			elseif boss.world >= 4 and rng:NextNumber() < Logic.weaponById.faust.drop and Logic.weaponLevel(data, "faust") == 0 then
				drop = "faust"
			end
			if drop then
				data.weapons[drop] = 1
				local w = Logic.weaponById[drop]
				text = text .. "\n🎉 BEUTE: " .. w.emoji .. " " .. w.name .. "!"
				PetService.announce(player.DisplayName .. " hat die Waffe " .. w.emoji .. " " .. w.name .. " erbeutet!")
			end
			GameService.notify(player, "👑 " .. boss.def.name .. " BESIEGT!", text, "title")
			GameService.sendFull(player)
		end
	end
end

function CombatService.attack(player)
	local data = DataService.get(player)
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not data or not hrp then return end
	local w = Logic.weaponById[data.weapon] or Logic.weaponById[Config.STARTER_WEAPON]
	local now = os.clock()
	if lastAttack[player] and now - lastAttack[player] < w.cooldown * 0.9 then return end
	lastAttack[player] = now

	local best, bestDist = nil, math.huge
	for _, boss in ipairs(bosses) do
		if not boss.dead then
			local d = (boss.hrp.Position - hrp.Position).Magnitude - boss.radius
			if d <= w.range and d < bestDist then
				best, bestDist = boss, d
			end
		end
	end
	if not best then return end

	local dmg = Logic.weaponDamage(data, w.id)
	local crit = rng:NextNumber() < w.crit
	if crit then dmg = dmg * 2.5 end
	best.hp = best.hp - dmg
	best.damage[player] = (best.damage[player] or 0) + dmg
	best.lastHit = now
	GameService.track(player, "bossHits", 1)
	local hitPos = best.hrp.Position + Vector3.new(rng:NextNumber(-2, 2), rng:NextNumber(0, 3), rng:NextNumber(-2, 2))
	hitFlash(hitPos, RARITY_COLOR[w.rarity] or Color3.new(1, 1, 1))
	Remotes.DamagePopup:FireClient(player, dmg, crit, hitPos)
	updateBoss(best)
	if best.hp <= 0 then
		defeat(best)
	end
end

----------------------------------------------------------------------------
-- Boss-Angriffe: roter Kreis → nach kurzer Zeit Schaden
----------------------------------------------------------------------------
local function telegraph(position, radius, delay, onHit)
	local ring = Instance.new("Part")
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.3, radius * 2, radius * 2)
	ring.CFrame = CFrame.new(position.X, 0.25, position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CanTouch = false
	ring.Material = Enum.Material.Neon
	ring.Color = Color3.fromRGB(255, 40, 60)
	ring.Transparency = 0.6
	ring.Parent = workspace
	task.delay(delay, function()
		ring.Transparency = 0.1
		ring.Color = Color3.fromRGB(255, 240, 200)
		onHit()
		Debris:AddItem(ring, 0.25)
	end)
end

local function nearbyPlayers(boss, range)
	local list = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp and (hrp.Position - boss.hrp.Position).Magnitude <= range then
			table.insert(list, { player = player, hrp = hrp })
		end
	end
	return list
end

local function hitArea(center, radius)
	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		local hrp = char and char:FindFirstChild("HumanoidRootPart")
		if hrp then
			local flat = Vector3.new(hrp.Position.X - center.X, 0, hrp.Position.Z - center.Z)
			if flat.Magnitude <= radius then
				hurt(player, Config.BOSS_HIT_PERCENT)
			end
		end
	end
end

local function bossAttack(boss)
	local near = nearbyPlayers(boss, 70)
	if #near == 0 then return end
	if rng:NextNumber() < 0.5 then
		-- Schockwelle rund um den Boss
		local center = boss.hrp.Position
		local r = 18 + boss.scale * 4
		telegraph(center, r, 1.6, function() hitArea(center, r) end)
	else
		-- "Mog-Blick": gezielter Angriff auf einen Spieler (+ eventuell einen zweiten)
		for k = 1, math.min(#near, boss.world >= 5 and 2 or 1) do
			local target = near[rng:NextInteger(1, #near)]
			local center = target.hrp.Position
			telegraph(center, 9, 1.4, function() hitArea(center, 9) end)
		end
	end
end

----------------------------------------------------------------------------
-- Remotes: Waffen kaufen, verbessern, ausrüsten
----------------------------------------------------------------------------
Remotes.BuyWeapon.OnServerEvent:Connect(function(player, id)
	local data = DataService.get(player)
	local w = Logic.weaponById[id]
	if not data or not w then return end
	if Logic.weaponLevel(data, id) > 0 then return end
	if w.price <= 0 then
		GameService.notify(player, "👑 Nur als Beute", w.desc, "bad")
		return
	end
	if data.cash < w.price then
		GameService.notify(player, "💸 Zu wenig Geld", w.name .. " kostet " .. Util.format(w.price) .. " Geld. Tipp: 💼 Jobs!", "bad")
		return
	end
	data.cash = data.cash - w.price
	data.weapons[id] = 1
	data.weapon = id
	CombatService.giveTool(player)
	GameService.notify(player, w.emoji .. " " .. w.name .. " gekauft!", "Ausgerüstet – ab zum nächsten Boss!", "good")
	GameService.sendFull(player)
end)

Remotes.UpgradeWeapon.OnServerEvent:Connect(function(player, id)
	local data = DataService.get(player)
	local w = Logic.weaponById[id]
	if not data or not w then return end
	local level = Logic.weaponLevel(data, id)
	if level <= 0 or level >= Config.WEAPON_MAX_LEVEL then return end
	local cost = Logic.weaponUpgradeCost(id, level)
	if data.cash < cost then
		GameService.notify(player, "💸 Zu wenig Geld", "Verbessern kostet " .. Util.format(cost) .. " Geld.", "bad")
		return
	end
	data.cash = data.cash - cost
	data.weapons[id] = level + 1
	if data.weapon == id then CombatService.giveTool(player) end
	GameService.notify(player, w.emoji .. " " .. w.name .. " verbessert!", "Jetzt Stufe " .. (level + 1) .. ".", "good")
	GameService.sendFull(player)
end)

Remotes.EquipWeapon.OnServerEvent:Connect(function(player, id)
	local data = DataService.get(player)
	if not data or Logic.weaponLevel(data, id) <= 0 then return end
	data.weapon = id
	CombatService.giveTool(player)
	GameService.sendFull(player)
end)

----------------------------------------------------------------------------
-- Start
----------------------------------------------------------------------------
function CombatService.init(npcEntries)
	for _, entry in ipairs(npcEntries) do
		if entry.isBoss then
			local hrp = entry.prompt.Parent
			local model = hrp and hrp.Parent
			if model and model:IsA("Model") then
				local boss = {
					def = entry.def, world = entry.world, model = model, hrp = hrp, head = model:FindFirstChild("Head") or hrp,
					parent = model.Parent, scale = entry.def.scale or 1, radius = 3 * (entry.def.scale or 1),
					maxHp = entry.def.hp or Config.BossHP[entry.world] or 1000, damage = {}, lastHit = 0, dead = false, nextAttack = 0,
				}
				boss.hp = boss.maxHp
				makeHpBar(boss)
				updateBoss(boss)
				table.insert(bosses, boss)
			end
		end
	end

	-- Charaktere: Waffe geben, Selbstbewusstsein auffüllen
	table.insert(GameService.characterHooks, function(player, char)
		player:WaitForChild("Backpack", 10)
		local data = DataService.get(player)
		if data then
			if Logic.weaponLevel(data, data.weapon) <= 0 then data.weapon = Config.STARTER_WEAPON end
			setConfidence(player, Logic.maxConfidence(data))
		end
		CombatService.giveTool(player)
	end)

	-- Boss-Schleife: Angriffe & Wiederauferstehung
	task.spawn(function()
		while true do
			task.wait(0.5)
			local now = os.clock()
			for _, boss in ipairs(bosses) do
				if boss.dead then
					if now >= boss.respawnAt then
						boss.dead = false
						boss.hp = boss.maxHp
						boss.model.Parent = boss.parent
						updateBoss(boss)
					end
				elseif now - boss.lastHit < 20 and now >= boss.nextAttack then
					boss.nextAttack = now + Config.BOSS_ATTACK_EVERY
					bossAttack(boss)
				elseif now - boss.lastHit > 60 and boss.hp < boss.maxHp then
					-- niemand kämpft mehr: Boss heilt sich
					boss.hp = boss.maxHp
					boss.damage = {}
					updateBoss(boss)
				end
			end
		end
	end)

	-- Selbstbewusstsein regeneriert sich langsam
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.get(player)
				if data then
					local max = Logic.maxConfidence(data)
					local conf = player:GetAttribute("Conf") or max
					if conf < max and os.clock() - (lastHurt[player] or 0) > 5 then
						setConfidence(player, conf + max * 0.08)
					elseif player:GetAttribute("MaxConf") ~= max then
						setConfidence(player, math.min(conf, max))
					end
				end
			end
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	lastAttack[player] = nil
	lastHurt[player] = nil
	for _, boss in ipairs(bosses) do
		boss.damage[player] = nil
	end
end)

return CombatService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000A"><Properties><string name="Name">DataService</string><ProtectedString name="Source"><![CDATA[--[[
	DATASERVICE – lädt und speichert den Spielstand jedes Spielers (DataStore).

	Wichtig: Damit das Speichern in Roblox Studio funktioniert, muss das Spiel
	veröffentlicht sein und unter Game Settings > Security
	"Enable Studio Access to API Services" eingeschaltet sein.
]]

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local DataService = {}

local store = nil
local okStore, errStore = pcall(function()
	store = DataStoreService:GetDataStore(Config.SAVE_KEY)
end)
if not okStore then
	warn("[Looksmaxxer] DataStore nicht verfügbar – es wird NICHT gespeichert:", errStore)
end

local profiles = {}   -- [player] = Spielstand
local loadedOk = {}   -- [player] = true, wenn erfolgreich geladen (nur dann speichern!)

-- So sieht ein neuer Spielstand aus
local function defaultData()
	return {
		version = 1,
		aura = 0, totalAura = 0, cash = 0, clicks = 0,
		levels = {},                 -- [upgradeId] = Stufe
		rebirths = 0, rebirthPoints = 0,
		perks = {},                  -- [perkId] = Stufe
		worlds = { ["1"] = true },   -- freigeschaltete Welten
		pets = {},                   -- Liste: { uid, id, tier, eq }
		nextPetId = 1,
		index = {},                  -- Sammelbuch: [petId] = true
		eggsOpened = 0, pity = 0,
		mogWins = 0, mogLosses = 0, bossWins = 0,
		bestTitle = 1,
		daily = { last = 0, streak = 0 },
		codes = {},                  -- eingelöste Codes
		potions = {},                -- [potionId] = Ende (os.time)
		settings = { music = true, sfx = true },
		lastOnline = 0,
		stats = {},                  -- Zähler für Aufträge & Erfolge
		quests = { day = 0, list = {}, bonus = false },
		achievements = {},           -- [erfolgId] = abgeholte Stufen
		jobCd = {},                  -- [jobId] = Ende der Pause (os.time)
		weapons = { zahnbuerste = 1 }, -- [waffeId] = Stufe
		weapon = "zahnbuerste",      -- ausgerüstete Waffe
		gems = 0,                    -- Premium-Währung (Robux-Shop, Glücksrad, Events)
		passes = {},                 -- gekaufte Gamepasses
		purchases = {},              -- verarbeitete Robux-Käufe (gegen doppeltes Gutschreiben)
		starterPack = false,
		eventTokens = {},            -- [eventId] = Anzahl Event-Münzen
		wheel = { last = 0, spins = 0 },
		vehicles = {},               -- [fahrzeugId] = true
		vehicle = "",                -- ausgewähltes Fahrzeug
		cosmetics = { owned = {}, aura = "", trail = "", hat = "" },
		records = { obbyLast = 0, raceBest = 0, gymLast = 0, courses = {} },
		playtime = { day = "", seconds = 0, claimed = {} },   -- Spielzeit-Geschenke pro Tag
	}
end
DataService.defaultData = defaultData

-- Fehlende Felder ergänzen (wenn das Spiel neue Funktionen bekommt)
local function reconcile(data)
	local def = defaultData()
	for k, v in pairs(def) do
		if data[k] == nil then
			data[k] = v
		elseif type(v) == "table" and type(data[k]) == "table" then
			for k2, v2 in pairs(v) do
				if data[k][k2] == nil then
					data[k][k2] = v2
				end
			end
		end
	end
	return data
end

function DataService.load(player)
	local data = nil
	local key = "u_" .. player.UserId
	if store then
		for attempt = 1, 3 do
			local ok, result = pcall(function()
				return store:GetAsync(key)
			end)
			if ok then
				data = result
				loadedOk[player] = true
				break
			end
			warn("[Looksmaxxer] Laden fehlgeschlagen (Versuch " .. attempt .. "):", result)
			task.wait(2)
		end
	end
	if type(data) ~= "table" then
		data = defaultData()
	end
	profiles[player] = reconcile(data)
	return profiles[player], loadedOk[player] == true
end

function DataService.get(player)
	return profiles[player]
end

function DataService.isSaving(player)
	return store ~= nil and loadedOk[player] == true
end

-- gibt true zurück, wenn der Stand sicher gespeichert ist (ohne DataStore, z. B. in Studio: true)
function DataService.save(player)
	local data = profiles[player]
	if not data then return false end
	if not store then return true end
	if not loadedOk[player] then return false end
	data.lastOnline = os.time()
	local ok, err = pcall(function()
		store:UpdateAsync("u_" .. player.UserId, function()
			return data
		end)
	end)
	if not ok then
		warn("[Looksmaxxer] Speichern fehlgeschlagen:", err)
	end
	return ok
end

function DataService.release(player)
	DataService.save(player)
	profiles[player] = nil
	loadedOk[player] = nil
end

function DataService.all()
	return profiles
end

-- Automatisch alle 2 Minuten speichern
task.spawn(function()
	while true do
		task.wait(120)
		for player in pairs(profiles) do
			task.spawn(DataService.save, player)
		end
	end
end)

-- Beim Herunterfahren des Servers alles speichern
game:BindToClose(function()
	local pending = 0
	for player in pairs(profiles) do
		pending = pending + 1
		task.spawn(function()
			DataService.save(player)
			pending = pending - 1
		end)
	end
	local start = os.clock()
	while pending > 0 and os.clock() - start < 25 do
		task.wait(0.2)
	end
end)

return DataService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000B"><Properties><string name="Name">EventService</string><ProtectedString name="Source"><![CDATA[--[[
	EVENTSERVICE – saisonale Events (Winter, Halloween, Sommer) laufen automatisch nach Kalender.
	Während eines Events liegen in allen Welten Sammelobjekte (z. B. ❄️ Schneeflocken).
	Mit den Event-Münzen öffnet man die Event-Box in Glow City (exklusive Pets!).
	Außerdem: Samstag & Sonntag automatisch doppelte Aura & doppeltes Glück (siehe Logic).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)

local EventService = {}
local rng = Random.new()
local items = {}        -- [world] = Liste der Sammelobjekte
local folder = nil

local function groundSpot(origin)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { folder }
	for _ = 1, 30 do
		local x, z = rng:NextNumber(-200, 200), rng:NextNumber(-200, 200)
		local hit = workspace:Raycast(origin + Vector3.new(x, 300, z), Vector3.new(0, -400, 0), params)
		if hit and (hit.Instance.Name == "Ground" or hit.Instance:IsA("Terrain")) and hit.Material ~= Enum.Material.Water and hit.Position.Y < 4 then
			return hit.Position
		end
	end
	return nil
end

local function spawnItem(ev, world)
	local pos = groundSpot(GameService.worldOrigin(world))
	if not pos then return end
	local p = Instance.new("Part")
	p.Name = "EventItem"
	p.Shape = Enum.PartType.Ball
	p.Size = Vector3.new(2.6, 2.6, 2.6)
	p.Color = ev.color
	p.Material = Enum.Material.Neon
	p.Transparency = 0.2
	p.Anchored = true
	p.CanCollide = false
	p.CFrame = CFrame.new(pos + Vector3.new(0, 2.5, 0))
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(3, 0, 3, 0)
	bb.StudsOffset = Vector3.new(0, 2.2, 0)
	bb.MaxDistance = 90
	bb.LightInfluence = 0
	bb.Parent = p
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Text = ev.tokenEmoji
	l.Parent = bb
	local light = Instance.new("PointLight")
	light.Color = ev.color
	light.Range = 10
	light.Parent = p
	local taken = false
	p.Touched:Connect(function(hit)
		if taken then return end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		local data = player and DataService.get(player)
		if not data then return end
		taken = true
		local amount = 1 + (Logic.isWeekend(os.time()) and 1 or 0)
		data.eventTokens[ev.id] = Logic.eventTokens(data, ev.id) + amount
		local aps = math.max(Logic.aps(data, GameService.currentWorld(player), os.time()), 5)
		GameService.addAura(data, aps * 5)
		GameService.notify(player, ev.tokenEmoji .. " +" .. amount .. " " .. ev.token, "Du hast jetzt " .. Logic.eventTokens(data, ev.id) .. ". Event-Box in Glow City!", "")
		GameService.sendFull(player)
		p:Destroy()
	end)
	p.Parent = folder
	table.insert(items[world], p)
end

function EventService.init()
	folder = Instance.new("Folder")
	folder.Name = "EventItems"
	folder.Parent = workspace
	for w = 1, #Config.Worlds do items[w] = {} end
	task.spawn(function()
		while true do
			local ev = Logic.activeEvent(os.time())
			for w = 1, #Config.Worlds do
				-- verschwundene (eingesammelte) Objekte aus der Liste entfernen
				local alive = {}
				for _, p in ipairs(items[w]) do
					if p.Parent then
						if ev then table.insert(alive, p) else p:Destroy() end
					end
				end
				items[w] = alive
				if ev and #alive < Config.EVENT_ITEMS_PER_WORLD then
					spawnItem(ev, w)
				end
			end
			task.wait(8)
		end
	end)
end

return EventService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000C"><Properties><string name="Name">FanService</string><ProtectedString name="Source"><![CDATA[--[[
	FANSERVICE – in jeder Welt laufen Leute herum, die du als Fans gewinnen kannst.
	• Promi-Level 1–10: je höher, desto mehr Charisma brauchst du
	• Du wählst einen von 3 Sprüchen/Aktionen (manche helfen, manche nicht 😄)
	• Erfolg: Aura + Geld, Zähler "fans" steigt (für Aufträge & Erfolge)
	Die Figuren laufen nur herum, wenn jemand in ihrer Welt ist (spart Leistung).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)

local FanService = {}
local rng = Random.new()
local fans = {}          -- alle Fans
local cooldowns = {}     -- [player] = { [fanId] = os.clock() bis wann gesperrt }
local pending = {}       -- [player] = { fan, openers, t }

local WALK_ANIM = "rbxassetid://507777826"   -- Standard-Laufanimation (R15)

local SKIN = { Color3.fromRGB(255, 224, 196), Color3.fromRGB(241, 194, 125), Color3.fromRGB(224, 172, 105),
	Color3.fromRGB(198, 134, 66), Color3.fromRGB(141, 85, 36), Color3.fromRGB(92, 58, 30) }
local CLOTHES = { Color3.fromRGB(230, 57, 70), Color3.fromRGB(255, 143, 171), Color3.fromRGB(155, 92, 255), Color3.fromRGB(58, 134, 255),
	Color3.fromRGB(42, 157, 143), Color3.fromRGB(255, 183, 3), Color3.fromRGB(240, 240, 240), Color3.fromRGB(34, 34, 34) }

-- freier Platz auf dem Boden (nicht in Gebäuden)
local function groundSpot(origin)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local npcs = workspace:FindFirstChild("NPCs")
	params.FilterDescendantsInstances = npcs and { npcs } or {}
	for _ = 1, 40 do
		local x = rng:NextNumber(-170, 170)
		local z = rng:NextNumber(-170, 170)
		if math.sqrt(x * x + z * z) > 35 then
			local from = origin + Vector3.new(x, 300, z)
			local hit = workspace:Raycast(from, Vector3.new(0, -400, 0), params)
			if hit and (hit.Instance.Name == "Ground" or hit.Instance:IsA("Terrain")) and hit.Material ~= Enum.Material.Water and hit.Position.Y < 4 then
				return hit.Position
			end
		end
	end
	return origin + Vector3.new(rng:NextNumber(-30, 30), 0, 40)
end

local function makeFan(world, index)
	local origin = GameService.worldOrigin(world)
	local fame = rng:NextInteger(1, 10)
	local name = Config.FanNames[rng:NextInteger(1, #Config.FanNames)]
	local role = Config.FanRoles[fame]
	local skin = SKIN[rng:NextInteger(1, #SKIN)]
	local model
	local ok = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = skin
		desc.LeftArmColor = skin
		desc.RightArmColor = skin
		desc.TorsoColor = CLOTHES[rng:NextInteger(1, #CLOTHES)]
		local pants = CLOTHES[rng:NextInteger(1, #CLOTHES)]
		desc.LeftLegColor = pants
		desc.RightLegColor = pants
		desc.HeightScale = rng:NextNumber(0.9, 1.05)
		model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then return nil end
	model.Name = "Fan_" .. name
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if not hum or not hrp then return nil end
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.WalkSpeed = 7
	local home = groundSpot(origin)
	model:PivotTo(CFrame.new(home + Vector3.new(0, 3, 0)))
	model.Parent = workspace:FindFirstChild("NPCs") or workspace
	pcall(function() hrp:SetNetworkOwner(nil) end)

	-- Namensschild
	local head = model:FindFirstChild("Head")
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(6, 0, 1.6, 0)
	bb.StudsOffset = Vector3.new(0, 2.4, 0)
	bb.MaxDistance = 80
	bb.LightInfluence = 0
	bb.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.TextScaled = true
	label.RichText = true
	label.Font = Enum.Font.FredokaOne
	label.TextColor3 = Color3.new(1, 1, 1)
	label.TextStrokeTransparency = 0.3
	label.Text = "<font color='#ff9ad5'>⭐ " .. name .. " · " .. fame .. "/10</font>\n<font size='12'>" .. role .. "</font>"
	label.Parent = bb

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Begeistern"
	prompt.ObjectText = name .. " (Promi " .. fame .. "/10)"
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = hrp

	-- Laufanimation
	pcall(function()
		local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
		animator.Parent = hum
		local anim = Instance.new("Animation")
		anim.AnimationId = WALK_ANIM
		local track = animator:LoadAnimation(anim)
		hum.Running:Connect(function(speed)
			if speed > 0.5 then
				if not track.IsPlaying then track:Play() end
			elseif track.IsPlaying then
				track:Stop()
			end
		end)
	end)

	local fan = { id = world .. "_" .. index, world = world, fame = fame, name = name, role = role,
		model = model, hum = hum, hrp = hrp, home = home, head = head }
	prompt.Triggered:Connect(function(player)
		FanService.talk(player, fan)
	end)
	return fan
end

-- Kurzes Herz über dem Kopf
local function heart(fan, text)
	if not fan.head then return end
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(3, 0, 1.5, 0)
	bb.StudsOffset = Vector3.new(0, 4.2, 0)
	bb.LightInfluence = 0
	bb.Parent = fan.head
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.Text = text
	l.Parent = bb
	task.delay(3, function() bb:Destroy() end)
end

function FanService.talk(player, fan)
	local data = DataService.get(player)
	if not data or not Logic.worldUnlocked(data, fan.world) then return end
	cooldowns[player] = cooldowns[player] or {}
	local blockedUntil = cooldowns[player][fan.id]
	if blockedUntil and blockedUntil > os.clock() then
		GameService.notify(player, "🙄 Gerade nicht", fan.name .. " braucht noch " .. math.ceil(blockedUntil - os.clock()) .. " s Pause von dir.", "")
		return
	end
	-- 3 zufällige Sprüche
	local pool = Util.copy(Config.FanOpeners)
	Util.shuffle(pool, rng)
	local openers = { pool[1], pool[2], pool[3] }
	pending[player] = { fan = fan, openers = openers, t = os.clock() }
	local texts = {}
	for i, o in ipairs(openers) do texts[i] = o.text end
	Remotes.FanDialog:FireClient(player, {
		name = fan.name, role = fan.role, fame = fan.fame,
		chance = math.floor(Logic.fanChance(data, fan.world, fan.fame, 0) * 100 + 0.5),
		charisma = Logic.charisma(data), req = Logic.fanReq(fan.world, fan.fame),
		openers = texts,
	})
end

Remotes.FanChoice.OnServerEvent:Connect(function(player, index)
	local p = pending[player]
	pending[player] = nil
	local data = DataService.get(player)
	if not p or not data or os.clock() - p.t > 60 then return end
	local op = p.openers[tonumber(index) or 0]
	if not op then return end
	local fan = p.fan
	local mod = op.mod or 0
	if op.kind == "conf" then
		mod = Logic.catLevels(data.levels, "conf") >= 30 and 0.15 or -0.1
	elseif op.kind == "glow" then
		mod = Logic.charisma(data) >= Logic.fanReq(fan.world, fan.fame) * 1.5 and 0.15 or -0.15
	elseif op.kind == "rand" then
		mod = rng:NextNumber(-0.25, 0.2)
	end
	local chance = Logic.fanChance(data, fan.world, fan.fame, mod)
	cooldowns[player] = cooldowns[player] or {}
	if rng:NextNumber() < chance then
		local aps = math.max(Logic.aps(data, GameService.currentWorld(player), os.time()), 5)
		local aura = aps * 10 * fan.fame
		local cash = math.floor(5 * fan.fame * fan.world * fan.world * Logic.cashMult(data))
		GameService.addAura(data, aura)
		data.cash = data.cash + cash
		GameService.track(player, "fans", 1)
		cooldowns[player][fan.id] = os.clock() + Config.FAN_REPEAT
		heart(fan, "💚")
		Remotes.FanResult:FireClient(player, true, Config.FanYes[rng:NextInteger(1, #Config.FanYes)],
			"+" .. Util.format(aura) .. " Aura · +" .. Util.format(cash) .. " Geld")
	else
		cooldowns[player][fan.id] = os.clock() + Config.FAN_FAIL_COOLDOWN
		heart(fan, "😒")
		local tip = chance < 0.35 and "Tipp: Mehr Glow, Selbstbewusstsein-Upgrades und Rebirths erhöhen dein Charisma." or ""
		Remotes.FanResult:FireClient(player, false, string.format(Config.FanNo[rng:NextInteger(1, #Config.FanNo)], fan.name), tip)
	end
	GameService.sendFull(player)
end)

-- Fans laufen in ihrer Nähe herum, wenn Spieler in der Welt sind
local function worldHasPlayers(world)
	for _, plr in ipairs(Players:GetPlayers()) do
		if (plr:GetAttribute("World") or 1) == world then return true end
	end
	return false
end

function FanService.init()
	for w = 1, #Config.Worlds do
		for i = 1, Config.FANS_PER_WORLD do
			local fan = makeFan(w, i)
			if fan then table.insert(fans, fan) end
		end
	end
	task.spawn(function()
		while true do
			task.wait(4)
			local active = {}
			for w = 1, #Config.Worlds do active[w] = worldHasPlayers(w) end
			for _, fan in ipairs(fans) do
				if fan.model.Parent then
					if active[fan.world] then
						-- Welt ist besucht: Fan bewegt sich
						if fan.hrp.Anchored then fan.hrp.Anchored = false end
						if rng:NextNumber() < 0.5 then
							local target = fan.home + Vector3.new(rng:NextNumber(-35, 35), 0, rng:NextNumber(-35, 35))
							fan.hum:MoveTo(target)
						end
					elseif not fan.hrp.Anchored then
						-- niemand da: Fan "einfrieren" (spart Server-Leistung)
						fan.hrp.Anchored = true
					end
				end
			end
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	cooldowns[player] = nil
	pending[player] = nil
end)

return FanService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">GameService</string><ProtectedString name="Source"><![CDATA[--[[
	GAMESERVICE – das Herzstück auf dem Server:
	Klicks, Upgrades, Aura pro Sekunde, Rebirth, Welten, Titel,
	Namensschild & Aussehen des Avatars, Offline-Verdienst.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local LookService = require(script.Parent.LookService)
local StyleLook = require(script.Parent.StyleLook)

local GameService = {}
GameService.characterHooks = {}   -- andere Module können sich hier für "Charakter erschienen" eintragen
GameService.joinHooks = {}        -- … und für "Spieler hat das Spiel betreten"

-- Zähler erhöhen (für Aufträge & Erfolge)
function GameService.track(player, stat, amount)
	local data = DataService.get(player)
	if not data then return end
	data.stats[stat] = (data.stats[stat] or 0) + (amount or 1)
end

----------------------------------------------------------------------------
-- Hilfsfunktionen
----------------------------------------------------------------------------
function GameService.worldOrigin(index)
	return Vector3.new((index - 1) * Config.WORLD_SPACING, 0, 0)
end

function GameService.worldIndexAt(x)
	local i = math.floor((x + Config.WORLD_SPACING / 2) / Config.WORLD_SPACING) + 1
	return math.clamp(i, 1, #Config.Worlds)
end

function GameService.currentWorld(player)
	return player:GetAttribute("World") or 1
end

function GameService.notify(player, title, text, kind)
	Remotes.Notify:FireClient(player, title, text, kind or "")
end

function GameService.addAura(data, amount)
	data.aura = data.aura + amount
	data.totalAura = data.totalAura + amount
end

-- Alles, was der Spieler zum Anzeigen braucht
function GameService.snapshot(player, data)
	local now = os.time()
	local w = GameService.currentWorld(player)
	return {
		data = data,
		world = w,
		aps = Logic.aps(data, w, now),
		click = Logic.clickValue(data, w, now),
		glow = Logic.baseGlow(data.levels),
		glowPower = Logic.glowPower(data),
		mult = Logic.multiplier(data, w, now),
		petMult = Logic.petMult(data),
		petSlots = Logic.petSlots(data),
		luck = Logic.luck(data, now),
		rebirthCost = Logic.rebirthCost(data.rebirths),
		serverTime = now,
		saving = DataService.isSaving(player),
	}
end

function GameService.sendFull(player)
	local data = DataService.get(player)
	if data then
		Remotes.Data:FireClient(player, "full", GameService.snapshot(player, data))
	end
end

function GameService.sendLight(player)
	local data = DataService.get(player)
	if not data then return end
	local now = os.time()
	local w = GameService.currentWorld(player)
	Remotes.Data:FireClient(player, "light", {
		aura = data.aura, cash = data.cash, totalAura = data.totalAura, gems = data.gems,
		aps = Logic.aps(data, w, now), click = Logic.clickValue(data, w, now),
		mult = Logic.multiplier(data, w, now), world = w, serverTime = now,
	})
end

----------------------------------------------------------------------------
-- Leaderstats (Spielerliste oben rechts)
----------------------------------------------------------------------------
local function setupLeaderstats(player, data)
	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	local glow = Instance.new("IntValue")
	glow.Name = "✨ Glow"
	glow.Parent = ls
	local reb = Instance.new("IntValue")
	reb.Name = "♻️ Rebirths"
	reb.Parent = ls
	ls.Parent = player
end

local function updateLeaderstats(player, data)
	local ls = player:FindFirstChild("leaderstats")
	if not ls then return end
	local glow = ls:FindFirstChild("✨ Glow")
	local reb = ls:FindFirstChild("♻️ Rebirths")
	if glow then glow.Value = math.floor(Logic.baseGlow(data.levels)) end
	if reb then reb.Value = data.rebirths end
end

----------------------------------------------------------------------------
-- Aussehen: Namensschild, Glitzer-Aura, breitere Schultern
----------------------------------------------------------------------------
local function makeLabel(parent, name, posY, height, color, bold)
	local l = Instance.new("TextLabel")
	l.Name = name
	l.BackgroundTransparency = 1
	l.Size = UDim2.new(1, 0, height, 0)
	l.Position = UDim2.new(0, 0, posY, 0)
	l.TextScaled = true
	l.Font = bold and Enum.Font.FredokaOne or Enum.Font.GothamBold
	l.TextColor3 = color
	l.TextStrokeTransparency = 0.4
	l.Text = ""
	l.Parent = parent
	return l
end

local function ensureNametag(head)
	local tag = head:FindFirstChild("Nametag")
	if tag then return tag end
	tag = Instance.new("BillboardGui")
	tag.Name = "Nametag"
	tag.Size = UDim2.new(7, 0, 2.2, 0)
	tag.StudsOffset = Vector3.new(0, 2.8, 0)
	tag.MaxDistance = 120
	tag.AlwaysOnTop = false
	tag.Parent = head
	makeLabel(tag, "TitleLabel", 0, 0.32, Color3.fromRGB(255, 120, 220), false)
	makeLabel(tag, "NameLabel", 0.32, 0.4, Color3.new(1, 1, 1), true)
	makeLabel(tag, "InfoLabel", 0.72, 0.28, Color3.fromRGB(255, 209, 102), false)
	return tag
end

function GameService.refreshCharacter(player)
	local data = DataService.get(player)
	local char = player.Character
	if not data or not char then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local head = char:FindFirstChild("Head")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hum or not head or not hrp then return end

	local glow = Logic.baseGlow(data.levels)
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.WalkSpeed = Logic.walkSpeed(data, player:GetAttribute("Riding") == true)
	local vehicle = Logic.vehicleById[data.vehicle or ""]
	hum.UseJumpPower = true
	hum.JumpPower = 50 + ((player:GetAttribute("Riding") and vehicle) and vehicle.jump or 0)

	-- Namensschild mit Titel
	local tag = ensureNametag(head)
	tag.TitleLabel.Text = (Logic.hasPass(data, "vip") and "👑 VIP · " or "") .. Config.Titles[Logic.titleIndex(glow)].title
	tag.TitleLabel.TextColor3 = Logic.hasPass(data, "vip") and Color3.fromRGB(255, 209, 102) or Color3.fromRGB(255, 120, 220)
	tag.NameLabel.Text = player.DisplayName
	tag.InfoLabel.Text = "✨ " .. Util.format(glow) .. " Glow  ·  ♻️ " .. data.rebirths

	-- Aussehen verändert sich mit den Upgrades (Pickel, Haare, Haltung, Schultern, Style …)
	local ok, err = pcall(LookService.apply, player, char, data)
	if not ok then warn("[Looksmaxxer] LookService:", err) end
	-- Ausrüstung: Aura, Spur, Hut, Fahrzeug
	local ok2, err2 = pcall(StyleLook.apply, player, char, data, player:GetAttribute("Riding") == true)
	if not ok2 then warn("[Looksmaxxer] StyleLook:", err2) end

	-- Glitzer-Aura (stärker mit Glow, Farbe wechselt mit Rebirths)
	local aura = hrp:FindFirstChild("GlowAura")
	if not aura then
		aura = Instance.new("ParticleEmitter")
		aura.Name = "GlowAura"
		aura.LightEmission = 1
		aura.Lifetime = NumberRange.new(0.8, 1.6)
		aura.Speed = NumberRange.new(1, 3)
		aura.SpreadAngle = Vector2.new(180, 180)
		aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
		aura.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		aura.Parent = hrp
	end
	local colorIndex = (data.rebirths % #Config.AuraColors) + 1
	aura.Color = ColorSequence.new(Config.AuraColors[colorIndex])
	aura.Rate = math.clamp(glow / 80, 0, 45)
	aura.Enabled = glow >= 40
end

-- Nach Änderungen an den Upgrades: Titel prüfen, alles aktualisieren
function GameService.afterLevelsChanged(player, data)
	local glow = Logic.baseGlow(data.levels)
	local idx = Logic.titleIndex(glow)
	if idx > data.bestTitle then
		data.bestTitle = idx
		local t = Config.Titles[idx]
		GameService.notify(player, "🏆 Neuer Titel: " .. t.title .. "!", t.text, "title")
	end
	updateLeaderstats(player, data)
	GameService.refreshCharacter(player)
	GameService.sendFull(player)
end

----------------------------------------------------------------------------
-- Welten & Teleport
----------------------------------------------------------------------------
function GameService.teleport(player, index)
	local char = player.Character
	if not char then return end
	local origin = GameService.worldOrigin(index)
	char:PivotTo(CFrame.new(origin + Vector3.new(0, 5, 22)))
	player:SetAttribute("World", index)
	local w = Config.Worlds[index]
	GameService.notify(player, w.emoji .. " " .. w.name, "Aura-Multiplikator dieser Welt: x" .. Util.format(w.mult), "world")
	GameService.sendFull(player)
end

-- Welt freischalten (Aura bezahlen) oder hinreisen
function GameService.tryWorld(player, index)
	local data = DataService.get(player)
	local w = Config.Worlds[index]
	if not data or not w then return end
	if Logic.worldUnlocked(data, index) then
		GameService.teleport(player, index)
		return
	end
	if not Logic.worldUnlocked(data, index - 1) then
		GameService.notify(player, "🔒 Gesperrt", "Schalte zuerst " .. Config.Worlds[index - 1].name .. " frei.", "bad")
		return
	end
	if data.rebirths < w.rebirths then
		GameService.notify(player, "🔒 Mehr Rebirths nötig", w.name .. " braucht " .. w.rebirths .. " Rebirths.", "bad")
		return
	end
	if data.aura < w.cost then
		GameService.notify(player, "💸 Zu wenig Aura", w.name .. " kostet " .. Util.format(w.cost) .. " Aura.", "bad")
		return
	end
	data.aura = data.aura - w.cost
	data.worlds[tostring(index)] = true
	GameService.notify(player, "🌍 Neue Welt freigeschaltet!", w.emoji .. " " .. w.name .. " – x" .. Util.format(w.mult) .. " Aura!", "title")
	GameService.teleport(player, index)
end

----------------------------------------------------------------------------
-- Spieler betritt / verlässt das Spiel
----------------------------------------------------------------------------
local function onCharacterAdded(player, char)
	local hum = char:WaitForChild("Humanoid", 10)
	char:WaitForChild("HumanoidRootPart", 10)
	char:WaitForChild("Head", 10)
	if not hum then return end
	player:SetAttribute("World", 1)
	GameService.refreshCharacter(player)
	for _, hook in ipairs(GameService.characterHooks) do
		task.spawn(hook, player, char)
	end
end

local function offlineEarnings(player, data)
	if data.lastOnline <= 0 then return end
	local hours = Config.OFFLINE_HOURS + 2 * Logic.perkLevel(data, "offline")
	local secs = math.min(hours * 3600, os.time() - data.lastOnline)
	local aps = Logic.aps(data, 1, os.time())
	if secs < 60 or aps <= 0 then return end
	local gain = aps * secs * Config.OFFLINE_RATE
	GameService.addAura(data, gain)
	GameService.notify(player, "😴 Beauty Sleep",
		"Du warst " .. Util.formatTime(secs) .. " weg und hast im Schlaf " .. Util.format(gain) .. " Aura gesammelt!", "offline")
end

function GameService.playerAdded(player)
	local data, saving = DataService.load(player)
	if not player.Parent then return end   -- schon wieder weg
	setupLeaderstats(player, data)
	updateLeaderstats(player, data)
	player:SetAttribute("World", 1)
	player:SetAttribute("Loaded", true)

	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(player, char)
	end)
	player.CharacterAppearanceLoaded:Connect(function()
		task.wait(0.5)
		GameService.refreshCharacter(player)
	end)
	if player.Character then
		task.spawn(onCharacterAdded, player, player.Character)
	end

	for _, hook in ipairs(GameService.joinHooks) do
		task.spawn(hook, player, data)
	end
	GameService.sendFull(player)
	task.delay(3, function()
		if not player.Parent then return end
		if not saving then
			GameService.notify(player, "⚠️ Speichern aus",
				"Der Spielstand kann gerade nicht gespeichert werden (in Studio: API-Zugriff aktivieren).", "bad")
		end
		offlineEarnings(player, data)
		GameService.sendFull(player)
	end)
end

----------------------------------------------------------------------------
-- Remotes: Klicks, Upgrades, Rebirth, Perks, Welten
----------------------------------------------------------------------------
local clickWindow = {}   -- Schutz gegen Auto-Klicker-Programme

Remotes.Click.OnServerEvent:Connect(function(player)
	local data = DataService.get(player)
	if not data then return end
	local now = os.clock()
	local w = clickWindow[player]
	if not w or now - w.start >= 1 then
		w = { start = now, n = 0 }
		clickWindow[player] = w
	end
	w.n = w.n + 1
	if w.n > 15 then return end   -- mehr als 15 Klicks pro Sekunde wird ignoriert
	GameService.addAura(data, Logic.clickValue(data, GameService.currentWorld(player), os.time()))
	data.clicks = data.clicks + 1
end)

Remotes.BuyUpgrade.OnServerEvent:Connect(function(player, id, amount)
	local data = DataService.get(player)
	local u = Logic.upgradeById[id]
	if not data or not u then return end
	if amount ~= "max" then
		amount = math.clamp(math.floor(tonumber(amount) or 1), 1, 100)
	end
	local level = Logic.level(data, id)
	local count, cost = Logic.bulk(u, level, amount, data.aura)
	if count <= 0 then
		GameService.notify(player, "✅ Maximal", u.name .. " ist schon auf der höchsten Stufe.", "")
		return
	end
	if cost > data.aura then
		GameService.notify(player, "💸 Zu wenig Aura", "Dir fehlen noch " .. Util.format(cost - data.aura) .. " Aura.", "bad")
		return
	end
	data.aura = data.aura - cost
	data.levels[id] = level + count
	GameService.track(player, "upgrades", count)
	if data.levels[id] >= Config.MAX_LEVEL then
		GameService.notify(player, u.emoji .. " " .. u.name .. " gemeistert!", "Maximale Stufe erreicht.", "good")
	end
	GameService.afterLevelsChanged(player, data)
end)

Remotes.Rebirth.OnServerEvent:Connect(function(player)
	local data = DataService.get(player)
	if not data then return end
	local cost = Logic.rebirthCost(data.rebirths)
	if data.aura < cost then
		GameService.notify(player, "💸 Noch nicht", "Rebirth kostet " .. Util.format(cost) .. " Aura.", "bad")
		return
	end
	data.aura = 0
	data.levels = {}
	data.rebirths = data.rebirths + 1
	local points = Logic.rebirthPointsFor(data.rebirths)
	data.rebirthPoints = data.rebirthPoints + points
	GameService.notify(player, "♻️ REBIRTH #" .. data.rebirths .. "!",
		"Neuer Multiplikator: x" .. Util.format(Logic.rebirthMult(data.rebirths)) .. " · +" .. points .. " Rebirth-Punkte", "rebirth")
	GameService.afterLevelsChanged(player, data)
end)

Remotes.BuyPerk.OnServerEvent:Connect(function(player, id)
	local data = DataService.get(player)
	local perk = Logic.perkById[id]
	if not data or not perk then return end
	local level = Logic.perkLevel(data, id)
	if level >= perk.max then return end
	local cost = Logic.perkCost(perk, level)
	if data.rebirthPoints < cost then
		GameService.notify(player, "💸 Zu wenig Rebirth-Punkte", "Du brauchst " .. cost .. " Punkte.", "bad")
		return
	end
	data.rebirthPoints = data.rebirthPoints - cost
	data.perks[id] = level + 1
	GameService.notify(player, perk.emoji .. " " .. perk.name, "Gekauft! (Stufe " .. (level + 1) .. ")", "good")
	GameService.refreshCharacter(player)
	GameService.sendFull(player)
end)

Remotes.Teleport.OnServerEvent:Connect(function(player, index)
	index = tonumber(index)
	if index then GameService.tryWorld(player, index) end
end)
Remotes.UnlockWorld.OnServerEvent:Connect(function(player, index)
	index = tonumber(index)
	if index then GameService.tryWorld(player, index) end
end)

Remotes.Setting.OnServerEvent:Connect(function(player, key, value)
	local data = DataService.get(player)
	if not data or (key ~= "music" and key ~= "sfx") then return end
	data.settings[key] = value == true
end)

----------------------------------------------------------------------------
-- Die Schleife: jede Sekunde Aura gutschreiben
----------------------------------------------------------------------------
function GameService.start()
	-- jede Minute Spielzeit zählen
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				GameService.track(player, "playMinutes", 1)
			end
		end
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.time()
			for _, player in ipairs(Players:GetPlayers()) do
				local data = DataService.get(player)
				local char = player.Character
				local hrp = char and char:FindFirstChild("HumanoidRootPart")
				if data then
					-- In welcher Welt steht der Spieler? (Schutz: nur freigeschaltete Welten zählen)
					if hrp then
						local idx = GameService.worldIndexAt(hrp.Position.X)
						if not Logic.worldUnlocked(data, idx) then
							idx = 1
							GameService.teleport(player, 1)
						end
						player:SetAttribute("World", idx)
					end
					local w = GameService.currentWorld(player)
					GameService.addAura(data, Logic.aps(data, w, now))
					if Logic.perkLevel(data, "autoclick") > 0 then
						GameService.addAura(data, Logic.clickValue(data, w, now) * 2)
					end
					GameService.sendLight(player)
				end
			end
		end
	end)
end

Players.PlayerRemoving:Connect(function(player)
	clickWindow[player] = nil
end)

return GameService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000E"><Properties><string name="Name">JobService</string><ProtectedString name="Source"><![CDATA[--[[
	JOBSERVICE – Geld verdienen mit Jobs.
	Ablauf: Spieler startet Job → Minispiel läuft auf dem Gerät →
	Ergebnis (3 Versuche) wird geschickt → Server prüft und zahlt.
	Je höher Glow-Score & Rebirths, desto mehr Lohn.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)
local GameService = require(script.Parent.GameService)

local JobService = {}
local running = {}   -- [player] = { id, start }

local jobById = {}
for _, j in ipairs(Config.Jobs) do
	jobById[j.id] = j
end

Remotes.StartJob.OnServerEvent:Connect(function(player, id)
	local data = DataService.get(player)
	local job = jobById[id]
	if not data or not job then return end
	if Logic.baseGlow(data.levels) < job.req then
		GameService.notify(player, "🔒 Gesperrt", job.name .. " gibt es ab " .. Util.format(job.req) .. " Glow.", "bad")
		return
	end
	local untilTime = data.jobCd[id] or 0
	if untilTime > os.time() then
		GameService.notify(player, "⏳ Pause", "Noch " .. Util.formatTime(untilTime - os.time()) .. " Pause.", "")
		return
	end
	running[player] = { id = id, start = os.clock() }
end)

Remotes.FinishJob.OnServerEvent:Connect(function(player, id, scores)
	local data = DataService.get(player)
	local run = running[player]
	running[player] = nil
	local job = jobById[id]
	if not data or not job or not run or run.id ~= id then return end
	local elapsed = os.clock() - run.start
	if elapsed < 1.5 or elapsed > 120 or type(scores) ~= "table" then return end

	-- 3 Versuche: 1 = perfekt, 0.6 = gut, 0.1 = daneben
	local total, perfect = 0, 0
	for i = 1, 3 do
		local s = tonumber(scores[i]) or 0.1
		if s >= 1 then s = 1; perfect = perfect + 1 elseif s >= 0.6 then s = 0.6 else s = 0.1 end
		total = total + s
	end
	local perf = total / 3
	if perfect == 3 then perf = perf * 1.25 end
	local earned = math.max(1, math.floor(Logic.jobPay(data, job) * perf * Logic.cashMult(data)))
	data.cash = data.cash + earned
	data.jobCd[id] = os.time() + job.cd
	GameService.track(player, "jobs", 1)
	local quip = perf >= 1.1 and "Der Kunde ist begeistert und will dich wieder buchen! 🤩"
		or (perf >= 0.6 and "Solide Arbeit. Der Chef nickt anerkennend." or "Naja … bezahlt wurdest du trotzdem. Irgendwie.")
	GameService.notify(player, job.emoji .. " Zahltag: +" .. Util.format(earned) .. " Geld", quip, "good")
	GameService.sendFull(player)
end)

Players.PlayerRemoving:Connect(function(player)
	running[player] = nil
end)

return JobService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">LeaderboardService</string><ProtectedString name="Source"><![CDATA[--[[
	LEADERBOARDSERVICE – globale Rangliste (Top 500) über ALLE Server.
	Gespeichert wird die "Glow-Power" jedes Spielers in einem OrderedDataStore.
	Alle 2 Minuten: eigene Werte hochladen, Top 500 neu laden.
]]

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserService = game:GetService("UserService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Util = require(Shared:WaitForChild("Util"))
local Remotes = require(script.Parent.Remotes)
local DataService = require(script.Parent.DataService)

local LeaderboardService = {}
local store = nil
pcall(function()
	store = DataStoreService:GetOrderedDataStore(Config.LEADERBOARD_KEY)
end)

local cache = {}          -- { { rank, userId, name, value } }
local lastRefresh = 0
local nameCache = {}
local boardRows = {}

local function uploadAll()
	if not store then return end
	for _, player in ipairs(Players:GetPlayers()) do
		local data = DataService.get(player)
		if data and DataService.isSaving(player) then
			local value = Logic.glowPower(data)
			if value > 0 then
				pcall(function()
					store:SetAsync(tostring(player.UserId), value)
				end)
			end
		end
	end
end

local function resolveNames(ids)
	local missing = {}
	for _, id in ipairs(ids) do
		if not nameCache[id] then table.insert(missing, id) end
	end
	-- in Paketen von 100 nachschlagen
	for i = 1, #missing, 100 do
		local chunk = {}
		for j = i, math.min(i + 99, #missing) do table.insert(chunk, missing[j]) end
		local ok, infos = pcall(function()
			return UserService:GetUserInfosByUserIdsAsync(chunk)
		end)
		if ok and infos then
			for _, info in ipairs(infos) do
				nameCache[info.Id] = info.DisplayName or info.Username
			end
		end
	end
end

local function refresh()
	if not store then return end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, 100)
	end)
	if not ok or not pages then return end
	local list = {}
	while true do
		for _, entry in ipairs(pages:GetCurrentPage()) do
			table.insert(list, { userId = tonumber(entry.key), value = entry.value })
			if #list >= Config.LEADERBOARD_SIZE then break end
		end
		if #list >= Config.LEADERBOARD_SIZE or pages.IsFinished then break end
		local okNext = pcall(function() pages:AdvanceToNextPageAsync() end)
		if not okNext then break end
	end
	local ids = {}
	for _, e in ipairs(list) do table.insert(ids, e.userId) end
	resolveNames(ids)
	for i, e in ipairs(list) do
		e.rank = i
		e.name = nameCache[e.userId] or ("Spieler " .. tostring(e.userId))
	end
	cache = list
	lastRefresh = os.time()

	-- Tafel in Glow City aktualisieren
	for r = 1, 10 do
		local row = boardRows[r]
		if row then
			local e = cache[r]
			local medal = ({ "🥇", "🥈", "🥉" })[r] or (r .. ".")
			row.Text = e and ("  " .. medal .. "  " .. e.name .. "  <font color='#ffd166'>" .. Util.format(e.value) .. "</font>") or ("  " .. r .. ". –")
		end
	end
end

Remotes.GetLeaderboard.OnServerInvoke = function(player)
	return { list = cache, updated = lastRefresh, available = store ~= nil }
end

function LeaderboardService.init(rows)
	boardRows = rows or {}
	task.spawn(function()
		task.wait(10)
		while true do
			uploadAll()
			refresh()
			task.wait(120)
		end
	end)
end

return LeaderboardService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">LookService</string><ProtectedString name="Source"><![CDATA[--[[
	LOOKSERVICE – dein Avatar verändert sich sichtbar mit den Upgrades.
	Am Anfang: richtig hässlich. Mit jeder Stufe wird es langsam besser.

	Kategorie (Summe der Stufen, max. 250)   → was man sieht
	Skincare     → Pickel verschwinden (bis 40), kränklich-grüne Haut wird normal (bis 40), ab 120 glänzende Haut
	Haare        → struppige Haare verschwinden (bis 42), ab 60 Glanz, ab 150 goldene Strähne, ab 230 Krone
	Fitness      → von schmächtig (0,85) zu breiten Schultern (1,45)
	Haltung      → von krummem Buckel zu aufrechter Haltung (bis 55)
	Schlaf       → Augenringe verschwinden (bis 30)
	Style        → Ketchup-Fleck weg (ab 3), Uhr (20), Parfum-Wolke (40), Goldkette (60), Sonnenbrille (120), Umhang (200)
	Zähne        → grüne Mundgeruch-Wolke weg (ab 10), ab 80 blitzendes Lächeln
	Selbstbewusstsein → nervöse Schweißtropfen weg (ab 15), ab 100 Sterne um den Kopf
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Logic = require(Shared:WaitForChild("Logic"))

local LookService = {}

local SICK = Color3.fromRGB(150, 175, 110)     -- kränkliche Hautfarbe am Anfang
local GOLD = Color3.fromRGB(255, 205, 60)
local BLACK = Color3.fromRGB(20, 20, 25)

-- Teil erstellen und fest an ein Körperteil schweißen
local function attach(folder, base, size, offset, color, opts)
	opts = opts or {}
	local p = Instance.new("Part")
	p.Name = opts.name or "Look"
	p.Size = size
	p.Color = color
	p.Material = opts.material or Enum.Material.SmoothPlastic
	p.Transparency = opts.transparency or 0
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.CastShadow = false
	p.Anchored = false
	if opts.ball then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
	end
	p.CFrame = base.CFrame * offset
	local w = Instance.new("WeldConstraint")
	w.Part0 = base
	w.Part1 = p
	w.Parent = p
	p.Parent = folder
	return p
end

local function emitter(parentPart, color, rate, opts)
	opts = opts or {}
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Rate = rate
	e.Lifetime = opts.lifetime or NumberRange.new(0.8, 1.4)
	e.Speed = opts.speed or NumberRange.new(0.5, 1.5)
	e.SpreadAngle = opts.spread or Vector2.new(180, 180)
	e.Size = opts.size or NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	e.LightEmission = opts.light or 0.5
	e.Acceleration = opts.acceleration or Vector3.new(0, 0, 0)
	e.EmissionDirection = opts.direction or Enum.NormalId.Top
	if opts.transparency then e.Transparency = opts.transparency end
	e.Parent = parentPart
	return e
end

-- Körperhaltung über die Gelenke (nur R15)
local function setMotor(motor, angleDeg)
	if not motor or not motor:IsA("Motor6D") then return end
	local orig = motor:GetAttribute("OrigC0")
	if not orig then
		orig = motor.C0
		motor:SetAttribute("OrigC0", orig)
	end
	motor.C0 = orig * CFrame.Angles(math.rad(-angleDeg), 0, 0)
end

function LookService.apply(player, char, data)
	local head = char:FindFirstChild("Head")
	local hum = char:FindFirstChildOfClass("Humanoid")
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not head or not hum or not torso then return end

	local function cat(id) return Logic.catLevels(data.levels, id) end
	local skin, hair, fit, sleep = cat("skin"), cat("hair"), cat("fit"), cat("sleep")
	local posture, style, teeth, conf = cat("posture"), cat("style"), cat("teeth"), cat("conf")

	local old = char:FindFirstChild("GlowUpLook")
	if old then old:Destroy() end
	local folder = Instance.new("Folder")
	folder.Name = "GlowUpLook"
	folder.Parent = char

	local hs = head.Size
	local front = -hs.Z / 2 - 0.03

	-- 1) SKINCARE: Hautfarbe & Pickel & Glanz
	if player:HasAppearanceLoaded() then
		local tint = 0.7 * (1 - math.min(1, skin / 40))
		for _, p in ipairs(char:GetChildren()) do
			if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
				local orig = p:GetAttribute("OrigColor")
				if not orig then
					orig = p.Color
					p:SetAttribute("OrigColor", orig)
				end
				p.Color = orig:Lerp(SICK, tint)
			end
		end
	end
	local pimpleSpots = { { -0.55, 0.3 }, { 0.6, 0.42 }, { -0.4, -0.35 }, { 0.5, -0.3 }, { 0.1, 0.62 }, { -0.7, -0.05 }, { 0.72, 0.05 }, { 0.2, -0.55 } }
	local pimples = math.max(0, #pimpleSpots - math.floor(skin / 5))
	for i = 1, pimples do
		local sp = pimpleSpots[i]
		attach(folder, head, Vector3.new(0.16, 0.16, 0.1), CFrame.new(sp[1] * hs.X / 2, sp[2] * hs.Y / 2, front), Color3.fromRGB(205, 60, 60), { ball = true, name = "Pickel" })
	end
	if skin >= 120 then
		local glowPart = attach(folder, head, Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, 0, 0), Color3.new(1, 1, 1), { transparency = 1 })
		emitter(glowPart, Color3.fromRGB(255, 255, 255), math.min(8, (skin - 100) / 20), { size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0) }), light = 1 })
	end

	-- 2) HAARE: struppig → gepflegt → Glanz → goldene Strähne → Krone
	local spikes = math.max(0, 7 - math.floor(hair / 6))
	for i = 1, spikes do
		local a = (i - (spikes + 1) / 2) * 22
		attach(folder, head, Vector3.new(0.14, 0.75, 0.14), CFrame.new(0, hs.Y / 2, 0) * CFrame.Angles(math.rad((i % 2 == 0) and 15 or -12), 0, math.rad(a)) * CFrame.new(0, 0.35, 0),
			Color3.fromRGB(70, 50, 35), { name = "Strähne" })
	end
	if hair >= 60 then
		local shine = attach(folder, head, Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, hs.Y / 2 + 0.2, 0), Color3.new(1, 1, 1), { transparency = 1 })
		emitter(shine, Color3.fromRGB(255, 255, 255), 2, { size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0) }), light = 1 })
	end
	if hair >= 150 then
		attach(folder, head, Vector3.new(0.25, 0.25, hs.Z * 0.9), CFrame.new(hs.X * 0.18, hs.Y / 2 + 0.08, 0) * CFrame.Angles(0, 0, math.rad(-15)), GOLD, { material = Enum.Material.Neon, ball = true, name = "Goldsträhne" })
	end
	if hair >= 230 then
		for i = 0, 7 do
			local a = i / 8 * math.pi * 2
			attach(folder, head, Vector3.new(0.18, 0.4, 0.18), CFrame.new(math.cos(a) * hs.X * 0.4, hs.Y / 2 + 0.55, math.sin(a) * hs.Z * 0.4), GOLD, { material = Enum.Material.Neon, name = "Krone" })
		end
	end

	-- 3) FITNESS: schmächtig → breit (nur R15)
	local width = 0.85 + math.min(0.6, fit / 250 * 0.6)
	pcall(function()
		local ws = hum:FindFirstChild("BodyWidthScale")
		local ds = hum:FindFirstChild("BodyDepthScale")
		if ws then ws.Value = width end
		if ds then ds.Value = 0.9 + (width - 0.85) * 0.6 end
	end)

	-- 4) HALTUNG: Buckel → aufrecht (nur R15)
	local slouch = math.max(0, 22 - posture * 0.4)
	pcall(function()
		local upper = char:FindFirstChild("UpperTorso")
		setMotor(upper and upper:FindFirstChild("Waist"), slouch)
		setMotor(head:FindFirstChild("Neck"), slouch * 0.8)
	end)

	-- 5) SCHLAF: Augenringe
	if sleep < 30 then
		local tr = 0.15 + (sleep / 30) * 0.85
		for _, s in ipairs({ -1, 1 }) do
			attach(folder, head, Vector3.new(hs.X * 0.22, hs.Y * 0.08, 0.08), CFrame.new(s * hs.X * 0.2, -hs.Y * 0.02, front), Color3.fromRGB(80, 50, 85),
				{ ball = true, transparency = tr, name = "Augenring" })
		end
	end

	-- 6) STYLE
	if style < 3 then
		attach(folder, torso, Vector3.new(0.55, 0.45, 0.06), CFrame.new(torso.Size.X * 0.2, torso.Size.Y * 0.15, -torso.Size.Z / 2 - 0.03), Color3.fromRGB(170, 40, 25),
			{ ball = true, name = "Ketchupfleck" })
	end
	local leftArm = char:FindFirstChild("LeftLowerArm") or char:FindFirstChild("Left Arm")
	if style >= 20 and leftArm then
		attach(folder, leftArm, Vector3.new(leftArm.Size.X + 0.08, 0.25, leftArm.Size.Z + 0.08), CFrame.new(0, -leftArm.Size.Y * 0.3, 0), GOLD,
			{ material = Enum.Material.Foil, name = "Uhr" })
	end
	if style >= 40 then
		local scent = attach(folder, torso, Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, torso.Size.Y * 0.4, 0), Color3.new(1, 1, 1), { transparency = 1 })
		emitter(scent, Color3.fromRGB(255, 150, 220), 3, { speed = NumberRange.new(1, 2), light = 0.3 })
	end
	if style >= 60 then
		for i = 0, 9 do
			local a = math.rad(200 + i * 14)
			attach(folder, torso, Vector3.new(0.13, 0.13, 0.13), CFrame.new(math.cos(a) * torso.Size.X * 0.28, torso.Size.Y * 0.42 + math.sin(a) * 0.35, -torso.Size.Z / 2 - 0.05),
				GOLD, { material = Enum.Material.Neon, ball = true, name = "Kette" })
		end
	end
	if style >= 120 then
		attach(folder, head, Vector3.new(hs.X * 0.85, 0.2, 0.08), CFrame.new(0, hs.Y * 0.42, -hs.Z * 0.35) * CFrame.Angles(math.rad(-30), 0, 0), BLACK, { name = "Sonnenbrille" })
	end
	if style >= 200 then
		attach(folder, torso, Vector3.new(torso.Size.X * 1.1, torso.Size.Y * 1.7, 0.12), CFrame.new(0, -torso.Size.Y * 0.35, torso.Size.Z / 2 + 0.1) * CFrame.Angles(math.rad(8), 0, 0),
			Color3.fromRGB(120, 30, 160), { material = Enum.Material.Fabric, name = "Umhang" })
	end

	-- 7) ZÄHNE: Mundgeruch → blitzendes Lächeln
	local mouth = attach(folder, head, Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, -hs.Y * 0.25, front - 0.1), Color3.new(1, 1, 1), { transparency = 1 })
	if teeth < 10 then
		emitter(mouth, Color3.fromRGB(140, 200, 60), 4, { direction = Enum.NormalId.Front, speed = NumberRange.new(1, 2),
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.25), NumberSequenceKeypoint.new(1, 0.7) }), light = 0,
			transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) }) })
	elseif teeth >= 80 then
		emitter(mouth, Color3.fromRGB(255, 255, 255), 1.5, { speed = NumberRange.new(0, 0.2), light = 1,
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(1, 0) }),
			lifetime = NumberRange.new(0.4, 0.6) })
	end

	-- 8) SELBSTBEWUSSTSEIN: Schweißtropfen → Sterne
	if conf < 15 then
		local sweat = attach(folder, head, Vector3.new(0.2, 0.2, 0.2), CFrame.new(hs.X * 0.45, hs.Y * 0.3, 0), Color3.new(1, 1, 1), { transparency = 1 })
		emitter(sweat, Color3.fromRGB(120, 200, 255), 3, { direction = Enum.NormalId.Bottom, acceleration = Vector3.new(0, -8, 0), speed = NumberRange.new(0.5, 1),
			size = NumberSequence.new(0.15), light = 0.2 })
	elseif conf >= 100 then
		local stars = attach(folder, head, Vector3.new(0.2, 0.2, 0.2), CFrame.new(0, hs.Y * 0.8, 0), Color3.new(1, 1, 1), { transparency = 1 })
		emitter(stars, Color3.fromRGB(255, 220, 80), math.min(6, conf / 40), { speed = NumberRange.new(1, 2), light = 1,
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) }) })
	end
	------------------------------------------------------------------
	-- NOCH MEHR VERÄNDERUNG
	------------------------------------------------------------------
	-- Größe: geduckt & klein → groß & aufrecht
	pcall(function()
		local hsv = hum:FindFirstChild("BodyHeightScale")
		if hsv then hsv.Value = 0.9 + math.min(0.15, posture / 250 * 0.15) + math.min(0.05, fit / 250 * 0.05) end
	end)

	-- Bierbauch (verschwindet mit Fitness bis Stufe 40)
	if fit < 40 then
		local depth = 0.25 + 0.9 * (1 - fit / 40)
		attach(folder, torso, Vector3.new(torso.Size.X * 0.85, torso.Size.Y * 0.6, depth), CFrame.new(0, -torso.Size.Y * 0.22, -torso.Size.Z / 2 - depth * 0.25),
			torso.Color, { ball = true, name = "Bauch" })
	end

	-- Muskeln: Bizeps (ab 60), Brust (ab 120), Sixpack (ab 180)
	if fit >= 60 then
		local m = math.clamp((fit - 60) / 140, 0, 1)
		for _, armName in ipairs({ "LeftUpperArm", "RightUpperArm", "Left Arm", "Right Arm" }) do
			local arm = char:FindFirstChild(armName)
			if arm then
				local big = 0.3 + 0.4 * m
				attach(folder, arm, Vector3.new(arm.Size.X * 0.95, arm.Size.Y * 0.5, big), CFrame.new(0, arm.Size.Y * 0.08, -arm.Size.Z / 2 - big * 0.15),
					arm.Color, { ball = true, name = "Bizeps" })
			end
		end
	end
	if fit >= 120 then
		local m2 = math.clamp((fit - 120) / 130, 0, 1)
		for _, sx in ipairs({ -1, 1 }) do
			attach(folder, torso, Vector3.new(torso.Size.X * 0.45, torso.Size.Y * 0.3, 0.3 + 0.25 * m2), CFrame.new(sx * torso.Size.X * 0.22, torso.Size.Y * 0.2, -torso.Size.Z / 2),
				torso.Color, { ball = true, name = "Brust" })
		end
	end
	if fit >= 180 then
		local absColor = torso.Color:Lerp(Color3.new(0, 0, 0), 0.12)
		for row = 0, 2 do
			for _, sx in ipairs({ -1, 1 }) do
				attach(folder, torso, Vector3.new(torso.Size.X * 0.2, torso.Size.Y * 0.13, 0.18),
					CFrame.new(sx * torso.Size.X * 0.12, -torso.Size.Y * 0.05 - row * torso.Size.Y * 0.15, -torso.Size.Z / 2 - 0.02), absColor, { ball = true, name = "Sixpack" })
			end
		end
	end

	-- Opa-Brille (bis Style 15)
	if style < 15 then
		for _, sx in ipairs({ -1, 1 }) do
			attach(folder, head, Vector3.new(0.06, hs.X * 0.34, hs.X * 0.34), CFrame.new(sx * hs.X * 0.2, hs.Y * 0.06, front - 0.03) * CFrame.Angles(0, math.rad(90), 0),
				BLACK, { name = "Brille" })
			attach(folder, head, Vector3.new(0.03, hs.X * 0.27, hs.X * 0.27), CFrame.new(sx * hs.X * 0.2, hs.Y * 0.06, front - 0.07) * CFrame.Angles(0, math.rad(90), 0),
				Color3.fromRGB(200, 230, 255), { transparency = 0.5, name = "Brillenglas" })
		end
		attach(folder, head, Vector3.new(hs.X * 0.12, 0.05, 0.05), CFrame.new(0, hs.Y * 0.08, front - 0.03), BLACK, { name = "Brille" })
	end

	-- Kantiges Kinn (ab Haltung 100)
	if posture >= 100 then
		local k = math.clamp((posture - 100) / 150, 0, 1)
		attach(folder, head, Vector3.new(hs.X * (0.55 + 0.15 * k), hs.Y * 0.18, hs.Z * 0.4), CFrame.new(0, -hs.Y / 2 + 0.06, -hs.Z * 0.22), head.Color, { name = "Kinn" })
	end

	-- Leuchtende Augen (ab Selbstbewusstsein 200)
	if conf >= 200 then
		for _, sx in ipairs({ -1, 1 }) do
			attach(folder, head, Vector3.new(0.14, 0.1, 0.06), CFrame.new(sx * hs.X * 0.18, hs.Y * 0.08, front - 0.02), Color3.fromRGB(80, 240, 255),
				{ material = Enum.Material.Neon, ball = true, name = "Augenleuchten" })
		end
	end

	-- Titel-Effekte: Scheinwerfer (Main Character), goldener Ring (Gigachad), kosmische Teilchen (Kosmisches Glow-Wesen)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local titleIdx = Logic.titleIndex(Logic.baseGlow(data.levels))
	if hrp and titleIdx >= 6 then
		local lamp = attach(folder, hrp, Vector3.new(0.3, 0.3, 0.3), CFrame.new(0, 9, 0), Color3.new(1, 1, 1), { transparency = 1, name = "Scheinwerfer" })
		local spot = Instance.new("SpotLight")
		spot.Face = Enum.NormalId.Bottom
		spot.Angle = 50
		spot.Range = 16
		spot.Brightness = 2.5
		spot.Color = Color3.fromRGB(255, 245, 220)
		spot.Parent = lamp
	end
	if hrp and titleIdx >= 10 then
		local footY = -(hrp.Size.Y / 2 + hum.HipHeight) + 0.15
		local ring = attach(folder, hrp, Vector3.new(0.1, 6, 6), CFrame.new(0, footY, 0) * CFrame.Angles(0, 0, math.rad(90)), GOLD,
			{ material = Enum.Material.Neon, transparency = 0.55, name = "Gigachad-Ring" })
		ring.Shape = Enum.PartType.Cylinder
	end
	if hrp and titleIdx >= 12 then
		local cosmic = attach(folder, hrp, Vector3.new(3, 5, 2), CFrame.new(0, 0, 0), Color3.new(1, 1, 1), { transparency = 1, name = "Kosmos" })
		emitter(cosmic, Color3.fromRGB(180, 110, 255), 12, { speed = NumberRange.new(0.5, 2), light = 1,
			size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) }) })
	end
end

return LookService
]]></ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX00000011"><Properties><string name="Name">MapBuilder</string><ProtectedString name="Source"><![CDATA[--[[
	MAPBUILDER – baut beim Serverstart alle 8 Welten automatisch auf:
	Boden, Deko je nach Thema, Geschenkbox-Stand, Rivale, Boss, Portale,
	Ranglisten-Tafel und Info-Tafel.

	Tipp: Du kannst die Karte später in Studio von Hand verschönern.
	Starte dazu das Spiel (Play), kopiere Workspace > Map, stoppe,
	füge sie ein und lösche dann den Aufruf von MapBuilder in "Main".
]]

local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Util = require(Shared:WaitForChild("Util"))
local Logic = require(Shared:WaitForChild("Logic"))

local MapBuilder = {}
MapBuilder.eggPrompts = {}    -- { prompt, egg, count }
MapBuilder.npcs = {}          -- { prompt, def, world, isBoss }
MapBuilder.portals = {}       -- { prompt, target }
MapBuilder.boardRows = {}     -- Textzeilen der Ranglisten-Tafel
MapBuilder.minigames = { gyms = {}, courses = {} }   -- Parkour, Rennen, Gym-Stationen

local S = Config.WORLD_SIZE
local HALF = S / 2
local WHITE = Color3.new(1, 1, 1)
local currentFolder = nil

----------------------------------------------------------------------------
-- Bau-Helfer
----------------------------------------------------------------------------
local function part(props)
	local p = Instance.new(props.Class or "Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	if props.Shape then p.Shape = props.Shape end
	if props.Size then p.Size = props.Size end
	for k, v in pairs(props) do
		if k ~= "Class" and k ~= "Parent" and k ~= "Shape" and k ~= "Size" then
			p[k] = v
		end
	end
	p.Parent = props.Parent or currentFolder
	return p
end

local function textLabel(parent, text, color, font)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(1, 0, 1, 0)
	l.BackgroundTransparency = 1
	l.TextScaled = true
	l.RichText = true
	l.Font = font or Enum.Font.FredokaOne
	l.TextColor3 = color or WHITE
	l.TextStrokeTransparency = 0.3
	l.Text = text
	l.Parent = parent
	return l
end

local function billboard(parent, text, w, h, offsetY, color)
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.new(w, 0, h, 0)
	bb.StudsOffset = Vector3.new(0, offsetY, 0)
	bb.MaxDistance = 220
	bb.LightInfluence = 0
	bb.Parent = parent
	local l = textLabel(bb, text, color)
	return bb, l
end

local function surfaceSign(p, face, text, bg, fg)
	local sg = Instance.new("SurfaceGui")
	sg.Face = face
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	sg.PixelsPerStud = 30
	sg.LightInfluence = 0
	sg.Parent = p
	local frame = Instance.new("Frame")
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundColor3 = bg or Color3.fromRGB(20, 5, 35)
	frame.BackgroundTransparency = bg and 0 or 1
	frame.Parent = sg
	local l = textLabel(frame, text, fg)
	return sg, l
end

local function prompt(parent, action, object, hold, key)
	local pr = Instance.new("ProximityPrompt")
	pr.ActionText = action
	pr.ObjectText = object or ""
	pr.HoldDuration = hold or 0
	pr.MaxActivationDistance = 14
	pr.RequiresLineOfSight = false
	if key then pr.KeyboardKeyCode = key end
	pr.Parent = parent
	return pr
end

-- Plätze, an denen keine Deko stehen soll (relativ zur Weltmitte)
local RESERVED = {
	{ 0, 0, 55 }, { 95, -55, 70 }, { -85, -40, 50 }, { 0, -160, 40 },
	{ 200, 0, 30 }, { -200, 0, 30 }, { 0, 100, 30 }, { -45, 60, 18 },
	{ -150, 120, 48 }, { -150, -110, 48 }, { 40, 62, 14 },
	{ -170, 60, 22 }, { -170, 110, 22 }, { -170, 160, 22 }, { -170, 205, 22 },
}
local currentReserved = {}
local currentMaxZ = nil      -- am Strand: ab hier beginnt das Meer   -- zusätzliche Sperrflächen der Welt, die gerade gebaut wird
local function isFree(x, z, radius)
	for _, r in ipairs(currentReserved) do
		local dx, dz = x - r[1], z - r[2]
		if math.sqrt(dx * dx + dz * dz) < r[3] + radius then
			return false
		end
	end
	for _, r in ipairs(RESERVED) do
		local dx, dz = x - r[1], z - r[2]
		if math.sqrt(dx * dx + dz * dz) < r[3] + radius then
			return false
		end
	end
	return true
end
local function freeSpot(rng, radius, minDist, maxDist)
	for _ = 1, 60 do
		-- Abstand zum Rand, damit nichts in Bergen/Dünen am Weltrand steckt
		local x = rng:NextNumber(-HALF + radius + 22, HALF - radius - 22)
		local z = rng:NextNumber(-HALF + radius + 22, HALF - radius - 22)
		local d = math.sqrt(x * x + z * z)
		if d >= (minDist or 0) and d <= (maxDist or 9999) and (not currentMaxZ or z + radius < currentMaxZ) and isFree(x, z, radius) then
			return x, z
		end
	end
	return nil
end

----------------------------------------------------------------------------
-- Deko-Bausteine
----------------------------------------------------------------------------
local function tree(O, x, z, color, scale)
	scale = scale or 1
	local leaf = color or Color3.fromRGB(63, 143, 69)
	part({ Size = Vector3.new(1.6, 11, 1.6) * scale, CFrame = CFrame.new(O + Vector3.new(x, 5.5 * scale, z)), Color = Color3.fromRGB(105, 70, 45), Material = Enum.Material.Wood })
	part({ Size = Vector3.new(0.7, 4, 0.7) * scale, CFrame = CFrame.new(O + Vector3.new(x + 1.2 * scale, 8 * scale, z)) * CFrame.Angles(0, 0, math.rad(-40)), Color = Color3.fromRGB(105, 70, 45), Material = Enum.Material.Wood })
	local blobs = { { 0, 13, 0, 9 }, { 2.6, 11.5, 1.2, 6.5 }, { -2.4, 11.8, -1, 6.8 }, { 0.6, 15.5, -0.8, 6 }, { -1, 12, 2.4, 6 } }
	for i, b in ipairs(blobs) do
		local shade = (i % 2 == 0) and 0.12 or -0.05
		part({ Shape = Enum.PartType.Ball, Size = Vector3.new(b[4], b[4], b[4]) * scale, CFrame = CFrame.new(O + Vector3.new(x + b[1] * scale, b[2] * scale, z + b[3] * scale)),
			Color = leaf:Lerp(shade > 0 and Color3.new(1, 1, 0.6) or Color3.new(0, 0.2, 0), math.abs(shade)), Material = Enum.Material.Grass })
	end
end

local function palm(O, x, z, rng)
	local tilt = math.rad(rng:NextNumber(-12, 12))
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(16, 1.6, 1.6),
		CFrame = CFrame.new(O + Vector3.new(x, 8, z)) * CFrame.Angles(0, 0, math.rad(90) + tilt), Color = Color3.fromRGB(150, 105, 60), Material = Enum.Material.Wood })
	for k = 0, 4 do
		local a = math.rad(k * 72)
		part({ Size = Vector3.new(1, 0.5, 8), CFrame = CFrame.new(O + Vector3.new(x, 16, z)) * CFrame.Angles(0, a, 0) * CFrame.new(0, 0, -4) * CFrame.Angles(math.rad(-20), 0, 0),
			Color = Color3.fromRGB(60, 170, 70), Material = Enum.Material.Grass })
	end
end

local function lamp(O, x, z)
	part({ Size = Vector3.new(0.8, 14, 0.8), CFrame = CFrame.new(O + Vector3.new(x, 7, z)), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Metal })
	local bulb = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), CFrame = CFrame.new(O + Vector3.new(x, 14.5, z)), Color = Color3.fromRGB(255, 225, 140), Material = Enum.Material.Neon })
	local light = Instance.new("PointLight")
	light.Range = 18
	light.Brightness = 1.2
	light.Color = Color3.fromRGB(255, 220, 160)
	light.Parent = bulb
end

local BUILDING_COLORS = {
	Color3.fromRGB(91, 95, 151), Color3.fromRGB(242, 132, 130), Color3.fromRGB(192, 133, 82), Color3.fromRGB(77, 144, 142),
	Color3.fromRGB(127, 200, 216), Color3.fromRGB(179, 136, 255), Color3.fromRGB(233, 196, 106), Color3.fromRGB(110, 110, 130),
}

local function building(O, x, z, w, d, h, color, material, signText, accent)
	part({ Size = Vector3.new(w, h, d), CFrame = CFrame.new(O + Vector3.new(x, h / 2, z)), Color = color, Material = material or Enum.Material.SmoothPlastic })
	part({ Size = Vector3.new(w + 1, 1.5, d + 1), CFrame = CFrame.new(O + Vector3.new(x, h + 0.75, z)), Color = color:Lerp(Color3.new(0, 0, 0), 0.35) })
	-- Fensterreihen auf allen vier Seiten
	local floors = math.floor(h / 10)
	for f = 1, floors do
		local y = f * 10 - 4
		part({ Size = Vector3.new(w * 0.8, 3, d + 0.4), CFrame = CFrame.new(O + Vector3.new(x, y, z)), Color = accent or Color3.fromRGB(255, 240, 190), Material = Enum.Material.Neon, Transparency = 0.25 })
		part({ Size = Vector3.new(w + 0.4, 3, d * 0.8), CFrame = CFrame.new(O + Vector3.new(x, y, z)), Color = accent or Color3.fromRGB(255, 240, 190), Material = Enum.Material.Neon, Transparency = 0.25 })
	end
	if signText then
		-- Schild auf der Seite, die zur Weltmitte zeigt
		local face, offset
		if math.abs(x) > math.abs(z) then
			if x > 0 then face, offset = Enum.NormalId.Left, Vector3.new(-w / 2 - 0.6, 0, 0)
			else face, offset = Enum.NormalId.Right, Vector3.new(w / 2 + 0.6, 0, 0) end
		else
			if z > 0 then face, offset = Enum.NormalId.Front, Vector3.new(0, 0, -d / 2 - 0.6)
			else face, offset = Enum.NormalId.Back, Vector3.new(0, 0, d / 2 + 0.6) end
		end
		local signPart = part({ Size = Vector3.new(math.abs(offset.Z) > 0 and w * 0.8 or 1, 6, math.abs(offset.X) > 0 and d * 0.8 or 1),
			CFrame = CFrame.new(O + Vector3.new(x, math.min(h - 4, 14), z) + offset), Color = Color3.fromRGB(20, 5, 35) })
		surfaceSign(signPart, face, signText, Color3.fromRGB(20, 5, 35), WHITE)
	end
end

local function rock(O, x, z, size, color)
	part({ Shape = Enum.PartType.Ball, Size = Vector3.new(size, size * 0.7, size), CFrame = CFrame.new(O + Vector3.new(x, size * 0.2, z)),
		Color = color or Color3.fromRGB(120, 120, 125), Material = Enum.Material.Slate })
end

----------------------------------------------------------------------------
-- Themen der Welten
----------------------------------------------------------------------------
local THEMES = {}

THEMES.city = function(O, w, rng)
	for _, horizontal in ipairs({ true, false }) do
		local road = horizontal and Vector3.new(S, 0.2, 24) or Vector3.new(24, 0.2, S)
		part({ Size = road, CFrame = CFrame.new(O + Vector3.new(0, horizontal and 0.1 or 0.12, 0)), Color = Color3.fromRGB(55, 55, 60), Material = Enum.Material.Asphalt })
		for _, side in ipairs({ -1, 1 }) do
			local walk = horizontal and Vector3.new(S, 0.5, 4) or Vector3.new(4, 0.5, S)
			local off = horizontal and Vector3.new(0, 0.25, side * 14) or Vector3.new(side * 14, 0.25, 0)
			part({ Size = walk, CFrame = CFrame.new(O + off), Color = Color3.fromRGB(190, 188, 182), Material = Enum.Material.Concrete })
		end
		for k = -11, 11 do
			if math.abs(k) > 1 then
				local dash = horizontal and Vector3.new(6, 0.22, 0.5) or Vector3.new(0.5, 0.22, 6)
				local pos = horizontal and Vector3.new(k * 20, 0.13, 0) or Vector3.new(0, 0.14, k * 20)
				part({ Size = dash, CFrame = CFrame.new(O + pos), Color = Color3.fromRGB(245, 245, 240) })
			end
		end
	end
	local names = { "💪 IRON GYM", "✂️ SALON GLOW", "☕ CAFÉ MEWING", "🛍️ DRIP MALL", "🦷 DR. STRAHLEWEISS", "🪞 SELFIE-STUDIO", "🏋️ PROTEIN-BAR", "💈 BARBER" }
	for i = 1, 16 do
		local wdt, dep = rng:NextNumber(26, 40), rng:NextNumber(26, 40)
		local x, z = freeSpot(rng, math.max(wdt, dep) / 2 + 4, 90)
		if x and math.abs(x) > 20 and math.abs(z) > 20 then
			building(O, x, z, wdt, dep, rng:NextNumber(28, 90), BUILDING_COLORS[rng:NextInteger(1, #BUILDING_COLORS)], nil, names[i])
		end
	end
	for i = 1, 18 do
		local x, z = freeSpot(rng, 2, 40)
		if x then lamp(O, x, z) end
	end
	for _ = 1, 16 do
		local x, z = freeSpot(rng, 6, 60)
		if x then tree(O, x, z) end
	end
end

THEMES.beach = function(O, w, rng)
	-- Meer (man kann ein Stück hineinlaufen)
	pcall(function()
		workspace.Terrain:FillBlock(CFrame.new(O + Vector3.new(0, -14, 190)), Vector3.new(S, 4, 120), Enum.Material.Sand)
		workspace.Terrain:FillBlock(CFrame.new(O + Vector3.new(0, -6, 190)), Vector3.new(S, 12, 120), Enum.Material.Water)
	end)
	for _ = 1, 26 do
		local x, z = freeSpot(rng, 5, 60)
		if x and z < 120 then palm(O, x, z, rng) end
	end
	local umbrellaColors = { Color3.fromRGB(255, 80, 120), Color3.fromRGB(255, 200, 0), Color3.fromRGB(0, 200, 220), Color3.fromRGB(120, 220, 90) }
	for _ = 1, 12 do
		local x, z = freeSpot(rng, 6, 60)
		if x and z < 120 then
			part({ Size = Vector3.new(0.5, 9, 0.5), CFrame = CFrame.new(O + Vector3.new(x, 4.5, z)), Color = WHITE })
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 12, 12), CFrame = CFrame.new(O + Vector3.new(x, 9, z)) * CFrame.Angles(0, 0, math.rad(90)),
				Color = umbrellaColors[rng:NextInteger(1, #umbrellaColors)] })
			part({ Size = Vector3.new(4, 0.2, 7), CFrame = CFrame.new(O + Vector3.new(x + 3, 0.15, z + 2)), Color = umbrellaColors[rng:NextInteger(1, #umbrellaColors)] })
		end
	end
	-- Muscle Beach: Hantel-Deko
	for k = -2, 2 do
		local x, z = 130 + k * 12, -110
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(8, 0.6, 0.6), CFrame = CFrame.new(O + Vector3.new(x, 1.2, z)), Color = Color3.fromRGB(80, 80, 80), Material = Enum.Material.Metal })
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 2.6, 2.6), CFrame = CFrame.new(O + Vector3.new(x - 3.5, 1.3, z)), Color = Color3.fromRGB(30, 30, 30) })
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 2.6, 2.6), CFrame = CFrame.new(O + Vector3.new(x + 3.5, 1.3, z)), Color = Color3.fromRGB(30, 30, 30) })
	end
	local signPart = part({ Size = Vector3.new(30, 6, 1), CFrame = CFrame.new(O + Vector3.new(130, 9, -125)), Color = Color3.fromRGB(20, 5, 35) })
	part({ Size = Vector3.new(1, 9, 1), CFrame = CFrame.new(O + Vector3.new(118, 4.5, -125)), Color = Color3.fromRGB(150, 105, 60) })
	part({ Size = Vector3.new(1, 9, 1), CFrame = CFrame.new(O + Vector3.new(142, 4.5, -125)), Color = Color3.fromRGB(150, 105, 60) })
	surfaceSign(signPart, Enum.NormalId.Back, "🏋️ MUSCLE BEACH", Color3.fromRGB(20, 5, 35), WHITE)
end

THEMES.mountain = function(O, w, rng)
	-- Berge am Rand mit Schneekappen
	for k = 1, 14 do
		local a = (k / 14) * math.pi * 2
		local size = rng:NextNumber(90, 150)
		local radius = size * 0.55
		-- Mittelpunkt hinter der Weltgrenze: die Berge sind Kulisse und verschlucken keine Deko oder Portale
		local r = HALF + radius * 0.75
		local x, z = math.cos(a) * r, math.sin(a) * r
		do
			local center = O + Vector3.new(x, -radius * 0.2, z)
			pcall(function()
				workspace.Terrain:FillBall(center, radius, Enum.Material.Rock)
				workspace.Terrain:FillBall(center + Vector3.new(0, radius * 0.62, 0), radius * 0.48, Enum.Material.Snow)
			end)
		end
	end
	for _ = 1, 30 do
		local x, z = freeSpot(rng, 5, 60, HALF - 60)
		if x then
			part({ Size = Vector3.new(1.6, 6, 1.6), CFrame = CFrame.new(O + Vector3.new(x, 3, z)), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood })
			for t = 0, 2 do
				local s = 9 - t * 2.5
				part({ Shape = Enum.PartType.Ball, Size = Vector3.new(s, s, s), CFrame = CFrame.new(O + Vector3.new(x, 6 + t * 4, z)), Color = Color3.fromRGB(35, 100, 55), Material = Enum.Material.Grass })
			end
		end
	end
	for _ = 1, 18 do
		local x, z = freeSpot(rng, 5, 60)
		if x then rock(O, x, z, rng:NextNumber(4, 10)) end
	end
	-- Protein-Wasserfall (Deko)
	part({ Size = Vector3.new(14, 60, 2), CFrame = CFrame.new(O + Vector3.new(-120, 30, -238)), Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.Neon, Transparency = 0.3 })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 30, 30), CFrame = CFrame.new(O + Vector3.new(-120, 0.4, -222)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = Color3.fromRGB(240, 235, 225), Material = Enum.Material.Glass, Transparency = 0.2, CanCollide = false })
end

THEMES.temple = function(O, w, rng)
	-- Moai-Statuen im Kreis
	for k = 1, 10 do
		local a = (k / 10) * math.pi * 2
		local x, z = math.cos(a) * 150, math.sin(a) * 150
		if isFree(x, z, 8) then
			local cf = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, math.atan2(x, z), 0)
			part({ Size = Vector3.new(8, 12, 6), CFrame = cf * CFrame.new(0, 6, 0), Color = Color3.fromRGB(110, 105, 100), Material = Enum.Material.Slate })
			part({ Size = Vector3.new(7, 11, 7), CFrame = cf * CFrame.new(0, 17.5, 0), Color = Color3.fromRGB(120, 115, 108), Material = Enum.Material.Slate })
			part({ Size = Vector3.new(7.2, 2, 7.6), CFrame = cf * CFrame.new(0, 20, 0), Color = Color3.fromRGB(100, 95, 90), Material = Enum.Material.Slate })
			part({ Class = "WedgePart", Size = Vector3.new(2, 4, 2), CFrame = cf * CFrame.new(0, 17, -4.4) * CFrame.Angles(0, math.rad(180), 0), Color = Color3.fromRGB(110, 105, 100), Material = Enum.Material.Slate })
		end
	end
	-- Tempeltreppe hinter dem Boss
	for step = 0, 6 do
		part({ Size = Vector3.new(90 - step * 10, 3, 14), CFrame = CFrame.new(O + Vector3.new(0, 1.5 + step * 3, -205 - step * 4)), Color = Color3.fromRGB(190, 175, 140), Material = Enum.Material.Sandstone })
	end
	-- Fackeln
	for _ = 1, 16 do
		local x, z = freeSpot(rng, 2, 50)
		if x then
			part({ Size = Vector3.new(1, 7, 1), CFrame = CFrame.new(O + Vector3.new(x, 3.5, z)), Color = Color3.fromRGB(90, 60, 40), Material = Enum.Material.Wood })
			local fire = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(O + Vector3.new(x, 7.5, z)), Color = Color3.fromRGB(255, 140, 30), Material = Enum.Material.Neon })
			local f = Instance.new("Fire")
			f.Size = 3
			f.Heat = 5
			f.Parent = fire
		end
	end
	for _ = 1, 14 do
		local x, z = freeSpot(rng, 6, 60)
		if x then tree(O, x, z, Color3.fromRGB(80, 160, 70)) end
	end
end

THEMES.fashion = function(O, w, rng)
	-- Laufsteg
	part({ Size = Vector3.new(14, 2, 90), CFrame = CFrame.new(O + Vector3.new(0, 1, -95)), Color = WHITE, Material = Enum.Material.Marble })
	part({ Size = Vector3.new(0.6, 0.3, 90), CFrame = CFrame.new(O + Vector3.new(-6.8, 2.1, -95)), Color = w.accent, Material = Enum.Material.Neon })
	part({ Size = Vector3.new(0.6, 0.3, 90), CFrame = CFrame.new(O + Vector3.new(6.8, 2.1, -95)), Color = w.accent, Material = Enum.Material.Neon })
	local names = { "👗 COUTURE", "👠 SCHUHE", "🕶️ BRILLEN", "👜 TASCHEN", "💍 SCHMUCK", "🧥 MÄNTEL", "🎩 HÜTE", "💄 BEAUTY" }
	for i = 1, 14 do
		local wdt = rng:NextNumber(26, 36)
		local x, z = freeSpot(rng, wdt / 2 + 4, 90)
		if x then
			building(O, x, z, wdt, wdt, rng:NextNumber(26, 60), Color3.fromRGB(35, 30, 45), Enum.Material.SmoothPlastic, names[i], w.accent)
		end
	end
	for _ = 1, 14 do
		local x, z = freeSpot(rng, 2, 40)
		if x then
			part({ Size = Vector3.new(0.8, 16, 0.8), CFrame = CFrame.new(O + Vector3.new(x, 8, z)), Color = Color3.fromRGB(30, 30, 30) })
			local spot = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.5, 2.5, 2.5), CFrame = CFrame.new(O + Vector3.new(x, 16.5, z)), Color = w.accent, Material = Enum.Material.Neon })
			local l = Instance.new("PointLight")
			l.Color = w.accent
			l.Range = 22
			l.Parent = spot
		end
	end
end

THEMES.hollywood = function(O, w, rng)
	for k = -3, 3 do
		local r = rng:NextNumber(60, 95)
		part({ Shape = Enum.PartType.Ball, Size = Vector3.new(r * 2, r * 2, r * 2), CFrame = CFrame.new(O + Vector3.new(k * 70, -r * 0.4, -300)),
			Color = Color3.fromRGB(120, 140, 70), Material = Enum.Material.Grass, CanCollide = false })
	end
	local signPart = part({ Size = Vector3.new(130, 20, 1), CFrame = CFrame.new(O + Vector3.new(0, 45, -255)), Transparency = 1, CanCollide = false })
	surfaceSign(signPart, Enum.NormalId.Back, "G L O W Y W O O D", nil, WHITE)
	-- Roter Teppich zum Boss
	part({ Size = Vector3.new(10, 0.3, 100), CFrame = CFrame.new(O + Vector3.new(0, 0.15, -90)), Color = Color3.fromRGB(200, 20, 40), Material = Enum.Material.Fabric })
	for z = -45, -135, -15 do
		for _, x in ipairs({ -8, 8 }) do
			part({ Size = Vector3.new(0.6, 3, 0.6), CFrame = CFrame.new(O + Vector3.new(x, 1.5, z)), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Metal })
		end
	end
	-- Walk of Fame Sterne
	for _ = 1, 36 do
		local x, z = freeSpot(rng, 2, 50)
		if x then
			part({ Size = Vector3.new(4, 0.2, 4), CFrame = CFrame.new(O + Vector3.new(x, 0.12, z)) * CFrame.Angles(0, math.rad(45), 0), Color = Color3.fromRGB(255, 120, 160), Material = Enum.Material.Neon, Transparency = 0.3 })
		end
	end
	for i = 1, 10 do
		local wdt = rng:NextNumber(24, 34)
		local x, z = freeSpot(rng, wdt / 2 + 4, 90)
		if x then building(O, x, z, wdt, wdt, rng:NextNumber(24, 50), BUILDING_COLORS[rng:NextInteger(1, #BUILDING_COLORS)], nil, i <= 4 and ({ "🎬 STUDIO 1", "🍿 KINO", "📸 PAPARAZZI", "⭐ STAR-HOTEL" })[i] or nil) end
	end
	for _ = 1, 12 do
		local x, z = freeSpot(rng, 5, 60)
		if x then palm(O, x, z, rng) end
	end
end

THEMES.dubai = function(O, w, rng)
	-- Wolkenkratzer aus Gold und Glas
	for i = 1, 14 do
		local wdt = rng:NextNumber(18, 30)
		local x, z = freeSpot(rng, wdt / 2 + 4, 110)
		if x then
			local h = rng:NextNumber(110, 240)
			local gold = rng:NextNumber() < 0.5
			building(O, x, z, wdt, wdt, h, gold and Color3.fromRGB(212, 175, 55) or Color3.fromRGB(120, 170, 210),
				gold and Enum.Material.Foil or Enum.Material.Glass, nil, Color3.fromRGB(255, 240, 200))
		end
	end
	-- Der höchste Turm hinter dem Boss
	part({ Size = Vector3.new(24, 330, 24), CFrame = CFrame.new(O + Vector3.new(0, 165, -225)), Color = Color3.fromRGB(200, 210, 225), Material = Enum.Material.Glass })
	part({ Size = Vector3.new(4, 60, 4), CFrame = CFrame.new(O + Vector3.new(0, 360, -225)), Color = Color3.fromRGB(212, 175, 55), Material = Enum.Material.Neon })
	for _ = 1, 16 do
		local x, z = freeSpot(rng, 5, 60)
		if x then palm(O, x, z, rng) end
	end
end

THEMES.galaxy = function(O, w, rng)
	-- Leuchtendes Gitter im Boden
	for k = -4, 4 do
		part({ Size = Vector3.new(S, 0.2, 0.6), CFrame = CFrame.new(O + Vector3.new(0, 0.1, k * 55)), Color = w.accent, Material = Enum.Material.Neon, Transparency = 0.4 })
		part({ Size = Vector3.new(0.6, 0.2, S), CFrame = CFrame.new(O + Vector3.new(k * 55, 0.1, 0)), Color = w.accent, Material = Enum.Material.Neon, Transparency = 0.4 })
	end
	-- Schwebende Planeten
	local planetColors = { Color3.fromRGB(255, 120, 200), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 200, 80), Color3.fromRGB(150, 255, 160), Color3.fromRGB(200, 120, 255) }
	for k = 1, 10 do
		local r = rng:NextNumber(10, 38)
		local a = rng:NextNumber(0, math.pi * 2)
		local dist = rng:NextNumber(120, 240)
		local pos = O + Vector3.new(math.cos(a) * dist, rng:NextNumber(70, 170), math.sin(a) * dist)
		part({ Shape = Enum.PartType.Ball, Size = Vector3.new(r, r, r), CFrame = CFrame.new(pos), Color = planetColors[(k % #planetColors) + 1], Material = Enum.Material.Neon, CanCollide = false })
		if k % 3 == 0 then
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, r * 1.9, r * 1.9), CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(20), 0, math.rad(90)),
				Color = WHITE, Material = Enum.Material.Neon, Transparency = 0.5, CanCollide = false })
		end
	end
	-- Sterne
	for _ = 1, 90 do
		local s = rng:NextNumber(0.6, 1.8)
		part({ Size = Vector3.new(s, s, s), CFrame = CFrame.new(O + Vector3.new(rng:NextNumber(-HALF, HALF), rng:NextNumber(80, 260), rng:NextNumber(-HALF, HALF))),
			Color = WHITE, Material = Enum.Material.Neon, CanCollide = false })
	end
	-- Kristalle
	for _ = 1, 18 do
		local x, z = freeSpot(rng, 4, 60)
		if x then
			local h = rng:NextNumber(6, 18)
			part({ Class = "WedgePart", Size = Vector3.new(3, h, 3), CFrame = CFrame.new(O + Vector3.new(x, h / 2, z)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0),
				Color = planetColors[rng:NextInteger(1, #planetColors)], Material = Enum.Material.Neon, Transparency = 0.2 })
		end
	end
end

----------------------------------------------------------------------------
-- ZUSÄTZLICHE DEKORATION (damit die Welten voller und lebendiger wirken)
----------------------------------------------------------------------------
local function ellipsoid(props)
	local p = part(props)
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = p
	return p
end

local SLOGANS = { "DRINK WATER 💧", "MEWING IS LIFE 🗿", "SKINCARE > ALLES 🧴", "8 STUNDEN SCHLAF 😴", "SMILE MORE 😁",
	"GLOW UP SEASON ✨", "LEON IST ÜBERALL 👑", "PROTEIN 💪", "SONNENCREME! ☀️", "ZAHNSEIDE RETTET LEBEN 🧵" }
local FLOWER_COLORS = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(255, 220, 80), Color3.fromRGB(170, 110, 255), Color3.fromRGB(255, 255, 255), Color3.fromRGB(255, 150, 60) }
local CAR_COLORS = { Color3.fromRGB(230, 57, 70), Color3.fromRGB(58, 134, 255), Color3.fromRGB(255, 200, 40), Color3.fromRGB(40, 40, 45), Color3.fromRGB(240, 240, 240), Color3.fromRGB(42, 157, 143) }

local function cloud(O, rng)
	local c = O + Vector3.new(rng:NextNumber(-HALF, HALF), rng:NextNumber(95, 150), rng:NextNumber(-HALF, HALF))
	for k = 1, 5 do
		local r = rng:NextNumber(12, 22)
		part({ Shape = Enum.PartType.Ball, Size = Vector3.new(r, r, r), CFrame = CFrame.new(c + Vector3.new((k - 3) * 9, rng:NextNumber(-3, 3), rng:NextNumber(-5, 5))),
			Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.SmoothPlastic, Transparency = 0.15, CanCollide = false, CastShadow = false })
	end
end

local function bench(O, x, z, rot)
	local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rot, 0)
	part({ Size = Vector3.new(7, 0.5, 2), CFrame = base * CFrame.new(0, 1.6, 0), Color = Color3.fromRGB(150, 95, 55), Material = Enum.Material.WoodPlanks })
	part({ Size = Vector3.new(7, 1.6, 0.4), CFrame = base * CFrame.new(0, 2.6, 0.8), Color = Color3.fromRGB(150, 95, 55), Material = Enum.Material.WoodPlanks })
	for _, s in ipairs({ -3, 3 }) do part({ Size = Vector3.new(0.4, 1.6, 1.8), CFrame = base * CFrame.new(s, 0.8, 0), Color = Color3.fromRGB(50, 50, 55), Material = Enum.Material.Metal }) end
end

local function bush(O, x, z, color, size)
	size = size or 4
	ellipsoid({ Size = Vector3.new(size * 1.3, size, size * 1.2), CFrame = CFrame.new(O + Vector3.new(x, size * 0.35, z)), Color = color or Color3.fromRGB(60, 150, 70), Material = Enum.Material.Grass })
end

local function flowerbed(O, x, z, rng)
	part({ Size = Vector3.new(7, 0.8, 4), CFrame = CFrame.new(O + Vector3.new(x, 0.4, z)), Color = Color3.fromRGB(110, 75, 45), Material = Enum.Material.Ground })
	for k = 1, 8 do
		local col = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
		part({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.9, 0.9, 0.9), CFrame = CFrame.new(O + Vector3.new(x + rng:NextNumber(-3, 3), 1.2, z + rng:NextNumber(-1.6, 1.6))), Color = col })
	end
end

local function trashcan(O, x, z)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 2.2, 2.2), CFrame = CFrame.new(O + Vector3.new(x, 1.5, z)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(60, 120, 80), Material = Enum.Material.Metal })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2.4, 2.4), CFrame = CFrame.new(O + Vector3.new(x, 3.1, z)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(40, 90, 60), Material = Enum.Material.Metal })
end

local function bigSign(O, x, z, text, rot, color)
	local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rot, 0)
	for _, s in ipairs({ -8, 8 }) do part({ Size = Vector3.new(1, 14, 1), CFrame = base * CFrame.new(s, 7, 0), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.Metal }) end
	local panel = part({ Size = Vector3.new(22, 8, 0.8), CFrame = base * CFrame.new(0, 15, 0), Color = color or Color3.fromRGB(255, 79, 216) })
	surfaceSign(panel, Enum.NormalId.Front, text, color or Color3.fromRGB(255, 79, 216), WHITE)
	surfaceSign(panel, Enum.NormalId.Back, text, color or Color3.fromRGB(255, 79, 216), WHITE)
end

local function car(O, x, z, rot, color, luxury)
	local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rot, 0)
	local mat = luxury and Enum.Material.Foil or Enum.Material.SmoothPlastic
	part({ Size = Vector3.new(5, 1.8, 10), CFrame = base * CFrame.new(0, 1.7, 0), Color = color, Material = mat, Reflectance = luxury and 0.3 or 0.1 })
	part({ Size = Vector3.new(4.4, 1.6, 5), CFrame = base * CFrame.new(0, 3.3, 0.6), Color = Color3.fromRGB(150, 200, 230), Material = Enum.Material.Glass, Transparency = 0.3 })
	for _, p in ipairs({ { -2.4, -3.2 }, { 2.4, -3.2 }, { -2.4, 3.2 }, { 2.4, 3.2 } }) do
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 2, 2), CFrame = base * CFrame.new(p[1], 1, p[2]), Color = Color3.fromRGB(25, 25, 25) })
	end
	for _, s in ipairs({ -1.6, 1.6 }) do part({ Size = Vector3.new(0.9, 0.5, 0.2), CFrame = base * CFrame.new(s, 1.9, -5.05), Color = Color3.fromRGB(255, 250, 200), Material = Enum.Material.Neon }) end
end

local function statue(O, x, z, color, rot)
	local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rot or 0, 0)
	part({ Size = Vector3.new(6, 3, 6), CFrame = base * CFrame.new(0, 1.5, 0), Color = Color3.fromRGB(230, 225, 215), Material = Enum.Material.Marble })
	local mat = Enum.Material.Foil
	part({ Size = Vector3.new(4.5, 4, 2), CFrame = base * CFrame.new(0, 8.5, 0), Color = color, Material = mat, Reflectance = 0.3 })   -- Brust (breit!)
	part({ Size = Vector3.new(2.2, 3.5, 1.6), CFrame = base * CFrame.new(-1, 4.8, 0), Color = color, Material = mat, Reflectance = 0.3 })
	part({ Size = Vector3.new(2.2, 3.5, 1.6), CFrame = base * CFrame.new(1, 4.8, 0), Color = color, Material = mat, Reflectance = 0.3 })
	part({ Size = Vector3.new(1.4, 4, 1.4), CFrame = base * CFrame.new(-3.1, 9.5, 0) * CFrame.Angles(0, 0, math.rad(-150)), Color = color, Material = mat, Reflectance = 0.3 })   -- Bizeps-Pose
	part({ Size = Vector3.new(1.4, 4, 1.4), CFrame = base * CFrame.new(3.1, 9.5, 0) * CFrame.Angles(0, 0, math.rad(150)), Color = color, Material = mat, Reflectance = 0.3 })
	part({ Size = Vector3.new(2.2, 2.6, 2.4), CFrame = base * CFrame.new(0, 11.8, 0), Color = color, Material = mat, Reflectance = 0.3 })   -- kantiger Kopf
	part({ Size = Vector3.new(2.4, 0.8, 2.6), CFrame = base * CFrame.new(0, 10.8, -0.1), Color = color, Material = mat, Reflectance = 0.3 })  -- Kiefer
end

local function fountain(O, x, z)
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(2, 18, 18), CFrame = CFrame.new(O + Vector3.new(x, 1, z)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(220, 220, 225), Material = Enum.Material.Marble })
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 15.5, 15.5), CFrame = CFrame.new(O + Vector3.new(x, 2.05, z)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(90, 190, 240), Material = Enum.Material.Glass, Transparency = 0.3 })
	part({ Size = Vector3.new(1.5, 6, 1.5), CFrame = CFrame.new(O + Vector3.new(x, 4, z)), Color = Color3.fromRGB(220, 220, 225), Material = Enum.Material.Marble })
	local top = part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(O + Vector3.new(x, 7.5, z)), Color = Color3.fromRGB(150, 220, 255), Material = Enum.Material.Glass, Transparency = 0.3 })
	local water = Instance.new("ParticleEmitter")
	water.Color = ColorSequence.new(Color3.fromRGB(180, 230, 255))
	water.Rate = 25
	water.Speed = NumberRange.new(6, 9)
	water.Lifetime = NumberRange.new(0.8, 1.1)
	water.SpreadAngle = Vector2.new(25, 25)
	water.Acceleration = Vector3.new(0, -20, 0)
	water.Size = NumberSequence.new(0.4)
	water.EmissionDirection = Enum.NormalId.Top
	water.Parent = top
end

-- Wetter / Teilchen in der Luft (Schnee, Blüten, Sterne …)
local function airParticles(O, color, size, speed, rate)
	local p = part({ Size = Vector3.new(S, 1, S), CFrame = CFrame.new(O + Vector3.new(0, 70, 0)), Transparency = 1, CanCollide = false, CanQuery = false })
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.Size = NumberSequence.new(size)
	e.Rate = rate or 40
	e.Speed = NumberRange.new(speed, speed * 1.5)
	e.Lifetime = NumberRange.new(10, 14)
	e.EmissionDirection = Enum.NormalId.Bottom
	e.SpreadAngle = Vector2.new(15, 15)
	e.LightEmission = 0.4
	e.Parent = p
end

local THEME_DECO = {}

THEME_DECO.city = function(O, w, rng)
	for k = 1, 12 do
		local alongX = k % 2 == 0
		local pos = rng:NextNumber(70, 165) * (rng:NextNumber() < 0.5 and -1 or 1)
		local lane = (rng:NextNumber() < 0.5 and -6 or 6)
		if alongX then car(O, pos, lane, math.rad(90), CAR_COLORS[rng:NextInteger(1, #CAR_COLORS)])
		else car(O, lane, pos, 0, CAR_COLORS[rng:NextInteger(1, #CAR_COLORS)]) end
	end
	for _ = 1, 10 do
		local x, z = freeSpot(rng, 2, 50)
		if x then
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.6, 1.3, 1.3), CFrame = CFrame.new(O + Vector3.new(x, 1.3, z)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(220, 40, 40) })
			part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = CFrame.new(O + Vector3.new(x, 2.7, z)), Color = Color3.fromRGB(220, 40, 40) })
		end
	end
	local x, z = freeSpot(rng, 6, 80)
	if x then statue(O, x, z, Color3.fromRGB(255, 205, 60), math.atan2(x, z)) end
	local fx, fz = freeSpot(rng, 10, 80)
	if fx then fountain(O, fx, fz) end
end

THEME_DECO.beach = function(O, w, rng)
	local boardColors = { Color3.fromRGB(255, 90, 120), Color3.fromRGB(0, 200, 220), Color3.fromRGB(255, 220, 60), Color3.fromRGB(120, 220, 90) }
	for _ = 1, 12 do
		local x, z = freeSpot(rng, 2, 50)
		if x and z < 115 then
			ellipsoid({ Size = Vector3.new(2, 8, 0.4), CFrame = CFrame.new(O + Vector3.new(x, 3.5, z)) * CFrame.Angles(math.rad(-10), rng:NextNumber(0, 6), 0),
				Color = boardColors[rng:NextInteger(1, #boardColors)] })
		end
	end
	for _ = 1, 7 do
		local x, z = freeSpot(rng, 5, 50)
		if x and z < 115 then
			part({ Size = Vector3.new(6, 2, 6), CFrame = CFrame.new(O + Vector3.new(x, 1, z)), Color = Color3.fromRGB(225, 200, 140), Material = Enum.Material.Sand })
			for _, p in ipairs({ { -2.5, -2.5 }, { 2.5, -2.5 }, { -2.5, 2.5 }, { 2.5, 2.5 } }) do
				part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.5, 1.6, 1.6), CFrame = CFrame.new(O + Vector3.new(x + p[1], 2.5, z + p[2])) * CFrame.Angles(0, 0, math.rad(90)),
					Color = Color3.fromRGB(225, 200, 140), Material = Enum.Material.Sand })
			end
		end
	end
	for k = 1, 5 do
		local x = rng:NextNumber(-200, 200)
		local z = rng:NextNumber(150, 225)
		local base = CFrame.new(O + Vector3.new(x, 0.8, z)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
		part({ Size = Vector3.new(5, 2, 12), CFrame = base, Color = Color3.fromRGB(250, 250, 250) })
		part({ Size = Vector3.new(0.5, 10, 0.5), CFrame = base * CFrame.new(0, 6, 0), Color = Color3.fromRGB(120, 80, 50), Material = Enum.Material.Wood })
		part({ Class = "WedgePart", Size = Vector3.new(0.2, 8, 5), CFrame = base * CFrame.new(0, 6, 2.6), Color = k % 2 == 0 and Color3.fromRGB(255, 90, 120) or Color3.fromRGB(255, 255, 255) })
	end
	-- Rettungsturm
	local tx, tz = 60, 100
	for _, p in ipairs({ { -3, -3 }, { 3, -3 }, { -3, 3 }, { 3, 3 } }) do
		part({ Size = Vector3.new(0.8, 10, 0.8), CFrame = CFrame.new(O + Vector3.new(tx + p[1], 5, tz + p[2])), Color = Color3.fromRGB(250, 250, 250) })
	end
	part({ Size = Vector3.new(8, 5, 8), CFrame = CFrame.new(O + Vector3.new(tx, 12.5, tz)), Color = Color3.fromRGB(230, 50, 50) })
	part({ Size = Vector3.new(9, 0.8, 9), CFrame = CFrame.new(O + Vector3.new(tx, 15.4, tz)), Color = Color3.fromRGB(250, 250, 250) })
	for _ = 1, 10 do
		local x, z = freeSpot(rng, 2, 45)
		if x and z < 115 then
			part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2, 2, 2), CFrame = CFrame.new(O + Vector3.new(x, 1, z)), Color = boardColors[rng:NextInteger(1, #boardColors)] })
		end
	end
end

THEME_DECO.mountain = function(O, w, rng)
	airParticles(O, Color3.fromRGB(255, 255, 255), 0.5, 4, 60)
	for _ = 1, 7 do
		local x, z = freeSpot(rng, 5, 60, HALF - 60)
		if x then
			local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
			local col = ({ Color3.fromRGB(230, 90, 60), Color3.fromRGB(60, 130, 220), Color3.fromRGB(240, 200, 60) })[rng:NextInteger(1, 3)]
			part({ Class = "WedgePart", Size = Vector3.new(6, 4, 3), CFrame = base * CFrame.new(0, 2, -1.5), Color = col })
			part({ Class = "WedgePart", Size = Vector3.new(6, 4, 3), CFrame = base * CFrame.new(0, 2, 1.5) * CFrame.Angles(0, math.rad(180), 0), Color = col })
		end
	end
	for _ = 1, 5 do
		local x, z = freeSpot(rng, 3, 60)
		if x then
			for k = 0, 2 do
				part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 0.6, 0.6), CFrame = CFrame.new(O + Vector3.new(x, 0.3, z)) * CFrame.Angles(0, math.rad(k * 60), 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood })
			end
			local fireBase = part({ Size = Vector3.new(1, 1, 1), CFrame = CFrame.new(O + Vector3.new(x, 0.8, z)), Transparency = 1, CanCollide = false })
			local f = Instance.new("Fire")
			f.Size = 4
			f.Parent = fireBase
		end
	end
	for _ = 1, 7 do
		local x, z = freeSpot(rng, 3, 50)
		if x then
			for k, r in ipairs({ 3.6, 2.7, 1.9 }) do
				part({ Shape = Enum.PartType.Ball, Size = Vector3.new(r, r, r), CFrame = CFrame.new(O + Vector3.new(x, ({ 1.6, 4.4, 6.6 })[k], z)), Color = Color3.fromRGB(250, 250, 255), Material = Enum.Material.Snow })
			end
			part({ Size = Vector3.new(0.3, 0.3, 1.2), CFrame = CFrame.new(O + Vector3.new(x, 6.6, z - 1.2)), Color = Color3.fromRGB(255, 140, 30) })
		end
	end
	for _ = 1, 2 do
		local x, z = freeSpot(rng, 10, 90)
		if x then
			building(O, x, z, 16, 12, 10, Color3.fromRGB(130, 85, 50), Enum.Material.WoodPlanks, nil, Color3.fromRGB(255, 220, 150))
			part({ Class = "WedgePart", Size = Vector3.new(17, 6, 7), CFrame = CFrame.new(O + Vector3.new(x, 14, z - 3)), Color = Color3.fromRGB(240, 245, 255), Material = Enum.Material.Snow })
			part({ Class = "WedgePart", Size = Vector3.new(17, 6, 7), CFrame = CFrame.new(O + Vector3.new(x, 14, z + 3)) * CFrame.Angles(0, math.rad(180), 0), Color = Color3.fromRGB(240, 245, 255), Material = Enum.Material.Snow })
		end
	end
end

THEME_DECO.temple = function(O, w, rng)
	airParticles(O, Color3.fromRGB(255, 180, 210), 0.5, 3, 40)
	for _ = 1, 18 do
		local x, z = freeSpot(rng, 2, 50)
		if x then
			part({ Size = Vector3.new(0.6, 6, 0.6), CFrame = CFrame.new(O + Vector3.new(x, 3, z)), Color = Color3.fromRGB(60, 40, 30), Material = Enum.Material.Wood })
			local lan = ellipsoid({ Size = Vector3.new(2, 2.6, 2), CFrame = CFrame.new(O + Vector3.new(x, 6.8, z)), Color = Color3.fromRGB(230, 50, 40), Material = Enum.Material.Neon })
			local l = Instance.new("PointLight")
			l.Color = Color3.fromRGB(255, 120, 80)
			l.Range = 12
			l.Parent = lan
		end
	end
	for _ = 1, 12 do
		local x, z = freeSpot(rng, 6, 60)
		if x then tree(O, x, z, Color3.fromRGB(255, 170, 205), 1.1) end
	end
	for _ = 1, 9 do
		local x, z = freeSpot(rng, 3, 60)
		if x then
			for k = 1, 5 do
				local h = rng:NextNumber(10, 18)
				part({ Size = Vector3.new(0.8, h, 0.8), CFrame = CFrame.new(O + Vector3.new(x + rng:NextNumber(-1.5, 1.5), h / 2, z + rng:NextNumber(-1.5, 1.5))),
					Color = Color3.fromRGB(110, 170, 60), Material = Enum.Material.Grass })
			end
		end
	end
	for _, pos in ipairs({ { 0, -110 }, { -150, 20 } }) do
		local base = CFrame.new(O + Vector3.new(pos[1], 0, pos[2]))
		for _, s in ipairs({ -7, 7 }) do part({ Size = Vector3.new(1.6, 16, 1.6), CFrame = base * CFrame.new(s, 8, 0), Color = Color3.fromRGB(210, 40, 30) }) end
		part({ Size = Vector3.new(20, 1.6, 2.2), CFrame = base * CFrame.new(0, 16.5, 0), Color = Color3.fromRGB(30, 25, 25) })
		part({ Size = Vector3.new(17, 1.2, 1.6), CFrame = base * CFrame.new(0, 13.5, 0), Color = Color3.fromRGB(210, 40, 30) })
	end
	local px, pz = freeSpot(rng, 14, 70)
	if px then
		part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 24, 24), CFrame = CFrame.new(O + Vector3.new(px, 0.3, pz)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = Color3.fromRGB(70, 150, 200), Material = Enum.Material.Glass, Transparency = 0.25, CanCollide = false })
		for _ = 1, 6 do
			ellipsoid({ Size = Vector3.new(0.8, 0.6, 1.8), CFrame = CFrame.new(O + Vector3.new(px + rng:NextNumber(-8, 8), 0.5, pz + rng:NextNumber(-8, 8))) * CFrame.Angles(0, rng:NextNumber(0, 6), 0),
				Color = rng:NextNumber() < 0.5 and Color3.fromRGB(255, 140, 50) or Color3.fromRGB(255, 255, 255), CanCollide = false })
		end
	end
end

THEME_DECO.fashion = function(O, w, rng)
	airParticles(O, Color3.fromRGB(255, 200, 240), 0.3, 2, 25)
	for _ = 1, 12 do
		local x, z = freeSpot(rng, 2, 45)
		if x then
			local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 2.5, 2.5), CFrame = base * CFrame.new(0, 0.15, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(30, 30, 30) })
			part({ Size = Vector3.new(0.3, 3, 0.3), CFrame = base * CFrame.new(0, 1.6, 0), Color = Color3.fromRGB(30, 30, 30) })
			part({ Size = Vector3.new(2.2, 2.8, 1.1), CFrame = base * CFrame.new(0, 4.4, 0), Color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)] })
			part({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = base * CFrame.new(0, 6.4, 0), Color = Color3.fromRGB(245, 240, 235) })
		end
	end
	for _ = 1, 8 do
		local x, z = freeSpot(rng, 3, 50)
		if x then
			part({ Size = Vector3.new(6, 0.3, 0.3), CFrame = CFrame.new(O + Vector3.new(x, 5, z)), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal })
			for _, s in ipairs({ -2.8, 2.8 }) do part({ Size = Vector3.new(0.3, 5, 0.3), CFrame = CFrame.new(O + Vector3.new(x + s, 2.5, z)), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal }) end
			for k = -2, 2 do
				part({ Size = Vector3.new(0.4, 2.6, 1.6), CFrame = CFrame.new(O + Vector3.new(x + k * 1.1, 3.5, z)), Color = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)], Material = Enum.Material.Fabric })
			end
		end
	end
	for _ = 1, 2 do
		local x, z = freeSpot(rng, 10, 80)
		if x then fountain(O, x, z) end
	end
end

THEME_DECO.hollywood = function(O, w, rng)
	for _ = 1, 8 do
		local x, z = freeSpot(rng, 3, 50)
		if x then
			local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
			for k = 0, 2 do part({ Size = Vector3.new(0.3, 5, 0.3), CFrame = base * CFrame.Angles(0, math.rad(k * 120), 0) * CFrame.new(0, 2.3, 0.8) * CFrame.Angles(math.rad(15), 0, 0), Color = Color3.fromRGB(40, 40, 40) }) end
			part({ Size = Vector3.new(2, 1.8, 3), CFrame = base * CFrame.new(0, 5.4, 0), Color = Color3.fromRGB(30, 30, 30) })
			part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 1.2, 1.2), CFrame = base * CFrame.new(0, 5.4, -1.9) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(80, 80, 90) })
		end
	end
	for _ = 1, 6 do
		local x, z = freeSpot(rng, 2, 45)
		if x then
			local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
			part({ Size = Vector3.new(2.4, 0.3, 2), CFrame = base * CFrame.new(0, 2.2, 0), Color = Color3.fromRGB(30, 30, 30), Material = Enum.Material.Fabric })
			part({ Size = Vector3.new(2.4, 1.6, 0.2), CFrame = base * CFrame.new(0, 3.4, 0.9), Color = Color3.fromRGB(30, 30, 30), Material = Enum.Material.Fabric })
			for _, s in ipairs({ -1.1, 1.1 }) do part({ Size = Vector3.new(0.2, 2.2, 2), CFrame = base * CFrame.new(s, 1.1, 0), Color = Color3.fromRGB(150, 100, 60), Material = Enum.Material.Wood }) end
		end
	end
	for _ = 1, 4 do
		local x, z = freeSpot(rng, 6, 70)
		if x then statue(O, x, z, Color3.fromRGB(255, 205, 60), math.atan2(x, z)) end
	end
	for _ = 1, 3 do
		local x, z = freeSpot(rng, 10, 90)
		if x then
			part({ Size = Vector3.new(10, 7, 22), CFrame = CFrame.new(O + Vector3.new(x, 3.5, z)), Color = Color3.fromRGB(235, 235, 240), Material = Enum.Material.Metal })
			surfaceSign(part({ Size = Vector3.new(8, 2, 0.3), CFrame = CFrame.new(O + Vector3.new(x, 6, z - 11.2)), Color = Color3.fromRGB(20, 5, 35) }), Enum.NormalId.Front, "⭐ STAR", Color3.fromRGB(20, 5, 35), WHITE)
		end
	end
end

THEME_DECO.dubai = function(O, w, rng)
	for _ = 1, 9 do
		local x, z = freeSpot(rng, 6, 50)
		if x then car(O, x, z, rng:NextNumber(0, 6), rng:NextNumber() < 0.6 and Color3.fromRGB(212, 175, 55) or Color3.fromRGB(250, 250, 250), true) end
	end
	for _ = 1, 8 do
		local a = rng:NextNumber(0, math.pi * 2)
		local r = rng:NextNumber(HALF + 15, HALF + 45)
		ellipsoid({ Size = Vector3.new(rng:NextNumber(40, 70), rng:NextNumber(10, 18), rng:NextNumber(30, 50)), CFrame = CFrame.new(O + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)),
			Color = Color3.fromRGB(230, 200, 140), Material = Enum.Material.Sand })
	end
	for _ = 1, 5 do
		local x, z = freeSpot(rng, 4, 60)
		if x then
			local base = CFrame.new(O + Vector3.new(x, 0, z)) * CFrame.Angles(0, rng:NextNumber(0, 6), 0)
			local col = Color3.fromRGB(200, 160, 100)
			ellipsoid({ Size = Vector3.new(2.4, 2.4, 5), CFrame = base * CFrame.new(0, 4.5, 0), Color = col })
			ellipsoid({ Size = Vector3.new(2, 2, 2.4), CFrame = base * CFrame.new(0, 6, 0.2), Color = col })
			ellipsoid({ Size = Vector3.new(0.8, 3, 0.8), CFrame = base * CFrame.new(0, 6, -2.6) * CFrame.Angles(math.rad(-20), 0, 0), Color = col })
			ellipsoid({ Size = Vector3.new(1.2, 1.2, 1.8), CFrame = base * CFrame.new(0, 7.6, -3.2), Color = col })
			for _, p in ipairs({ { -0.8, -1.8 }, { 0.8, -1.8 }, { -0.8, 1.8 }, { 0.8, 1.8 } }) do
				part({ Size = Vector3.new(0.5, 3.8, 0.5), CFrame = base * CFrame.new(p[1], 1.9, p[2]), Color = col })
			end
		end
	end
	for _ = 1, 3 do
		local x, z = freeSpot(rng, 10, 80)
		if x then fountain(O, x, z) end
	end
	for _ = 1, 2 do
		local x, z = freeSpot(rng, 6, 80)
		if x then statue(O, x, z, Color3.fromRGB(212, 175, 55), math.atan2(x, z)) end
	end
end

THEME_DECO.galaxy = function(O, w, rng)
	airParticles(O, Color3.fromRGB(220, 200, 255), 0.4, 1.5, 50)
	-- Rakete
	local rx, rz = 150, 120
	part({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(40, 10, 10), CFrame = CFrame.new(O + Vector3.new(rx, 22, rz)) * CFrame.Angles(0, 0, math.rad(90)), Color = Color3.fromRGB(240, 240, 245), Material = Enum.Material.Metal })
	ellipsoid({ Size = Vector3.new(10, 14, 10), CFrame = CFrame.new(O + Vector3.new(rx, 44, rz)), Color = Color3.fromRGB(230, 50, 60) })
	for k = 0, 3 do
		part({ Class = "WedgePart", Size = Vector3.new(1, 10, 6), CFrame = CFrame.new(O + Vector3.new(rx, 5, rz)) * CFrame.Angles(0, math.rad(k * 90), 0) * CFrame.new(0, 0, 7), Color = Color3.fromRGB(230, 50, 60) })
	end
	part({ Shape = Enum.PartType.Ball, Size = Vector3.new(3.5, 3.5, 3.5), CFrame = CFrame.new(O + Vector3.new(rx, 30, rz - 5)), Color = Color3.fromRGB(120, 200, 255), Material = Enum.Material.Neon })
	for _ = 1, 4 do
		local pos = O + Vector3.new(rng:NextNumber(-200, 200), rng:NextNumber(50, 90), rng:NextNumber(-200, 200))
		part({ Size = Vector3.new(3, 3, 4), CFrame = CFrame.new(pos), Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal, CanCollide = false })
		for _, s in ipairs({ -1, 1 }) do
			part({ Size = Vector3.new(7, 0.2, 3), CFrame = CFrame.new(pos + Vector3.new(s * 5.5, 0, 0)), Color = Color3.fromRGB(40, 70, 160), Material = Enum.Material.Glass, CanCollide = false })
		end
	end
	for _ = 1, 16 do
		local s = rng:NextNumber(3, 9)
		part({ Shape = Enum.PartType.Ball, Size = Vector3.new(s, s * 0.8, s), CFrame = CFrame.new(O + Vector3.new(rng:NextNumber(-220, 220), rng:NextNumber(15, 60), rng:NextNumber(-220, 220))),
			Color = Color3.fromRGB(110, 95, 130), Material = Enum.Material.Slate, CanCollide = false })
	end
	for _ = 1, 12 do
		local x, z = freeSpot(rng, 3, 50)
		if x then
			local h = rng:NextNumber(4, 9)
			part({ Size = Vector3.new(0.5, h, 0.5), CFrame = CFrame.new(O + Vector3.new(x, h / 2, z)), Color = Color3.fromRGB(80, 200, 160) })
			part({ Shape = Enum.PartType.Ball, Size = Vector3.new(2.2, 2.2, 2.2), CFrame = CFrame.new(O + Vector3.new(x, h + 0.6, z)), Color = Color3.fromRGB(255, 100, 220), Material = Enum.Material.Neon })
		end
	end
end

-- Für ALLE Welten: Wolken, Bänke, Büsche, Blumen, Mülleimer, Werbetafeln
local function decorate(O, w, rng)
	if w.theme ~= "galaxy" then
		for _ = 1, 10 do cloud(O, rng) end
	end
	local natural = (w.theme == "mountain" or w.theme == "temple" or w.theme == "beach")
	for _ = 1, 12 do
		local x, z = freeSpot(rng, 4, 45)
		if x then bench(O, x, z, rng:NextNumber(0, 6)) end
	end
	if w.theme ~= "galaxy" then
		for _ = 1, 20 do
			local x, z = freeSpot(rng, 3, 45)
			if x then bush(O, x, z, natural and Color3.fromRGB(70, 140, 60) or Color3.fromRGB(60, 160, 80), rng:NextNumber(3, 5)) end
		end
		for _ = 1, 10 do
			local x, z = freeSpot(rng, 4, 45)
			if x then flowerbed(O, x, z, rng) end
		end
	end
	if not natural then
		for _ = 1, 8 do
			local x, z = freeSpot(rng, 2, 40)
			if x then trashcan(O, x, z) end
		end
	end
	for k = 1, 4 do
		local x, z = freeSpot(rng, 12, 90)
		if x then bigSign(O, x, z, SLOGANS[((math.floor(w.mult * 7) + k) % #SLOGANS) + 1], math.atan2(x, z) + math.pi, w.accent) end
	end
	local extra = THEME_DECO[w.theme]
	if extra then extra(O, w, rng) end
end


local GROUND_MATERIAL = {
	city = Enum.Material.Concrete, beach = Enum.Material.Sand, mountain = Enum.Material.Grass, temple = Enum.Material.Grass,
	fashion = Enum.Material.Pavement, hollywood = Enum.Material.Sandstone, dubai = Enum.Material.Sand, galaxy = Enum.Material.Slate,
}
-- Welten mit echtem Gelände (Terrain) als Boden
local TERRAIN_GROUND = { beach = Enum.Material.Sand, mountain = Enum.Material.Snow, temple = Enum.Material.Grass, dubai = Enum.Material.Sand }

----------------------------------------------------------------------------
-- NPCs (Rivalen & Bosse)
----------------------------------------------------------------------------
local npcFolder = nil

local function makeNPC(def, position, isBoss)
	local scale = def.scale or 1
	local model = nil
	local ok = pcall(function()
		local desc = Instance.new("HumanoidDescription")
		desc.HeadColor = def.skin
		desc.LeftArmColor = def.skin
		desc.RightArmColor = def.skin
		desc.TorsoColor = def.shirt
		desc.LeftLegColor = def.pants
		desc.RightLegColor = def.pants
		desc.HeightScale = scale
		desc.WidthScale = scale * (isBoss and 1.15 or 1)
		desc.DepthScale = scale
		desc.HeadScale = scale
		model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	end)
	if not ok or not model then
		-- Notlösung: einfache Figur aus Blöcken
		model = Instance.new("Model")
		local body = Instance.new("Part")
		body.Name = "HumanoidRootPart"
		body.Size = Vector3.new(2, 5, 1) * scale
		body.Color = def.shirt
		body.Anchored = true
		body.Parent = model
		local head = Instance.new("Part")
		head.Name = "Head"
		head.Size = Vector3.new(1.6, 1.6, 1.6) * scale
		head.Color = def.skin
		head.Anchored = true
		head.CFrame = body.CFrame * CFrame.new(0, 3.3 * scale, 0)
		head.Parent = model
		model.PrimaryPart = body
	end
	model.Name = def.name
	local hrp = model:FindFirstChild("HumanoidRootPart")
	local hum = model:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	model:PivotTo(CFrame.new(position + Vector3.new(0, 3 * scale, 0)) * CFrame.Angles(0, math.rad(180), 0))
	if hrp then hrp.Anchored = true end
	model.Parent = npcFolder

	local head = model:FindFirstChild("Head") or hrp
	local title
	if def.final then
		title = "<font color='#ffd166'>💀 LEON · ENDBOSS</font>"
	elseif isBoss then
		title = "<font color='#ff5d73'>👑 BOSS</font>"
	else
		title = "<font color='#ffb36b'>⚔️ RIVALE</font>"
	end
	billboard(head, title .. "\n" .. def.name .. "\n<font size='14' color='#ffd166'>Stufe " .. def.level .. " · ♻️ " .. def.rebirths .. "</font>",
		8, 3.2, 3 * scale, WHITE)

	if isBoss and hrp then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Rate = def.final and 40 or 15
		sparkle.LightEmission = 1
		sparkle.Lifetime = NumberRange.new(1, 2)
		sparkle.Speed = NumberRange.new(2, 4)
		sparkle.SpreadAngle = Vector2.new(180, 180)
		sparkle.Color = ColorSequence.new(def.final and Color3.fromRGB(255, 209, 102) or Color3.fromRGB(255, 93, 115))
		sparkle.Parent = hrp
	end

	local pr = prompt(hrp or head, isBoss and "Boss herausfordern" or "Mog Battle", def.name, isBoss and 1 or 0.4)
	return pr
end

